<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unabhaengige Gegenprobe zur PDF-Signatur (siehe tools/cms-verify/README.md).
    Bewusst NICHT Teil von Pagebound.slnx: das Werkzeug wird von Hand
    aufgerufen und soll den normalen Build nicht aufhalten.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cms-verify</AssemblyName>
    <RootNamespace>Pagebound.Tools.CmsVerify</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Die CMS/PKCS-Typen liegen nicht im Standardverweis-Satz. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.0" />
  </ItemGroup>

</Project>
