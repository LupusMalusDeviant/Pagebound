@page "/reader"
@using Pagebound.Web.Features.PdfTools
@inject ILocalizationService L
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@*
    Single-Pane-Reader. Die eigentliche Logik steckt in <ReaderPane />,
    weil sie auch in der SplitView (FA-090..092) wiederverwendet wird —
    dort liegen dann zwei Panes nebeneinander, jede mit eigenem State.

    `?pdf={hash}`-Parameter: kommt von der Library-Page (Klick auf einen
    Eintrag) und triggert im Pane das Auto-Open der gespeicherten Bytes
    aus IndexedDB. Wenn die Bytes fehlen, fällt's still auf den File-
    Picker zurück.

    Subtabs „Dokument" | „Werkzeuge" (UI-Konsolidierung): der Werkzeuge-Tab
    rendert <PdfToolsPanel /> direkt im Reader — mit den Bytes des aktuell
    geöffneten PDFs vorbefüllt (kein erneutes Laden nötig). Die ReaderPane
    bleibt dabei im DOM (nur per CSS versteckt), damit Scroll-Position,
    Suche und Annotations-State beim Tab-Wechsel erhalten bleiben.
*@

<PageTitle>@L.T("reader.pageTitle")</PageTitle>

<div class="border-b border-pb-border px-4 sm:px-6 lg:px-8 py-2 flex items-center gap-2"
     role="tablist" aria-label="@L.T("reader.tabs.aria")">
    <button type="button" role="tab" id="reader-tab-doc"
            aria-selected="@((!_toolsTabActive).ToString().ToLowerInvariant())"
            aria-controls="reader-tabpanel-doc"
            class="@TabClass(!_toolsTabActive)"
            @onclick="ShowDocumentTab">
        @L.T("reader.tab.document")
    </button>
    <button type="button" role="tab" id="reader-tab-tools"
            aria-selected="@(_toolsTabActive.ToString().ToLowerInvariant())"
            aria-controls="reader-tabpanel-tools"
            class="@TabClass(_toolsTabActive)"
            @onclick="ShowToolsTab">
        @L.T("reader.tab.tools")
    </button>
</div>

@if (_pendingResult is not null)
{
    <div class="border-b border-pb-border bg-pb-surface px-4 sm:px-6 lg:px-8 py-2 flex flex-wrap items-center gap-2 text-xs" role="status">
        <span class="min-w-0 truncate">@L.T("reader.tools.result", new Dictionary<string, object> { ["name"] = _pendingResultName ?? "PDF" })</span>
        <button type="button" class="btn-side is-primary" @onclick="OpenPendingResult">@L.T("reader.tools.openResult")</button>
        <button type="button" class="btn-side" @onclick="@(() => _pendingResult = null)">@L.T("reader.tools.dismissResult")</button>
    </div>
}

<div id="reader-tabpanel-doc" role="tabpanel" aria-labelledby="reader-tab-doc"
     class="@(_toolsTabActive ? "hidden" : null)">
    <ReaderPane @ref="_pane" InitialPdfHash="@_pdfHash" />
</div>

@if (_toolsTabEverOpened)
{
    <div id="reader-tabpanel-tools" role="tabpanel" aria-labelledby="reader-tab-tools"
         class="@(_toolsTabActive ? "mx-auto max-w-[1800px] px-4 sm:px-6 lg:px-8 py-8" : "hidden")">
        <PdfToolsPanel @key="_toolsPanelKey"
                       Embedded="true"
                       InitialPdfBytes="@_toolsBytes"
                       InitialPdfName="@_toolsName" />
    </div>
}

@code {
    private string? _pdfHash;
    private ReaderPane? _pane;

    // Werkzeuge-Subtab: Panel wird beim ersten Öffnen erzeugt und danach nur
    // versteckt; wechselt im Reader das Dokument, erzwingt @key eine frische
    // Instanz mit den neuen Bytes.
    private bool _toolsTabActive;
    private bool _toolsTabEverOpened;
    private byte[]? _toolsBytes;
    private string? _toolsName;
    private int _toolsPanelKey;

    private static string TabClass(bool active) =>
        active
            ? "rounded border border-pb-accent px-3 py-1 text-sm text-pb-accent font-medium"
            : "rounded border border-pb-border px-3 py-1 text-sm text-pb-fg-muted hover:text-pb-fg";

    private void ShowDocumentTab() => _toolsTabActive = false;

    private void ShowToolsTab()
    {
        var bytes = _pane?.LoadedPdfBytes;
        if (!_toolsTabEverOpened || !ReferenceEquals(bytes, _toolsBytes))
        {
            _toolsBytes = bytes;
            _toolsName = _pane?.LoadedTitle;
            _toolsPanelKey++;
        }
        _toolsTabEverOpened = true;
        _toolsTabActive = true;
    }

    // Werkzeug-Ergebnisse (Downloads aus dem „Werkzeuge"-Tab) zur Übernahme in
    // den Reader anbieten — beobachtet die zentrale Download-Bridge.
    private byte[]? _pendingResult;
    private string? _pendingResultName;
    private DotNetObjectReference<ReaderPage>? _selfRef;

    [JSInvokable]
    public Task OnPdfDownloaded(string filename, string base64)
    {
        // Nur Ergebnisse aus dem Werkzeuge-Tab anbieten — Downloads aus dem
        // Dokument-Tab (z. B. signiertes PDF speichern) nicht doppelt andienen.
        if (_toolsTabActive)
        {
            _pendingResult = Convert.FromBase64String(base64);
            _pendingResultName = filename;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private async Task OpenPendingResult()
    {
        var bytes = _pendingResult;
        var name = _pendingResultName ?? "ergebnis.pdf";
        _pendingResult = null;
        if (bytes is null || _pane is null) return;
        ShowDocumentTab();
        await _pane.OpenBytesAsync(bytes, name);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("pageboundShortcuts.registerDownloadObserver", _selfRef);
        }
    }

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UpdateFromQuery();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        try
        {
            _ = JS.InvokeVoidAsync("pageboundShortcuts.unregisterDownloadObserver");
        }
        catch
        {
            // Teardown während Navigation — ignorieren.
        }
        _selfRef?.Dispose();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        UpdateFromQuery();
        StateHasChanged();
    }

    /// <summary>
    /// Liest <c>?pdf=...</c> aus der aktuellen URL — wir parsen das manuell,
    /// statt <c>Microsoft.AspNetCore.WebUtilities</c> als Dependency zu ziehen
    /// (würde nur diese eine Stelle rechtfertigen). Single-Param-Lookup ist
    /// einfach genug; mehrere Werte mit gleichem Key werden nicht unterstützt.
    /// </summary>
    private void UpdateFromQuery()
    {
        _pdfHash = ExtractQueryValue(Nav.Uri, "pdf");
    }

    private static string? ExtractQueryValue(string fullUri, string key)
    {
        var qIdx = fullUri.IndexOf('?');
        if (qIdx < 0) return null;
        var query = fullUri.Substring(qIdx + 1);
        var fragIdx = query.IndexOf('#');
        if (fragIdx >= 0) query = query.Substring(0, fragIdx);

        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq < 0) continue;
            var k = Uri.UnescapeDataString(pair.Substring(0, eq));
            if (!string.Equals(k, key, StringComparison.Ordinal)) continue;
            return Uri.UnescapeDataString(pair.Substring(eq + 1));
        }
        return null;
    }
}
