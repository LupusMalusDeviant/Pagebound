@page "/reader"
@using System.Globalization
@using Markdig
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IPdfRenderer Renderer
@inject IPdfManipulator Manipulator
@inject IHashService Hasher
@inject IAnnotationService Annotations
@inject IMarkdownExporter MarkdownExporter
@inject IIntegrityService Integrity
@inject IStorageService Storage
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Reader — Pagebound</PageTitle>

<section class="mx-auto max-w-[1800px] px-4 sm:px-6 lg:px-8 py-8">
    <header class="max-w-4xl mx-auto mb-6">
        <h1 class="text-2xl font-bold">Reader (Demo)</h1>
        <p class="mt-1 text-sm text-pb-fg-muted">
            Erste vertikale Skelett-Iteration für Release 0.1.
            Volltext-Suche, Outline, Highlights folgen.
        </p>
    </header>

    <div class="max-w-4xl mx-auto rounded-lg border border-pb-border bg-pb-surface p-4">
        <label class="flex flex-col gap-2 text-sm">
            <span class="font-medium">PDF auswählen</span>
            <InputFile OnChange="HandleFileSelected"
                       accept=".pdf"
                       class="block text-sm file:mr-3 file:rounded file:border-0 file:bg-pb-accent file:px-3 file:py-1.5 file:text-white file:cursor-pointer cursor-pointer" />
        </label>

        @if (_errorMessage is not null)
        {
            <div class="mt-3 rounded border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-700 whitespace-pre-wrap font-mono"
                 role="alert">
                @_errorMessage
            </div>
        }

        @if (_isLoading)
        {
            <div class="mt-3 text-sm text-pb-fg-muted" aria-live="polite">Lade …</div>
        }
    </div>

    @if (_handle is not null)
    {
        <div class="max-w-4xl mx-auto mt-4 rounded-lg border border-pb-border bg-pb-surface p-4">
            <form @onsubmit="DoSearchAsync" @onsubmit:preventDefault>
                <div class="flex flex-wrap gap-2 items-center">
                    <input @bind="_searchQuery"
                           @bind:event="oninput"
                           type="search"
                           data-pb-search-input
                           class="flex-1 min-w-0 rounded border border-pb-border bg-pb-bg px-3 py-1.5 text-sm"
                           placeholder="Im Dokument suchen …  (Strg+F)"
                           disabled="@_isSearching"
                           aria-label="Suchbegriff" />
                    <button type="submit"
                            class="rounded bg-pb-accent px-3 py-1.5 text-sm text-white disabled:opacity-40"
                            disabled="@(_isSearching || string.IsNullOrWhiteSpace(_searchQuery))">
                        @(_isSearching ? "Suche …" : "Suchen")
                    </button>
                    @if (_searchHits is not null)
                    {
                        <button type="button"
                                class="rounded border border-pb-border px-2 py-1 text-xs text-pb-fg-muted hover:text-pb-fg"
                                @onclick="ClearSearch"
                                aria-label="Suche zurücksetzen">
                            Zurücksetzen
                        </button>
                    }
                </div>
                <div class="mt-2 flex gap-4 text-xs text-pb-fg-muted">
                    <label class="flex items-center gap-1 cursor-pointer">
                        <input type="checkbox" @bind="_matchCase" class="rounded" />
                        Groß-/Kleinschreibung
                    </label>
                    <label class="flex items-center gap-1 cursor-pointer">
                        <input type="checkbox" @bind="_wholeWord" class="rounded" />
                        Ganzes Wort
                    </label>
                </div>
            </form>

            @if (_searchHits is not null)
            {
                <div class="mt-3 text-sm" aria-live="polite">
                    @if (_pdfHasNoTextLayer)
                    {
                        <div class="rounded border border-amber-300/40 bg-amber-50/10 px-3 py-2 text-pb-fg">
                            <div class="font-medium">Diese PDF enthält keinen durchsuchbaren Text.</div>
                            <p class="mt-1 text-pb-fg-muted">
                                Wahrscheinlich wurde der Text als Vektor-Pfade gerendert
                                (typisch für stilisierte Designer-Layouts aus Illustrator,
                                InDesign oder Figma). Eine Volltext-Suche ist erst möglich,
                                wenn der Text per OCR erkannt wird — das ist als
                                Funktion <span class="font-mono">FA-050</span> in
                                <span class="font-medium">Release 0.9</span> geplant.
                            </p>
                        </div>
                    }
                    else if (_searchHits.Count == 0)
                    {
                        <span class="text-pb-fg-muted">Keine Treffer für „<span class="font-medium">@_lastSearched</span>".</span>
                    }
                    else
                    {
                        <span><span class="font-medium">@_searchHits.Count</span> Treffer für „<span class="font-medium">@_lastSearched</span>":</span>
                        <ul class="mt-2 max-h-64 overflow-y-auto divide-y divide-pb-border border border-pb-border rounded">
                            @foreach (var hit in _searchHits)
                            {
                                var snippetBefore = hit.Snippet.Substring(0, Math.Min(hit.SnippetMatchStart, hit.Snippet.Length));
                                var matchEnd = Math.Min(hit.SnippetMatchStart + hit.Match.Length, hit.Snippet.Length);
                                var snippetMatch = hit.Snippet.Substring(Math.Min(hit.SnippetMatchStart, hit.Snippet.Length), matchEnd - Math.Min(hit.SnippetMatchStart, hit.Snippet.Length));
                                var snippetAfter = matchEnd < hit.Snippet.Length ? hit.Snippet.Substring(matchEnd) : "";
                                <li>
                                    <button type="button"
                                            class="block w-full text-left p-2 hover:bg-pb-bg"
                                            @onclick="@(() => GoToPageAsync(hit.PageNumber))">
                                        <div class="text-xs text-pb-fg-muted">Seite @hit.PageNumber</div>
                                        <div class="text-sm">
                                            @snippetBefore<mark class="bg-pb-accent/20 text-pb-fg rounded px-0.5">@snippetMatch</mark>@snippetAfter
                                        </div>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
        </div>

        <div class="max-w-4xl mx-auto mt-6 flex items-center justify-between gap-3">
            <div class="text-sm">
                <span class="font-medium">@(_handle.Title ?? "Ohne Titel")</span>
                <span class="text-pb-fg-muted"> · @_handle.PageCount Seiten</span>
            </div>
            <nav class="flex items-center gap-2" aria-label="Seitennavigation">
                <button type="button"
                        class="rounded border border-pb-border px-3 py-1 text-sm disabled:opacity-40"
                        disabled="@(_currentPage <= 1 || _isRendering)"
                        @onclick="PreviousPage">
                    ‹ Zurück
                </button>
                <span class="text-sm tabular-nums">
                    Seite @_currentPage / @_handle.PageCount
                </span>
                <button type="button"
                        class="rounded border border-pb-border px-3 py-1 text-sm disabled:opacity-40"
                        disabled="@(_currentPage >= _handle.PageCount || _isRendering)"
                        @onclick="NextPage">
                    Weiter ›
                </button>
            </nav>
        </div>

        <div class="max-w-4xl mx-auto mt-3 flex flex-wrap items-center gap-4 text-sm">
            <div class="flex flex-wrap items-center gap-2">
                <span class="text-pb-fg-muted">Zoom:</span>
                @foreach (var z in _zoomLevels)
                {
                    var current = z;
                    <button type="button"
                            class="@($"rounded border px-2 py-0.5 {(Math.Abs(_zoomFactor - current) < 0.001 ? "border-pb-accent text-pb-accent" : "border-pb-border text-pb-fg-muted")}")"
                            disabled="@_isRendering"
                            @onclick="@(() => SetZoom(current))">
                        @($"{(int)(current * 100)}%")
                    </button>
                }
            </div>
            <div class="flex items-center gap-2">
                <span class="text-pb-fg-muted">Werkzeug:</span>
                <button type="button"
                        class="@($"rounded border px-2 py-0.5 {(_annotationMode == AnnotationMode.Select ? "border-pb-accent text-pb-accent" : "border-pb-border text-pb-fg-muted")}")"
                        @onclick="@(() => SetAnnotationMode(AnnotationMode.Select))"
                        title="Auswahl-Modus (kein neuer Pin bei Klick)">
                    Auswählen
                </button>
                <button type="button"
                        class="@($"rounded border px-2 py-0.5 {(_annotationMode == AnnotationMode.StickyNote ? "border-pb-accent text-pb-accent" : "border-pb-border text-pb-fg-muted")}")"
                        @onclick="@(() => SetAnnotationMode(AnnotationMode.StickyNote))"
                        title="Klick aufs PDF erstellt eine neue Notiz">
                    📝 Notiz
                </button>
                @if (_activeSignatureImage is null)
                {
                    <label class="rounded border border-pb-border bg-pb-bg px-2 py-0.5 text-pb-fg-muted hover:text-pb-fg cursor-pointer"
                           title="PNG/JPG-Signatur laden, dann zum Platzieren auf das PDF klicken">
                        ✍️ Signatur laden
                        <InputFile OnChange="HandleSignatureImageSelectedAsync"
                                   accept=".png,.jpg,.jpeg,image/png,image/jpeg"
                                   class="hidden" />
                    </label>
                }
                else
                {
                    <button type="button"
                            class="@($"rounded border px-2 py-0.5 {(_annotationMode == AnnotationMode.Signature ? "border-pb-accent text-pb-accent" : "border-pb-border text-pb-fg-muted")}")"
                            @onclick="@(() => SetAnnotationMode(AnnotationMode.Signature))"
                            title="Klick aufs PDF platziert die geladene Signatur">
                        ✍️ @(_activeSignatureFilename ?? "Signatur") platzieren
                    </button>
                    <button type="button"
                            class="text-xs text-pb-fg-muted hover:text-pb-fg px-1"
                            @onclick="ClearActiveSignature"
                            title="Signatur entladen"
                            aria-label="Signatur entladen">
                        ✕
                    </button>
                }
                <button type="button"
                        class="@($"rounded border px-2 py-0.5 text-pb-fg-muted hover:text-pb-fg {(_signerPanelOpen ? "border-pb-accent text-pb-accent" : "border-pb-border")}")"
                        @onclick="@(() => _signerPanelOpen = !_signerPanelOpen)"
                        title="Unterzeichner-Daten — werden in die Signatur und beim Signiert-Speichern in die PDF-Metadaten geschrieben">
                    👤 @(string.IsNullOrWhiteSpace(_signer.Name) ? "Unterzeichner …" : _signer.Name)
                </button>
                @if (_annotations.Any(a => a.Type == AnnotationType.Signature))
                {
                    <button type="button"
                            class="rounded border border-pb-border bg-pb-bg px-2 py-0.5 text-pb-fg-muted hover:text-pb-fg disabled:opacity-40"
                            disabled="@_isSavingSignedPdf"
                            @onclick="ExportSignedPdfAsync"
                            title="PDF mit allen platzierten Signaturen und Signer-Metadaten als neue Datei herunterladen">
                        @(_isSavingSignedPdf ? "Speichere …" : "📥 Signiert speichern")
                    </button>
                }
                <span class="text-pb-fg-muted ml-2">Zeichnen:</span>
                <button type="button"
                        class="@($"rounded border px-2 py-0.5 {(_annotationMode == AnnotationMode.Pen ? "border-pb-accent text-pb-accent" : "border-pb-border text-pb-fg-muted")}")"
                        @onclick="@(() => SetAnnotationMode(AnnotationMode.Pen))"
                        title="Freihand-Zeichnen mit Maus/Stift (FA-013)">
                    ✏️ Stift
                </button>
                <button type="button"
                        class="@($"rounded border px-2 py-0.5 {(_annotationMode == AnnotationMode.RectShape ? "border-pb-accent text-pb-accent" : "border-pb-border text-pb-fg-muted")}")"
                        @onclick="@(() => SetAnnotationMode(AnnotationMode.RectShape))"
                        title="Rechteck aufziehen (FA-014)">
                    ▭ Rechteck
                </button>
                <button type="button"
                        class="@($"rounded border px-2 py-0.5 {(_annotationMode == AnnotationMode.ArrowShape ? "border-pb-accent text-pb-accent" : "border-pb-border text-pb-fg-muted")}")"
                        @onclick="@(() => SetAnnotationMode(AnnotationMode.ArrowShape))"
                        title="Pfeil ziehen (FA-014)">
                    ↗ Pfeil
                </button>
                <button type="button"
                        class="@($"rounded border px-2 py-0.5 {(_annotationMode == AnnotationMode.LineShape ? "border-pb-accent text-pb-accent" : "border-pb-border text-pb-fg-muted")}")"
                        @onclick="@(() => SetAnnotationMode(AnnotationMode.LineShape))"
                        title="Linie ziehen (FA-014)">
                    ╱ Linie
                </button>
            </div>
            @if (IsDrawingMode(_annotationMode))
            {
                <div class="max-w-4xl mx-auto mt-1 flex flex-wrap items-center gap-3 text-xs text-pb-fg-muted">
                    <span>Farbe:</span>
                    @foreach (var (label, css) in DrawPalette)
                    {
                        var c = css;
                        var l = label;
                        var isActive = string.Equals(_drawColor, c, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="@($"w-6 h-6 rounded-full border {(isActive ? "border-pb-accent ring-2 ring-pb-accent/40" : "border-pb-border")} hover:scale-110 transition-transform")"
                                style="@($"background-color:{c}")"
                                title="@l"
                                aria-label="@($"Stiftfarbe {l}")"
                                @onclick="@(() => SetDrawColor(c))"></button>
                    }
                    <span class="ml-2">Stärke:</span>
                    @foreach (var (label, fraction) in DrawStrokeWidths)
                    {
                        var f = fraction;
                        var l = label;
                        var isActive = Math.Abs(_drawStrokeWidth - f) < 1e-6;
                        <button type="button"
                                class="@($"rounded border px-2 py-0.5 {(isActive ? "border-pb-accent text-pb-accent" : "border-pb-border text-pb-fg-muted")}")"
                                title="@($"Strichstärke {l}")"
                                @onclick="@(() => SetDrawStrokeWidth(f))">
                            @l
                        </button>
                    }
                </div>
            }
            <div class="flex items-center gap-2">
                <button type="button"
                        class="@($"rounded border px-2 py-0.5 {(_outlineOpen ? "border-pb-accent text-pb-accent" : "border-pb-border text-pb-fg-muted")}")"
                        title="Inhaltsverzeichnis ein- bzw. ausblenden"
                        @onclick="@(() => _outlineOpen = !_outlineOpen)">
                    📑 Inhalt
                    @if (_outline is null && _handle is not null)
                    {
                        <span class="ml-1 text-xs text-pb-fg-muted">(leer)</span>
                    }
                </button>
                <button type="button"
                        class="rounded border border-pb-border bg-pb-bg px-2 py-0.5 text-pb-fg-muted hover:text-pb-fg disabled:opacity-40 disabled:cursor-not-allowed"
                        disabled="@(_isExporting || _annotations.Count == 0)"
                        title="@(_annotations.Count == 0 ? "Noch keine Annotationen zum Exportieren" : "Highlights + Notizen als Markdown exportieren (Obsidian-kompatibel)")"
                        @onclick="ExportMarkdownAsync">
                    @(_isExporting ? "Exportiere …" : "📤 Markdown")
                    @if (!_isExporting && _annotations.Count > 0)
                    {
                        <span class="ml-1 text-xs">(@_annotations.Count)</span>
                    }
                </button>
            </div>
        </div>

        @if (_signerPanelOpen)
        {
            <div class="max-w-4xl mx-auto mt-2 rounded-lg border border-pb-border bg-pb-surface p-3">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-sm font-medium">Unterzeichner-Daten</span>
                    <span class="text-xs text-pb-fg-muted">werden in der Sidecar und beim „Signiert speichern" ins PDF-Info-Dictionary geschrieben</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm">
                    <label class="flex flex-col gap-1">
                        <span class="text-xs text-pb-fg-muted">Name <span class="text-red-400">*</span></span>
                        <input type="text"
                               class="rounded border border-pb-border bg-pb-bg px-2 py-1"
                               placeholder="Max Mustermann"
                               value="@_signer.Name"
                               @oninput="@(e => _signer = _signer with { Name = e.Value?.ToString() ?? string.Empty })" />
                    </label>
                    <label class="flex flex-col gap-1">
                        <span class="text-xs text-pb-fg-muted">E-Mail</span>
                        <input type="email"
                               class="rounded border border-pb-border bg-pb-bg px-2 py-1"
                               placeholder="max@example.com"
                               value="@(_signer.Email ?? string.Empty)"
                               @oninput="@(e => _signer = _signer with { Email = NullIfBlank(e.Value?.ToString()) })" />
                    </label>
                    <label class="flex flex-col gap-1">
                        <span class="text-xs text-pb-fg-muted">Begründung / Anlass</span>
                        <input type="text"
                               class="rounded border border-pb-border bg-pb-bg px-2 py-1"
                               placeholder="Vertragsannahme, Auftragsbestätigung, …"
                               value="@(_signer.Reason ?? string.Empty)"
                               @oninput="@(e => _signer = _signer with { Reason = NullIfBlank(e.Value?.ToString()) })" />
                    </label>
                    <label class="flex flex-col gap-1">
                        <span class="text-xs text-pb-fg-muted">Ort</span>
                        <input type="text"
                               class="rounded border border-pb-border bg-pb-bg px-2 py-1"
                               placeholder="Berlin, Stralsund, …"
                               value="@(_signer.Location ?? string.Empty)"
                               @oninput="@(e => _signer = _signer with { Location = NullIfBlank(e.Value?.ToString()) })" />
                    </label>
                </div>
                <div class="mt-2 flex justify-end gap-2">
                    <button type="button"
                            class="text-xs text-pb-fg-muted hover:text-pb-fg"
                            @onclick="@(() => _signerPanelOpen = false)">
                        Schließen
                    </button>
                    <button type="button"
                            class="rounded bg-pb-accent px-3 py-1 text-xs text-white disabled:opacity-40"
                            disabled="@(!_signer.IsComplete)"
                            @onclick="SaveSignerToStorageAsync"
                            title="Daten für alle weiteren Signaturen merken (im Browser)">
                        Merken
                    </button>
                </div>
            </div>
        }

        <div class="mt-6 flex gap-4 items-start">

        @if (_outlineOpen)
        {
            <aside class="w-64 shrink-0 rounded-lg border border-pb-border bg-pb-surface p-3 max-h-[80vh] overflow-y-auto"
                   aria-label="Inhaltsverzeichnis">
                <div class="flex items-center justify-between mb-2">
                    <h3 class="text-sm font-medium">Inhaltsverzeichnis</h3>
                    <button type="button"
                            class="text-pb-fg-muted hover:text-pb-fg text-xs"
                            @onclick="@(() => _outlineOpen = false)"
                            aria-label="Inhaltsverzeichnis schließen">
                        ✕
                    </button>
                </div>
                @if (_outline is null)
                {
                    <p class="text-xs text-pb-fg-muted italic">Diese PDF hat kein Inhaltsverzeichnis.</p>
                }
                else
                {
                    <ul class="text-sm">
                        @foreach (var entry in _outline.Entries)
                        {
                            <OutlineNode Entry="entry" OnNavigate="GoToPageAsync" />
                        }
                    </ul>
                }
            </aside>
        }

        <figure class="flex-1 min-w-0 flex justify-center rounded-lg border border-pb-border bg-pb-bg p-4 overflow-visible">
            @if (_rasterDataUrl is not null && _renderedPage is not null)
            {
                var pageW = _renderedPage.PageWidthPt;
                var pageH = _renderedPage.PageHeightPt;
                var maxWidthPx = _renderedPage.WidthPx;
                var canvasStyle = string.Format(
                    CultureInfo.InvariantCulture,
                    "container-type:size; aspect-ratio:{0}/{1}; width:min(100%, {2}px)",
                    pageW, pageH, maxWidthPx);
                <div data-pb-page-canvas
                     class="relative @(_annotationMode == AnnotationMode.StickyNote || IsDrawingMode(_annotationMode) ? "cursor-crosshair" : "cursor-text")"
                     style="@canvasStyle"
                     @onclick="HandlePdfClickAsync"
                     @onmouseup="HandleCanvasMouseUpAsync">
                    <img src="@_rasterDataUrl"
                         data-pb-pdf-image
                         alt="@($"Seite {_currentPage} von {_handle.PageCount}")"
                         class="block w-full h-full shadow-sm select-none pointer-events-none"
                         draggable="false" />

                    @* Text-Layer (transparent + selectable) für FA-005 Suche-Highlighting und FA-010 Highlight-Selection.
                       Im Sticky-Note-Modus deaktiviert (pointer-events-none + select-none), damit Klicks aufs PDF
                       direkt auf das Canvas-Div durchschlagen und einen Pin setzen können. *@
                    @if (_pageTextItems.Count > 0)
                    {
                        var textLayerClass = (_annotationMode == AnnotationMode.StickyNote || IsDrawingMode(_annotationMode))
                            ? "absolute inset-0 leading-none whitespace-pre select-none pointer-events-none"
                            : "absolute inset-0 leading-none whitespace-pre select-text";
                        <div class="@textLayerClass" aria-hidden="true">
                            @foreach (var item in _pageTextItems)
                            {
                                var leftPct = (item.X / pageW * 100).ToString("F3", CultureInfo.InvariantCulture);
                                var topPct = (item.Y / pageH * 100).ToString("F3", CultureInfo.InvariantCulture);
                                var widthPct = (item.Width / pageW * 100).ToString("F3", CultureInfo.InvariantCulture);
                                var fontCqh = (item.Height / pageH * 100).ToString("F3", CultureInfo.InvariantCulture);
                                <span class="absolute text-transparent origin-top-left"
                                      style="@($"left:{leftPct}%; top:{topPct}%; width:{widthPct}%; font-size:{fontCqh}cqh")">@item.Text</span>
                            }
                        </div>
                    }

                    @* Highlight-Layer (über Text, semi-transparent, klickbar zur Bearbeitung) *@
                    @foreach (var hl in HighlightsOnCurrentPage)
                    {
                        var highlight = hl;
                        var color = HighlightAnnotation.GetColor(highlight);
                        foreach (var rect in HighlightAnnotation.GetRects(highlight))
                        {
                            var rLeft = (rect.X * 100).ToString("F3", CultureInfo.InvariantCulture);
                            var rTop = (rect.Y * 100).ToString("F3", CultureInfo.InvariantCulture);
                            var rWidth = (rect.Width * 100).ToString("F3", CultureInfo.InvariantCulture);
                            var rHeight = (rect.Height * 100).ToString("F3", CultureInfo.InvariantCulture);
                            <button type="button"
                                    class="absolute cursor-pointer border-0 p-0"
                                    style="@($"left:{rLeft}%; top:{rTop}%; width:{rWidth}%; height:{rHeight}%; background-color:{color}; mix-blend-mode:multiply; opacity:0.85")"
                                    aria-label="Markierter Text bearbeiten"
                                    title="@HighlightAnnotation.GetText(highlight)"
                                    @onclick="@(() => OpenHighlightEditor(highlight))"
                                    @onclick:stopPropagation></button>
                        }
                    }

                    @* Ink + Shape Overlay (FA-013 Stift, FA-014 Formen).
                       SVG mit viewBox 0..1 — alle Punkte/Bounds sind als
                       Seiten-Anteile gespeichert und skalieren automatisch
                       mit dem Zoom. *@
                    @if (InkOnCurrentPage.Any() || ShapesOnCurrentPage.Any())
                    {
                        var drawingActive = IsDrawingMode(_annotationMode);
                        // Hit-Helper-Stroke: transparente, deutlich dickere
                        // Variante jedes Pfads — pointer-events:stroke fängt
                        // nur EXAKT auf der Strichbreite, deshalb brauchen wir
                        // ein eigenes Element mit ~0.02 Seiten-Anteilen für
                        // bequemes Klicken zum Löschen. Im Zeichen-Modus auch
                        // diese Helper deaktivieren, damit Klicks beim Live-Zeichnen
                        // an die JS-Bridge auf dem Canvas durchgereicht werden.
                        const string HitStrokeWidth = "0.024";
                        var hitPointerCss = drawingActive
                            ? "pointer-events:none"
                            : "pointer-events:stroke; cursor:pointer";
                        <svg class="absolute inset-0 w-full h-full"
                             style="pointer-events:none; z-index:10"
                             viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true">
                            @foreach (var ink in InkOnCurrentPage)
                            {
                                var inkAnn = ink;
                                var inkColor = InkAnnotation.GetColor(inkAnn);
                                var inkSw = InkAnnotation.GetStrokeWidth(inkAnn)
                                    .ToString("F4", CultureInfo.InvariantCulture);
                                foreach (var stroke in InkAnnotation.GetStrokes(inkAnn))
                                {
                                    var d = BuildInkPath(stroke);
                                    if (string.IsNullOrEmpty(d)) continue;
                                    @* Hit-Helper: transparent + dick + klickbar *@
                                    <path d="@d" fill="none" stroke="transparent" stroke-width="@HitStrokeWidth"
                                          stroke-linecap="round" stroke-linejoin="round"
                                          style="@hitPointerCss"
                                          @onclick="@(() => OpenDrawingEditor(inkAnn))"
                                          @onclick:stopPropagation />
                                    @* Sichtbarer Stroke: pointer-events deaktiviert *@
                                    <path d="@d" fill="none" stroke="@inkColor" stroke-width="@inkSw"
                                          stroke-linecap="round" stroke-linejoin="round"
                                          style="pointer-events:none" />
                                }
                            }
                            @foreach (var shape in ShapesOnCurrentPage)
                            {
                                var sa = shape;
                                var kind = ShapeAnnotation.GetShape(sa);
                                var col = ShapeAnnotation.GetColor(sa);
                                var sw = ShapeAnnotation.GetStrokeWidth(sa);
                                var swStr = sw.ToString("F4", CultureInfo.InvariantCulture);
                                var sx = ShapeAnnotation.GetStartX(sa);
                                var sy = ShapeAnnotation.GetStartY(sa);
                                var ex = ShapeAnnotation.GetEndX(sa);
                                var ey = ShapeAnnotation.GetEndY(sa);
                                if (kind == ShapeKind.Rectangle)
                                {
                                    var rx = Math.Min(sx, ex).ToString("F4", CultureInfo.InvariantCulture);
                                    var ry = Math.Min(sy, ey).ToString("F4", CultureInfo.InvariantCulture);
                                    var rw = Math.Abs(ex - sx).ToString("F4", CultureInfo.InvariantCulture);
                                    var rh = Math.Abs(ey - sy).ToString("F4", CultureInfo.InvariantCulture);
                                    @* Hit-Helper auf den Rahmen, nicht auf den hohlen Innenraum *@
                                    <rect x="@rx" y="@ry" width="@rw" height="@rh"
                                          fill="none" stroke="transparent" stroke-width="@HitStrokeWidth"
                                          style="@hitPointerCss"
                                          @onclick="@(() => OpenDrawingEditor(sa))"
                                          @onclick:stopPropagation />
                                    <rect x="@rx" y="@ry" width="@rw" height="@rh"
                                          fill="none" stroke="@col" stroke-width="@swStr"
                                          style="pointer-events:none" />
                                }
                                else
                                {
                                    var x1 = sx.ToString("F4", CultureInfo.InvariantCulture);
                                    var y1 = sy.ToString("F4", CultureInfo.InvariantCulture);
                                    var x2 = ex.ToString("F4", CultureInfo.InvariantCulture);
                                    var y2 = ey.ToString("F4", CultureInfo.InvariantCulture);
                                    <line x1="@x1" y1="@y1" x2="@x2" y2="@y2"
                                          stroke="transparent" stroke-width="@HitStrokeWidth"
                                          stroke-linecap="round"
                                          style="@hitPointerCss"
                                          @onclick="@(() => OpenDrawingEditor(sa))"
                                          @onclick:stopPropagation />
                                    <line x1="@x1" y1="@y1" x2="@x2" y2="@y2"
                                          stroke="@col" stroke-width="@swStr"
                                          stroke-linecap="round"
                                          style="pointer-events:none" />
                                    @if (kind == ShapeKind.Arrow)
                                    {
                                        var head = ComputeArrowHead(sx, sy, ex, ey, sw);
                                        if (head is not null)
                                        {
                                            var (hx1, hy1, hx2, hy2, hx3, hy3) = head.Value;
                                            var points = string.Format(CultureInfo.InvariantCulture,
                                                "{0:F4},{1:F4} {2:F4},{3:F4} {4:F4},{5:F4}",
                                                hx1, hy1, hx2, hy2, hx3, hy3);
                                            <polygon points="@points" fill="@col" stroke="none"
                                                     style="pointer-events:none" />
                                        }
                                    }
                                }
                            }
                        </svg>
                    }

                    @* Lösch-Mini-Toolbar (FA-013/014) bei selektierter Ink/Shape *@
                    @if (_editingDrawing is not null && _editingDrawing.PageNumber == _currentPage)
                    {
                        var (anchorX, anchorY) = GetDrawingAnchor(_editingDrawing);
                        var anchorLeftPct = (anchorX * 100).ToString("F2", CultureInfo.InvariantCulture);
                        var anchorTopPct = (anchorY * 100).ToString("F2", CultureInfo.InvariantCulture);
                        var translateY = anchorY < 0.08 ? "8px" : "calc(-100% - 6px)";
                        <div class="absolute z-20 flex items-center gap-1 rounded-md border border-pb-border bg-pb-surface px-2 py-1 shadow-lg"
                             style="@($"left:{anchorLeftPct}%; top:{anchorTopPct}%; transform: translate(-50%, {translateY})")"
                             @onclick:stopPropagation>
                            <span class="text-xs text-pb-fg-muted mr-1">
                                @(_editingDrawing.Type == AnnotationType.Ink ? "Stift" : "Form")
                            </span>
                            <button type="button"
                                    class="px-2 py-0.5 text-xs rounded border border-pb-border text-pb-fg-muted hover:text-pb-fg"
                                    @onclick="DeleteEditingDrawingAsync"
                                    title="Löschen">
                                🗑 Löschen
                            </button>
                            <button type="button"
                                    class="ml-1 px-1 text-pb-fg-muted hover:text-pb-fg text-sm"
                                    @onclick="@(() => _editingDrawing = null)"
                                    aria-label="Auswahl verwerfen">✕</button>
                        </div>
                    }

                    @* Inline-Toolbar bei Selection (FA-018) *@
                    @if (_pendingSelection is not null && _editingHighlight is null)
                    {
                        var anchorLeft = (_pendingSelection.AnchorX * 100).ToString("F2", CultureInfo.InvariantCulture);
                        var anchorTop = (_pendingSelection.AnchorY * 100).ToString("F2", CultureInfo.InvariantCulture);
                        // Bei Selection ganz oben auf der Seite klappt die Toolbar
                        // nach unten, sonst nach oben (Default).
                        var toolbarTranslateY = _pendingSelection.AnchorY < 0.08
                            ? "8px"
                            : "calc(-100% - 6px)";
                        <div class="absolute z-20 flex items-center gap-1 rounded-md border border-pb-border bg-pb-surface px-2 py-1 shadow-lg"
                             style="@($"left:{anchorLeft}%; top:{anchorTop}%; transform: translate(-50%, {toolbarTranslateY})")"
                             @onmousedown:preventDefault
                             @onclick:stopPropagation>
                            <span class="text-xs text-pb-fg-muted mr-1">Markieren:</span>
                            @foreach (var color in HighlightPalette)
                            {
                                var c = color;
                                <button type="button"
                                        class="w-5 h-5 rounded-full border border-pb-border hover:scale-110 transition-transform"
                                        style="@($"background-color:{c}")"
                                        title="@c"
                                        aria-label="@($"Mit Farbe {c} markieren")"
                                        @onclick="@(() => HighlightPendingSelectionAsync(c))"></button>
                            }
                            <button type="button"
                                    class="ml-1 px-1 text-pb-fg-muted hover:text-pb-fg text-sm"
                                    @onclick="DismissSelection"
                                    aria-label="Auswahl verwerfen">✕</button>
                        </div>
                    }

                    @* Highlight-Editor (Click auf bereits gesetzten Highlight) *@
                    @if (_editingHighlight is not null && _editingHighlight.PageNumber == _currentPage)
                    {
                        var firstRect = HighlightAnnotation.GetRects(_editingHighlight).FirstOrDefault();
                        if (firstRect is not null)
                        {
                            var editLeft = (firstRect.X * 100).ToString("F2", CultureInfo.InvariantCulture);
                            var editTop = (firstRect.Y * 100).ToString("F2", CultureInfo.InvariantCulture);
                            // Highlight oben → Toolbar unter dem Rechteck.
                            var hlTranslateY = firstRect.Y < 0.08
                                ? $"calc({firstRect.Height * 100:F2}% + 6px)"
                                : "calc(-100% - 6px)";
                            <div class="absolute z-20 flex items-center gap-1 rounded-md border border-pb-border bg-pb-surface px-2 py-1 shadow-lg"
                                 style="@($"left:{editLeft}%; top:{editTop}%; transform: translate(0, {hlTranslateY})")"
                                 @onclick:stopPropagation>
                                <span class="text-xs text-pb-fg-muted mr-1">Farbe:</span>
                                @foreach (var color in HighlightPalette)
                                {
                                    var c = color;
                                    var isCurrent = HighlightAnnotation.GetColor(_editingHighlight) == c;
                                    <button type="button"
                                            class="@($"w-5 h-5 rounded-full border hover:scale-110 transition-transform {(isCurrent ? "border-pb-accent" : "border-pb-border")}")"
                                            style="@($"background-color:{c}")"
                                            @onclick="@(() => ChangeHighlightColorAsync(c))"></button>
                                }
                                <button type="button"
                                        class="ml-1 rounded border border-red-300/40 px-2 py-0.5 text-xs text-red-400 hover:bg-red-50/10"
                                        @onclick="DeleteEditingHighlightAsync">
                                    Löschen
                                </button>
                                <button type="button"
                                        class="ml-1 px-1 text-pb-fg-muted hover:text-pb-fg text-sm"
                                        @onclick="CancelHighlightEditing"
                                        aria-label="Schließen">✕</button>
                            </div>
                        }
                    }

                    @* Signaturen (FA-015) — PNG-Bild mit Integritäts-Status-Badge *@
                    @foreach (var sig in SignaturesOnCurrentPage)
                    {
                        var signature = sig;
                        var sigLeft = (SignatureAnnotation.GetX(signature) * 100).ToString("F3", CultureInfo.InvariantCulture);
                        var sigTop = (SignatureAnnotation.GetY(signature) * 100).ToString("F3", CultureInfo.InvariantCulture);
                        var sigWidth = (SignatureAnnotation.GetWidth(signature) * 100).ToString("F3", CultureInfo.InvariantCulture);
                        var sigHeight = (SignatureAnnotation.GetHeight(signature) * 100).ToString("F3", CultureInfo.InvariantCulture);
                        var status = _signatureStatuses.GetValueOrDefault(signature.Id.Value, SignatureIntegrityStatus.NoHash);
                        var ringClass = status switch
                        {
                            SignatureIntegrityStatus.Valid => "ring-2 ring-green-400/70",
                            SignatureIntegrityStatus.Invalid => "ring-2 ring-red-400/80",
                            _ => "ring-1 ring-amber-400/50"
                        };
                        var badgeBg = status switch
                        {
                            SignatureIntegrityStatus.Valid => "bg-green-500",
                            SignatureIntegrityStatus.Invalid => "bg-red-500",
                            _ => "bg-amber-500"
                        };
                        var badgeIcon = status switch
                        {
                            SignatureIntegrityStatus.Valid => "✓",
                            SignatureIntegrityStatus.Invalid => "!",
                            _ => "?"
                        };
                        var badgeTitle = status switch
                        {
                            SignatureIntegrityStatus.Valid => "Integrität geprüft — PDF + Annotationen unverändert seit Signatur",
                            SignatureIntegrityStatus.Invalid => "Integrität verletzt — PDF oder Annotationen wurden nach der Signatur verändert",
                            _ => "Kein Integritäts-Hash gespeichert"
                        };
                        var signedAtLabel = SignatureAnnotation.GetSignedAt(signature).ToLocalTime().ToString("yyyy-MM-dd HH:mm");
                        <div data-pb-signature-id="@signature.Id.Value"
                             class="absolute @ringClass rounded bg-white/40 cursor-move select-none touch-none"
                             style="@($"left:{sigLeft}%; top:{sigTop}%; width:{sigWidth}%; height:{sigHeight}%")"
                             title="@($"Signatur von {signedAtLabel} — {badgeTitle} (Ziehen zum Verschieben)")"
                             @onmousedown="@((MouseEventArgs e) => HandleSignatureMouseDownAsync(e, signature))"
                             @onmousedown:stopPropagation
                             @onclick:stopPropagation>
                            <img src="@SignatureAnnotation.GetImageDataUrl(signature)"
                                 alt="Signatur"
                                 draggable="false"
                                 class="w-full h-full object-contain pointer-events-none" />
                            <span class="absolute -top-2 -right-2 w-5 h-5 rounded-full text-xs text-white flex items-center justify-center shadow @badgeBg pointer-events-none"
                                  aria-label="@badgeTitle">@badgeIcon</span>
                            <button type="button"
                                    class="absolute -bottom-2 -left-2 w-5 h-5 rounded-full bg-pb-surface border border-pb-border text-xs text-pb-fg-muted hover:text-red-500 flex items-center justify-center shadow"
                                    @onclick="@(() => DeleteSignatureAsync(signature))"
                                    @onclick:stopPropagation
                                    @onmousedown:stopPropagation
                                    title="Signatur entfernen"
                                    aria-label="Signatur entfernen">
                                ✕
                            </button>
                            <div class="absolute -bottom-2 -right-2 w-5 h-5 rounded-full bg-pb-surface border border-pb-border text-xs text-pb-fg-muted hover:text-pb-accent flex items-center justify-center shadow cursor-nwse-resize"
                                 @onmousedown="@((MouseEventArgs e) => HandleSignatureResizeMouseDownAsync(e, signature))"
                                 @onmousedown:stopPropagation
                                 @onclick:stopPropagation
                                 title="Größe ändern (ziehen)"
                                 aria-label="Größe ändern">
                                ↘
                            </div>
                        </div>
                    }

                    @* Pins für alle Sticky Notes auf der aktuellen Seite *@
                    @foreach (var note in StickyNotesOnCurrentPage)
                    {
                        var n = note;
                        var leftPct = (StickyNoteAnnotation.GetX(n) * 100).ToString("F2", CultureInfo.InvariantCulture);
                        var topPct = (StickyNoteAnnotation.GetY(n) * 100).ToString("F2", CultureInfo.InvariantCulture);
                        var color = StickyNoteAnnotation.GetColor(n);
                        var preview = StickyNoteAnnotation.GetContent(n);
                        var previewText = string.IsNullOrWhiteSpace(preview) ? "(leer)" : preview;
                        <button type="button"
                                class="absolute -translate-x-1/2 -translate-y-1/2 rounded-full border border-pb-border shadow-md w-7 h-7 flex items-center justify-center text-xs hover:scale-110 transition-transform"
                                style="@($"left:{leftPct}%; top:{topPct}%; background-color:{color}")"
                                title="@previewText"
                                aria-label="@($"Notiz auf Seite {n.PageNumber}: {previewText}")"
                                @onclick="@(() => OpenEditor(n))"
                                @onclick:stopPropagation>
                            📝
                        </button>
                    }

                    @* Editor-Popover für aktuelle Notiz *@
                    @if (_editingAnnotation is not null && _editingAnnotation.PageNumber == _currentPage)
                    {
                        var noteX = StickyNoteAnnotation.GetX(_editingAnnotation);
                        var noteY = StickyNoteAnnotation.GetY(_editingAnnotation);
                        var editLeft = (noteX * 100).ToString("F2", CultureInfo.InvariantCulture);
                        var editTop = (noteY * 100).ToString("F2", CultureInfo.InvariantCulture);
                        // Pin sitzt rechts → Popover nach links flippen, damit es nicht überhängt.
                        // Pin sitzt unten → Popover nach oben flippen.
                        var translateX = noteX > 0.55 ? "calc(-100% - 8px)" : "8px";
                        var translateY = noteY > 0.65 ? "calc(-100% + 8px)" : "-8px";
                        <div class="absolute z-10 w-80 rounded-lg border border-pb-border bg-pb-surface shadow-xl p-3"
                             style="@($"left:{editLeft}%; top:{editTop}%; transform: translate({translateX}, {translateY})")"
                             @onclick:stopPropagation>
                            <div class="flex items-center justify-between mb-2 gap-2">
                                <span class="text-xs text-pb-fg-muted">Notiz · Seite @_editingAnnotation.PageNumber</span>
                                <div class="flex items-center gap-1">
                                    <button type="button"
                                            class="text-xs text-pb-fg-muted hover:text-pb-fg rounded border border-pb-border px-1.5 py-0.5"
                                            @onclick="ToggleEditorPreview"
                                            title="@(_editorPreviewMode ? "Zum Bearbeiten umschalten" : "Markdown-Vorschau anzeigen")">
                                        @(_editorPreviewMode ? "Bearbeiten" : "Vorschau")
                                    </button>
                                    <button type="button"
                                            class="text-pb-fg-muted hover:text-pb-fg text-sm"
                                            @onclick="CancelEditing"
                                            aria-label="Schließen">
                                        ✕
                                    </button>
                                </div>
                            </div>

                            @if (_editorPreviewMode)
                            {
                                @if (string.IsNullOrWhiteSpace(_editingContent))
                                {
                                    <p class="h-28 rounded border border-pb-border bg-pb-bg px-2 py-1 text-sm text-pb-fg-muted italic">
                                        Keine Notiz erfasst.
                                    </p>
                                }
                                else
                                {
                                    <div class="pb-markdown h-28 overflow-y-auto rounded border border-pb-border bg-pb-bg px-2 py-1 text-sm">
                                        @RenderMarkdown(_editingContent)
                                    </div>
                                }
                            }
                            else
                            {
                                <textarea @bind="_editingContent"
                                          @bind:event="oninput"
                                          class="w-full h-28 rounded border border-pb-border bg-pb-bg px-2 py-1 text-sm resize-none font-mono"
                                          placeholder="**Markdown** wird unterstützt …"
                                          aria-label="Notiz-Inhalt"></textarea>
                            }
                            <div class="mt-2 flex gap-2 justify-end">
                                <button type="button"
                                        class="rounded border border-red-300/40 px-2 py-1 text-xs text-red-400 hover:bg-red-50/10"
                                        @onclick="DeleteEditingAnnotationAsync">
                                    Löschen
                                </button>
                                <button type="button"
                                        class="rounded bg-pb-accent px-3 py-1 text-xs text-white"
                                        @onclick="SaveEditingAnnotationAsync">
                                    Speichern
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-sm text-pb-fg-muted py-12">Rendere …</div>
            }
        </figure>

        </div> @* /flex-Wrapper Outline+PDF *@

        <p class="max-w-4xl mx-auto mt-4 text-xs text-pb-fg-muted">
            Tastatur:
            <kbd class="rounded border border-pb-border px-1.5 py-0.5">←</kbd>
            <kbd class="rounded border border-pb-border px-1.5 py-0.5">→</kbd>
            Seitenwechsel ·
            <kbd class="rounded border border-pb-border px-1.5 py-0.5">Pos1</kbd>
            <kbd class="rounded border border-pb-border px-1.5 py-0.5">Ende</kbd>
            erste / letzte Seite ·
            <kbd class="rounded border border-pb-border px-1.5 py-0.5">Strg+F</kbd>
            Suche ·
            <kbd class="rounded border border-pb-border px-1.5 py-0.5">Esc</kbd>
            Zurücksetzen ·
            <kbd class="rounded border border-pb-border px-1.5 py-0.5">Strg+ +</kbd>
            <kbd class="rounded border border-pb-border px-1.5 py-0.5">Strg+ −</kbd>
            <kbd class="rounded border border-pb-border px-1.5 py-0.5">Strg+0</kbd>
            Zoom
        </p>
    }
    else if (!_isLoading)
    {
        <div class="max-w-4xl mx-auto mt-6 rounded-lg border border-dashed border-pb-border p-6 text-center text-sm text-pb-fg-muted">
            Wähle eine PDF-Datei aus, um sie zu öffnen.
        </div>
    }
</section>

@code {
    private const long MaxFileSize = 100L * 1024 * 1024; // 100 MB Demo-Limit
    private const string ShortcutsJs = "pageboundShortcuts";
    private const string SearchInputSelector = "[data-pb-search-input]";

    // Interner PDF.js-Scale für den User-Faktor "100 %" (1.0).
    // Damit ergibt der Default eine gut lesbare Render-Auflösung; alle weiteren
    // Stufen sind Vielfache davon (siehe _zoomLevels).
    private const double BaseScale = 2.0;

    // Zoom-Faktoren wie sie der Nutzer sieht: 0.5 = "50 %", 1.0 = "100 %", ...
    private readonly double[] _zoomLevels = [0.5, 0.75, 1.0, 1.25, 1.5, 2.0];

    private PdfDocumentHandle? _handle;
    private int _currentPage = 1;
    private double _zoomFactor = 1.0;
    private string? _rasterDataUrl;
    private string? _errorMessage;
    private bool _isLoading;
    private bool _isRendering;

    // Such-Zustand (FA-005)
    private string _searchQuery = string.Empty;
    private bool _matchCase;
    private bool _wholeWord;
    private bool _isSearching;
    private IReadOnlyList<SearchHit>? _searchHits;
    private string _lastSearched = string.Empty;
    private bool _pdfHasNoTextLayer;

    // Tastatur-Shortcuts (NFA-031 Tastatur-Navigation)
    private DotNetObjectReference<ReaderPage>? _dotNetRef;
    private bool _shortcutsRegistered;

    // Annotation-State (FA-011 Sticky Notes, FA-070 ff. Persistenz)
    private const string PdfImageSelector = "[data-pb-pdf-image]";
    private const string PageCanvasSelector = "[data-pb-page-canvas]";
    private PdfId? _currentPdfId;
    private string? _currentFilename;
    private bool _isExporting;
    private IReadOnlyList<Annotation> _annotations = Array.Empty<Annotation>();
    private AnnotationMode _annotationMode = AnnotationMode.Select;
    private Annotation? _editingAnnotation;
    private string _editingContent = string.Empty;

    // Text-Layer + Highlight-State (FA-010 Highlight, FA-018 Inline-Toolbar)
    private RenderedPage? _renderedPage;
    private IReadOnlyList<TextItem> _pageTextItems = Array.Empty<TextItem>();
    private SelectionDto? _pendingSelection;
    private Annotation? _editingHighlight;

    // Outline (FA-006)
    private PdfOutline? _outline;
    private bool _outlineOpen;

    // Notiz-Editor-Modus (FA-012 Markdown-Live-Preview)
    private bool _editorPreviewMode;

    // Markdig-Pipeline ohne raw HTML (XSS-Schutz für NFA-025).
    // Static damit die Pipeline einmal pro App-Lifetime gebaut wird.
    private static readonly MarkdownPipeline MarkdownPipeline =
        new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .DisableHtml()
            .Build();

    private static MarkupString RenderMarkdown(string source)
    {
        if (string.IsNullOrWhiteSpace(source))
        {
            return new MarkupString(string.Empty);
        }
        return new MarkupString(Markdown.ToHtml(source, MarkdownPipeline));
    }

    private static readonly string[] HighlightPalette =
    {
        HighlightAnnotation.DefaultColor, // gelb
        "#bbf7d0", // green-200
        "#bae6fd", // sky-200
        "#fbcfe8", // pink-200
        "#ddd6fe"  // violet-200
    };

    private double InternalScale => BaseScale * _zoomFactor;

    private IEnumerable<Annotation> StickyNotesOnCurrentPage =>
        _annotations.Where(a => a.Type == AnnotationType.StickyNote && a.PageNumber == _currentPage);

    private IEnumerable<Annotation> HighlightsOnCurrentPage =>
        _annotations.Where(a => a.Type == AnnotationType.Highlight && a.PageNumber == _currentPage);

    private enum AnnotationMode
    {
        Select,
        StickyNote,
        Signature,
        Pen,
        RectShape,
        ArrowShape,
        LineShape
    }

    private static bool IsDrawingMode(AnnotationMode mode) => mode is
        AnnotationMode.Pen or AnnotationMode.RectShape or
        AnnotationMode.ArrowShape or AnnotationMode.LineShape;

    // Zeichenwerkzeug-State (FA-013 Stift, FA-014 Formen).
    // Persistente Listener-Verwaltung liegt im JS (shortcuts-bridge), pro
    // pointerdown→up kommt ein Callback zurück mit den 0..1-Punkten.
    private static readonly (string Label, string Css)[] DrawPalette =
    {
        ("Schwarz", "#000000"),
        ("Rot", "#dc2626"),
        ("Blau", "#2563eb")
    };

    private static readonly (string Label, double Fraction)[] DrawStrokeWidths =
    {
        ("dünn", 0.002),
        ("normal", 0.004),
        ("dick", 0.008)
    };

    private string _drawColor = "#000000";
    private double _drawStrokeWidth = 0.004;
    private int? _captureAttachedToPage;

    // Signatur-State (FA-015/016/017)
    private const string SignerStorageKey = "settings:signer";
    private string? _activeSignatureImage; // Data-URL
    private string? _activeSignatureFilename;
    private const int MaxSignatureBytes = 2 * 1024 * 1024; // 2 MB
    private Dictionary<string, SignatureIntegrityStatus> _signatureStatuses = new();
    private byte[]? _originalPdfBytes;
    private SignerInfo _signer = SignerInfo.Empty;
    private bool _signerPanelOpen;
    private bool _isSavingSignedPdf;
    private bool _signerLoaded;

    private IEnumerable<Annotation> SignaturesOnCurrentPage =>
        _annotations.Where(a => a.Type == AnnotationType.Signature && a.PageNumber == _currentPage);

    private IEnumerable<Annotation> InkOnCurrentPage =>
        _annotations.Where(a => a.Type == AnnotationType.Ink && a.PageNumber == _currentPage);

    private IEnumerable<Annotation> ShapesOnCurrentPage =>
        _annotations.Where(a => a.Type == AnnotationType.Shape && a.PageNumber == _currentPage);

    private sealed record SelectionDto(
        string Text,
        IReadOnlyList<HighlightRect> Rects,
        double AnchorX,
        double AnchorY);

    private static string? NullIfBlank(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        _isLoading = true;
        _rasterDataUrl = null;
        ClearSearchState();
        ResetAnnotationState();

        try
        {
            if (_handle is not null)
            {
                await Renderer.UnloadAsync(_handle);
                _handle = null;
            }

            _currentFilename = e.File.Name;
            await using var stream = e.File.OpenReadStream(MaxFileSize);
            await using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            _originalPdfBytes = buffer.ToArray();
            buffer.Position = 0;

            // Hash zuerst: damit die Annotations dieser PDF eindeutig zugeordnet
            // sind, auch wenn der Dateiname sich ändert oder die PDF anderswo
            // liegt.
            var hash = await Hasher.ComputeAsync(buffer, HashAlgorithm.Sha256, CancellationToken.None);
            buffer.Position = 0;
            _currentPdfId = PdfId.FromHash(hash);

            _handle = await Renderer.LoadAsync(buffer, new LoadOptions(), CancellationToken.None);
            _currentPage = 1;

            _annotations = await Annotations.GetForDocumentAsync(_currentPdfId.Value, CancellationToken.None);
            await RecomputeSignatureStatusesAsync();

            // Outline ist optional: viele PDFs haben keinen TOC. In dem Fall
            // bleibt _outline null und die Sidebar zeigt einen Hinweis statt
            // einer leeren Baumstruktur.
            try
            {
                _outline = await Renderer.GetOutlineAsync(_handle, CancellationToken.None);
            }
            catch
            {
                _outline = null;
            }
            _outlineOpen = _outline is not null;

            await RenderCurrentPageAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"PDF konnte nicht geöffnet werden: {ex.Message}";
            _handle = null;
            ResetAnnotationState();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ResetAnnotationState()
    {
        _annotations = Array.Empty<Annotation>();
        _currentPdfId = null;
        _currentFilename = null;
        _isExporting = false;
        _annotationMode = AnnotationMode.Select;
        _editingAnnotation = null;
        _editingContent = string.Empty;
        _pageTextItems = Array.Empty<TextItem>();
        _renderedPage = null;
        _pendingSelection = null;
        _editingHighlight = null;
        _outline = null;
        _outlineOpen = false;
        _activeSignatureImage = null;
        _activeSignatureFilename = null;
        _signatureStatuses.Clear();
        _originalPdfBytes = null;
        _signerPanelOpen = false;
        _isSavingSignedPdf = false;
    }

    private async Task RenderCurrentPageAsync()
    {
        if (_handle is null) return;

        _isRendering = true;
        _pendingSelection = null;
        try
        {
            var rendered = await Renderer.RenderPageAsync(
                _handle,
                _currentPage,
                new RenderOptions(Scale: InternalScale),
                CancellationToken.None);

            _renderedPage = rendered;
            if (rendered.RasterBytes is not null && rendered.RasterFormat is not null)
            {
                _rasterDataUrl = $"data:{rendered.RasterFormat};base64,{Convert.ToBase64String(rendered.RasterBytes)}";
            }

            // Text-Layer nachladen: ohne ihn ist keine Text-Selection und damit
            // kein Highlighting möglich. Bei PDFs ohne Text-Layer (vektorisiert)
            // kommt ein leeres Array zurück und der Layer rendert einfach nichts.
            try
            {
                _pageTextItems = await Renderer.ExtractTextAsync(_handle, _currentPage, CancellationToken.None);
            }
            catch
            {
                _pageTextItems = Array.Empty<TextItem>();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Seite konnte nicht gerendert werden: {ex.Message}";
        }
        finally
        {
            _isRendering = false;
        }
    }

    private async Task PreviousPage()
    {
        if (_handle is null || _currentPage <= 1) return;
        _currentPage--;
        await RenderCurrentPageAsync();
    }

    private async Task NextPage()
    {
        if (_handle is null || _currentPage >= _handle.PageCount) return;
        _currentPage++;
        await RenderCurrentPageAsync();
    }

    private async Task SetZoom(double zoomFactor)
    {
        if (Math.Abs(_zoomFactor - zoomFactor) < 0.001) return;
        _zoomFactor = zoomFactor;
        await RenderCurrentPageAsync();
    }

    private async Task DoSearchAsync()
    {
        if (_handle is null) return;
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _searchHits = null;
            return;
        }

        _isSearching = true;
        _errorMessage = null;
        _pdfHasNoTextLayer = false;
        try
        {
            var options = new SearchOptions(MatchCase: _matchCase, WholeWord: _wholeWord);
            _searchHits = await Renderer.SearchAsync(_handle, _searchQuery, options, CancellationToken.None);
            _lastSearched = _searchQuery;

            // Wenn die Suche gar nichts gefunden hat, prüfen wir, ob das
            // überhaupt am PDF liegt: hat Seite 1 *irgendeinen* Text-Item?
            // Wenn nicht, ist die PDF vektorisiert (typisch für stilisierte
            // Designer-Layouts) — dafür braucht es OCR (FA-050 / Release 0.9).
            if (_searchHits.Count == 0)
            {
                var sample = await Renderer.ExtractTextAsync(_handle, 1, CancellationToken.None);
                _pdfHasNoTextLayer = sample.Count == 0;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Suche fehlgeschlagen: {ex.Message}";
            _searchHits = null;
        }
        finally
        {
            _isSearching = false;
        }
    }

    private void ClearSearch()
    {
        ClearSearchState();
    }

    private void ClearSearchState()
    {
        _searchHits = null;
        _searchQuery = string.Empty;
        _lastSearched = string.Empty;
        _pdfHasNoTextLayer = false;
    }

    private async Task GoToPageAsync(int pageNumber)
    {
        if (_handle is null) return;
        if (pageNumber < 1 || pageNumber > _handle.PageCount) return;
        if (pageNumber == _currentPage) return;
        _currentPage = pageNumber;
        await RenderCurrentPageAsync();
    }

    // --- Annotations (Sticky Notes, FA-011) ---------------------------------

    private void SetAnnotationMode(AnnotationMode mode)
    {
        _annotationMode = mode;
        // Editor schließen, wenn wir den Modus wechseln — sonst überlappen
        // sich Modus-Indikatoren und offener Popover unangenehm.
        _editingAnnotation = null;
        _editingContent = string.Empty;
        _editingDrawing = null;
        // Drawing-Capture (FA-013/014): bei Mode-Wechsel JS-Listener
        // (de-)attachen. Fire-and-Forget — stopDrawingCapture in JS ist
        // idempotent, also race-frei.
        _ = SyncDrawingCaptureAsync();
    }

    private void SetDrawColor(string color)
    {
        _drawColor = color;
        _ = SyncDrawingCaptureAsync();
    }

    private void SetDrawStrokeWidth(double fraction)
    {
        _drawStrokeWidth = fraction;
        _ = SyncDrawingCaptureAsync();
    }

    /// <summary>
    /// Hängt den JS-seitigen Pointer-Listener für Stift/Formen an das
    /// Page-Canvas-Element, sobald ein Drawing-Mode aktiv ist — und entfernt
    /// ihn wieder, sobald wir den Modus verlassen. Wird nach jedem Tool-/
    /// Stilwechsel aufgerufen, damit Farbe + Strichstärke live ankommen.
    /// </summary>
    private async Task SyncDrawingCaptureAsync()
    {
        if (_dotNetRef is null) return;
        try
        {
            if (IsDrawingMode(_annotationMode))
            {
                await JS.InvokeVoidAsync(
                    "pageboundShortcuts.startDrawingCapture",
                    PageCanvasSelector,
                    MapDrawingModeToJs(_annotationMode),
                    new { color = _drawColor, strokeWidthFraction = _drawStrokeWidth },
                    _dotNetRef,
                    nameof(HandleDrawCompletedAsync));
                _captureAttachedToPage = _currentPage;
            }
            else if (_captureAttachedToPage is not null)
            {
                await JS.InvokeVoidAsync("pageboundShortcuts.stopDrawingCapture");
                _captureAttachedToPage = null;
            }
        }
        catch
        {
            // Bridge nicht erreichbar — Tool tut dann einfach nichts.
        }
    }

    private static string MapDrawingModeToJs(AnnotationMode mode) => mode switch
    {
        AnnotationMode.Pen => "ink",
        AnnotationMode.RectShape => "rect",
        AnnotationMode.ArrowShape => "arrow",
        AnnotationMode.LineShape => "line",
        _ => "ink"
    };

    [JSInvokable]
    public async Task HandleDrawCompletedAsync(DrawingCaptureResult result)
    {
        if (_currentPdfId is null) return;
        if (result.Strokes is null || result.Strokes.Count == 0) return;

        NewAnnotation? toCreate = null;
        if (string.Equals(result.Mode, "ink", StringComparison.OrdinalIgnoreCase))
        {
            var strokes = result.Strokes
                .Select(s => new InkStroke(
                    s.Select(p => new InkPoint(p.X, p.Y)).ToList()))
                .ToList();
            toCreate = InkAnnotation.Create(
                _currentPdfId.Value,
                _currentPage,
                strokes,
                result.Color,
                result.StrokeWidthFraction);
        }
        else if (result.Strokes[0].Count >= 2)
        {
            var startPoint = result.Strokes[0][0];
            var endPoint = result.Strokes[0][^1];
            var shape = result.Mode.ToLowerInvariant() switch
            {
                "rect" => ShapeKind.Rectangle,
                "arrow" => ShapeKind.Arrow,
                "line" => ShapeKind.Line,
                _ => ShapeKind.Rectangle
            };
            toCreate = ShapeAnnotation.Create(
                _currentPdfId.Value,
                _currentPage,
                shape,
                startPoint.X, startPoint.Y,
                endPoint.X, endPoint.Y,
                result.Color,
                result.StrokeWidthFraction);
        }

        if (toCreate is null) return;

        var created = await Annotations.CreateAsync(toCreate, CancellationToken.None);
        _annotations = _annotations.Append(created).ToList();
        await InvokeAsync(StateHasChanged);
    }

    public sealed record DrawingCaptureResult(
        string Mode,
        string Color,
        double StrokeWidthFraction,
        List<List<DrawPoint>> Strokes);

    public sealed record DrawPoint(double X, double Y);

    // Selektierte Ink/Shape für die Lösch-Mini-Toolbar.
    private Annotation? _editingDrawing;

    private void OpenDrawingEditor(Annotation annotation)
    {
        // In Zeichen-Modi schlucken wir Klicks auf existierende Annotations,
        // damit der User wirklich zeichnet und nicht versehentlich editiert.
        if (IsDrawingMode(_annotationMode)) return;
        _editingDrawing = annotation;
    }

    private async Task DeleteEditingDrawingAsync()
    {
        if (_editingDrawing is null) return;
        var id = _editingDrawing.Id;
        await Annotations.DeleteAsync(id, CancellationToken.None);
        _annotations = _annotations.Where(a => a.Id.Value != id.Value).ToList();
        _editingDrawing = null;
    }

    /// <summary>
    /// Ankerpunkt für die Lösch-Mini-Toolbar (oben-Mitte der Bounding-Box
    /// der jeweiligen Ink/Shape).
    /// </summary>
    private static (double X, double Y) GetDrawingAnchor(Annotation annotation)
    {
        if (annotation.Type == AnnotationType.Ink)
        {
            var minX = 1.0; var minY = 1.0; var maxX = 0.0;
            var found = false;
            foreach (var stroke in InkAnnotation.GetStrokes(annotation))
            {
                foreach (var p in stroke.Points)
                {
                    if (p.X < minX) minX = p.X;
                    if (p.X > maxX) maxX = p.X;
                    if (p.Y < minY) minY = p.Y;
                    found = true;
                }
            }
            return found ? ((minX + maxX) * 0.5, minY) : (0.5, 0.5);
        }
        if (annotation.Type == AnnotationType.Shape)
        {
            var sx = ShapeAnnotation.GetStartX(annotation);
            var sy = ShapeAnnotation.GetStartY(annotation);
            var ex = ShapeAnnotation.GetEndX(annotation);
            var ey = ShapeAnnotation.GetEndY(annotation);
            return ((sx + ex) * 0.5, Math.Min(sy, ey));
        }
        return (0.5, 0.5);
    }

    private static string BuildInkPath(InkStroke stroke)
    {
        if (stroke.Points.Count < 2) return string.Empty;
        return string.Join(" ", stroke.Points.Select((p, i) =>
            string.Format(CultureInfo.InvariantCulture,
                "{0} {1:F4} {2:F4}",
                i == 0 ? "M" : "L", p.X, p.Y)));
    }

    /// <summary>
    /// Liefert die drei Eckpunkte der Pfeilspitze (Endpunkt + zwei Basis-Punkte
    /// links/rechts der Linienrichtung). Größe skaliert leicht mit der
    /// Strichstärke, ist aber nach unten begrenzt damit dünne Pfeile sichtbar
    /// bleiben. Gibt <c>null</c> zurück, wenn Start und Ende identisch sind.
    /// </summary>
    private static (double X1, double Y1, double X2, double Y2, double X3, double Y3)?
        ComputeArrowHead(double sx, double sy, double ex, double ey, double strokeWidth)
    {
        var dx = ex - sx;
        var dy = ey - sy;
        var len = Math.Sqrt(dx * dx + dy * dy);
        if (len <= 0) return null;
        var arrowSize = Math.Max(0.012, strokeWidth * 3);
        var ux = dx / len;
        var uy = dy / len;
        var bx = ex - ux * arrowSize;
        var by = ey - uy * arrowSize;
        var nx = -uy;
        var ny = ux;
        var hb = arrowSize * 0.5;
        return (ex, ey, bx + nx * hb, by + ny * hb, bx - nx * hb, by - ny * hb);
    }

    private async Task HandlePdfClickAsync(MouseEventArgs e)
    {
        // Editor schließt, sobald wir ins Dokument klicken (außer eben in den
        // Editor selbst — der stoppt das Event via @onclick:stopPropagation).
        if (_editingAnnotation is not null)
        {
            await SaveEditingAnnotationAsync();
        }

        if (_currentPdfId is null || _handle is null) return;

        if (_annotationMode == AnnotationMode.Signature)
        {
            await PlaceSignatureAsync(e);
            return;
        }

        if (_annotationMode != AnnotationMode.StickyNote) return;

        var fraction = await JS.InvokeAsync<NormalizedPosition?>(
            "pageboundShortcuts.clientPositionToFraction",
            PdfImageSelector,
            e.ClientX,
            e.ClientY);
        if (fraction is null) return;

        var newAnnotation = StickyNoteAnnotation.Create(
            _currentPdfId.Value,
            _currentPage,
            fraction.X,
            fraction.Y,
            string.Empty);

        var created = await Annotations.CreateAsync(newAnnotation, CancellationToken.None);
        _annotations = _annotations.Append(created).ToList();

        // Sofort in den Edit-Modus springen, damit der Nutzer den Text
        // eingeben kann, ohne erst auf den Pin zu klicken.
        OpenEditor(created);

        // Nach dem Erstellen zurück zum Select-Modus — verhindert versehentliche
        // Mehrfach-Erstellung beim Weiterklicken.
        _annotationMode = AnnotationMode.Select;
        await RecomputeSignatureStatusesAsync();
    }

    private void OpenEditor(Annotation annotation)
    {
        _editingAnnotation = annotation;
        _editingContent = StickyNoteAnnotation.GetContent(annotation);
        // Vorhandener Inhalt → erst lesen, sonst direkt schreiben.
        _editorPreviewMode = !string.IsNullOrWhiteSpace(_editingContent);
    }

    private void ToggleEditorPreview()
    {
        _editorPreviewMode = !_editorPreviewMode;
    }

    private async Task SaveEditingAnnotationAsync()
    {
        if (_editingAnnotation is null) return;
        var current = _editingAnnotation;
        var newContent = _editingContent;

        // Wenn sich nichts geändert hat, Editor einfach schließen.
        if (StickyNoteAnnotation.GetContent(current) != newContent)
        {
            var updated = StickyNoteAnnotation.WithContent(current, newContent);
            var saved = await Annotations.UpdateAsync(updated, CancellationToken.None);
            _annotations = _annotations
                .Select(a => a.Id.Value == saved.Id.Value ? saved : a)
                .ToList();
            await RecomputeSignatureStatusesAsync();
        }

        _editingAnnotation = null;
        _editingContent = string.Empty;
    }

    private async Task DeleteEditingAnnotationAsync()
    {
        if (_editingAnnotation is null) return;
        var idToRemove = _editingAnnotation.Id;
        await Annotations.DeleteAsync(idToRemove, CancellationToken.None);
        _annotations = _annotations.Where(a => a.Id.Value != idToRemove.Value).ToList();
        _editingAnnotation = null;
        _editingContent = string.Empty;
        await RecomputeSignatureStatusesAsync();
    }

    private void CancelEditing()
    {
        _editingAnnotation = null;
        _editingContent = string.Empty;
    }

    private sealed record NormalizedPosition(double X, double Y);

    // --- PNG-Signatur + Integrität (FA-015, FA-016, FA-017) -----------------

    private async Task HandleSignatureImageSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _errorMessage = null;

        if (file.Size > MaxSignatureBytes)
        {
            _errorMessage = $"Signaturbild ist zu groß (max {MaxSignatureBytes / 1024} KB).";
            return;
        }
        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            _errorMessage = "Bitte eine Bilddatei (PNG / JPG) auswählen.";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(MaxSignatureBytes);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            var base64 = Convert.ToBase64String(bytes);
            var mime = string.IsNullOrEmpty(file.ContentType) ? "image/png" : file.ContentType;
            _activeSignatureImage = $"data:{mime};base64,{base64}";
            _activeSignatureFilename = file.Name;
            _annotationMode = AnnotationMode.Signature;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Signaturbild konnte nicht geladen werden: {ex.Message}";
            _activeSignatureImage = null;
            _activeSignatureFilename = null;
        }
    }

    private void ClearActiveSignature()
    {
        _activeSignatureImage = null;
        _activeSignatureFilename = null;
        if (_annotationMode == AnnotationMode.Signature)
        {
            _annotationMode = AnnotationMode.Select;
        }
    }

    private async Task PlaceSignatureAsync(MouseEventArgs e)
    {
        if (_activeSignatureImage is null) return;
        if (_currentPdfId is null) return;

        var fraction = await JS.InvokeAsync<NormalizedPosition?>(
            "pageboundShortcuts.clientPositionToFraction",
            PdfImageSelector,
            e.ClientX,
            e.ClientY);
        if (fraction is null) return;

        // Default-Größe: 25 % Breite, 8 % Höhe — ausreichend für eine
        // handschriftliche Unterschrift. Klick ist Top-Left der Signatur.
        const double width = 0.25;
        const double height = 0.08;
        var x = Math.Min(fraction.X, 1 - width);
        var y = Math.Min(fraction.Y, 1 - height);
        var signedAt = DateTimeOffset.UtcNow;

        var newAnnotation = SignatureAnnotation.Create(
            _currentPdfId.Value,
            _currentPage,
            _activeSignatureImage,
            x, y, width, height,
            signedAt,
            integrityHash: null,
            signer: _signer);

        // Erst Annotation anlegen — damit wir eine echte ID haben.
        var created = await Annotations.CreateAsync(newAnnotation, CancellationToken.None);

        // Hash berechnen über pdfHash + Bestand vor dieser Signatur + Zeitstempel.
        var hash = await Integrity.ComputeSignatureHashAsync(
            _currentPdfId.Value,
            created,
            _annotations, // _annotations enthält noch nicht 'created'
            signedAt,
            CancellationToken.None);

        // Hash zurück in die Signatur schreiben.
        var withHash = SignatureAnnotation.WithIntegrityHash(created, hash);
        var saved = await Annotations.UpdateAsync(withHash, CancellationToken.None);

        _annotations = _annotations.Append(saved).ToList();
        _signatureStatuses[saved.Id.Value] = SignatureIntegrityStatus.Valid;

        // Nach Platzieren: zurück zum Select-Modus, Signatur bleibt geladen
        // damit weitere Platzierungen mit derselben Unterschrift möglich sind.
        _annotationMode = AnnotationMode.Select;
    }

    private async Task RecomputeSignatureStatusesAsync()
    {
        if (_currentPdfId is null)
        {
            _signatureStatuses.Clear();
            return;
        }

        var newStatuses = new Dictionary<string, SignatureIntegrityStatus>();
        foreach (var sig in _annotations.Where(a => a.Type == AnnotationType.Signature))
        {
            var status = await Integrity.VerifySignatureAsync(
                _currentPdfId.Value,
                sig,
                _annotations,
                CancellationToken.None);
            newStatuses[sig.Id.Value] = status;
        }
        _signatureStatuses = newStatuses;
    }

    private async Task DeleteSignatureAsync(Annotation signature)
    {
        await Annotations.DeleteAsync(signature.Id, CancellationToken.None);
        _annotations = _annotations.Where(a => a.Id.Value != signature.Id.Value).ToList();
        _signatureStatuses.Remove(signature.Id.Value);
        await RecomputeSignatureStatusesAsync();
    }

    private async Task LoadSignerFromStorageAsync()
    {
        if (_signerLoaded) return;
        _signerLoaded = true;
        try
        {
            var stored = await Storage.GetAsync<SignerInfo>(SignerStorageKey, CancellationToken.None);
            if (stored is not null)
            {
                _signer = stored;
            }
        }
        catch
        {
            // Storage nicht erreichbar — Signer bleibt leer, harmlos.
        }
    }

    private async Task SaveSignerToStorageAsync()
    {
        try
        {
            await Storage.SetAsync(SignerStorageKey, _signer, CancellationToken.None);
        }
        catch
        {
            // Persistenz best-effort; UI bleibt funktional.
        }
    }

    private async Task ExportSignedPdfAsync()
    {
        if (_originalPdfBytes is null || _currentPdfId is null) return;
        var signatureAnnotations = _annotations
            .Where(a => a.Type == AnnotationType.Signature)
            .OrderBy(a => a.PageNumber)
            .ThenBy(a => SignatureAnnotation.GetSignedAt(a))
            .ToList();
        if (signatureAnnotations.Count == 0) return;

        _isSavingSignedPdf = true;
        _errorMessage = null;

        try
        {
            var embedded = signatureAnnotations.Select(a =>
            {
                var dataUrl = SignatureAnnotation.GetImageDataUrl(a);
                var commaIdx = dataUrl.IndexOf(',');
                var base64 = commaIdx >= 0 ? dataUrl[(commaIdx + 1)..] : dataUrl;
                var bytes = Convert.FromBase64String(base64);
                return new EmbeddedSignature(
                    PageNumber: a.PageNumber,
                    ImageBytes: bytes,
                    X: SignatureAnnotation.GetX(a),
                    Y: SignatureAnnotation.GetY(a),
                    Width: SignatureAnnotation.GetWidth(a),
                    Height: SignatureAnnotation.GetHeight(a),
                    SignedAt: SignatureAnnotation.GetSignedAt(a),
                    Signer: SignatureAnnotation.GetSigner(a),
                    IntegrityHash: SignatureAnnotation.GetIntegrityHash(a));
            }).ToList();

            using var ms = new MemoryStream(_originalPdfBytes);
            var signed = await Manipulator.EmbedSignaturesAsync(ms, embedded, CancellationToken.None);

            var baseName = !string.IsNullOrWhiteSpace(_currentFilename)
                ? System.IO.Path.GetFileNameWithoutExtension(_currentFilename)
                : (_handle?.Title ?? "pagebound");
            var safeBase = string.Concat(baseName.Select(c =>
                char.IsLetterOrDigit(c) || c is '_' or '-' or '.' or ' ' ? c : '_'));
            var downloadName = $"{safeBase}_signed.pdf";

            var b64 = Convert.ToBase64String(signed);
            await JS.InvokeVoidAsync(
                "pageboundShortcuts.downloadBytes",
                downloadName,
                b64,
                "application/pdf");
        }
        catch (Exception ex)
        {
            // Volle Diagnose in die UI rendern, weil TargetInvocationException
            // bei JS-Interop-Rückgabewegen die echte Exception oft verschluckt.
            var details = new System.Text.StringBuilder();
            var walker = ex;
            while (walker is not null)
            {
                details.AppendLine($"{walker.GetType().FullName}: {walker.Message}");
                walker = walker.InnerException;
            }
            _errorMessage = $"Signiertes PDF konnte nicht erzeugt werden:\n{details}";
            try
            {
                await JS.InvokeVoidAsync("console.error", "[Pagebound] sign-pdf failed", ex.ToString());
            }
            catch
            {
                // Konsole nicht verfügbar — Fehler steht eh in der UI.
            }
        }
        finally
        {
            _isSavingSignedPdf = false;
        }
    }

    private async Task HandleSignatureMouseDownAsync(MouseEventArgs e, Annotation signature)
    {
        if (_dotNetRef is null) return;
        // Linke Maustaste nur; ohne diese Prüfung würde Rechtsklick auch
        // einen Drag-Listener registrieren.
        if (e.Button != 0) return;
        try
        {
            await JS.InvokeVoidAsync(
                "pageboundShortcuts.dragElementToFraction",
                $"[data-pb-signature-id=\"{signature.Id.Value}\"]",
                PageCanvasSelector,
                e.ClientX,
                e.ClientY,
                _dotNetRef,
                nameof(HandleSignatureDragCompleteAsync),
                signature.Id.Value);
        }
        catch (JSException)
        {
            // Bridge nicht erreichbar — Drag wird einfach nicht starten.
        }
    }

    private async Task HandleSignatureResizeMouseDownAsync(MouseEventArgs e, Annotation signature)
    {
        if (_dotNetRef is null) return;
        if (e.Button != 0) return;
        try
        {
            await JS.InvokeVoidAsync(
                "pageboundShortcuts.resizeElementToFraction",
                $"[data-pb-signature-id=\"{signature.Id.Value}\"]",
                PageCanvasSelector,
                e.ClientX,
                e.ClientY,
                0.05, // minWidth
                0.02, // minHeight
                _dotNetRef,
                nameof(HandleSignatureResizeCompleteAsync),
                signature.Id.Value);
        }
        catch (JSException)
        {
            // Bridge nicht erreichbar — Resize wird einfach nicht starten.
        }
    }

    [JSInvokable]
    public async Task HandleSignatureResizeCompleteAsync(string signatureId, double newWidth, double newHeight)
    {
        var signature = _annotations.FirstOrDefault(a =>
            a.Id.Value == signatureId && a.Type == AnnotationType.Signature);
        if (signature is null) return;

        var currentW = SignatureAnnotation.GetWidth(signature);
        var currentH = SignatureAnnotation.GetHeight(signature);
        if (Math.Abs(currentW - newWidth) < 0.0005 && Math.Abs(currentH - newHeight) < 0.0005)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        var payload = signature.Payload.ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
        payload[SignatureAnnotation.PayloadKeyWidth] = newWidth;
        payload[SignatureAnnotation.PayloadKeyHeight] = newHeight;
        var updated = signature with
        {
            UpdatedAt = DateTimeOffset.UtcNow,
            Payload = payload
        };
        var saved = await Annotations.UpdateAsync(updated, CancellationToken.None);
        _annotations = _annotations.Select(a => a.Id.Value == saved.Id.Value ? saved : a).ToList();

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task HandleSignatureDragCompleteAsync(string signatureId, double newX, double newY)
    {
        var signature = _annotations.FirstOrDefault(a =>
            a.Id.Value == signatureId && a.Type == AnnotationType.Signature);
        if (signature is null) return;

        var currentX = SignatureAnnotation.GetX(signature);
        var currentY = SignatureAnnotation.GetY(signature);
        // Wenn sich die Position effektiv nicht geändert hat (Klick ohne Bewegung),
        // sparen wir uns die Persistenz.
        if (Math.Abs(currentX - newX) < 0.0005 && Math.Abs(currentY - newY) < 0.0005)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        // Position-Update — Hash bleibt valid, weil Signaturen sich gegenseitig
        // im Canonical-String nicht enthalten (siehe IntegrityService).
        var payload = signature.Payload.ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
        payload[SignatureAnnotation.PayloadKeyX] = newX;
        payload[SignatureAnnotation.PayloadKeyY] = newY;
        var updated = signature with
        {
            UpdatedAt = DateTimeOffset.UtcNow,
            Payload = payload
        };
        var saved = await Annotations.UpdateAsync(updated, CancellationToken.None);
        _annotations = _annotations.Select(a => a.Id.Value == saved.Id.Value ? saved : a).ToList();

        await InvokeAsync(StateHasChanged);
    }

    // --- Markdown-Export (FA-080, FA-081, FA-082) ---------------------------

    private async Task ExportMarkdownAsync()
    {
        if (_currentPdfId is null || _handle is null) return;
        if (_isExporting) return;

        _isExporting = true;
        _errorMessage = null;
        try
        {
            var options = new MarkdownExportOptions(
                Title: _handle.Title,
                SourceFilename: _currentFilename,
                PageCount: _handle.PageCount,
                IncludeHighlights: true,
                IncludeNotes: true,
                IncludeYamlFrontmatter: true,
                UseWikilinks: true);

            var content = await MarkdownExporter.ExportAsync(
                _currentPdfId.Value,
                options,
                CancellationToken.None);

            var baseName = !string.IsNullOrWhiteSpace(_currentFilename)
                ? System.IO.Path.GetFileNameWithoutExtension(_currentFilename)
                : (_handle.Title ?? "pagebound-export");
            // Auf Safe-Zeichen reduzieren, damit der Browser-Download-Dialog
            // den Vorschlag nicht heimlich umbenennt.
            var safeBase = string.Concat(baseName.Select(c =>
                char.IsLetterOrDigit(c) || c is '_' or '-' or '.' or ' ' ? c : '_'));
            var downloadFilename = $"{safeBase}.md";

            await JS.InvokeVoidAsync(
                "pageboundShortcuts.downloadFile",
                downloadFilename,
                content,
                "text/markdown");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Markdown-Export fehlgeschlagen: {ex.Message}";
        }
        finally
        {
            _isExporting = false;
        }
    }

    // --- Text-Highlight (FA-010 + FA-018 Inline-Toolbar) --------------------

    private async Task HandleCanvasMouseUpAsync(MouseEventArgs e)
    {
        // Im Sticky-Note-Modus übernimmt der img-Click-Handler;
        // außerdem wollen wir keine Selection-Toolbar, wenn der Editor offen ist.
        if (_annotationMode != AnnotationMode.Select) return;
        if (_editingAnnotation is not null) return;
        if (_currentPdfId is null) return;

        var selection = await JS.InvokeAsync<SelectionDto?>(
            "pageboundShortcuts.getCurrentTextSelection",
            PageCanvasSelector);

        if (selection is null || selection.Rects.Count == 0 || string.IsNullOrWhiteSpace(selection.Text))
        {
            _pendingSelection = null;
            return;
        }
        _pendingSelection = selection;
    }

    private async Task HighlightPendingSelectionAsync(string color)
    {
        if (_pendingSelection is null) return;
        if (_currentPdfId is null) return;

        var newAnnotation = HighlightAnnotation.Create(
            _currentPdfId.Value,
            _currentPage,
            _pendingSelection.Rects,
            _pendingSelection.Text,
            color);

        var saved = await Annotations.CreateAsync(newAnnotation, CancellationToken.None);
        _annotations = _annotations.Append(saved).ToList();
        _pendingSelection = null;

        // Browser-Selection aufheben, damit die Toolbar sicher verschwindet
        // und der Highlight optisch im Vordergrund stehen kann.
        try
        {
            await JS.InvokeVoidAsync("pageboundShortcuts.clearSelection");
        }
        catch (JSException)
        {
            // Ignorieren, harmlose Edge-Case bei sehr früher Tab-Disposal.
        }

        await RecomputeSignatureStatusesAsync();
    }

    private void DismissSelection()
    {
        _pendingSelection = null;
    }

    private void OpenHighlightEditor(Annotation highlight)
    {
        _editingHighlight = highlight;
    }

    private void CancelHighlightEditing()
    {
        _editingHighlight = null;
    }

    private async Task ChangeHighlightColorAsync(string color)
    {
        if (_editingHighlight is null) return;
        var updated = HighlightAnnotation.WithColor(_editingHighlight, color);
        var saved = await Annotations.UpdateAsync(updated, CancellationToken.None);
        _annotations = _annotations
            .Select(a => a.Id.Value == saved.Id.Value ? saved : a)
            .ToList();
        _editingHighlight = saved;
    }

    private async Task DeleteEditingHighlightAsync()
    {
        if (_editingHighlight is null) return;
        var id = _editingHighlight.Id;
        await Annotations.DeleteAsync(id, CancellationToken.None);
        _annotations = _annotations.Where(a => a.Id.Value != id.Value).ToList();
        _editingHighlight = null;
        await RecomputeSignatureStatusesAsync();
    }

    // --- Tastatur-Shortcuts -------------------------------------------------

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!_shortcutsRegistered)
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                try
                {
                    await JS.InvokeVoidAsync($"{ShortcutsJs}.register", _dotNetRef);
                    _shortcutsRegistered = true;
                }
                catch (JSException)
                {
                    // shortcuts-bridge.js noch nicht geparsed — bei einem späteren
                    // Render-Zyklus erneut versuchen.
                    _dotNetRef.Dispose();
                    _dotNetRef = null;
                }
            }

            await LoadSignerFromStorageAsync();
            StateHasChanged();
        }

        // Drawing-Capture (FA-013/014): Page-Wechsel rendert das Canvas neu —
        // unsere pointer-Listener leben aber auf dem alten DOM-Element. Wenn ein
        // Zeichenmodus aktiv ist und die Page wechselte, JS-Capture neu attachen.
        if (IsDrawingMode(_annotationMode) && _captureAttachedToPage != _currentPage)
        {
            await SyncDrawingCaptureAsync();
        }
    }

    [JSInvokable]
    public async Task HandleShortcut(string shortcut)
    {
        switch (shortcut)
        {
            case "page-prev":
                await PreviousPage();
                break;
            case "page-next":
                await NextPage();
                break;
            case "page-first":
                if (_handle is not null) await GoToPageAsync(1);
                break;
            case "page-last":
                if (_handle is not null) await GoToPageAsync(_handle.PageCount);
                break;
            case "focus-search":
                if (_handle is not null)
                {
                    await JS.InvokeVoidAsync($"{ShortcutsJs}.focusElement", SearchInputSelector);
                }
                break;
            case "clear-search":
                if (_pendingSelection is not null)
                {
                    _pendingSelection = null;
                }
                else if (_editingHighlight is not null)
                {
                    _editingHighlight = null;
                }
                else if (_searchHits is not null || !string.IsNullOrEmpty(_searchQuery))
                {
                    ClearSearchState();
                }
                break;
            case "zoom-in":
                await StepZoom(+1);
                break;
            case "zoom-out":
                await StepZoom(-1);
                break;
            case "zoom-reset":
                await SetZoom(1.0);
                break;
        }

        // Blazor rendert nach JSInvokable-Methoden nicht automatisch — wir
        // triggern einen Re-Render, damit UI-Zustand sichtbar wird.
        await InvokeAsync(StateHasChanged);
    }

    private async Task StepZoom(int direction)
    {
        var currentIdx = Array.FindIndex(_zoomLevels, z => Math.Abs(z - _zoomFactor) < 0.001);
        if (currentIdx < 0)
        {
            // Aktueller Faktor liegt nicht auf einer Stufe → finde nächstgelegene.
            currentIdx = Array.FindIndex(_zoomLevels, z => z >= _zoomFactor);
            if (currentIdx < 0) currentIdx = _zoomLevels.Length - 1;
        }
        var nextIdx = Math.Clamp(currentIdx + direction, 0, _zoomLevels.Length - 1);
        if (nextIdx == currentIdx) return;
        await SetZoom(_zoomLevels[nextIdx]);
    }

    public async ValueTask DisposeAsync()
    {
        if (_shortcutsRegistered)
        {
            try
            {
                await JS.InvokeVoidAsync($"{ShortcutsJs}.unregister");
            }
            catch (JSDisconnectedException)
            {
                // Browser-Circuit ist weg, ignorieren.
            }
            catch (JSException)
            {
                // Bridge möglicherweise nicht mehr geladen.
            }
            _shortcutsRegistered = false;
        }
        _dotNetRef?.Dispose();
        _dotNetRef = null;

        if (_handle is not null)
        {
            try
            {
                await Renderer.UnloadAsync(_handle);
            }
            catch
            {
                // Page wird entladen; ignoriere Cleanup-Fehler.
            }
            _handle = null;
        }
    }
}
