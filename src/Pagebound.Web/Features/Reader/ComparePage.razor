@page "/compare"
@inject NavigationManager Nav
@inject ILocalizationService L

@*
    Konsolidierung (UI): Der eigenständige PDF-Vergleich ist in der Split-View
    aufgegangen — dort gibt es Datei-Auswahl pro Pane plus den „Vergleichen"-
    Button (gemeinsame Engine: PdfTextDiff / PdfDiffResultView).
    Die Route /compare bleibt für Bookmarks erhalten und leitet nur noch um.
*@

<PageTitle>@L.T("compare.pageTitle")</PageTitle>

<p class="px-4 py-8 text-sm text-pb-fg-muted">@L.T("app.loadingShort")</p>

@code {
    protected override void OnInitialized()
        => Nav.NavigateTo("split?compare=1", replace: true);
}
