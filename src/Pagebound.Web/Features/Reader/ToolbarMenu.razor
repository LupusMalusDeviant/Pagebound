@*
    Wiederverwendbares Toolbar-Dropdown (Kategorie-Menü der Reader-Leiste).
    Trigger-Button + Panel. Schließt bei Klick außerhalb (transparenter, seiten-
    füllender Backdrop) UND nach einer Auswahl: ein Klick im Panel blubbert auf
    das Panel-@onclick, das schließt — die Item-Handler laufen zuerst (Target vor
    Bubble). Kein JS-Interop nötig.
*@
<div class="relative inline-block">
    <button type="button"
            class="@($"rounded border px-2 py-0.5 inline-flex items-center gap-1 {(Active ? "pb-toolbtn is-on" : "pb-toolbtn")}")"
            title="@Title"
            aria-haspopup="true"
            aria-expanded="@(_open ? "true" : "false")"
            @onclick="Toggle">
        <span>@Label</span>
        <svg class="@($"w-3.5 h-3.5 shrink-0 -mr-0.5 transition-transform duration-150 {(_open ? "rotate-180" : "")}")"
             viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m4 6 4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </button>
    @if (_open)
    {
        @* Backdrop: fängt Klicks außerhalb → schließt. Transparent. *@
        <div class="fixed inset-0 z-40" @onclick="Close" aria-hidden="true"></div>
        <div class="absolute left-0 top-full mt-1 z-50 min-w-max rounded-lg pb-glass-strong p-1 flex flex-col gap-0.5"
             role="menu"
             @onclick="Close">
            @ChildContent
        </div>
    }
</div>

@code {
    /// <summary>Beschriftung des Trigger-Buttons (Kategoriename).</summary>
    [Parameter] public string Label { get; set; } = string.Empty;

    /// <summary>Tooltip des Trigger-Buttons.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Aktiv-Hervorhebung (z. B. wenn das aktive Werkzeug in dieser Kategorie liegt).</summary>
    [Parameter] public bool Active { get; set; }

    /// <summary>Die Menü-Einträge (Buttons/Labels mit Klasse <c>pb-menuitem</c>).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _open;
    private void Toggle() => _open = !_open;
    private void Close() => _open = false;

    /// <summary>
    /// Von außen schließen — z. B. nachdem ein Menü-Eintrag asynchron eine Datei
    /// geladen hat (Signatur-PNG) und der Reader in den Platzieren-Modus wechselt.
    /// Der Backdrop würde sonst offen bleiben und den ersten Platzieren-Klick
    /// abfangen. StateHasChanged, weil der Aufruf von außerhalb des eigenen
    /// Event-Zyklus kommt.
    /// </summary>
    public void ForceClose()
    {
        if (!_open) return;
        _open = false;
        StateHasChanged();
    }
}
