@using System.Globalization
@using Markdig
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IPdfRenderer Renderer
@inject IPdfManipulator Manipulator
@inject IHashService Hasher
@inject IAnnotationService Annotations
@inject IMarkdownExporter MarkdownExporter
@inject IIntegrityService Integrity
@inject IStorageService Storage
@inject ISidecarService Sidecar
@inject IWorkspaceService Workspace
@inject ILibraryService Library
@inject IOcrService Ocr
@inject IFileHandleService Files
@inject IPdfFormService FormService
@inject ILocalizationService L
@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="mx-auto max-w-[1800px] px-4 sm:px-6 lg:px-8 py-8">
    <header class="max-w-4xl mx-auto mb-6">
        <h1 class="text-2xl font-bold">@L.T("reader.heading")</h1>
        <p class="mt-1 text-sm text-pb-fg-muted">
            @L.T("reader.subheading")
        </p>
    </header>

    <div class="max-w-4xl mx-auto rounded-lg pb-glass p-4">
        <label class="flex flex-col gap-2 text-sm">
            <span class="font-medium">@L.T("reader.choosePdf")</span>
            @if (_fsaSupported)
            {
                @* File-System-Access-API: zeigt einen nativen Picker, dessen
                   Handle wir nach dem ersten Open in IndexedDB persistieren.
                   Späteres Wieder-Öffnen aus der Library kommt dann mit
                   höchstens einem dezenten Permission-Dialog statt einem
                   weiteren File-Picker durch. *@
                <button type="button"
                        class="btn primary self-start disabled:opacity-40"
                        disabled="@_isLoading"
                        @onclick="PickPdfViaFsaAsync">
                    <Icon Name="folder" /> @L.T("reader.choosePdf")
                </button>
            }
            else
            {
                <InputFile OnChange="HandleFileSelected"
                           accept=".pdf"
                           class="block text-sm file:mr-3 file:rounded file:border-0 file:bg-pb-accent file:px-3 file:py-1.5 file:font-semibold file:text-[var(--accent-ink)] file:cursor-pointer cursor-pointer" />
            }
        </label>

        @if (_errorMessage is not null)
        {
            <div class="mt-3 rounded border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-700 whitespace-pre-wrap font-mono"
                 role="alert">
                @_errorMessage
            </div>
        }

        @if (_isLoading)
        {
            <div class="mt-3 text-sm text-pb-fg-muted" aria-live="polite">@L.T("app.loadingShort")</div>
        }
    </div>

    @if (_handle is not null)
    {
        <div class="max-w-4xl mx-auto mt-4 rounded-lg pb-glass p-4">
            <form @onsubmit="DoSearchAsync" @onsubmit:preventDefault>
                <div class="flex flex-wrap gap-2 items-center">
                    <input @bind="_searchQuery"
                           @bind:event="oninput"
                           type="search"
                           data-pb-search-input
                           class="flex-1 min-w-0 rounded border border-pb-border bg-pb-bg px-3 py-1.5 text-sm"
                           placeholder="@L.T("reader.search.placeholder")"
                           disabled="@_isSearching"
                           aria-label="@L.T("reader.search.label")" />
                    <button type="submit"
                            class="btn primary disabled:opacity-40"
                            disabled="@(_isSearching || string.IsNullOrWhiteSpace(_searchQuery))">
                        @(_isSearching ? L.T("reader.search.searching") : L.T("reader.search.button"))
                    </button>
                    @if (_searchHits is not null)
                    {
                        <button type="button"
                                class="rounded border border-pb-border px-2 py-1 text-xs text-pb-fg-muted hover:text-pb-fg"
                                @onclick="ClearSearch"
                                aria-label="@L.T("reader.search.resetAria")">
                            @L.T("reader.search.reset")
                        </button>
                    }
                </div>
                <div class="mt-2 flex gap-4 text-xs text-pb-fg-muted">
                    <label class="flex items-center gap-1 cursor-pointer">
                        <input type="checkbox" @bind="_matchCase" class="rounded" />
                        @L.T("reader.search.matchCase")
                    </label>
                    <label class="flex items-center gap-1 cursor-pointer">
                        <input type="checkbox" @bind="_wholeWord" class="rounded" />
                        @L.T("reader.search.wholeWord")
                    </label>
                    <button type="button"
                            class="ml-auto rounded border border-pb-border px-2 py-1 text-xs text-pb-fg-muted hover:text-pb-fg disabled:opacity-40"
                            disabled="@(_isOcrRunning || _handle is null)"
                            title="@L.T("reader.ocr.title")"
                            @onclick="RunOcrOnCurrentPageAsync">
                        @(_isOcrRunning ? L.T("reader.ocr.running") : L.T("reader.ocr.button"))
                    </button>
                </div>
            </form>

            @if (_ocrStatus is not null)
            {
                <div class="@($"mt-2 rounded border px-3 py-1 text-xs {(_ocrStatusIsError ? "border-red-300/40 bg-red-50/10 text-pb-fg" : "border-green-300/40 bg-green-50/10 text-pb-fg-muted")}")"
                     aria-live="polite">
                    @_ocrStatus
                    <button type="button"
                            class="float-right text-pb-fg-muted hover:text-pb-fg ml-2"
                            @onclick="@(() => _ocrStatus = null)"
                            aria-label="@L.T("common.close")">✕</button>
                </div>
            }

            @if (_searchHits is not null)
            {
                <div class="mt-3 text-sm" aria-live="polite">
                    @if (_pdfHasNoTextLayer)
                    {
                        <div class="rounded border border-amber-300/40 bg-amber-50/10 px-3 py-2 text-pb-fg">
                            <div class="font-medium">@L.T("reader.search.noTextLayer.title")</div>
                            <p class="mt-1 text-pb-fg-muted">@L.T("reader.search.noTextLayer.body")</p>
                            <button type="button"
                                    class="btn primary sm mt-2 disabled:opacity-40"
                                    disabled="@_isOcrRunning"
                                    title="@L.T("reader.ocr.title")"
                                    @onclick="RunOcrOnCurrentPageAsync">
                                @(_isOcrRunning ? L.T("reader.ocr.running") : L.T("reader.ocr.button"))
                            </button>
                        </div>
                    }
                    else if (_searchHits.Count == 0)
                    {
                        <span class="text-pb-fg-muted">@L.T("reader.search.noHits", new Dictionary<string, object> { ["query"] = _lastSearched })</span>
                    }
                    else
                    {
                        <span>@L.T("reader.search.hitsCount", new Dictionary<string, object> { ["count"] = _searchHits.Count, ["query"] = _lastSearched })</span>
                        <ul class="mt-2 max-h-64 overflow-y-auto divide-y divide-pb-border border border-pb-border rounded">
                            @foreach (var hit in _searchHits)
                            {
                                var snippetBefore = hit.Snippet.Substring(0, Math.Min(hit.SnippetMatchStart, hit.Snippet.Length));
                                var matchEnd = Math.Min(hit.SnippetMatchStart + hit.Match.Length, hit.Snippet.Length);
                                var snippetMatch = hit.Snippet.Substring(Math.Min(hit.SnippetMatchStart, hit.Snippet.Length), matchEnd - Math.Min(hit.SnippetMatchStart, hit.Snippet.Length));
                                var snippetAfter = matchEnd < hit.Snippet.Length ? hit.Snippet.Substring(matchEnd) : "";
                                <li>
                                    <button type="button"
                                            class="block w-full text-left p-2 hover:bg-pb-bg"
                                            @onclick="@(() => GoToPageAsync(hit.PageNumber))">
                                        <div class="text-xs text-pb-fg-muted">@L.T("reader.search.hitPage", new Dictionary<string, object> { ["page"] = hit.PageNumber })</div>
                                        <div class="text-sm">
                                            @snippetBefore<mark class="bg-pb-accent/20 text-pb-fg rounded px-0.5">@snippetMatch</mark>@snippetAfter
                                        </div>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
        </div>

        @* Titel-Block bleibt oben; die Seitennavigation wandert als Sticky-Bottom-
           Bar unter das PDF (F-21). *@
        <div class="max-w-4xl mx-auto mt-6 text-sm">
            <span class="font-medium">@(_handle.Title ?? L.T("common.untitled"))</span>
            <span class="text-pb-fg-muted"> · @_handle.PageCount @L.T("reader.pages")</span>
        </div>

        @* Kompakte Menüleiste — Kategorie-Dropdowns (ToolbarMenu) statt breiter Button-Reihe. *@
        <div class="max-w-4xl mx-auto mt-3 flex flex-wrap items-center gap-2 text-sm">
            <ToolbarMenu Label="@($"{L.T("reader.zoom.label")} {(int)(_zoomFactor * 100)}%")" Title="@L.T("reader.zoom.label")">
                @foreach (var z in _zoomLevels)
                {
                    var current = z;
                    <button type="button"
                            class="@($"pb-menuitem {(Math.Abs(_zoomFactor - current) < 0.001 ? "is-on" : "")}")"
                            disabled="@_isRendering"
                            @onclick="@(() => SetZoom(current))">
                        @($"{(int)(current * 100)}%")
                    </button>
                }
            </ToolbarMenu>
            <button type="button"
                    class="@($"rounded border px-2 py-0.5 {(_annotationMode == AnnotationMode.Select ? "pb-toolbtn is-on" : "pb-toolbtn")}")"
                    @onclick="@(() => SetAnnotationMode(AnnotationMode.Select))"
                    title="@L.T("reader.tool.select.title")">
                @L.T("reader.tool.select")
            </button>

            <ToolbarMenu Label="@L.T("reader.menu.edit")" Title="@L.T("reader.menu.edit")"
                         Active="@(_annotationMode is AnnotationMode.EditText or AnnotationMode.Redaction)">
                <button type="button" class="@($"pb-menuitem {(_annotationMode == AnnotationMode.EditText ? "is-on" : "")}")" @onclick="@(() => SetAnnotationMode(AnnotationMode.EditText))" title="@L.T("reader.edit.title")">@L.T("reader.edit.tool")</button>
                <button type="button" class="@($"pb-menuitem {(_annotationMode == AnnotationMode.Redaction ? "is-on" : "")}")" @onclick="@(() => SetAnnotationMode(AnnotationMode.Redaction))" title="@L.T("reader.redact.title")">@L.T("reader.redact.tool")</button>
            </ToolbarMenu>

            <ToolbarMenu Label="@L.T("reader.menu.add")" Title="@L.T("reader.menu.add")"
                         Active="@(_annotationMode is AnnotationMode.StickyNote or AnnotationMode.FreeText or AnnotationMode.DateStamp)">
                <button type="button" class="@($"pb-menuitem {(_annotationMode == AnnotationMode.FreeText ? "is-on" : "")}")" @onclick="@(() => SetAnnotationMode(AnnotationMode.FreeText))" title="@L.T("reader.tool.text.title")">@L.T("reader.tool.text")</button>
                <button type="button" class="@($"pb-menuitem {(_annotationMode == AnnotationMode.DateStamp ? "is-on" : "")}")" @onclick="@(() => SetAnnotationMode(AnnotationMode.DateStamp))" title="@L.T("reader.tool.date.title")">@L.T("reader.tool.date")</button>
                <button type="button" class="@($"pb-menuitem {(_annotationMode == AnnotationMode.StickyNote ? "is-on" : "")}")" @onclick="@(() => SetAnnotationMode(AnnotationMode.StickyNote))" title="@L.T("reader.tool.note.title")">@L.T("reader.tool.note")</button>
            </ToolbarMenu>

            <ToolbarMenu Label="@L.T("reader.menu.draw")" Title="@L.T("reader.menu.draw")" Active="@IsDrawingMode(_annotationMode)">
                <button type="button" class="@($"pb-menuitem {(_annotationMode == AnnotationMode.Pen ? "is-on" : "")}")" @onclick="@(() => SetAnnotationMode(AnnotationMode.Pen))" title="@L.T("reader.draw.pen.title")">@L.T("reader.draw.pen")</button>
                <button type="button" class="@($"pb-menuitem {(_annotationMode == AnnotationMode.RectShape ? "is-on" : "")}")" @onclick="@(() => SetAnnotationMode(AnnotationMode.RectShape))" title="@L.T("reader.draw.rect.title")">@L.T("reader.draw.rect")</button>
                <button type="button" class="@($"pb-menuitem {(_annotationMode == AnnotationMode.ArrowShape ? "is-on" : "")}")" @onclick="@(() => SetAnnotationMode(AnnotationMode.ArrowShape))" title="@L.T("reader.draw.arrow.title")">@L.T("reader.draw.arrow")</button>
                <button type="button" class="@($"pb-menuitem {(_annotationMode == AnnotationMode.LineShape ? "is-on" : "")}")" @onclick="@(() => SetAnnotationMode(AnnotationMode.LineShape))" title="@L.T("reader.draw.line.title")">@L.T("reader.draw.line")</button>
            </ToolbarMenu>

            <ToolbarMenu @ref="_signatureMenu" Label="@L.T("reader.menu.signature")" Title="@L.T("reader.menu.signature")"
                         Active="@(_annotationMode == AnnotationMode.Signature || _signerPanelOpen)">
                @if (_activeSignatureImage is null)
                {
                    @* stopPropagation: der Klick darf NICHT auf das Panel-@onclick=Close
                       durchblubbern — sonst schließt das Menü und reißt den InputFile aus
                       dem DOM, bevor sein change-Event feuert (OnChange käme nie an, das
                       PNG würde nie geladen). Nach dem Laden schließt der Handler das Menü
                       selbst via _signatureMenu.ForceClose(). *@
                    <label class="pb-menuitem cursor-pointer" @onclick:stopPropagation title="@L.T("reader.tool.signature.loadTitle")">
                        @L.T("reader.tool.signature.load")
                        <InputFile OnChange="HandleSignatureImageSelectedAsync" accept=".png,.jpg,.jpeg,image/png,image/jpeg" class="hidden" />
                    </label>
                }
                else
                {
                    <button type="button" class="@($"pb-menuitem {(_annotationMode == AnnotationMode.Signature ? "is-on" : "")}")" @onclick="@(() => SetAnnotationMode(AnnotationMode.Signature))" title="@L.T("reader.tool.signature.placeTitle")">
                        @L.T("reader.tool.signature.placeFormat", new Dictionary<string, object> { ["name"] = _activeSignatureFilename ?? L.T("reader.tool.signature.defaultName") })
                    </button>
                    <button type="button" class="pb-menuitem" @onclick="ClearActiveSignature" title="@L.T("reader.tool.signature.unload")">✕ @L.T("reader.tool.signature.unload")</button>
                }
                <button type="button" class="pb-menuitem" @onclick="@(() => _signaturePadOpen = true)" title="@L.T("reader.sig.draw.hint")">✍ @L.T("reader.sig.draw.menu")</button>
                <button type="button" class="@($"pb-menuitem {(_signerPanelOpen ? "is-on" : "")}")" @onclick="@(() => _signerPanelOpen = !_signerPanelOpen)" title="@L.T("reader.signer.toggleTitle")">
                    @(string.IsNullOrWhiteSpace(_signer.Name) ? L.T("reader.signer.toggleEmpty") : "👤 " + _signer.Name)
                </button>
                @if (_annotations.Any(a => a.Type == AnnotationType.Signature))
                {
                    <button type="button" class="pb-menuitem" disabled="@_isSavingSignedPdf" @onclick="ExportSignedPdfAsync" title="@L.T("reader.signed.saveTitle")">
                        @(_isSavingSignedPdf ? L.T("reader.signed.saving") : L.T("reader.signed.save"))
                    </button>
                }
            </ToolbarMenu>
            <ToolbarMenu Label="@L.T("reader.menu.view")" Title="@L.T("reader.menu.view")"
                         Active="@(_continuous || _nightMode || _outlineOpen || _thumbsOpen || _formPanelOpen)">
                <button type="button" class="@($"pb-menuitem {(_continuous ? "is-on" : "")}")" title="@L.T("reader.view.continuousTitle")" @onclick="ToggleContinuousAsync">
                    @L.T("reader.view.continuous")
                    @if (_continuous && _handle is not null && _continuousRenderedCount < _handle.PageCount)
                    {
                        <span class="ml-1 text-xs text-pb-fg-muted">@_continuousRenderedCount/@_handle.PageCount</span>
                    }
                </button>
                <button type="button" class="@($"pb-menuitem {(_nightMode ? "is-on" : "")}")" title="@L.T("reader.view.nightTitle")" @onclick="@(() => _nightMode = !_nightMode)">@L.T("reader.view.night")</button>
                <button type="button" class="@($"pb-menuitem {(_outlineOpen ? "is-on" : "")}")" title="@L.T("reader.outline.toggleTitle")" @onclick="@(() => _outlineOpen = !_outlineOpen)">
                    @L.T("reader.outline.toggle")
                    @if (_outline is null && _handle is not null)
                    {
                        <span class="ml-1 text-xs text-pb-fg-muted">@L.T("reader.outline.empty")</span>
                    }
                </button>
                <button type="button" class="@($"pb-menuitem {(_thumbsOpen ? "is-on" : "")}")" title="@L.T("reader.thumbs.toggleTitle")" @onclick="ToggleThumbsAsync">
                    @L.T("reader.thumbs.toggle")
                    @if (_thumbsOpen && _handle is not null && _thumbnailsProgress < _handle.PageCount)
                    {
                        <span class="ml-1 text-xs text-pb-fg-muted">@L.T("reader.thumbs.loading", new Dictionary<string, object> { ["current"] = _thumbnailsProgress, ["total"] = _handle.PageCount })</span>
                    }
                </button>
                @if (HasFormFields)
                {
                    <button type="button" class="@($"pb-menuitem {(_formPanelOpen ? "is-on" : "")}")" title="@L.T("reader.form.toggleTitle")" @onclick="@(() => _formPanelOpen = !_formPanelOpen)">
                        @L.T("reader.form.toggle") <span class="ml-1 text-xs text-pb-fg-muted">(@_formFields.Count)</span>
                    </button>
                }
                <button type="button" class="@($"pb-menuitem {(_ttsActive ? "is-on" : "")}")"
                        disabled="@(_pageTextItems.Count == 0)"
                        title="@(_pageTextItems.Count == 0 ? L.T("reader.tts.noText") : L.T("reader.tts.hint"))"
                        @onclick="StartReadingAsync">
                    🔊 @L.T("reader.tts.read")
                    @if (_pageTextItems.Count == 0)
                    {
                        <span class="ml-1 text-xs text-pb-fg-muted">@L.T("reader.tts.needOcr")</span>
                    }
                </button>
            </ToolbarMenu>

            <ToolbarMenu Label="@L.T("reader.menu.export")" Title="@L.T("reader.menu.export")">
                <button type="button" class="pb-menuitem" disabled="@(_isExporting || _annotations.Count == 0)" title="@(_annotations.Count == 0 ? L.T("reader.export.empty") : L.T("reader.export.title"))" @onclick="ExportMarkdownAsync">
                    @(_isExporting ? L.T("common.exportingProgress") : L.T("reader.export.button"))
                    @if (!_isExporting && _annotations.Count > 0)
                    {
                        <span class="ml-1 text-xs">(@_annotations.Count)</span>
                    }
                </button>
                <button type="button" class="pb-menuitem" disabled="@(_isFlattening || _annotations.Count == 0 || _originalPdfBytes is null)" title="@(_annotations.Count == 0 ? L.T("reader.flatten.empty") : L.T("reader.flatten.title"))" @onclick="FlattenAnnotationsAsync">
                    @(_isFlattening ? L.T("reader.flatten.running") : L.T("reader.flatten.button"))
                </button>
                <button type="button" class="pb-menuitem" disabled="@(_isExportingSidecar || _annotations.Count == 0)" title="@(_annotations.Count == 0 ? L.T("reader.sidecar.exportEmpty") : L.T("reader.sidecar.exportTitle"))" @onclick="ExportSidecarAsync">
                    @(_isExportingSidecar ? L.T("reader.sidecar.exporting") : L.T("reader.sidecar.export"))
                </button>
                @if (_workspaceName is not null)
                {
                    <button type="button" class="pb-menuitem" disabled="@(_isSavingToWorkspace || _annotations.Count == 0)" title="@L.T("reader.workspace.saveTitle", new Dictionary<string, object> { ["folder"] = _workspaceName })" @onclick="SaveToWorkspaceAsync">
                        @(_isSavingToWorkspace ? L.T("reader.workspace.saving") : L.T("reader.workspace.save"))
                    </button>
                }
                <label class="pb-menuitem cursor-pointer @(_handle is null ? "opacity-40 cursor-not-allowed" : "")" title="@L.T("reader.sidecar.importTitle")">
                    @L.T("reader.sidecar.import")
                    <InputFile OnChange="HandleSidecarFileSelectedAsync" accept=".json,application/json" disabled="@(_handle is null)" class="hidden" />
                </label>
            </ToolbarMenu>
        </div>

        @* Kontextleisten unter der Menüleiste — erscheinen je aktivem Modus. *@
        @if (_annotationMode == AnnotationMode.Redaction || _redactions.Count > 0)
        {
            <div class="max-w-4xl mx-auto mt-1 flex flex-wrap items-center gap-2 text-xs">
                <span class="text-pb-fg-muted">@L.T("reader.redact.hint")</span>
                <span class="text-pb-fg-muted">·&nbsp;@L.T("reader.redact.count", new Dictionary<string, object> { ["count"] = _redactions.Count })</span>
                <button type="button" class="btn primary"
                        disabled="@(_isRedacting || _redactions.Count == 0 || _originalPdfBytes is null)"
                        @onclick="ApplyRedactionsAsync">
                    @(_isRedacting ? L.T("reader.redact.running") : L.T("reader.redact.apply"))
                </button>
                <button type="button" class="rounded border border-pb-border px-2 py-0.5 text-pb-fg-muted hover:text-pb-fg disabled:opacity-40"
                        disabled="@(_redactions.Count == 0)" @onclick="ClearRedactions">
                    @L.T("reader.redact.clear")
                </button>
                <label class="ml-1 inline-flex items-center gap-1 text-pb-fg-muted" title="@L.T("reader.redact.audit.title")">
                    <input type="checkbox" @bind="_redactAudit" />
                    @L.T("reader.redact.audit")
                </label>
                <span class="mx-1 h-3 w-px bg-pb-border"></span>
                <span class="text-pb-fg-muted">@L.T("reader.redact.pattern.label")</span>
                <select @bind="_redactPreset" class="rounded border border-pb-border bg-pb-bg px-1 py-0.5 text-xs text-pb-fg">
                    <option value="email">@L.T("reader.redact.pattern.email")</option>
                    <option value="phone">@L.T("reader.redact.pattern.phone")</option>
                    <option value="iban">@L.T("reader.redact.pattern.iban")</option>
                    <option value="creditcard">@L.T("reader.redact.pattern.creditcard")</option>
                    <option value="custom">@L.T("reader.redact.pattern.custom")</option>
                </select>
                @if (_redactPreset == "custom")
                {
                    <input @bind="_redactCustomRegex" placeholder="@L.T("reader.redact.pattern.customPlaceholder")"
                           class="w-40 rounded border border-pb-border bg-pb-bg px-1 py-0.5 text-xs text-pb-fg" />
                }
                <button type="button" class="rounded border border-pb-border px-2 py-0.5 text-pb-fg-muted hover:text-pb-fg disabled:opacity-40"
                        disabled="@(_isFindingPattern || _handle is null)"
                        title="@L.T("reader.redact.pattern.hint")"
                        @onclick="FindPatternMatchesAsync">
                    @(_isFindingPattern ? L.T("reader.redact.pattern.finding") : L.T("reader.redact.pattern.find"))
                </button>
                @if (_patternFindStatus is not null)
                {
                    <span class="text-pb-fg-muted">@_patternFindStatus</span>
                }
            </div>
        }
        @if (_annotationMode == AnnotationMode.EditText || _edits.Count > 0)
        {
            <div class="max-w-4xl mx-auto mt-1 flex flex-wrap items-center gap-2 text-xs">
                <span class="text-pb-fg-muted">@L.T("reader.edit.hint")</span>
                <span class="text-pb-fg-muted">·&nbsp;@L.T("reader.edit.count", new Dictionary<string, object> { ["count"] = _edits.Count })</span>
                <button type="button" class="btn primary"
                        disabled="@(_isApplyingEdits || _edits.Count == 0 || _originalPdfBytes is null)"
                        @onclick="ApplyTextEditsAsync">
                    @(_isApplyingEdits ? L.T("reader.edit.running") : L.T("reader.edit.apply"))
                </button>
                <button type="button" class="rounded border border-pb-border px-2 py-0.5 text-pb-fg-muted hover:text-pb-fg disabled:opacity-40"
                        disabled="@(_edits.Count == 0)" @onclick="ClearEdits">
                    @L.T("reader.edit.clear")
                </button>
            </div>
        }
        @if (IsDrawingMode(_annotationMode))
        {
            <div class="max-w-4xl mx-auto mt-1 flex flex-wrap items-center gap-3 text-xs text-pb-fg-muted">
                <span>@L.T("reader.draw.color")</span>
                @foreach (var (labelKey, css) in DrawPalette)
                {
                    var c = css;
                    var label = L.T(labelKey);
                    var isActive = string.Equals(_drawColor, c, StringComparison.OrdinalIgnoreCase);
                    <button type="button"
                            class="@($"w-6 h-6 rounded-full border {(isActive ? "border-pb-accent ring-2 ring-pb-accent/40" : "border-pb-border")} hover:scale-110 transition-transform")"
                            style="@($"background-color:{c}")"
                            title="@label"
                            aria-label="@L.T("reader.draw.color.aria", new Dictionary<string, object> { ["label"] = label })"
                            @onclick="@(() => SetDrawColor(c))"></button>
                }
                <span class="ml-2">@L.T("reader.draw.width")</span>
                @foreach (var (labelKey, fraction) in DrawStrokeWidths)
                {
                    var f = fraction;
                    var label = L.T(labelKey);
                    var isActive = Math.Abs(_drawStrokeWidth - f) < 1e-6;
                    <button type="button"
                            class="@($"rounded border px-2 py-0.5 {(isActive ? "pb-toolbtn is-on" : "pb-toolbtn")}")"
                            title="@L.T("reader.draw.width.title", new Dictionary<string, object> { ["label"] = label })"
                            @onclick="@(() => SetDrawStrokeWidth(f))">
                        @label
                    </button>
                }
            </div>
        }
        @if (_ttsActive)
        {
            <div class="max-w-4xl mx-auto mt-1 flex flex-wrap items-center gap-2 text-xs">
                <span class="text-pb-fg-muted">🔊 @L.T("reader.tts.active")</span>
                <button type="button" class="rounded border border-pb-border px-2 py-0.5 text-pb-fg-muted hover:text-pb-fg" @onclick="TtsToggleAsync">
                    @(_ttsPaused ? L.T("reader.tts.resume") : L.T("reader.tts.pause"))
                </button>
                <button type="button" class="rounded border border-pb-border px-2 py-0.5 text-pb-fg-muted hover:text-pb-fg" @onclick="TtsStopAsync">
                    @L.T("reader.tts.stop")
                </button>
            </div>
        }

        @if (_signaturePadOpen)
        {
            <SignaturePad OnAccept="OnSignatureDrawnAsync" OnCancel="@(() => _signaturePadOpen = false)" />
        }

        @if (_sidecarStatus is not null)
        {
            <div class="@($"max-w-4xl mx-auto mt-2 rounded border px-3 py-2 text-sm {(_sidecarStatusIsError ? "border-red-300/40 bg-red-50/10 text-pb-fg" : "border-green-300/40 bg-green-50/10 text-pb-fg")}")">
                @_sidecarStatus
                <button type="button"
                        class="float-right text-pb-fg-muted hover:text-pb-fg ml-2"
                        @onclick="@(() => _sidecarStatus = null)"
                        aria-label="@L.T("common.close")">✕</button>
            </div>
        }

        @if (_signerPanelOpen)
        {
            <div class="max-w-4xl mx-auto mt-2 rounded-lg pb-glass-strong p-3">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-sm font-medium">@L.T("reader.signer.panel.heading")</span>
                    <span class="text-xs text-pb-fg-muted">@L.T("reader.signer.panel.subheading")</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm">
                    <label class="flex flex-col gap-1">
                        <span class="text-xs text-pb-fg-muted">@L.T("reader.signer.name") <span class="text-red-400">*</span></span>
                        <input type="text"
                               class="rounded border border-pb-border bg-pb-bg px-2 py-1"
                               placeholder="@L.T("reader.signer.name.placeholder")"
                               value="@_signer.Name"
                               @oninput="@(e => _signer = _signer with { Name = e.Value?.ToString() ?? string.Empty })" />
                    </label>
                    <label class="flex flex-col gap-1">
                        <span class="text-xs text-pb-fg-muted">@L.T("reader.signer.email")</span>
                        <input type="email"
                               class="rounded border border-pb-border bg-pb-bg px-2 py-1"
                               placeholder="@L.T("reader.signer.email.placeholder")"
                               value="@(_signer.Email ?? string.Empty)"
                               @oninput="@(e => _signer = _signer with { Email = NullIfBlank(e.Value?.ToString()) })" />
                    </label>
                    <label class="flex flex-col gap-1">
                        <span class="text-xs text-pb-fg-muted">@L.T("reader.signer.reason")</span>
                        <input type="text"
                               class="rounded border border-pb-border bg-pb-bg px-2 py-1"
                               placeholder="@L.T("reader.signer.reason.placeholder")"
                               value="@(_signer.Reason ?? string.Empty)"
                               @oninput="@(e => _signer = _signer with { Reason = NullIfBlank(e.Value?.ToString()) })" />
                    </label>
                    <label class="flex flex-col gap-1">
                        <span class="text-xs text-pb-fg-muted">@L.T("reader.signer.location")</span>
                        <input type="text"
                               class="rounded border border-pb-border bg-pb-bg px-2 py-1"
                               placeholder="@L.T("reader.signer.location.placeholder")"
                               value="@(_signer.Location ?? string.Empty)"
                               @oninput="@(e => _signer = _signer with { Location = NullIfBlank(e.Value?.ToString()) })" />
                    </label>
                </div>
                <div class="mt-2 flex justify-end gap-2">
                    <button type="button"
                            class="text-xs text-pb-fg-muted hover:text-pb-fg"
                            @onclick="@(() => _signerPanelOpen = false)">
                        @L.T("common.close")
                    </button>
                    <button type="button"
                            class="btn primary sm disabled:opacity-40"
                            disabled="@(!_signer.IsComplete)"
                            @onclick="SaveSignerToStorageAsync"
                            title="@L.T("reader.signer.rememberTitle")">
                        @L.T("reader.signer.remember")
                    </button>
                </div>
            </div>
        }

        @if (_formPanelOpen && HasFormFields)
        {
            <div class="max-w-4xl mx-auto mt-2 rounded-lg pb-glass-strong p-3">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <span class="text-sm font-medium">@L.T("reader.form.heading")</span>
                        <span class="ml-2 text-xs text-pb-fg-muted">@L.T("reader.form.fieldCount", new Dictionary<string, object> { ["count"] = _formFields.Count })</span>
                    </div>
                    <button type="button"
                            class="text-pb-fg-muted hover:text-pb-fg text-xs"
                            @onclick="@(() => _formPanelOpen = false)"
                            aria-label="@L.T("common.close")">✕</button>
                </div>

                <div class="space-y-4 max-h-[60vh] overflow-y-auto pr-1">
                    @foreach (var group in _formFields.GroupBy(f => f.PageNumber).OrderBy(g => g.Key == 0 ? int.MaxValue : g.Key))
                    {
                        <div>
                            <div class="text-xs font-medium text-pb-fg-muted mb-1 border-b border-pb-border pb-1">
                                @(group.Key == 0
                                    ? L.T("reader.form.pageUnknown")
                                    : L.T("reader.form.pageLabel", new Dictionary<string, object> { ["page"] = group.Key }))
                            </div>
                            <div class="space-y-2 pt-1">
                                @foreach (var field in group)
                                {
                                    var f = field;
                                    <div class="grid grid-cols-1 sm:grid-cols-[12rem_1fr] gap-2 items-start">
                                        <button type="button"
                                                class="text-sm text-pb-fg pt-1 text-left break-words hover:text-pb-accent disabled:hover:text-pb-fg"
                                                disabled="@(f.PageNumber < 1)"
                                                title="@L.T("reader.form.jumpTitle")"
                                                @onclick="@(() => JumpToFormFieldPage(f))">
                                            @f.Name
                                            @if (f.Required)
                                            {
                                                <span class="text-red-400">*</span>
                                            }
                                        </button>
                                        <div>
                                            @switch (f.Type)
                                            {
                                                case PdfFormFieldType.Text:
                                                    <input type="text"
                                                           aria-label="@f.Name"
                                                           class="w-full rounded border border-pb-border bg-pb-bg px-2 py-1 text-sm disabled:opacity-50"
                                                           value="@GetSingle(f.Name)"
                                                           disabled="@f.ReadOnly"
                                                           @onchange="@(e => SetSingle(f.Name, e.Value?.ToString()))" />
                                                    break;
                                                case PdfFormFieldType.Checkbox:
                                                    <label class="flex items-center gap-2 text-sm">
                                                        <input type="checkbox"
                                                               checked="@IsChecked(f.Name)"
                                                               disabled="@f.ReadOnly"
                                                               @onchange="@(e => SetChecked(f.Name, e.Value is true))" />
                                                        <span class="text-pb-fg-muted">@L.T("reader.form.checkboxOn")</span>
                                                    </label>
                                                    break;
                                                case PdfFormFieldType.Radio:
                                                    <div class="flex flex-wrap gap-3 text-sm">
                                                        @foreach (var opt in f.Options)
                                                        {
                                                            var o = opt;
                                                            <label class="flex items-center gap-1 cursor-pointer">
                                                                <input type="radio"
                                                                       name="@($"radio-{f.Name}")"
                                                                       checked="@(GetSingle(f.Name) == o)"
                                                                       disabled="@f.ReadOnly"
                                                                       @onchange="@(() => SetSingle(f.Name, o))" />
                                                                @o
                                                            </label>
                                                        }
                                                    </div>
                                                    break;
                                                case PdfFormFieldType.Dropdown:
                                                    <select aria-label="@f.Name"
                                                            class="w-full rounded border border-pb-border bg-pb-bg px-2 py-1 text-sm disabled:opacity-50"
                                                            disabled="@f.ReadOnly"
                                                            @onchange="@(e => SetSingle(f.Name, e.Value?.ToString()))">
                                                        <option value="" selected="@(GetSingle(f.Name).Length == 0)">@L.T("reader.form.dropdownEmpty")</option>
                                                        @foreach (var opt in f.Options)
                                                        {
                                                            var o = opt;
                                                            <option value="@o" selected="@(GetSingle(f.Name) == o)">@o</option>
                                                        }
                                                    </select>
                                                    break;
                                                case PdfFormFieldType.ListBox:
                                                    <select multiple
                                                            aria-label="@f.Name"
                                                            class="w-full rounded border border-pb-border bg-pb-bg px-2 py-1 text-sm disabled:opacity-50 min-h-[4rem]"
                                                            disabled="@f.ReadOnly"
                                                            @onchange="@(e => SetMulti(f.Name, e.Value))">
                                                        @foreach (var opt in f.Options)
                                                        {
                                                            var o = opt;
                                                            <option value="@o" selected="@(GetMulti(f.Name).Contains(o))">@o</option>
                                                        }
                                                    </select>
                                                    break;
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-4 flex flex-wrap items-center justify-end gap-3 border-t border-pb-border pt-3">
                    <div class="flex items-center gap-3 text-xs text-pb-fg-muted mr-auto">
                        <span>@L.T("reader.form.saveMode")</span>
                        <label class="flex items-center gap-1 cursor-pointer">
                            <input type="radio" name="form-save-mode"
                                   checked="@(!_formSaveFlatten)"
                                   @onchange="@(() => _formSaveFlatten = false)" />
                            @L.T("reader.form.saveEditable")
                        </label>
                        <label class="flex items-center gap-1 cursor-pointer">
                            <input type="radio" name="form-save-mode"
                                   checked="@_formSaveFlatten"
                                   @onchange="@(() => _formSaveFlatten = true)" />
                            @L.T("reader.form.saveFlatten")
                        </label>
                    </div>
                    <button type="button"
                            class="btn primary disabled:opacity-40"
                            disabled="@_isFillingForm"
                            @onclick="SaveFilledFormAsync">
                        @(_isFillingForm ? L.T("reader.form.saving") : L.T("reader.form.save"))
                    </button>
                </div>

                @if (_formStatus is not null)
                {
                    <div class="@($"mt-2 rounded border px-3 py-1 text-xs {(_formStatusIsError ? "border-red-300/40 bg-red-50/10 text-pb-fg" : "border-green-300/40 bg-green-50/10 text-pb-fg-muted")}")"
                         aria-live="polite">
                        @_formStatus
                        <button type="button"
                                class="float-right text-pb-fg-muted hover:text-pb-fg ml-2"
                                @onclick="@(() => _formStatus = null)"
                                aria-label="@L.T("common.close")">✕</button>
                    </div>
                }
            </div>
        }

        <div class="mt-6 flex gap-4 items-start">

        @if (_outlineOpen)
        {
            <aside class="w-64 shrink-0 rounded-lg pb-glass-strong p-3 max-h-[80vh] overflow-y-auto"
                   aria-label="@L.T("reader.outline.heading")">
                <div class="flex items-center justify-between mb-2">
                    <h3 class="text-sm font-medium">@L.T("reader.outline.heading")</h3>
                    <button type="button"
                            class="text-pb-fg-muted hover:text-pb-fg text-xs"
                            @onclick="@(() => _outlineOpen = false)"
                            aria-label="@L.T("reader.outline.closeAria")">
                        ✕
                    </button>
                </div>
                @if (_outline is null)
                {
                    <p class="text-xs text-pb-fg-muted italic">@L.T("reader.outline.noOutline")</p>
                }
                else
                {
                    <ul class="text-sm">
                        @foreach (var entry in _outline.Entries)
                        {
                            <OutlineNode Entry="entry" OnNavigate="GoToPageAsync" />
                        }
                    </ul>
                }
            </aside>
        }

        @if (_thumbsOpen)
        {
            <aside class="w-44 shrink-0 rounded-lg pb-glass p-2 max-h-[80vh] overflow-y-auto"
                   aria-label="@L.T("reader.thumbs.heading")">
                <div class="flex items-center justify-between mb-2 px-1">
                    <h3 class="text-sm font-medium">@L.T("reader.thumbs.heading")</h3>
                    <button type="button"
                            class="text-pb-fg-muted hover:text-pb-fg text-xs"
                            @onclick="@(() => _thumbsOpen = false)"
                            aria-label="@L.T("reader.thumbs.closeAria")">
                        ✕
                    </button>
                </div>
                @if (_handle is not null)
                {
                    <ul class="space-y-2">
                        @for (var i = 1; i <= _handle.PageCount; i++)
                        {
                            var pageNum = i;
                            var thumb = _thumbnails.GetValueOrDefault(pageNum);
                            var isCurrent = pageNum == _currentPage;
                            <li>
                                <button type="button"
                                        class="@($"w-full flex flex-col items-center gap-1 rounded border p-1 hover:border-pb-fg-muted {(isCurrent ? "border-pb-accent ring-2 ring-pb-accent/30" : "border-pb-border")}")"
                                        title="@L.T("reader.thumbs.pageAria", new Dictionary<string, object> { ["page"] = pageNum })"
                                        aria-label="@L.T("reader.thumbs.pageAria", new Dictionary<string, object> { ["page"] = pageNum })"
                                        @onclick="@(() => GoToPageAsync(pageNum))">
                                    @if (thumb is not null)
                                    {
                                        <img src="@thumb"
                                             alt="@L.T("reader.thumbs.pageLabel", new Dictionary<string, object> { ["page"] = pageNum })"
                                             draggable="false"
                                             class="block w-full h-auto bg-pb-bg shadow-sm" />
                                    }
                                    else
                                    {
                                        <div class="w-full aspect-[3/4] bg-pb-bg animate-pulse"></div>
                                    }
                                    <span class="text-xs text-pb-fg-muted tabular-nums">@pageNum</span>
                                </button>
                            </li>
                        }
                    </ul>
                }
            </aside>
        }

        @if (_continuous && _handle is not null)
        {
            @* Fortlaufende Leseansicht (FA Reader-Komfort): alle Seiten gestapelt,
               scrollbar. Read-only (Annotieren/Schwärzen im Einzelseiten-Modus). *@
            <div class="flex-1 min-w-0 overflow-auto rounded-lg border border-pb-border bg-pb-bg p-4"
                 style="max-height: calc(100vh - 230px)">
                <div class="mx-auto flex w-full max-w-3xl flex-col items-center gap-4">
                    @for (var p = 1; p <= _handle.PageCount; p++)
                    {
                        var pg = p;
                        @if (_continuousPages.TryGetValue(pg, out var url))
                        {
                            <img src="@url" draggable="false"
                                 alt="@L.T("reader.thumbs.pageLabel", new Dictionary<string, object> { ["page"] = pg })"
                                 class="block w-full select-none shadow-sm"
                                 style="@(_nightMode ? NightFilterStyle : null)" />
                        }
                        else
                        {
                            <div class="flex w-full items-center justify-center text-xs text-pb-fg-muted"
                                 style="aspect-ratio: 1 / 1.414; background: var(--bg-sunken, #1118270d)">
                                @L.T("reader.thumbs.pageLabel", new Dictionary<string, object> { ["page"] = pg })
                            </div>
                        }
                    }
                </div>
            </div>
        }
        else
        {
        <figure class="flex-1 min-w-0 flex justify-center rounded-lg border border-pb-border bg-pb-bg p-4 overflow-visible">
            @if (_rasterDataUrl is not null && _renderedPage is not null)
            {
                var pageW = _renderedPage.PageWidthPt;
                var pageH = _renderedPage.PageHeightPt;
                var maxWidthPx = _renderedPage.WidthPx;
                var canvasStyle = string.Format(
                    CultureInfo.InvariantCulture,
                    "container-type:size; aspect-ratio:{0}/{1}; width:min(100%, {2}px)",
                    pageW, pageH, maxWidthPx);
                <div data-pb-page-canvas
                     class="relative @(IsPlacementMode(_annotationMode) || IsDrawCaptureMode(_annotationMode) ? "cursor-crosshair" : "cursor-text")"
                     style="@canvasStyle"
                     @onclick="HandlePdfClickAsync"
                     @onmouseup="HandleCanvasMouseUpAsync">
                    <img src="@_rasterDataUrl"
                         data-pb-pdf-image
                         alt="@L.T("reader.imageAlt", new Dictionary<string, object> { ["current"] = _currentPage, ["total"] = _handle.PageCount })"
                         class="block w-full h-full shadow-sm select-none pointer-events-none"
                         style="@(_nightMode ? NightFilterStyle : null)"
                         draggable="false" />

                    @* Text-Layer für FA-005 (Suche-Highlighting) und FA-010 (Highlight-Selection).
                       In allen Platzierungs- (Sticky Note / Freitext / Datum) und Zeichen-
                       Modi deaktiviert, damit Klicks aufs PDF direkt auf das Canvas-Div
                       durchschlagen (siehe IsPlacementMode / IsDrawCaptureMode).

                       Zwei Code-Pfade:
                       a) Native PDF-Text: PDF.js' eigene TextLayer-Klasse rendert die
                          Spans pixel-genau (siehe pdfjs-bridge.renderTextLayerToContainer).
                          Der Container ist hier nur ein leeres Anker-Div mit dem
                          data-pb-native-text-layer-Selector; JavaScript füllt ihn nach
                          jedem Render.
                       b) OCR-Output (FA-050): kommt mit Pixel-Bounding-Boxes statt
                          font-stream — die rendern wir als Razor-Spans mit scaleX-Helper. *@
                    @{
                        var textLayerInteractiveCss = (IsPlacementMode(_annotationMode) || IsDrawCaptureMode(_annotationMode))
                            ? "select-none pointer-events-none"
                            : "select-text";
                    }
                    @if (_useOcrTextLayer && _pageTextItems.Count > 0)
                    {
                        <div class="@($"absolute inset-0 leading-none whitespace-pre {textLayerInteractiveCss}")"
                             aria-hidden="true">
                            @foreach (var item in _pageTextItems)
                            {
                                var leftPct = (item.X / pageW * 100).ToString("F3", CultureInfo.InvariantCulture);
                                var topPct = (item.Y / pageH * 100).ToString("F3", CultureInfo.InvariantCulture);
                                var widthPct = (item.Width / pageW * 100).ToString("F3", CultureInfo.InvariantCulture);
                                var fontCqh = (item.Height / pageH * 100).ToString("F3", CultureInfo.InvariantCulture);
                                <span data-pb-text="true"
                                      data-pb-target-width="@widthPct"
                                      class="absolute text-transparent origin-top-left whitespace-pre leading-none"
                                      style="@($"left:{leftPct}%; top:{topPct}%; font-size:{fontCqh}cqh; line-height:1")">@item.Text</span>
                            }
                        </div>
                    }
                    else
                    {
                        @* pb-textLayer-Klasse muss als statischer Wert im Razor-Markup stehen —
                           sonst überschreibt Blazor sie bei jedem Re-Render (z.B. Werkzeug-Wechsel)
                           und die `color:transparent`-Regel auf den PDF.js-Spans greift nicht mehr,
                           wodurch der Text-Layer plötzlich wieder sichtbar wird. *@
                        <div data-pb-native-text-layer
                             class="@($"pb-textLayer {textLayerInteractiveCss}")"
                             aria-hidden="true"></div>
                    }

                    @* Highlight-Layer (über Text, semi-transparent, klickbar zur Bearbeitung) *@
                    @foreach (var hl in HighlightsOnCurrentPage)
                    {
                        var highlight = hl;
                        var color = HighlightAnnotation.GetColor(highlight);
                        foreach (var rect in HighlightAnnotation.GetRects(highlight))
                        {
                            var rLeft = (rect.X * 100).ToString("F3", CultureInfo.InvariantCulture);
                            var rTop = (rect.Y * 100).ToString("F3", CultureInfo.InvariantCulture);
                            var rWidth = (rect.Width * 100).ToString("F3", CultureInfo.InvariantCulture);
                            var rHeight = (rect.Height * 100).ToString("F3", CultureInfo.InvariantCulture);
                            <button type="button"
                                    class="absolute cursor-pointer border-0 p-0"
                                    style="@($"left:{rLeft}%; top:{rTop}%; width:{rWidth}%; height:{rHeight}%; background-color:{color}; mix-blend-mode:multiply; opacity:0.85")"
                                    aria-label="@L.T("reader.highlight.editAria")"
                                    title="@HighlightAnnotation.GetText(highlight)"
                                    @onclick="@(() => OpenHighlightEditor(highlight))"
                                    @onclick:stopPropagation></button>
                        }
                    }

                    @* Schwärzungs-Vorschau: solide schwarze Kästen (echte Redaktion
                       passiert erst beim Anwenden via redactPdf — Rasterung). *@
                    @foreach (var rb in RedactionsOnCurrentPage)
                    {
                        var r = rb;
                        <div class="absolute"
                             style="@($"left:{(r.X * 100).ToString("F3", CultureInfo.InvariantCulture)}%; top:{(r.Y * 100).ToString("F3", CultureInfo.InvariantCulture)}%; width:{(r.Width * 100).ToString("F3", CultureInfo.InvariantCulture)}%; height:{(r.Height * 100).ToString("F3", CultureInfo.InvariantCulture)}%; background:#000; pointer-events:none; z-index:20")"
                             aria-hidden="true"></div>
                    }

                    @* Vorschau der Text-Bearbeitungen: opaker Cover-Kasten (Hintergrund-
                       farbe) + neuer Text darüber. Das echte Einbrennen passiert erst
                       beim Anwenden via applyTextEdits. *@
                    @foreach (var eb in EditsOnCurrentPage)
                    {
                        var ed = eb;
                        var edLeft = (ed.X * 100).ToString("F3", CultureInfo.InvariantCulture);
                        var edTop = (ed.Y * 100).ToString("F3", CultureInfo.InvariantCulture);
                        var edW = (ed.Width * 100).ToString("F3", CultureInfo.InvariantCulture);
                        var edH = (ed.Height * 100).ToString("F3", CultureInfo.InvariantCulture);
                        var edFontCqh = (ed.FontSize * 100).ToString("F3", CultureInfo.InvariantCulture);
                        <div class="absolute whitespace-pre leading-tight" aria-hidden="true"
                             style="@($"left:{edLeft}%; top:{edTop}%; min-width:{edW}%; min-height:{edH}%; background:{ed.BgColor}; color:{ed.Color}; font-size:{edFontCqh}cqh; pointer-events:none; z-index:20")">@ed.NewText</div>
                    }

                    @* Ink + Shape Overlay (FA-013 Stift, FA-014 Formen).
                       SVG mit viewBox 0..1 — alle Punkte/Bounds sind als
                       Seiten-Anteile gespeichert und skalieren automatisch
                       mit dem Zoom. *@
                    @if (InkOnCurrentPage.Any() || ShapesOnCurrentPage.Any())
                    {
                        var drawingActive = IsDrawingMode(_annotationMode);
                        // Hit-Helper-Stroke: transparente, deutlich dickere
                        // Variante jedes Pfads — pointer-events:stroke fängt
                        // nur EXAKT auf der Strichbreite, deshalb brauchen wir
                        // ein eigenes Element mit ~0.02 Seiten-Anteilen für
                        // bequemes Klicken zum Löschen. Im Zeichen-Modus auch
                        // diese Helper deaktivieren, damit Klicks beim Live-Zeichnen
                        // an die JS-Bridge auf dem Canvas durchgereicht werden.
                        const string HitStrokeWidth = "0.024";
                        var hitPointerCss = drawingActive
                            ? "pointer-events:none"
                            : "pointer-events:stroke; cursor:pointer";
                        <svg class="absolute inset-0 w-full h-full"
                             style="pointer-events:none; z-index:10"
                             viewBox="0 0 1 1" preserveAspectRatio="none" aria-hidden="true">
                            @foreach (var ink in InkOnCurrentPage)
                            {
                                var inkAnn = ink;
                                var inkColor = InkAnnotation.GetColor(inkAnn);
                                var inkSw = InkAnnotation.GetStrokeWidth(inkAnn)
                                    .ToString("F4", CultureInfo.InvariantCulture);
                                foreach (var stroke in InkAnnotation.GetStrokes(inkAnn))
                                {
                                    var d = BuildInkPath(stroke);
                                    if (string.IsNullOrEmpty(d)) continue;
                                    @* Hit-Helper: transparent + dick + klickbar *@
                                    <path d="@d" fill="none" stroke="transparent" stroke-width="@HitStrokeWidth"
                                          stroke-linecap="round" stroke-linejoin="round"
                                          style="@hitPointerCss"
                                          @onclick="@(() => OpenDrawingEditor(inkAnn))"
                                          @onclick:stopPropagation />
                                    @* Sichtbarer Stroke: pointer-events deaktiviert *@
                                    <path d="@d" fill="none" stroke="@inkColor" stroke-width="@inkSw"
                                          stroke-linecap="round" stroke-linejoin="round"
                                          style="pointer-events:none" />
                                }
                            }
                            @foreach (var shape in ShapesOnCurrentPage)
                            {
                                var sa = shape;
                                var kind = ShapeAnnotation.GetShape(sa);
                                var col = ShapeAnnotation.GetColor(sa);
                                var sw = ShapeAnnotation.GetStrokeWidth(sa);
                                var swStr = sw.ToString("F4", CultureInfo.InvariantCulture);
                                var sx = ShapeAnnotation.GetStartX(sa);
                                var sy = ShapeAnnotation.GetStartY(sa);
                                var ex = ShapeAnnotation.GetEndX(sa);
                                var ey = ShapeAnnotation.GetEndY(sa);
                                if (kind == ShapeKind.Rectangle)
                                {
                                    var rx = Math.Min(sx, ex).ToString("F4", CultureInfo.InvariantCulture);
                                    var ry = Math.Min(sy, ey).ToString("F4", CultureInfo.InvariantCulture);
                                    var rw = Math.Abs(ex - sx).ToString("F4", CultureInfo.InvariantCulture);
                                    var rh = Math.Abs(ey - sy).ToString("F4", CultureInfo.InvariantCulture);
                                    @* Hit-Helper auf den Rahmen, nicht auf den hohlen Innenraum *@
                                    <rect x="@rx" y="@ry" width="@rw" height="@rh"
                                          fill="none" stroke="transparent" stroke-width="@HitStrokeWidth"
                                          style="@hitPointerCss"
                                          @onclick="@(() => OpenDrawingEditor(sa))"
                                          @onclick:stopPropagation />
                                    <rect x="@rx" y="@ry" width="@rw" height="@rh"
                                          fill="none" stroke="@col" stroke-width="@swStr"
                                          style="pointer-events:none" />
                                }
                                else
                                {
                                    var aspect = pageH > 0 ? pageW / pageH : 1.0;
                                    var head = kind == ShapeKind.Arrow
                                        ? ComputeArrowHead(sx, sy, ex, ey, sw, aspect)
                                        : null;
                                    // Sichtbarer Schaft endet bei Pfeilen an der Spitzen-Basis,
                                    // damit die runde Strich-Endkappe unter dem Dreieck
                                    // verschwindet (sonst „Punkt" an der Spitze).
                                    var lex = ex; var ley = ey;
                                    if (head is { } hb) { lex = (hb.X2 + hb.X3) / 2; ley = (hb.Y2 + hb.Y3) / 2; }
                                    var x1 = sx.ToString("F4", CultureInfo.InvariantCulture);
                                    var y1 = sy.ToString("F4", CultureInfo.InvariantCulture);
                                    var hxe = ex.ToString("F4", CultureInfo.InvariantCulture);
                                    var hye = ey.ToString("F4", CultureInfo.InvariantCulture);
                                    var vxe = lex.ToString("F4", CultureInfo.InvariantCulture);
                                    var vye = ley.ToString("F4", CultureInfo.InvariantCulture);
                                    @* Hit-Helper über die volle Länge (auch über der Spitze klickbar) *@
                                    <line x1="@x1" y1="@y1" x2="@hxe" y2="@hye"
                                          stroke="transparent" stroke-width="@HitStrokeWidth"
                                          stroke-linecap="round"
                                          style="@hitPointerCss"
                                          @onclick="@(() => OpenDrawingEditor(sa))"
                                          @onclick:stopPropagation />
                                    <line x1="@x1" y1="@y1" x2="@vxe" y2="@vye"
                                          stroke="@col" stroke-width="@swStr"
                                          stroke-linecap="round"
                                          style="pointer-events:none" />
                                    @if (head is { } h2)
                                    {
                                        var (hx1, hy1, hx2, hy2, hx3, hy3) = h2;
                                        var points = string.Format(CultureInfo.InvariantCulture,
                                            "{0:F4},{1:F4} {2:F4},{3:F4} {4:F4},{5:F4}",
                                            hx1, hy1, hx2, hy2, hx3, hy3);
                                        <polygon points="@points" fill="@col" stroke="none"
                                                 style="pointer-events:none" />
                                    }
                                }
                            }
                        </svg>
                    }

                    @* Lösch-Mini-Toolbar (FA-013/014) bei selektierter Ink/Shape *@
                    @if (_editingDrawing is not null && _editingDrawing.PageNumber == _currentPage)
                    {
                        var (anchorX, anchorY) = GetDrawingAnchor(_editingDrawing);
                        var anchorLeftPct = (anchorX * 100).ToString("F2", CultureInfo.InvariantCulture);
                        var anchorTopPct = (anchorY * 100).ToString("F2", CultureInfo.InvariantCulture);
                        var translateY = anchorY < 0.08 ? "8px" : "calc(-100% - 6px)";
                        <div class="absolute z-20 flex items-center gap-1 rounded-md pb-glass-strong px-2 py-1"
                             style="@($"left:{anchorLeftPct}%; top:{anchorTopPct}%; transform: translate(-50%, {translateY})")"
                             @onclick:stopPropagation>
                            <span class="text-xs text-pb-fg-muted mr-1">
                                @(_editingDrawing.Type == AnnotationType.Ink ? L.T("reader.draw.kind.ink") : L.T("reader.draw.kind.shape"))
                            </span>
                            <button type="button"
                                    class="px-2 py-0.5 text-xs rounded border border-pb-border text-pb-fg-muted hover:text-pb-fg"
                                    @onclick="DeleteEditingDrawingAsync"
                                    title="@L.T("common.delete")">
                                @L.T("common.deleteIcon")
                            </button>
                            <button type="button"
                                    class="ml-1 px-1 text-pb-fg-muted hover:text-pb-fg text-sm"
                                    @onclick="@(() => _editingDrawing = null)"
                                    aria-label="@L.T("common.deleteAria")">✕</button>
                        </div>
                    }

                    @* Inline-Toolbar bei Selection (FA-018) *@
                    @if (_pendingSelection is not null && _editingHighlight is null)
                    {
                        var anchorLeft = (_pendingSelection.AnchorX * 100).ToString("F2", CultureInfo.InvariantCulture);
                        var anchorTop = (_pendingSelection.AnchorY * 100).ToString("F2", CultureInfo.InvariantCulture);
                        // Bei Selection ganz oben auf der Seite klappt die Toolbar
                        // nach unten, sonst nach oben (Default).
                        var toolbarTranslateY = _pendingSelection.AnchorY < 0.08
                            ? "8px"
                            : "calc(-100% - 6px)";
                        <div class="absolute z-20 flex items-center gap-1 rounded-md pb-glass-strong px-2 py-1"
                             style="@($"left:{anchorLeft}%; top:{anchorTop}%; transform: translate(-50%, {toolbarTranslateY})")"
                             @onmousedown:preventDefault
                             @onclick:stopPropagation>
                            <span class="text-xs text-pb-fg-muted mr-1">@L.T("reader.highlight.markLabel")</span>
                            @foreach (var color in HighlightPalette)
                            {
                                var c = color;
                                <button type="button"
                                        class="w-5 h-5 rounded-full border border-pb-border hover:scale-110 transition-transform"
                                        style="@($"background-color:{c}")"
                                        title="@c"
                                        aria-label="@L.T("reader.highlight.colorButtonAria", new Dictionary<string, object> { ["color"] = c })"
                                        @onclick="@(() => HighlightPendingSelectionAsync(c))"></button>
                            }
                            <button type="button"
                                    class="ml-1 px-1 text-pb-fg-muted hover:text-pb-fg text-sm"
                                    @onclick="DismissSelection"
                                    aria-label="@L.T("common.deleteAria")">✕</button>
                        </div>
                    }

                    @* Highlight-Editor (Click auf bereits gesetzten Highlight) *@
                    @if (_editingHighlight is not null && _editingHighlight.PageNumber == _currentPage)
                    {
                        var firstRect = HighlightAnnotation.GetRects(_editingHighlight).FirstOrDefault();
                        if (firstRect is not null)
                        {
                            var editLeft = (firstRect.X * 100).ToString("F2", CultureInfo.InvariantCulture);
                            var editTop = (firstRect.Y * 100).ToString("F2", CultureInfo.InvariantCulture);
                            // Highlight oben → Toolbar unter dem Rechteck.
                            var hlTranslateY = firstRect.Y < 0.08
                                ? $"calc({firstRect.Height * 100:F2}% + 6px)"
                                : "calc(-100% - 6px)";
                            <div class="absolute z-20 flex items-center gap-1 rounded-md pb-glass-strong px-2 py-1"
                                 style="@($"left:{editLeft}%; top:{editTop}%; transform: translate(0, {hlTranslateY})")"
                                 @onclick:stopPropagation>
                                <span class="text-xs text-pb-fg-muted mr-1">@L.T("reader.highlight.colorLabel")</span>
                                @foreach (var color in HighlightPalette)
                                {
                                    var c = color;
                                    var isCurrent = HighlightAnnotation.GetColor(_editingHighlight) == c;
                                    <button type="button"
                                            class="@($"w-5 h-5 rounded-full border hover:scale-110 transition-transform {(isCurrent ? "border-pb-accent" : "border-pb-border")}")"
                                            style="@($"background-color:{c}")"
                                            @onclick="@(() => ChangeHighlightColorAsync(c))"></button>
                                }
                                <button type="button"
                                        class="ml-1 rounded border border-red-300/40 px-2 py-0.5 text-xs text-red-400 hover:bg-red-50/10"
                                        @onclick="DeleteEditingHighlightAsync">
                                    @L.T("common.delete")
                                </button>
                                <button type="button"
                                        class="ml-1 px-1 text-pb-fg-muted hover:text-pb-fg text-sm"
                                        @onclick="CancelHighlightEditing"
                                        aria-label="@L.T("common.close")">✕</button>
                            </div>
                        }
                    }

                    @* Signaturen (FA-015) — PNG-Bild mit Integritäts-Status-Badge *@
                    @foreach (var sig in SignaturesOnCurrentPage)
                    {
                        var signature = sig;
                        var sigLeft = (SignatureAnnotation.GetX(signature) * 100).ToString("F3", CultureInfo.InvariantCulture);
                        var sigTop = (SignatureAnnotation.GetY(signature) * 100).ToString("F3", CultureInfo.InvariantCulture);
                        var sigWidth = (SignatureAnnotation.GetWidth(signature) * 100).ToString("F3", CultureInfo.InvariantCulture);
                        var sigHeight = (SignatureAnnotation.GetHeight(signature) * 100).ToString("F3", CultureInfo.InvariantCulture);
                        var status = _signatureStatuses.GetValueOrDefault(signature.Id.Value, SignatureIntegrityStatus.NoHash);
                        var ringClass = status switch
                        {
                            SignatureIntegrityStatus.Valid => "ring-2 ring-green-400/70",
                            SignatureIntegrityStatus.Invalid => "ring-2 ring-red-400/80",
                            _ => "ring-1 ring-amber-400/50"
                        };
                        var badgeBg = status switch
                        {
                            SignatureIntegrityStatus.Valid => "bg-green-500",
                            SignatureIntegrityStatus.Invalid => "bg-red-500",
                            _ => "bg-amber-500"
                        };
                        var badgeIcon = status switch
                        {
                            SignatureIntegrityStatus.Valid => "✓",
                            SignatureIntegrityStatus.Invalid => "!",
                            _ => "?"
                        };
                        var badgeTitle = status switch
                        {
                            SignatureIntegrityStatus.Valid => L.T("reader.signature.statusValid"),
                            SignatureIntegrityStatus.Invalid => L.T("reader.signature.statusInvalid"),
                            _ => L.T("reader.signature.statusNoHash")
                        };
                        var signedAtLabel = SignatureAnnotation.GetSignedAt(signature).ToLocalTime().ToString("yyyy-MM-dd HH:mm");
                        var dragTitle = L.T("reader.signature.dragTitle", new Dictionary<string, object> { ["date"] = signedAtLabel, ["status"] = badgeTitle });
                        <div data-pb-signature-id="@signature.Id.Value"
                             class="absolute @ringClass rounded bg-white/40 cursor-move select-none touch-none"
                             style="@($"left:{sigLeft}%; top:{sigTop}%; width:{sigWidth}%; height:{sigHeight}%")"
                             title="@dragTitle"
                             @onmousedown="@((MouseEventArgs e) => HandleSignatureMouseDownAsync(e, signature))"
                             @onmousedown:stopPropagation
                             @onclick:stopPropagation>
                            <img src="@SignatureAnnotation.GetImageDataUrl(signature)"
                                 alt="@L.T("reader.signature.alt")"
                                 draggable="false"
                                 class="w-full h-full object-contain pointer-events-none" />
                            <span class="absolute -top-2 -right-2 w-5 h-5 rounded-full text-xs text-white flex items-center justify-center shadow @badgeBg pointer-events-none"
                                  aria-label="@badgeTitle">@badgeIcon</span>
                            <button type="button"
                                    class="absolute -bottom-2 -left-2 w-5 h-5 rounded-full bg-pb-surface border border-pb-border text-xs text-pb-fg-muted hover:text-red-500 flex items-center justify-center shadow"
                                    @onclick="@(() => DeleteSignatureAsync(signature))"
                                    @onclick:stopPropagation
                                    @onmousedown:stopPropagation
                                    title="@L.T("reader.signature.removeTitle")"
                                    aria-label="@L.T("reader.signature.removeTitle")">
                                ✕
                            </button>
                            <div class="absolute -bottom-2 -right-2 w-5 h-5 rounded-full bg-pb-surface border border-pb-border text-xs text-pb-fg-muted hover:text-pb-accent flex items-center justify-center shadow cursor-nwse-resize"
                                 @onmousedown="@((MouseEventArgs e) => HandleSignatureResizeMouseDownAsync(e, signature))"
                                 @onmousedown:stopPropagation
                                 @onclick:stopPropagation
                                 title="@L.T("reader.signature.resizeTitle")"
                                 aria-label="@L.T("reader.signature.resizeAria")">
                                ↘
                            </div>
                        </div>
                    }

                    @* Freitexte + Datum-Stempel (FA — Text auf der Seite wie im Edge-Reader).
                       Drag verschiebt (JS-Bridge), Klick ohne Bewegung öffnet den Editor. *@
                    @foreach (var txt in FreeTextsOnCurrentPage)
                    {
                        var freeText = txt;
                        // F-11: Wird genau dieser Text gerade editiert, zeigt sein Div den
                        // Pending-Stil live (ohne Persistierung); sonst den gespeicherten.
                        var isThisEditing = _editingFreeText is not null && _editingFreeText.Id.Value == freeText.Id.Value;
                        var txtLeft = (FreeTextAnnotation.GetX(freeText) * 100).ToString("F3", CultureInfo.InvariantCulture);
                        var txtTop = (FreeTextAnnotation.GetY(freeText) * 100).ToString("F3", CultureInfo.InvariantCulture);
                        var txtFontCqh = ((isThisEditing ? _editingFreeTextFontSize : FreeTextAnnotation.GetFontSize(freeText)) * 100).ToString("F3", CultureInfo.InvariantCulture);
                        var txtColor = isThisEditing ? _editingFreeTextColor : FreeTextAnnotation.GetColor(freeText);
                        var txtContent = FreeTextAnnotation.GetText(freeText);
                        @* F-10: Gespeicherte Freitexte sind nie leer (leere werden nicht
                           persistiert), daher kein Platzhalter-/Geisterbox-Zweig mehr. *@
                        <div data-pb-freetext-id="@freeText.Id.Value"
                             class="absolute cursor-move select-none touch-none whitespace-pre leading-tight rounded px-0.5 hover:outline-dashed hover:outline-1 hover:outline-pb-accent/50"
                             style="@($"left:{txtLeft}%; top:{txtTop}%; font-size:{txtFontCqh}cqh; color:{txtColor}")"
                             title="@L.T("reader.text.dragTitle")"
                             @onmousedown="@((MouseEventArgs e) => HandleFreeTextMouseDownAsync(e, freeText))"
                             @onmousedown:stopPropagation
                             @onclick:stopPropagation>@txtContent</div>
                    }

                    @* Editor-Popover für den aktuell bearbeiteten ODER neu platzierten
                       (Pending, noch nicht persistierten) Freitext. *@
                    @if (IsFreeTextEditorOpen
                         && (_editingFreeText?.PageNumber ?? _pendingFreeTextPosition!.Value.Page) == _currentPage)
                    {
                        var ftX = _editingFreeText is not null ? FreeTextAnnotation.GetX(_editingFreeText) : _pendingFreeTextPosition!.Value.X;
                        var ftY = _editingFreeText is not null ? FreeTextAnnotation.GetY(_editingFreeText) : _pendingFreeTextPosition!.Value.Y;
                        var ftPlacement = ComputePopoverPlacement(ftX, ftY);
                        @* F-17: Popover als eigene Komponente — Tastenanschläge re-rendern
                           nur die Komponente (Content-Sync via plain Action, kein Parent-
                           Re-Render). Verhalten sonst unverändert. *@
                        <FreeTextEditorPopover Content="@_editingFreeTextContent"
                                               OnContentInput="@(v => _editingFreeTextContent = v)"
                                               FontSize="@_editingFreeTextFontSize"
                                               Color="@_editingFreeTextColor"
                                               Page="@_currentPage"
                                               Left="@ftPlacement.Left"
                                               Top="@ftPlacement.Top"
                                               Transform="@ftPlacement.Transform"
                                               Sizes="@FreeTextSizes"
                                               Palette="@DrawPalette"
                                               OnStyleChanged="@(args => SetFreeTextStyle(args.FontSize, args.Color))"
                                               OnSave="@SaveEditingFreeTextAsync"
                                               OnDelete="@DeleteEditingFreeTextAsync"
                                               OnCancel="@CancelFreeTextEditing" />
                    }

                    @* Editor-Popover für die Inline-Text-Bearbeitung („Text bearbeiten").
                       Wiederverwendung der Freitext-Editor-Komponente, aber gegen den
                       Pending-Edit-State gebunden (eigener Save/Cancel-Pfad). *@
                    @if (IsTextEditorOpen && _pendingEdit!.Page == _currentPage)
                    {
                        var edPlacement = ComputePopoverPlacement(_pendingEdit.X, _pendingEdit.Y);
                        <FreeTextEditorPopover Content="@_pendingEditContent"
                                               OnContentInput="@(v => _pendingEditContent = v)"
                                               FontSize="@_pendingEditFontSize"
                                               Color="@_pendingEditColor"
                                               Page="@_currentPage"
                                               Left="@edPlacement.Left"
                                               Top="@edPlacement.Top"
                                               Transform="@edPlacement.Transform"
                                               Sizes="@FreeTextSizes"
                                               Palette="@DrawPalette"
                                               OnStyleChanged="@(args => SetPendingEditStyle(args.FontSize, args.Color))"
                                               OnSave="@CommitPendingEdit"
                                               OnDelete="@CancelPendingEdit"
                                               OnCancel="@CancelPendingEdit" />
                    }

                    @* Pins für alle Sticky Notes auf der aktuellen Seite *@
                    @foreach (var note in StickyNotesOnCurrentPage)
                    {
                        var n = note;
                        var leftPct = (StickyNoteAnnotation.GetX(n) * 100).ToString("F2", CultureInfo.InvariantCulture);
                        var topPct = (StickyNoteAnnotation.GetY(n) * 100).ToString("F2", CultureInfo.InvariantCulture);
                        var color = StickyNoteAnnotation.GetColor(n);
                        var preview = StickyNoteAnnotation.GetContent(n);
                        var previewText = string.IsNullOrWhiteSpace(preview) ? L.T("common.empty") : preview;
                        <button type="button"
                                class="absolute -translate-x-1/2 -translate-y-1/2 rounded-full border border-pb-border shadow-md w-7 h-7 flex items-center justify-center text-xs hover:scale-110 transition-transform"
                                style="@($"left:{leftPct}%; top:{topPct}%; background-color:{color}")"
                                title="@previewText"
                                aria-label="@L.T("reader.note.pinAria", new Dictionary<string, object> { ["page"] = n.PageNumber, ["preview"] = previewText })"
                                @onclick="@(() => OpenEditor(n))"
                                @onclick:stopPropagation>
                            <Icon Name="note" />
                        </button>
                    }

                    @* Editor-Popover für aktuelle Notiz *@
                    @if (_editingAnnotation is not null && _editingAnnotation.PageNumber == _currentPage)
                    {
                        var noteX = StickyNoteAnnotation.GetX(_editingAnnotation);
                        var noteY = StickyNoteAnnotation.GetY(_editingAnnotation);
                        // Pin sitzt rechts → Popover nach links flippen, damit es nicht
                        // überhängt; Pin sitzt unten → nach oben flippen (F-16 Helper).
                        var notePlacement = ComputePopoverPlacement(noteX, noteY);
                        <div class="absolute z-10 w-80 rounded-lg pb-glass-strong p-3"
                             style="@($"left:{notePlacement.Left}%; top:{notePlacement.Top}%; transform: {notePlacement.Transform}")"
                             @onclick:stopPropagation>
                            <div class="flex items-center justify-between mb-2 gap-2">
                                <span class="text-xs text-pb-fg-muted">@L.T("reader.note.contextLabel", new Dictionary<string, object> { ["page"] = _editingAnnotation.PageNumber })</span>
                                <div class="flex items-center gap-1">
                                    <button type="button"
                                            class="text-xs text-pb-fg-muted hover:text-pb-fg rounded border border-pb-border px-1.5 py-0.5"
                                            @onclick="ToggleEditorPreview"
                                            title="@(_editorPreviewMode ? L.T("reader.note.toEditTitle") : L.T("reader.note.toPreviewTitle"))">
                                        @(_editorPreviewMode ? L.T("reader.note.edit") : L.T("reader.note.preview"))
                                    </button>
                                    <button type="button"
                                            class="text-pb-fg-muted hover:text-pb-fg text-sm"
                                            @onclick="CancelEditing"
                                            aria-label="@L.T("common.close")">
                                        ✕
                                    </button>
                                </div>
                            </div>

                            @if (_editorPreviewMode)
                            {
                                @if (string.IsNullOrWhiteSpace(_editingContent))
                                {
                                    <p class="h-28 rounded border border-pb-border bg-pb-bg px-2 py-1 text-sm text-pb-fg-muted italic">
                                        @L.T("reader.note.emptyPreview")
                                    </p>
                                }
                                else
                                {
                                    <div class="pb-markdown h-28 overflow-y-auto rounded border border-pb-border bg-pb-bg px-2 py-1 text-sm">
                                        @RenderMarkdown(_editingContent)
                                    </div>
                                }
                            }
                            else
                            {
                                <textarea @bind="_editingContent"
                                          @bind:event="oninput"
                                          class="w-full h-28 rounded border border-pb-border bg-pb-bg px-2 py-1 text-sm resize-none font-mono"
                                          placeholder="@L.T("reader.note.placeholder")"
                                          aria-label="@L.T("reader.note.contentAria")"></textarea>
                            }
                            <div class="mt-2 flex gap-2 justify-end">
                                <button type="button"
                                        class="rounded border border-red-300/40 px-2 py-1 text-xs text-red-400 hover:bg-red-50/10"
                                        @onclick="DeleteEditingAnnotationAsync">
                                    @L.T("common.delete")
                                </button>
                                <button type="button"
                                        class="btn primary sm"
                                        @onclick="SaveEditingAnnotationAsync">
                                    @L.T("common.save")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-sm text-pb-fg-muted py-12">@L.T("common.renderingProgress")</div>
            }
        </figure>
        }

        </div> @* /flex-Wrapper Outline+PDF *@

        @* Seitennavigation als Sticky-Bottom-Bar (F-21): klebt beim Scrollen am
           unteren Rand des Reader-Bereichs. Editierbares Seitenfeld springt via
           GoToPageAsync; ungültige/aus-dem-Bereich-Eingaben werden geklemmt. *@
        <nav class="sticky bottom-0 z-30 max-w-4xl mx-auto mt-6 flex items-center justify-center gap-3 rounded-t-lg border-t border-pb-border pb-glass-strong px-4 py-2"
             aria-label="@L.T("reader.pageNav")">
            <button type="button"
                    class="rounded border pb-toolbtn px-3 py-1 text-sm disabled:opacity-40"
                    disabled="@(_currentPage <= 1 || _isRendering)"
                    @onclick="PreviousPage">
                @L.T("reader.prev")
            </button>
            <span class="flex items-center gap-1.5 text-sm tabular-nums">
                <input type="number"
                       @key="_pageInputNonce"
                       min="1" max="@_handle.PageCount"
                       value="@_currentPage"
                       @onchange="GoToPageFromInputAsync"
                       disabled="@_isRendering"
                       class="w-16 rounded border border-pb-border bg-pb-bg px-2 py-1 text-sm text-center tabular-nums"
                       aria-label="@L.T("reader.pageInput.aria")" />
                <span class="text-pb-fg-muted">@L.T("reader.pageOfTotal", new Dictionary<string, object> { ["total"] = _handle.PageCount })</span>
            </span>
            <button type="button"
                    class="rounded border pb-toolbtn px-3 py-1 text-sm disabled:opacity-40"
                    disabled="@(_currentPage >= _handle.PageCount || _isRendering)"
                    @onclick="NextPage">
                @L.T("reader.next")
            </button>
        </nav>

        <p class="max-w-4xl mx-auto mt-4 text-xs text-pb-fg-muted">
            @L.T("reader.shortcuts.label")
            <kbd class="rounded border border-pb-border px-1.5 py-0.5">←</kbd>
            <kbd class="rounded border border-pb-border px-1.5 py-0.5">→</kbd>
            @L.T("reader.shortcuts.pageChange") ·
            <kbd class="rounded border border-pb-border px-1.5 py-0.5">Pos1</kbd>
            <kbd class="rounded border border-pb-border px-1.5 py-0.5">Ende</kbd>
            @L.T("reader.shortcuts.firstLast") ·
            <kbd class="rounded border border-pb-border px-1.5 py-0.5">Strg+F</kbd>
            @L.T("reader.shortcuts.search") ·
            <kbd class="rounded border border-pb-border px-1.5 py-0.5">Esc</kbd>
            @L.T("reader.shortcuts.reset") ·
            <kbd class="rounded border border-pb-border px-1.5 py-0.5">Strg+ +</kbd>
            <kbd class="rounded border border-pb-border px-1.5 py-0.5">Strg+ −</kbd>
            <kbd class="rounded border border-pb-border px-1.5 py-0.5">Strg+0</kbd>
            @L.T("reader.shortcuts.zoom")
        </p>
    }
    else if (!_isLoading)
    {
