    private async Task ExportSidecarAsync()
    {
        if (_currentPdfId is null || _handle is null || _isExportingSidecar) return;
        _isExportingSidecar = true;
        _sidecarStatus = null;
        try
        {
            var json = await BuildCurrentSidecarJsonAsync().ConfigureAwait(false);
            if (json is null) return;
            var sidecarFilename = BuildSidecarFilename(_currentFilename);
            await JS.InvokeVoidAsync(
                "pageboundShortcuts.downloadFile",
                sidecarFilename,
                json,
                "application/json");
        }
        catch (Exception ex)
        {
            _sidecarStatus = L.T("reader.sidecar.importError",
                new Dictionary<string, object> { ["message"] = ex.Message });
            _sidecarStatusIsError = true;
        }
        finally
        {
            _isExportingSidecar = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Baut das Sidecar-JSON für die aktuell offene PDF (Annotationen + Meta).
    /// Gemeinsam genutzt von Download-Export und Workspace-Speichern. Null, wenn
    /// keine PDF offen ist.
    /// </summary>
    private async Task<string?> BuildCurrentSidecarJsonAsync()
    {
        if (_currentPdfId is null || _handle is null) return null;
        var meta = new PdfMeta(
            Filename: _currentFilename ?? "document.pdf",
            FileHashSha256: _currentPdfId.Value.Value,
            FileSize: _originalPdfBytes?.LongLength ?? 0,
            PageCount: _handle.PageCount);
        var template = await Sidecar.CreateNewAsync(_currentFilename ?? string.Empty, meta, CancellationToken.None)
            .ConfigureAwait(false);
        var withAnnotations = template with
        {
            UpdatedAt = DateTimeOffset.UtcNow,
            Annotations = _annotations.ToList()
        };
        return await Sidecar.SerializeAsync(withAnnotations, CancellationToken.None).ConfigureAwait(false);
    }

    /// <summary>FA-072: das aktuelle Sidecar in den zentralen Workspace schreiben.</summary>
    private async Task SaveToWorkspaceAsync()
    {
        if (_currentPdfId is null || _isSavingToWorkspace) return;
        _isSavingToWorkspace = true;
        _sidecarStatus = null;
        try
        {
            var json = await BuildCurrentSidecarJsonAsync().ConfigureAwait(false);
            if (json is null) return;
            var ok = await Workspace.SaveSidecarAsync(_currentPdfId.Value.Value, json, CancellationToken.None)
                .ConfigureAwait(false);
            _sidecarStatus = ok
                ? L.T("reader.workspace.saved", new Dictionary<string, object> { ["folder"] = _workspaceName ?? "" })
                : L.T("reader.workspace.saveFailed");
            _sidecarStatusIsError = !ok;
        }
        catch (Exception ex)
        {
            _sidecarStatus = L.T("reader.sidecar.importError",
                new Dictionary<string, object> { ["message"] = ex.Message });
            _sidecarStatusIsError = true;
        }
        finally
        {
            _isSavingToWorkspace = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Parst ein Sidecar-JSON und führt dessen Annotationen zusammen — überspringt
    /// solche, deren Id bereits vorhanden ist, sodass das Workspace-Auto-Load beim
    /// Wieder-Öffnen keine Duplikate erzeugt. Gibt die Anzahl neu übernommener
    /// Annotationen zurück.
    /// </summary>
    private async Task<int> MergeSidecarJsonAsync(string json)
    {
        if (_currentPdfId is null || string.IsNullOrWhiteSpace(json)) return 0;
        await using var ms = new MemoryStream(System.Text.Encoding.UTF8.GetBytes(json));
        var parsed = await Sidecar.ParseAsync(ms, CancellationToken.None).ConfigureAwait(false);
        if (parsed.Sidecar is null) return 0;
        var migration = await Sidecar.MigrateAsync(parsed.Sidecar, CancellationToken.None).ConfigureAwait(false);
        var sidecar = migration.Result;
        var pdfId = _currentPdfId.Value;
        var existingIds = _annotations.Select(a => a.Id.Value).ToHashSet();
        var added = new List<Annotation>();
        foreach (var imported in sidecar.Annotations)
        {
            if (existingIds.Contains(imported.Id.Value)) continue;
            var fresh = await Annotations.CreateAsync(
                new NewAnnotation(pdfId, imported.Type, imported.PageNumber, imported.Payload),
                CancellationToken.None).ConfigureAwait(false);
            added.Add(fresh);
        }
        if (added.Count > 0) _annotations = _annotations.Concat(added).ToList();
        return added.Count;
    }

    private static string BuildSidecarFilename(string? pdfFilename)
    {
        var baseName = string.IsNullOrWhiteSpace(pdfFilename) ? "document" : pdfFilename;
        if (baseName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            baseName = baseName.Substring(0, baseName.Length - 4);
        }
        // Defensive: gleicher Safe-Zeichensatz wie beim Markdown-Export.
        var safeBase = string.Concat(baseName.Select(c =>
            char.IsLetterOrDigit(c) || c is '_' or '-' or '.' or ' ' ? c : '_'));
        return $"{safeBase}.pagebound.json";
    }

    private async Task HandleSidecarFileSelectedAsync(InputFileChangeEventArgs e)
    {
        if (_currentPdfId is null) return;
        var file = e.File;
        if (file is null) return;
        _sidecarStatus = null;

        try
        {
            const long maxBytes = 50L * 1024 * 1024; // 50 MB hardcap für JSON
            await using var stream = file.OpenReadStream(maxBytes);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms).ConfigureAwait(false);
            ms.Position = 0;

            var parsed = await Sidecar.ParseAsync(ms, CancellationToken.None).ConfigureAwait(false);
            if (parsed.Sidecar is null)
            {
                _sidecarStatus = L.T("reader.sidecar.importError",
                    new Dictionary<string, object> { ["message"] = "JSON nicht parsebar oder kein Sidecar-Format" });
                _sidecarStatusIsError = true;
                return;
            }

            var migration = await Sidecar.MigrateAsync(parsed.Sidecar, CancellationToken.None).ConfigureAwait(false);
            var sidecar = migration.Result;

            // Hash-Mismatch macht den Import nicht ungültig (User könnte z.B.
            // dieselbe PDF nur leicht modifiziert haben), aber wir warnen
            // sichtbar in der Status-Box.
            var wrongPdf = !string.Equals(
                sidecar.PdfMeta.FileHashSha256,
                _currentPdfId.Value.Value,
                StringComparison.OrdinalIgnoreCase);

            var pdfId = _currentPdfId.Value;
            var existingIds = _annotations.Select(a => a.Id.Value).ToHashSet();
            var newAnnotations = new List<Annotation>();
            foreach (var imported in sidecar.Annotations)
            {
                // Sidecar-Annotation gehört eigentlich zu einer anderen pdfId.
                // Wir nehmen Type/Page/Payload und erzeugen darauf eine frische
                // Annotation im AnnotationService (frische Id, korrekte pdfId,
                // sofortige Persistenz via IndexedDB).
                if (existingIds.Contains(imported.Id.Value)) continue;
                var fresh = await Annotations.CreateAsync(
                    new NewAnnotation(pdfId, imported.Type, imported.PageNumber, imported.Payload),
                    CancellationToken.None).ConfigureAwait(false);
                newAnnotations.Add(fresh);
            }
            _annotations = _annotations.Concat(newAnnotations).ToList();

            _sidecarStatus = wrongPdf
                ? $"{L.T("reader.sidecar.wrongPdf")} — {L.T("reader.sidecar.imported", new Dictionary<string, object> { ["added"] = newAnnotations.Count, ["filename"] = file.Name })}"
                : L.T("reader.sidecar.imported",
                    new Dictionary<string, object> { ["added"] = newAnnotations.Count, ["filename"] = file.Name });
            _sidecarStatusIsError = wrongPdf;

            // F-07: Annotationen aus einer neueren App-Version (unbekannter Typ)
            // wurden übernommen, können hier aber nicht angezeigt werden → sichtbar
            // warnen, statt sie still zu verschlucken.
            if (parsed.HasUnknownAnnotations)
            {
                _sidecarStatus += " " + L.T("reader.sidecar.unknownTypes",
                    new Dictionary<string, object> { ["count"] = parsed.UnknownAnnotationCount });
                _sidecarStatusIsError = true;
            }
        }
        catch (Exception ex)
        {
            _sidecarStatus = L.T("reader.sidecar.importError",
                new Dictionary<string, object> { ["message"] = ex.Message });
            _sidecarStatusIsError = true;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    // --- Text-Highlight (FA-010 + FA-018 Inline-Toolbar) --------------------

    private async Task HandleCanvasMouseUpAsync(MouseEventArgs e)
    {
        // Im Sticky-Note-Modus übernimmt der img-Click-Handler;
        // außerdem wollen wir keine Selection-Toolbar, wenn der Editor offen ist.
        if (_annotationMode != AnnotationMode.Select) return;
        if (_editingAnnotation is not null) return;
        if (_currentPdfId is null) return;

        var selection = await JS.InvokeAsync<SelectionDto?>(
            "pageboundShortcuts.getCurrentTextSelection",
            PageCanvasSelector);

        if (selection is null || selection.Rects.Count == 0 || string.IsNullOrWhiteSpace(selection.Text))
        {
            _pendingSelection = null;
            return;
        }
        _pendingSelection = selection;
    }

    private async Task HighlightPendingSelectionAsync(string color)
    {
        if (_pendingSelection is null) return;
        if (_currentPdfId is null) return;

        var newAnnotation = HighlightAnnotation.Create(
            _currentPdfId.Value,
            _currentPage,
            _pendingSelection.Rects,
            _pendingSelection.Text,
            color);

        var saved = await Annotations.CreateAsync(newAnnotation, CancellationToken.None);
        _annotations = _annotations.Append(saved).ToList();
        _pendingSelection = null;

        // Browser-Selection aufheben, damit die Toolbar sicher verschwindet
        // und der Highlight optisch im Vordergrund stehen kann.
        try
        {
            await JS.InvokeVoidAsync("pageboundShortcuts.clearSelection");
        }
        catch (JSException)
        {
            // Ignorieren, harmlose Edge-Case bei sehr früher Tab-Disposal.
        }

        await RecomputeSignatureStatusesAsync();
    }

    private void DismissSelection()
    {
        _pendingSelection = null;
    }

    private void OpenHighlightEditor(Annotation highlight)
    {
        _editingHighlight = highlight;
    }

    private void CancelHighlightEditing()
    {
        _editingHighlight = null;
    }

    private async Task ChangeHighlightColorAsync(string color)
    {
        if (_editingHighlight is null) return;
        var updated = HighlightAnnotation.WithColor(_editingHighlight, color);
        var saved = await Annotations.UpdateAsync(updated, CancellationToken.None);
        ReplaceAnnotation(saved);
        _editingHighlight = saved;
    }

    private async Task DeleteEditingHighlightAsync()
    {
        if (_editingHighlight is null) return;
        var id = _editingHighlight.Id;
        await Annotations.DeleteAsync(id, CancellationToken.None);
        RemoveAnnotation(id);
        _editingHighlight = null;
        await RecomputeSignatureStatusesAsync();
    }

    // --- Tastatur-Shortcuts -------------------------------------------------

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!_shortcutsRegistered)
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                try
                {
                    await JS.InvokeVoidAsync($"{ShortcutsJs}.register", _dotNetRef);
                    _shortcutsRegistered = true;
                }
                catch (JSException)
                {
                    // shortcuts-bridge.js noch nicht geparsed — bei einem späteren
                    // Render-Zyklus erneut versuchen.
                    _dotNetRef.Dispose();
                    _dotNetRef = null;
                }
            }

            await LoadSignerFromStorageAsync();
            StateHasChanged();
        }

        // Drawing-Capture (FA-013/014): Page-Wechsel rendert das Canvas neu —
        // unsere pointer-Listener leben aber auf dem alten DOM-Element. Wenn ein
        // Zeichenmodus aktiv ist und die Page wechselte, JS-Capture neu attachen.
        if (IsDrawingMode(_annotationMode) && _captureAttachedToPage != _currentPage)
        {
            await SyncDrawingCaptureAsync();
        }
    }

    [JSInvokable]
    public async Task HandleShortcut(string shortcut)
    {
        switch (shortcut)
        {
            case "page-prev":
                await PreviousPage();
                break;
            case "page-next":
                await NextPage();
                break;
            case "page-first":
                if (_handle is not null) await GoToPageAsync(1);
                break;
            case "page-last":
                if (_handle is not null) await GoToPageAsync(_handle.PageCount);
                break;
            case "focus-search":
                if (_handle is not null)
                {
                    await JS.InvokeVoidAsync($"{ShortcutsJs}.focusElement", SearchInputSelector);
                }
                break;
            case "clear-search":
                if (_pendingSelection is not null)
                {
                    _pendingSelection = null;
                }
                else if (_editingHighlight is not null)
                {
                    _editingHighlight = null;
                }
                else if (_searchHits is not null || !string.IsNullOrEmpty(_searchQuery))
                {
                    ClearSearchState();
                }
                break;
            case "zoom-in":
                await StepZoom(+1);
                break;
            case "zoom-out":
                await StepZoom(-1);
                break;
            case "zoom-reset":
                await SetZoom(1.0);
                break;
        }

        // Blazor rendert nach JSInvokable-Methoden nicht automatisch — wir
        // triggern einen Re-Render, damit UI-Zustand sichtbar wird.
        await InvokeAsync(StateHasChanged);
    }

    private async Task StepZoom(int direction)
    {
        var currentIdx = Array.FindIndex(_zoomLevels, z => Math.Abs(z - _zoomFactor) < 0.001);
        if (currentIdx < 0)
        {
            // Aktueller Faktor liegt nicht auf einer Stufe → finde nächstgelegene.
            currentIdx = Array.FindIndex(_zoomLevels, z => z >= _zoomFactor);
            if (currentIdx < 0) currentIdx = _zoomLevels.Length - 1;
        }
        var nextIdx = Math.Clamp(currentIdx + direction, 0, _zoomLevels.Length - 1);
        if (nextIdx == currentIdx) return;
        await SetZoom(_zoomLevels[nextIdx]);
    }

    public async ValueTask DisposeAsync()
    {
        if (_shortcutsRegistered)
        {
            try
            {
                await JS.InvokeVoidAsync($"{ShortcutsJs}.unregister");
            }
            catch (JSDisconnectedException)
            {
                // Browser-Circuit ist weg, ignorieren.
            }
            catch (JSException)
            {
                // Bridge möglicherweise nicht mehr geladen.
            }
            _shortcutsRegistered = false;
        }
        _dotNetRef?.Dispose();
        _dotNetRef = null;

        if (_handle is not null)
        {
            try
            {
                await Renderer.UnloadAsync(_handle);
            }
            catch
            {
                // Page wird entladen; ignoriere Cleanup-Fehler.
            }
            _handle = null;
        }
    }
}
