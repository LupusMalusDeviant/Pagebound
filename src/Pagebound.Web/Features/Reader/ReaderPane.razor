    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        _isLoading = true;
        _rasterDataUrl = null;
        ClearSearchState();
        ResetAnnotationState();

        try
        {
            await using var stream = e.File.OpenReadStream(MaxFileSize);
            await using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            await LoadPdfBytesAsync(buffer.ToArray(), e.File.Name).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            _errorMessage = $"PDF konnte nicht geöffnet werden: {ex.Message}";
            _handle = null;
            ResetAnnotationState();
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Lädt eine PDF aus rohen Bytes — entweder direkt aus einem File-Picker
    /// (HandleFileSelected) oder beim Auto-Open via Library-Klick + IndexedDB-
    /// gespeicherten Bytes. Persistiert die Bytes für späteres One-Click-
    /// Wiederöffnen (FA-060), wenn die Datei kleiner als <see cref="MaxPersistBytes"/>
    /// ist; sehr große PDFs würden sonst die IndexedDB-Quota sprengen.
    /// </summary>
    private async Task LoadPdfBytesAsync(byte[] bytes, string filename, string? tempHandleId = null)
    {
        if (_handle is not null)
        {
            await Renderer.UnloadAsync(_handle).ConfigureAwait(false);
            _handle = null;
        }

        _currentFilename = filename;
        _originalPdfBytes = bytes;

        await using var buffer = new MemoryStream(bytes, writable: false);
        var hash = await Hasher.ComputeAsync(buffer, HashAlgorithm.Sha256, CancellationToken.None).ConfigureAwait(false);
        buffer.Position = 0;
        _currentPdfId = PdfId.FromHash(hash);
        _handle = await Renderer.LoadAsync(buffer, new LoadOptions(), CancellationToken.None).ConfigureAwait(false);
        _currentPage = 1;
        _redactions.Clear();
        _edits.Clear();
        _pendingEdit = null;
        StopTts();
        _continuous = false;
        _continuousPages.Clear();
        _continuousRenderedCount = 0;
        _annotations = await Annotations.GetForDocumentAsync(_currentPdfId.Value, CancellationToken.None).ConfigureAwait(false);

        // FA-072/073: Wenn ein zentraler Sidecar-Workspace gesetzt ist, dort nach
        // einem Sidecar für diesen Hash suchen und neue (noch nicht in IndexedDB
        // vorhandene) Annotationen zusammenführen — so synchronisiert der Ordner
        // Annotationen zwischen Geräten/Browsern.
        _workspaceName = await Workspace.GetWorkspaceNameAsync(CancellationToken.None).ConfigureAwait(false);
        if (_workspaceName is not null)
        {
            try
            {
                var wsJson = await Workspace.LoadSidecarAsync(hash, CancellationToken.None).ConfigureAwait(false);
                if (!string.IsNullOrWhiteSpace(wsJson))
                {
                    var added = await MergeSidecarJsonAsync(wsJson!).ConfigureAwait(false);
                    if (added > 0)
                    {
                        _sidecarStatus = L.T("reader.workspace.autoloaded",
                            new Dictionary<string, object> { ["added"] = added, ["folder"] = _workspaceName });
                        _sidecarStatusIsError = false;
                    }
                }
            }
            catch
            {
                // Best-effort — Workspace-Probleme dürfen das Öffnen nicht blockieren.
            }
        }
        await RecomputeSignatureStatusesAsync().ConfigureAwait(false);

        // FA-060: Library-Tracking + Persistenz der Bytes für späteres One-Click-Open.
        try
        {
            var pdfMeta = new PdfMeta(
                Filename: filename,
                FileHashSha256: hash,
                FileSize: bytes.LongLength,
                PageCount: _handle.PageCount);
            var existing = await Library.FindByHashAsync(hash, CancellationToken.None).ConfigureAwait(false);
            var entry = existing is null
                ? new LibraryEntry(
                    Id: LibraryEntryId.NewId(),
                    PdfPath: filename,
                    Title: _handle.Title ?? filename,
                    Author: null,
                    Tags: Array.Empty<string>(),
                    Rating: null,
                    AddedAt: DateTimeOffset.UtcNow,
                    LastOpenedAt: DateTimeOffset.UtcNow,
                    Progress: new ReadingProgress(1, DateTimeOffset.UtcNow),
                    PdfMeta: pdfMeta)
                : existing with
                {
                    LastOpenedAt = DateTimeOffset.UtcNow,
                    PdfMeta = pdfMeta
                };
            await Library.AddOrUpdateAsync(entry, CancellationToken.None).ConfigureAwait(false);

            if (bytes.LongLength <= MaxPersistBytes)
            {
                await Storage.SetBytesAsync(PdfBytesKeyFor(hash), bytes, CancellationToken.None).ConfigureAwait(false);
            }

            // File-System-Access-API: Wenn der initiale Pick ein Handle
            // mitgeliefert hat, jetzt unter dem PDF-Hash persistieren. Ab dann
            // kann der Library-Klick die Datei via Permission-Dialog
            // reaktivieren statt über den Bytes-Cache zu gehen — auch wenn
            // die PDF gar nicht oder nicht mehr im Cache liegt.
            if (!string.IsNullOrEmpty(tempHandleId))
            {
                try
                {
                    await Files.PersistHandleAsync(tempHandleId, hash, CancellationToken.None).ConfigureAwait(false);
                }
                catch
                {
                    // Best-effort — beim nächsten Open wird notfalls neu gepickt.
                }
            }
        }
        catch
        {
            // Tracking + Persistenz sind beide non-essential; Fehler schlucken wir leise.
        }
        try
        {
            _outline = await Renderer.GetOutlineAsync(_handle, CancellationToken.None).ConfigureAwait(false);
        }
        catch
        {
            _outline = null;
        }
        _outlineOpen = _outline is not null;

        // AcroForm-Felder erkennen (FA-040). Fehlt ein Formular oder schlägt das
        // Lesen fehl, bleibt der Formular-Toggle einfach ausgeblendet.
        try
        {
            await using var formStream = new MemoryStream(bytes, writable: false);
            SetFormFields(await FormService.GetFieldsAsync(formStream, CancellationToken.None).ConfigureAwait(false));
        }
        catch
        {
            SetFormFields(Array.Empty<PdfFormField>());
        }
        await RenderCurrentPageAsync().ConfigureAwait(false);
    }

    /// <summary>Öffnet PDF-Bytes direkt im Pane (z. B. ein Werkzeug-Ergebnis aus
    /// dem „Werkzeuge"-Tab — UI-Konsolidierung: Ergebnis zurück in den Reader).</summary>
    public async Task OpenBytesAsync(byte[] bytes, string filename)
    {
        _errorMessage = null;
        _isLoading = true;
        ClearSearchState();
        ResetAnnotationState();
        try
        {
            await LoadPdfBytesAsync(bytes, filename).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Öffnen fehlgeschlagen: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
    }

    /// <summary>
    /// Versucht, eine PDF anhand ihres SHA-256-Hashes aus der IndexedDB-
    /// Persistenz zu laden. Gibt <c>true</c> zurück, wenn die Bytes da waren
    /// und erfolgreich geladen wurden — sonst <c>false</c> (z.B. nie gespeichert,
    /// zu groß gewesen, Storage gelöscht). Der Aufrufer muss dann den File-
    /// Picker anzeigen.
    /// </summary>
    public async Task<bool> TryAutoOpenByHashAsync(string hash)
    {
        if (string.IsNullOrWhiteSpace(hash)) return false;
        _errorMessage = null;
        _isLoading = true;
        ClearSearchState();
        ResetAnnotationState();
        try
        {
            // 1) File-System-Access-API: gespeichertes Handle reaktivieren —
            //    der User bekommt höchstens einen Permission-Dialog, keinen
            //    weiteren File-Picker. Funktioniert nur in Chromium.
            var reopened = await Files.TryReopenAsync(hash, CancellationToken.None).ConfigureAwait(false);
            if (reopened is not null)
            {
                await LoadPdfBytesAsync(reopened.Bytes, reopened.Filename).ConfigureAwait(false);
                return true;
            }

            // 2) Bytes-Cache aus IndexedDB (alle Browser, Cap 100 MB).
            var bytes = await Storage.GetBytesAsync(PdfBytesKeyFor(hash), CancellationToken.None).ConfigureAwait(false);
            if (bytes is null || bytes.Length == 0) return false;

            var entry = await Library.FindByHashAsync(hash, CancellationToken.None).ConfigureAwait(false);
            var filename = entry?.PdfMeta?.Filename
                ?? entry?.Title
                ?? "document.pdf";

            await LoadPdfBytesAsync(bytes, filename).ConfigureAwait(false);
            return true;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Auto-Open fehlgeschlagen: {ex.Message}";
            return false;
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
    }

    private const long MaxPersistBytes = 100L * 1024 * 1024; // 100 MB Cap pro PDF
    private static string PdfBytesKeyFor(string hash) => $"pdf:bytes:{hash}";

    // File-System-Access-API (Chromium). Im Pane gecached, damit die Markup-
    // Variante (Button vs InputFile) nicht jedes Re-Render einen JS-Roundtrip
    // braucht.
    private bool _fsaSupported;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _fsaSupported = await Files.IsSupportedAsync(CancellationToken.None).ConfigureAwait(false);
        }
        catch
        {
            _fsaSupported = false;
        }
    }

    /// <summary>
    /// Klick-Handler für den FSA-Open-Button. Lädt die gewählte PDF in den
    /// Reader und persistiert das File-Handle unter ihrem SHA-256-Hash —
    /// damit kann ein späterer Library-Klick die Datei ohne weiteren Picker
    /// wieder öffnen.
    /// </summary>
    private async Task PickPdfViaFsaAsync()
    {
        _errorMessage = null;
        _isLoading = true;
        _rasterDataUrl = null;
        ClearSearchState();
        ResetAnnotationState();
        try
        {
            var picked = await Files.PickPdfAsync(CancellationToken.None).ConfigureAwait(false);
            if (picked is null) return; // User-canceled
            await LoadPdfBytesAsync(picked.Bytes, picked.Filename, picked.TempHandleId).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            _errorMessage = $"PDF konnte nicht geöffnet werden: {ex.Message}";
            _handle = null;
            ResetAnnotationState();
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
    }

    private void ResetAnnotationState()
    {
        _annotations = Array.Empty<Annotation>();
        _currentPdfId = null;
        _currentFilename = null;
        _isExporting = false;
        _annotationMode = AnnotationMode.Select;
        _redactions.Clear();
        _edits.Clear();
        _pendingEdit = null;
        StopTts();
        _continuous = false;
        _continuousPages.Clear();
        _continuousRenderedCount = 0;
        _editingAnnotation = null;
        _editingContent = string.Empty;
        _pageTextItems = Array.Empty<TextItem>();
        _renderedPage = null;
        _pendingSelection = null;
        _editingHighlight = null;
        _outline = null;
        _outlineOpen = false;
        _activeSignatureImage = null;
        _activeSignatureFilename = null;
        _signatureStatuses.Clear();
        _originalPdfBytes = null;
        _signerPanelOpen = false;
        _isSavingSignedPdf = false;
        _formFields = Array.Empty<PdfFormField>();
        _formValues.Clear();
        _formPanelOpen = false;
        _isFillingForm = false;
        _formStatus = null;
        _formStatusIsError = false;
        // Thumbnails (FA-007): laufendes Render abbrechen + Cache leeren,
        // damit das nächste Dokument bei Bedarf frische Thumbnails bekommt.
        _thumbnailsCts?.Cancel();
        _thumbnailsCts = null;
        _thumbnails = new Dictionary<int, string>();
        _thumbnailsProgress = 0;
        _thumbsOpen = false;
        // OCR-Status der Vorgänger-PDF nicht "vererben".
        _ocrStatus = null;
        _ocrStatusIsError = false;
        _isOcrRunning = false;
        _useOcrTextLayer = false;
    }

    // --- Formular / AcroForms (FA-040/041) --------------------------------

    /// <summary>Übernimmt frisch erkannte Felder und initialisiert die Editierwerte.</summary>
    private void SetFormFields(IReadOnlyList<PdfFormField> fields)
    {
        _formFields = fields;
        _formValues.Clear();
        foreach (var f in fields)
        {
            _formValues[f.Name] = f.Value.ToList();
        }
        _formPanelOpen = false;
        _formStatus = null;
        _formStatusIsError = false;
    }

    private string GetSingle(string name) =>
        _formValues.TryGetValue(name, out var v) && v.Count > 0 ? v[0] : string.Empty;

    private void SetSingle(string name, string? value) =>
        _formValues[name] = string.IsNullOrEmpty(value)
            ? new List<string>()
            : new List<string> { value };

    private bool IsChecked(string name) =>
        _formValues.TryGetValue(name, out var v) && v.Contains("true");

    private void SetChecked(string name, bool on) =>
        _formValues[name] = on ? new List<string> { "true" } : new List<string>();

    private IReadOnlyList<string> GetMulti(string name) =>
        _formValues.TryGetValue(name, out var v) ? v : Array.Empty<string>();

    private void SetMulti(string name, object? value)
    {
        var arr = value switch
        {
            string[] strings => strings,
            IEnumerable<string> en => en.ToArray(),
            _ => Array.Empty<string>()
        };
        _formValues[name] = arr.ToList();
    }

    private async Task JumpToFormFieldPage(PdfFormField field)
    {
        if (field.PageNumber >= 1 && _handle is not null && field.PageNumber <= _handle.PageCount)
        {
            await GoToPageAsync(field.PageNumber);
        }
    }

    /// <summary>
    /// Schreibt die editierten Werte zurück ins PDF (FA-041) und lädt das
    /// Ergebnis als <c>&lt;name&gt;.filled.pdf</c> herunter. ReadOnly-Felder
    /// werden nicht angefasst.
    /// </summary>
    private async Task SaveFilledFormAsync()
    {
        if (_originalPdfBytes is null || !HasFormFields || _isFillingForm) return;

        _isFillingForm = true;
        _formStatus = null;
        _formStatusIsError = false;
        try
        {
            var editable = _formFields.Where(f => !f.ReadOnly).Select(f => f.Name).ToHashSet();
            var values = _formValues
                .Where(kv => editable.Contains(kv.Key))
                .Select(kv => new FormFieldValue(kv.Key, kv.Value.ToArray()))
                .ToList();

            var options = new FillFormOptions(
                _formSaveFlatten ? FormSaveMode.Flatten : FormSaveMode.KeepEditable);

            await using var ms = new MemoryStream(_originalPdfBytes, writable: false);
            var filled = await FormService.FillAsync(ms, values, options, CancellationToken.None);

            var baseName = !string.IsNullOrWhiteSpace(_currentFilename)
                ? System.IO.Path.GetFileNameWithoutExtension(_currentFilename)
                : (_handle?.Title ?? "pagebound");
            var safeBase = string.Concat(baseName.Select(c =>
                char.IsLetterOrDigit(c) || c is '_' or '-' or '.' or ' ' ? c : '_'));
            var downloadName = $"{safeBase}.filled.pdf";

            await JS.InvokeVoidAsync(
                "pageboundShortcuts.downloadBytes",
                downloadName,
                Convert.ToBase64String(filled),
                "application/pdf");

            _formStatus = L.T("reader.form.saved", new Dictionary<string, object> { ["name"] = downloadName });
        }
        catch (Exception ex)
        {
            _formStatus = L.T("reader.form.saveError", new Dictionary<string, object> { ["error"] = ex.Message });
            _formStatusIsError = true;
        }
        finally
        {
            _isFillingForm = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // --- OCR (FA-050) -----------------------------------------------------

    private async Task RunOcrOnCurrentPageAsync()
    {
        if (_handle is null || _isOcrRunning) return;
        _isOcrRunning = true;
        _ocrStatus = null;
        try
        {
            // High-res Render speziell für OCR — die Display-Qualität (BaseScale ×
            // Zoom-Faktor) ist sonst stark vom User-Zoom abhängig; ein
            // konsistentes Scale 2.5 hält die Trefferquote stabil.
            var hiRes = await Renderer.RenderPageAsync(
                _handle,
                _currentPage,
                new RenderOptions(Scale: 2.5),
                CancellationToken.None).ConfigureAwait(false);
            if (hiRes.RasterBytes is null) return;

            var dataUrl = $"data:{hiRes.RasterFormat ?? "image/png"};base64,{Convert.ToBase64String(hiRes.RasterBytes)}";
            var result = await Ocr.RecognizePageAsync(dataUrl, OcrLanguages, CancellationToken.None).ConfigureAwait(false);

            var pageW = hiRes.PageWidthPt;
            var pageH = hiRes.PageHeightPt;
            // Bewusst die tatsächliche Render-Größe nehmen, nicht das
            // result.ImageWidth/Height aus der JS-Bridge — Tesseract liefert
            // dort nur die max-bbox über alle erkannten Wörter zurück, das
            // ist bei PDFs mit Rand systematisch zu klein und verschiebt
            // anschließend alle Mappings nach rechts/unten.
            double imgW = hiRes.WidthPx;
            double imgH = hiRes.HeightPx;

            if (imgW > 0 && imgH > 0 && result.Words.Count > 0)
            {
                // OCR-Bounding-Boxes in PDF-Punkte umrechnen — die Render-Skala
                // ist intern bekannt, aber das simple Verhältnis Bild ↔ Page
                // reicht, weil RenderPageAsync proportional skaliert.
                var scaleX = pageW / imgW;
                var scaleY = pageH / imgH;
                _pageTextItems = result.Words.Select(w => new TextItem(
                    w.Text,
                    w.X * scaleX,
                    w.Y * scaleY,
                    w.Width * scaleX,
                    w.Height * scaleY)).ToList();
                // Sobald wir Wörter haben, gilt die Seite als durchsuchbar —
                // die "kein Textlayer"-Box im Such-UI klappt damit zu.
                _pdfHasNoTextLayer = false;
                // Native PDF.js-TextLayer abräumen und den OCR-Pfad aktivieren:
                // OCR liefert Pixel-Bounding-Boxes, keinen TextContent-Stream,
                // also kann PDF.js' Layer-Klasse sie nicht rendern.
                _useOcrTextLayer = true;
                try
                {
                    await JS.InvokeVoidAsync("pageboundPdf.clearTextLayer", NativeTextLayerSelector);
                }
                catch
                {
                    // best-effort
                }
            }

            _ocrStatus = L.T("reader.ocr.success", new Dictionary<string, object>
            {
                ["count"] = result.Words.Count,
                ["confidence"] = result.Confidence.ToString("F0", CultureInfo.InvariantCulture)
            });
            _ocrStatusIsError = false;
        }
        catch (Exception ex)
        {
            _ocrStatus = L.T("reader.ocr.failed", new Dictionary<string, object> { ["message"] = ex.Message });
            _ocrStatusIsError = true;
        }
        finally
        {
            _isOcrRunning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleThumbsAsync()
    {
        if (_thumbsOpen)
        {
            _thumbsOpen = false;
            _thumbnailsCts?.Cancel();
            _thumbnailsCts = null;
            return;
        }

        _thumbsOpen = true;
        // Gegenseitig schließend mit Outline — beide Sidebars gleichzeitig
        // wäre auf dem 1280er-Layout zu eng. Wenn der User Outline aktiv hat,
        // klappt sie hier wegen.
        _outlineOpen = false;

        if (_handle is null) return;
        if (_thumbnails.Count >= _handle.PageCount) return;

        _thumbnailsCts = new CancellationTokenSource();
        await RenderThumbnailsAsync(_handle, _thumbnailsCts.Token).ConfigureAwait(false);
    }

    private async Task RenderThumbnailsAsync(PdfDocumentHandle handle, CancellationToken ct)
    {
        try
        {
            for (var i = 1; i <= handle.PageCount; i++)
            {
                ct.ThrowIfCancellationRequested();
                if (_thumbnails.ContainsKey(i))
                {
                    _thumbnailsProgress = i;
                    continue;
                }
                var rendered = await Renderer
                    .RenderPageAsync(handle, i, new RenderOptions(Scale: 0.35), ct)
                    .ConfigureAwait(false);
                if (rendered.RasterBytes is not null && rendered.RasterFormat is not null)
                {
                    _thumbnails[i] = $"data:{rendered.RasterFormat};base64,{Convert.ToBase64String(rendered.RasterBytes)}";
                }
                _thumbnailsProgress = i;
                await InvokeAsync(StateHasChanged);
                // Browser-Frame Zeit zum Atmen geben — sonst friert die UI ein,
                // wenn jemand bei einer 200-Seiten-PDF die Sidebar öffnet.
                await Task.Yield();
            }
        }
        catch (OperationCanceledException)
        {
            // Erwartet bei Datei-Wechsel oder Sidebar-Close.
        }
    }

    private async Task RenderCurrentPageAsync()
    {
        if (_handle is null) return;

        _isRendering = true;
        _pendingSelection = null;
        try
        {
            var rendered = await Renderer.RenderPageAsync(
                _handle,
                _currentPage,
                new RenderOptions(Scale: InternalScale),
                CancellationToken.None);

            _renderedPage = rendered;
            if (rendered.RasterBytes is not null && rendered.RasterFormat is not null)
            {
                _rasterDataUrl = $"data:{rendered.RasterFormat};base64,{Convert.ToBase64String(rendered.RasterBytes)}";
            }

            // Text-Layer nachladen: ohne ihn ist keine Text-Selection und damit
            // kein Highlighting möglich. Bei PDFs ohne Text-Layer (vektorisiert)
            // kommt ein leeres Array zurück und der Layer rendert einfach nichts.
            try
            {
                _pageTextItems = await Renderer.ExtractTextAsync(_handle, _currentPage, CancellationToken.None);
            }
            catch
            {
                _pageTextItems = Array.Empty<TextItem>();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Seite konnte nicht gerendert werden: {ex.Message}";
        }
        finally
        {
            _isRendering = false;
        }

        // StateHasChanged + await sorgt dafür, dass das neue Markup im DOM
        // liegt, bevor wir Layer-Manipulationen vornehmen.
        await InvokeAsync(StateHasChanged);

        if (_useOcrTextLayer)
        {
            // OCR-Pfad: Razor hat die <span>s schon gerendert; jetzt skaliert
            // der Helper sie pixel-genau auf ihre Ziel-Bounding-Box.
            try
            {
                await JS.InvokeVoidAsync("pageboundShortcuts.fixTextLayerScale", PageCanvasSelector);
            }
            catch
            {
                // Bridge nicht erreichbar — Spans bleiben ungeskaliert, Selection
                // funktioniert weiter, ist nur ein paar Pixel daneben.
            }
        }
        else if (_handle is not null)
        {
            // Native-Pfad: PDF.js' eigene TextLayer-Klasse rendert die Spans in
            // den Anker-Container. Das Result enthält die für die Suche
            // benötigten TextItems (in PDF-Punkten, mit ascent-korrigiertem Y).
            try
            {
                var items = await JS.InvokeAsync<TextItem[]>(
                    "pageboundPdf.renderTextLayerToContainer",
                    _handle.Id,
                    _currentPage,
                    NativeTextLayerSelector,
                    PdfImageSelector);
                if (items is not null)
                {
                    _pageTextItems = items;
                }
            }
            catch
            {
                // Bridge oder TextLayer nicht erreichbar — Selection ist dann
                // disabled, Suche funktioniert weiter über getTextContent.
            }
        }
    }

    private async Task PreviousPage()
    {
        if (_handle is null || _currentPage <= 1) return;
        _currentPage--;
        await RenderCurrentPageAsync();
    }

    private async Task NextPage()
    {
        if (_handle is null || _currentPage >= _handle.PageCount) return;
        _currentPage++;
        await RenderCurrentPageAsync();
    }

    private async Task SetZoom(double zoomFactor)
    {
        if (Math.Abs(_zoomFactor - zoomFactor) < 0.001) return;
        _zoomFactor = zoomFactor;
        await RenderCurrentPageAsync();
    }

    private async Task DoSearchAsync()
    {
        if (_handle is null) return;
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _searchHits = null;
            return;
        }

        _isSearching = true;
        _errorMessage = null;
        _pdfHasNoTextLayer = false;
        try
        {
            var options = new SearchOptions(MatchCase: _matchCase, WholeWord: _wholeWord);
            _searchHits = await Renderer.SearchAsync(_handle, _searchQuery, options, CancellationToken.None);
            _lastSearched = _searchQuery;

            // Wenn die Suche gar nichts gefunden hat, prüfen wir, ob das
            // überhaupt am PDF liegt: hat Seite 1 *irgendeinen* Text-Item?
            // Wenn nicht, ist die PDF vektorisiert (typisch für stilisierte
            // Designer-Layouts) — dafür braucht es OCR (FA-050 / Release 0.9).
            if (_searchHits.Count == 0)
            {
                var sample = await Renderer.ExtractTextAsync(_handle, 1, CancellationToken.None);
                _pdfHasNoTextLayer = sample.Count == 0;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Suche fehlgeschlagen: {ex.Message}";
            _searchHits = null;
        }
        finally
        {
            _isSearching = false;
        }
    }

    private void ClearSearch()
    {
        ClearSearchState();
    }

    private void ClearSearchState()
    {
        _searchHits = null;
        _searchQuery = string.Empty;
        _lastSearched = string.Empty;
        _pdfHasNoTextLayer = false;
    }

    private async Task GoToPageAsync(int pageNumber)
    {
        if (_handle is null) return;
        if (pageNumber < 1 || pageNumber > _handle.PageCount) return;
        if (pageNumber == _currentPage) return;
        _currentPage = pageNumber;
        await RenderCurrentPageAsync();
    }

    // F-21: Sprung aus dem editierbaren Seitenfeld (Enter oder Blur). Ungültige
    // oder aus-dem-Bereich liegende Eingaben (0, 999, Text) werden auf [1..Count]
    // geklemmt bzw. verworfen; das Nonce-Bump baut das Feld neu auf, sodass es die
    // gültige aktuelle Seite anzeigt.
    private async Task GoToPageFromInputAsync(ChangeEventArgs e)
    {
        if (_handle is null) return;
        _pageInputNonce++;
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var page))
        {
            await GoToPageAsync(Math.Clamp(page, 1, _handle.PageCount));
        }
    }

    // --- Annotations (Sticky Notes, FA-011) ---------------------------------

    private async Task SetAnnotationMode(AnnotationMode mode)
    {
        _annotationMode = mode;
        // Offenen Editor beim Moduswechsel ORDENTLICH schließen (nicht nur die
        // State-Felder nullen): getippten Inhalt speichern, leere Freitext-
        // Annotation entfernen. Sonst bleibt beim Text-Werkzeug eine leere
        // Geister-Annotation in IndexedDB/Sidecar zurück und ungespeicherter
        // Text geht verloren. Die Save-Methoden nullen ihren State selbst.
        await SaveEditingFreeTextAsync();
        await SaveEditingAnnotationAsync();
        CommitPendingEdit();
        _editingDrawing = null;
        // Drawing-Capture (FA-013/014): bei Mode-Wechsel JS-Listener
        // (de-)attachen. Fire-and-Forget — stopDrawingCapture in JS ist
        // idempotent, also race-frei.
        _ = SyncDrawingCaptureAsync();
    }

    private void SetDrawColor(string color)
    {
        _drawColor = color;
        _ = SyncDrawingCaptureAsync();
    }

    private void SetDrawStrokeWidth(double fraction)
    {
        _drawStrokeWidth = fraction;
        _ = SyncDrawingCaptureAsync();
    }

    /// <summary>
    /// Hängt den JS-seitigen Pointer-Listener für Stift/Formen an das
    /// Page-Canvas-Element, sobald ein Drawing-Mode aktiv ist — und entfernt
    /// ihn wieder, sobald wir den Modus verlassen. Wird nach jedem Tool-/
    /// Stilwechsel aufgerufen, damit Farbe + Strichstärke live ankommen.
    /// </summary>
    private async Task SyncDrawingCaptureAsync()
    {
        if (_dotNetRef is null) return;
        try
        {
            if (IsDrawCaptureMode(_annotationMode))
            {
                await JS.InvokeVoidAsync(
                    "pageboundShortcuts.startDrawingCapture",
                    PageCanvasSelector,
                    MapDrawingModeToJs(_annotationMode),
                    new { color = _drawColor, strokeWidthFraction = _drawStrokeWidth },
                    _dotNetRef,
                    nameof(HandleDrawCompletedAsync));
                _captureAttachedToPage = _currentPage;
            }
            else if (_captureAttachedToPage is not null)
            {
                await JS.InvokeVoidAsync("pageboundShortcuts.stopDrawingCapture");
                _captureAttachedToPage = null;
            }
        }
        catch
        {
            // Bridge nicht erreichbar — Tool tut dann einfach nichts.
        }
    }

    private static string MapDrawingModeToJs(AnnotationMode mode) => mode switch
    {
        AnnotationMode.Pen => "ink",
        AnnotationMode.RectShape => "rect",
        AnnotationMode.ArrowShape => "arrow",
        AnnotationMode.LineShape => "line",
        AnnotationMode.Redaction => "rect",
        _ => "ink"
    };

    [JSInvokable]
    public async Task HandleDrawCompletedAsync(DrawingCaptureResult result)
    {
        if (_currentPdfId is null) return;
        if (result.Strokes is null || result.Strokes.Count == 0) return;

        // Schwärzen: transienter Redaktions-Bereich (rechteckig), keine Annotation.
        if (_annotationMode == AnnotationMode.Redaction)
        {
            if (result.Strokes[0].Count >= 2)
            {
                var s = result.Strokes[0][0];
                var e = result.Strokes[0][^1];
                var w = Math.Abs(e.X - s.X);
                var h = Math.Abs(e.Y - s.Y);
                if (w > 0.003 && h > 0.003)
                {
                    _redactions.Add(new RedactionBox(_currentPage, Math.Min(s.X, e.X), Math.Min(s.Y, e.Y), w, h));
                    await InvokeAsync(StateHasChanged);
                }
            }
            return;
        }

        NewAnnotation? toCreate = null;
        if (string.Equals(result.Mode, "ink", StringComparison.OrdinalIgnoreCase))
        {
            var strokes = result.Strokes
                .Select(s => new InkStroke(
                    s.Select(p => new InkPoint(p.X, p.Y)).ToList()))
                .ToList();
            toCreate = InkAnnotation.Create(
                _currentPdfId.Value,
                _currentPage,
                strokes,
                result.Color,
                result.StrokeWidthFraction);
        }
        else if (result.Strokes[0].Count >= 2)
        {
            var startPoint = result.Strokes[0][0];
            var endPoint = result.Strokes[0][^1];
            var shape = result.Mode.ToLowerInvariant() switch
            {
                "rect" => ShapeKind.Rectangle,
                "arrow" => ShapeKind.Arrow,
                "line" => ShapeKind.Line,
                _ => ShapeKind.Rectangle
            };
            toCreate = ShapeAnnotation.Create(
                _currentPdfId.Value,
                _currentPage,
                shape,
                startPoint.X, startPoint.Y,
                endPoint.X, endPoint.Y,
                result.Color,
                result.StrokeWidthFraction);
        }

        if (toCreate is null) return;

        var created = await Annotations.CreateAsync(toCreate, CancellationToken.None);
        _annotations = _annotations.Append(created).ToList();
        await InvokeAsync(StateHasChanged);
    }

    public sealed record DrawingCaptureResult(
        string Mode,
        string Color,
        double StrokeWidthFraction,
        List<List<DrawPoint>> Strokes);

    public sealed record DrawPoint(double X, double Y);

    private void ClearRedactions() => _redactions.Clear();

    // --- Inline-Text-Bearbeitung („Text bearbeiten" — Cover + Redraw) --------

    private void ClearEdits()
    {
        _edits.Clear();
        _pendingEdit = null;
        _pendingEditContent = string.Empty;
    }

    // Klick → nächstliegende Textzeile suchen und den Editor (vorbefüllt mit dem
    // alten Text) an ihrer Position öffnen. Kein Treffer → freies Einfügen an der
    // Klickposition.
    private async Task StartTextEditAsync(MouseEventArgs e)
    {
        if (_currentPdfId is null || _handle is null) return;

        var fraction = await JS.InvokeAsync<NormalizedPosition?>(
            "pageboundShortcuts.clientPositionToFraction",
            PdfImageSelector,
            e.ClientX,
            e.ClientY);
        if (fraction is null) return;

        TextBlockDto? block = null;
        try
        {
            block = await JS.InvokeAsync<TextBlockDto?>(
                "pageboundPdf.findTextBlockAt", _handle.Id, _currentPage, fraction.X, fraction.Y);
        }
        catch (Exception)
        {
            // Text-Erkennung fehlgeschlagen → wie „kein Treffer" behandeln.
        }

        if (block is not null)
        {
            _pendingEdit = new TextEditBox(_currentPage, block.X, block.Y, block.W, block.H,
                block.Text, block.Text, block.FontSize, DefaultEditTextColor, DefaultEditBgColor);
            _pendingEditContent = block.Text;
            _pendingEditFontSize = block.FontSize;
        }
        else
        {
            _pendingEdit = new TextEditBox(_currentPage, fraction.X, fraction.Y, 0.2, FreeTextAnnotation.DefaultFontSize,
                string.Empty, string.Empty, FreeTextAnnotation.DefaultFontSize, DefaultEditTextColor, DefaultEditBgColor);
            _pendingEditContent = string.Empty;
            _pendingEditFontSize = FreeTextAnnotation.DefaultFontSize;
        }
        _pendingEditColor = DefaultEditTextColor;
    }

    private void SetPendingEditStyle(double fontSize, string color)
    {
        _pendingEditFontSize = fontSize;
        _pendingEditColor = color;
    }

    // Übernimmt den getippten Edit in die Liste (bzw. verwirft ihn, wenn nichts
    // geändert wurde). Leerer neuer Text bei vorhandenem Alt-Text = „übermalen".
    private void CommitPendingEdit()
    {
        if (_pendingEdit is null) return;
        var p = _pendingEdit;
        var newText = _pendingEditContent ?? string.Empty;
        _pendingEdit = null;
        _pendingEditContent = string.Empty;

        // Keine Änderung gegenüber dem Originaltext → nichts zu tun.
        if (string.Equals(newText, p.OldText, StringComparison.Ordinal)) return;
        // Freies Einfügen ohne Inhalt → nichts zu tun.
        if (newText.Length == 0 && p.OldText.Length == 0) return;

        _edits.Add(p with { NewText = newText, FontSize = _pendingEditFontSize, Color = _pendingEditColor });
    }

    private void CancelPendingEdit()
    {
        _pendingEdit = null;
        _pendingEditContent = string.Empty;
    }

    // Bearbeitungen anwenden: übermalt die alten Regionen und zeichnet den neuen
    // Text ein (Cover + Redraw), Download als <name>.edited.pdf. Original/Sidecar
    // bleiben unangetastet. Hinweis: der ursprüngliche Text bleibt extrahierbar —
    // für echte Entfernung das Schwärzen-Werkzeug nutzen.
    private async Task ApplyTextEditsAsync()
    {
        if (_originalPdfBytes is null || _edits.Count == 0 || _isApplyingEdits) return;
        _isApplyingEdits = true;
        _errorMessage = null;
        try
        {
            var regions = _edits
                .Select(ed => new TextEditRegion(ed.Page, ed.X, ed.Y, ed.Width, ed.Height, ed.NewText, ed.FontSize, ed.Color, ed.BgColor))
                .ToList();
            using var ms = new MemoryStream(_originalPdfBytes);
            var edited = await Manipulator.ApplyTextEditsAsync(ms, regions, CancellationToken.None);

            var baseName = !string.IsNullOrWhiteSpace(_currentFilename)
                ? System.IO.Path.GetFileNameWithoutExtension(_currentFilename)
                : (_handle?.Title ?? "pagebound");
            var safeBase = string.Concat(baseName.Select(c =>
                char.IsLetterOrDigit(c) || c is '_' or '-' or '.' or ' ' ? c : '_'));
            await JS.InvokeVoidAsync(
                "pageboundShortcuts.downloadBytes",
                $"{safeBase}.edited.pdf",
                Convert.ToBase64String(edited),
                "application/pdf");
            _edits.Clear();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Bearbeitung fehlgeschlagen:\n{ex.Message}";
        }
        finally
        {
            _isApplyingEdits = false;
        }
    }

    // Fortlaufende Leseansicht: beim Einschalten alle Seiten progressiv rendern.
    private async Task ToggleContinuousAsync()
    {
        _continuous = !_continuous;
        if (_continuous && _handle is not null && _continuousRenderedCount < _handle.PageCount)
        {
            await RenderContinuousAsync();
        }
    }

    private async Task RenderContinuousAsync()
    {
        if (_handle is null || _continuousRendering) return;
        _continuousRendering = true;
        try
        {
            for (var p = 1; p <= _handle.PageCount; p++)
            {
                if (_continuousPages.ContainsKey(p)) continue;
                var rendered = await Renderer.RenderPageAsync(
                    _handle, p, new RenderOptions(Scale: 1.5), CancellationToken.None).ConfigureAwait(false);
                _continuousPages[p] = $"data:{rendered.RasterFormat};base64,{Convert.ToBase64String(rendered.RasterBytes)}";
                _continuousRenderedCount = _continuousPages.Count;
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            _continuousRendering = false;
        }
    }

    // Echte Redaktion anwenden: rasterisiert die betroffenen Seiten und brennt die
    // schwarzen Bereiche ein (entfernt den darunterliegenden Text), Download als
    // <name>.redacted.pdf. Die Originaldatei/Sidecar bleibt unangetastet.
    private async Task ApplyRedactionsAsync()
    {
        if (_originalPdfBytes is null || _redactions.Count == 0 || _isRedacting) return;
        _isRedacting = true;
        _errorMessage = null;
        try
        {
            var regions = _redactions
                .Select(r => new RedactionRegion(r.Page, r.X, r.Y, r.Width, r.Height))
                .ToList();
            using var ms = new MemoryStream(_originalPdfBytes);
            var redacted = await Manipulator.RedactAsync(ms, regions, CancellationToken.None);

            var baseName = !string.IsNullOrWhiteSpace(_currentFilename)
                ? System.IO.Path.GetFileNameWithoutExtension(_currentFilename)
                : (_handle?.Title ?? "pagebound");
            var safeBase = string.Concat(baseName.Select(c =>
                char.IsLetterOrDigit(c) || c is '_' or '-' or '.' or ' ' ? c : '_'));
            await JS.InvokeVoidAsync(
                "pageboundShortcuts.downloadBytes",
                $"{safeBase}.redacted.pdf",
                Convert.ToBase64String(redacted),
                "application/pdf");

            if (_redactAudit)
            {
                var report = await BuildRedactionAuditAsync(_originalPdfBytes, redacted, regions, $"{safeBase}.pdf");
                await JS.InvokeVoidAsync(
                    "pageboundShortcuts.downloadBytes",
                    $"{safeBase}.redaktions-audit.md",
                    Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(report)),
                    "text/markdown");
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Schwärzung fehlgeschlagen:\n{ex.Message}";
        }
        finally
        {
            _isRedacting = false;
        }
    }

    private sealed record AuditPageDto(int Page, List<AuditRectDto> Rects);
    private sealed record AuditRectDto(double X, double Y, double W, double H);

    private static bool RectIntersects(AuditRectDto it, RedactionRegion z) =>
        !(it.X + it.W <= z.X || it.X >= z.X + z.Width
          || it.Y + it.H <= z.Y || it.Y >= z.Y + z.Height);

    // Erzeugt den Redaktions-Audit-Report (Markdown): SHA-256 vorher/nachher +
    // je geschwärzter Seite die Zahl der Text-Fragmente in den Zonen (vorher →
    // nachher). Nachher == 0 belegt, dass der Text-Layer in den Zonen leer ist.
    private async Task<string> BuildRedactionAuditAsync(
        byte[] original, byte[] redacted, IReadOnlyList<RedactionRegion> regions, string fileName)
    {
        string Loc(string de, string en) => L.CurrentLanguage == "de" ? de : en;

        var pages = regions.Select(r => r.PageNumber).Distinct().OrderBy(p => p).ToArray();
        var hashBefore = await Hasher.ComputeAsync(original, Pagebound.Core.Domain.HashAlgorithm.Sha256, CancellationToken.None);
        var hashAfter = await Hasher.ComputeAsync(redacted, Pagebound.Core.Domain.HashAlgorithm.Sha256, CancellationToken.None);

        AuditPageDto[] before, after;
        try
        {
            before = await JS.InvokeAsync<AuditPageDto[]>("pageboundPdf.textRectsForPages", Convert.ToBase64String(original), pages);
            after = await JS.InvokeAsync<AuditPageDto[]>("pageboundPdf.textRectsForPages", Convert.ToBase64String(redacted), pages);
        }
        catch
        {
            before = Array.Empty<AuditPageDto>();
            after = Array.Empty<AuditPageDto>();
        }

        int CountIn(AuditPageDto[] src, int page) =>
            (src.FirstOrDefault(p => p.Page == page)?.Rects ?? new List<AuditRectDto>())
            .Count(it => regions.Any(z => z.PageNumber == page && RectIntersects(it, z)));

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("# " + Loc("Pagebound — Redaktions-Audit", "Pagebound — Redaction Audit")).AppendLine();
        sb.AppendLine($"- {Loc("Datei", "File")}: `{fileName}`");
        sb.AppendLine($"- {Loc("Zeitpunkt", "Timestamp")}: {DateTimeOffset.Now:yyyy-MM-dd HH:mm:ss zzz}");
        sb.AppendLine($"- SHA-256 ({Loc("vorher", "before")}): `{hashBefore}`");
        sb.AppendLine($"- SHA-256 ({Loc("nachher", "after")}): `{hashAfter}`");
        sb.AppendLine($"- {Loc("Geschwärzte Zonen", "Redacted zones")}: {regions.Count} ({Loc("auf", "on")} {pages.Length} {Loc("Seite(n)", "page(s)")})").AppendLine();

        sb.AppendLine($"| {Loc("Seite", "Page")} | {Loc("Zonen", "Zones")} | {Loc("Textfragmente in Zonen", "Text fragments in zones")} ({Loc("vorher", "before")} → {Loc("nachher", "after")}) | Status |");
        sb.AppendLine("|---:|---:|:--|:--|");
        var allClean = true;
        foreach (var p in pages)
        {
            var zones = regions.Count(z => z.PageNumber == p);
            var b = CountIn(before, p);
            var a = CountIn(after, p);
            var ok = a == 0;
            allClean &= ok;
            var status = ok
                ? "✓ " + Loc("kein Resttext", "no residual text")
                : "⚠ " + Loc("Resttext gefunden", "residual text found");
            sb.AppendLine($"| {p} | {zones} | {b} → {a} | {status} |");
        }
        sb.AppendLine();
        var verdict = allClean
            ? "✓ " + Loc(
                "Alle geschwärzten Seiten wurden rasterisiert; im Text-Layer der Ausgabedatei liegt in den Redaktionszonen kein extrahierbarer Text mehr.",
                "All redacted pages were rasterized; the output's text layer holds no extractable text in the redaction zones.")
            : "⚠ " + Loc(
                "In mindestens einer Zone wurde noch Text gefunden — bitte manuell prüfen.",
                "Residual text was found in at least one zone — please review manually.");
        sb.AppendLine("**" + verdict + "**").AppendLine();
        sb.AppendLine("> " + Loc(
            "Hinweis: Die eigentliche Garantie ist die Rasterisierung (Text und Vektoren werden zu Pixeln). Dieser Report prüft den Text-Layer der Ausgabe; eingebrannte Pixel sind per Design nicht mehr als Text vorhanden.",
            "Note: the actual guarantee is rasterization (text and vectors become pixels). This report checks the output's text layer; burned-in pixels are by design no longer present as text."));
        return sb.ToString();
    }

    // Selektierte Ink/Shape für die Lösch-Mini-Toolbar.
    private Annotation? _editingDrawing;

    private void OpenDrawingEditor(Annotation annotation)
    {
        // In Zeichen-Modi schlucken wir Klicks auf existierende Annotations,
        // damit der User wirklich zeichnet und nicht versehentlich editiert.
        if (IsDrawingMode(_annotationMode)) return;
        _editingDrawing = annotation;
    }

    // Popover-Platzierung (F-16): berechnet left/top (% der Seite) + die
    // Flip-Transform, sodass der Editor-Popover nicht über den Seitenrand
    // hinausläuft. Gemeinsam für Freitext- und Sticky-Note-Editor.
    private static (string Left, string Top, string Transform) ComputePopoverPlacement(double x, double y)
    {
        var left = (x * 100).ToString("F2", CultureInfo.InvariantCulture);
        var top = (y * 100).ToString("F2", CultureInfo.InvariantCulture);
        var translateX = x > 0.55 ? "calc(-100% - 8px)" : "8px";
        var translateY = y > 0.65 ? "calc(-100% + 8px)" : "-8px";
        return (left, top, $"translate({translateX}, {translateY})");
    }

    // List-Mutations-Helper (F-16): ersetzt bzw. entfernt eine Annotation in
    // _annotations. Lösen das zuvor 6-/5-fach duplizierte Select-/Where-Idiom ab.
    private void ReplaceAnnotation(Annotation saved) =>
        _annotations = _annotations
            .Select(a => a.Id.Value == saved.Id.Value ? saved : a)
            .ToList();

    private void RemoveAnnotation(AnnotationId id) =>
        _annotations = _annotations
            .Where(a => a.Id.Value != id.Value)
            .ToList();

    private async Task DeleteEditingDrawingAsync()
    {
        if (_editingDrawing is null) return;
        var id = _editingDrawing.Id;
        await Annotations.DeleteAsync(id, CancellationToken.None);
        RemoveAnnotation(id);
        _editingDrawing = null;
    }

    /// <summary>
    /// Ankerpunkt für die Lösch-Mini-Toolbar (oben-Mitte der Bounding-Box
    /// der jeweiligen Ink/Shape).
    /// </summary>
    private static (double X, double Y) GetDrawingAnchor(Annotation annotation)
    {
        if (annotation.Type == AnnotationType.Ink)
        {
            var minX = 1.0; var minY = 1.0; var maxX = 0.0;
            var found = false;
            foreach (var stroke in InkAnnotation.GetStrokes(annotation))
            {
                foreach (var p in stroke.Points)
                {
                    if (p.X < minX) minX = p.X;
                    if (p.X > maxX) maxX = p.X;
                    if (p.Y < minY) minY = p.Y;
                    found = true;
                }
            }
            return found ? ((minX + maxX) * 0.5, minY) : (0.5, 0.5);
        }
        if (annotation.Type == AnnotationType.Shape)
        {
            var sx = ShapeAnnotation.GetStartX(annotation);
            var sy = ShapeAnnotation.GetStartY(annotation);
            var ex = ShapeAnnotation.GetEndX(annotation);
            var ey = ShapeAnnotation.GetEndY(annotation);
            return ((sx + ex) * 0.5, Math.Min(sy, ey));
        }
        return (0.5, 0.5);
    }

    private static string BuildInkPath(InkStroke stroke)
    {
        if (stroke.Points.Count < 2) return string.Empty;
        return string.Join(" ", stroke.Points.Select((p, i) =>
            string.Format(CultureInfo.InvariantCulture,
                "{0} {1:F4} {2:F4}",
                i == 0 ? "M" : "L", p.X, p.Y)));
    }

    /// <summary>
    /// Liefert die drei Eckpunkte der Pfeilspitze (Endpunkt + zwei Basis-Punkte
    /// links/rechts der Linienrichtung). Größe skaliert leicht mit der
    /// Strichstärke, ist aber nach unten begrenzt damit dünne Pfeile sichtbar
    /// bleiben. Gibt <c>null</c> zurück, wenn Start und Ende identisch sind.
    /// </summary>
    private static (double X1, double Y1, double X2, double Y2, double X3, double Y3)?
        ComputeArrowHead(double sx, double sy, double ex, double ey, double strokeWidth, double aspect)
    {
        if (aspect <= 0) aspect = 1;
        // Die Spitze wird im quadratischen Pixel-Raum berechnet (x mit dem Seiten-
        // verhältnis skaliert), sonst verzerrt der SVG-viewBox 0..1 mit
        // preserveAspectRatio=none die Geometrie und die Spitze wirkt schief.
        var sxs = sx * aspect;
        var exs = ex * aspect;
        var dxs = exs - sxs;
        var dys = ey - sy;
        var len = Math.Sqrt(dxs * dxs + dys * dys);
        if (len <= 0) return null;
        var ux = dxs / len;
        var uy = dys / len;
        // Spitzenlänge: solide sichtbar, skaliert mit der Strichstärke
        // (strokeWidth ist Seitenbreiten-Anteil → ×aspect = Höhen-Anteil),
        // bei kurzen Pfeilen auf 40 % der Länge gedeckelt.
        var arrowSize = Math.Min(len * 0.4, Math.Max(0.024, strokeWidth * aspect * 4.0));
        var bxs = exs - ux * arrowSize;
        var bys = ey - uy * arrowSize;
        var nx = -uy;
        var ny = ux;
        var hb = arrowSize * 0.5;
        // zurück in 0..1-Seiten-Koordinaten (x wieder „entzerren")
        return (ex, ey,
                (bxs + nx * hb) / aspect, bys + ny * hb,
                (bxs - nx * hb) / aspect, bys - ny * hb);
    }

    private async Task HandlePdfClickAsync(MouseEventArgs e)
    {
        Console.WriteLine($"[SIG-DIAG] PDF-Klick angekommen: mode={_annotationMode} isPlacing={_isPlacing} activeImg={_activeSignatureImage != null}");
        // Reentrancy-Guard (F-08): ein schneller zweiter Klick darf nicht am
        // await-Punkt (JS-Interop / CreateAsync) durchlaufen und doppelt
        // platzieren. Schützt alle vier Platzierungs-Modi auf einmal. Der Modus
        // wird bewusst NICHT vorab zurückgesetzt (Signatur bleibt geladen).
        if (_isPlacing) return;
        _isPlacing = true;
        try
        {
            // Editor schließt, sobald wir ins Dokument klicken (außer eben in den
            // Editor selbst — der stoppt das Event via @onclick:stopPropagation).
            if (_editingAnnotation is not null)
            {
                await SaveEditingAnnotationAsync();
            }
            if (IsFreeTextEditorOpen)
            {
                // Auch einen offenen Pending-Text (F-10) speichern/verwerfen.
                await SaveEditingFreeTextAsync();
            }
            if (IsTextEditorOpen)
            {
                // Offenen „Text bearbeiten"-Editor übernehmen, bevor der neue Klick
                // verarbeitet wird (analog zum Freitext).
                CommitPendingEdit();
            }

            if (_currentPdfId is null || _handle is null) return;

            if (_annotationMode == AnnotationMode.Signature)
            {
                await PlaceSignatureAsync(e);
                return;
            }

            if (_annotationMode == AnnotationMode.FreeText)
            {
                // Leerer Text + Editor öffnen — der Nutzer tippt direkt los (wie Edge).
                await PlaceFreeTextAsync(e, string.Empty, openEditor: true);
                return;
            }

            if (_annotationMode == AnnotationMode.DateStamp)
            {
                // Aktuelles PC-Datum (lokale Zeitzone des Browsers/Rechners) im
                // sprachabhängigen Format aus den i18n-Ressourcen. Absicherung
                // (F-14): Fehlt der Key, gibt L.T den Key SELBST zurück — der darf
                // nicht als Formatstring interpretiert werden. Und ein kaputter
                // Formatstring einer Übersetzung darf den Klick-Handler nicht
                // werfen → in beiden Fällen ISO-Fallback "yyyy-MM-dd".
                const string dateFormatKey = "reader.tool.date.format";
                const string dateFallbackFormat = "yyyy-MM-dd";
                var dateFormat = L.T(dateFormatKey);
                if (string.IsNullOrWhiteSpace(dateFormat) || dateFormat == dateFormatKey)
                {
                    dateFormat = dateFallbackFormat;
                }
                string dateText;
                try
                {
                    dateText = DateTime.Now.ToString(dateFormat, CultureInfo.InvariantCulture);
                }
                catch (FormatException)
                {
                    dateText = DateTime.Now.ToString(dateFallbackFormat, CultureInfo.InvariantCulture);
                }
                await PlaceFreeTextAsync(e, dateText, openEditor: false);
                return;
            }

            if (_annotationMode == AnnotationMode.EditText)
            {
                await StartTextEditAsync(e);
                return;
            }

            if (_annotationMode != AnnotationMode.StickyNote) return;

            var fraction = await JS.InvokeAsync<NormalizedPosition?>(
                "pageboundShortcuts.clientPositionToFraction",
                PdfImageSelector,
                e.ClientX,
                e.ClientY);
            if (fraction is null) return;

            var newAnnotation = StickyNoteAnnotation.Create(
                _currentPdfId.Value,
                _currentPage,
                fraction.X,
                fraction.Y,
                string.Empty);

            var created = await Annotations.CreateAsync(newAnnotation, CancellationToken.None);
            _annotations = _annotations.Append(created).ToList();

            // Sofort in den Edit-Modus springen, damit der Nutzer den Text
            // eingeben kann, ohne erst auf den Pin zu klicken.
            OpenEditor(created);

            // Nach dem Erstellen zurück zum Select-Modus — verhindert versehentliche
            // Mehrfach-Erstellung beim Weiterklicken.
            _annotationMode = AnnotationMode.Select;
            await RecomputeSignatureStatusesAsync();
        }
        finally
        {
            _isPlacing = false;
        }
    }

    private void OpenEditor(Annotation annotation)
    {
        _editingAnnotation = annotation;
        _editingContent = StickyNoteAnnotation.GetContent(annotation);
        // Vorhandener Inhalt → erst lesen, sonst direkt schreiben.
        _editorPreviewMode = !string.IsNullOrWhiteSpace(_editingContent);
    }

    private void ToggleEditorPreview()
    {
        _editorPreviewMode = !_editorPreviewMode;
    }

    private async Task SaveEditingAnnotationAsync()
    {
        if (_editingAnnotation is null) return;
        var current = _editingAnnotation;
        var newContent = _editingContent;

        // Wenn sich nichts geändert hat, Editor einfach schließen.
        if (StickyNoteAnnotation.GetContent(current) != newContent)
        {
            var updated = StickyNoteAnnotation.WithContent(current, newContent);
            var saved = await Annotations.UpdateAsync(updated, CancellationToken.None);
            ReplaceAnnotation(saved);
            await RecomputeSignatureStatusesAsync();
        }

        _editingAnnotation = null;
        _editingContent = string.Empty;
    }

    private async Task DeleteEditingAnnotationAsync()
    {
        if (_editingAnnotation is null) return;
        var idToRemove = _editingAnnotation.Id;
        await Annotations.DeleteAsync(idToRemove, CancellationToken.None);
        RemoveAnnotation(idToRemove);
        _editingAnnotation = null;
        _editingContent = string.Empty;
        await RecomputeSignatureStatusesAsync();
    }

    private void CancelEditing()
    {
        _editingAnnotation = null;
        _editingContent = string.Empty;
    }

    // --- Freitext + Datum-Stempel (FA — Text-Werkzeug wie Edge-Reader) ------

    private async Task PlaceFreeTextAsync(MouseEventArgs e, string initialText, bool openEditor)
    {
        if (_currentPdfId is null) return;

        var fraction = await JS.InvokeAsync<NormalizedPosition?>(
            "pageboundShortcuts.clientPositionToFraction",
            PdfImageSelector,
            e.ClientX,
            e.ClientY);
        if (fraction is null) return;

        if (openEditor)
        {
            // Text-Werkzeug (F-10): NOCH NICHT persistieren. Klickposition als
            // Pending-State halten und den Editor dagegen öffnen — erzeugt wird
            // die Annotation erst in SaveEditingFreeTextAsync, sobald nicht-leerer
            // Text getippt wurde. So entstehen keine leeren Geister-Annotationen
            // und das Signatur-Badge flackert beim bloßen Platzieren nicht.
            _pendingFreeTextPosition = (fraction.X, fraction.Y, _currentPage);
            _editingFreeText = null;
            _editingFreeTextContent = string.Empty;
            // F-11: Pending-Stil auf die Defaults setzen (neuer Text).
            _editingFreeTextFontSize = FreeTextAnnotation.DefaultFontSize;
            _editingFreeTextColor = FreeTextAnnotation.DefaultColor;
            _annotationMode = AnnotationMode.Select;
            return;
        }

        // Datum-Stempel: hat sofort Text und öffnet keinen Editor → direkt
        // persistieren (eine reale, nicht-leere Annotation).
        var newAnnotation = FreeTextAnnotation.Create(
            _currentPdfId.Value,
            _currentPage,
            fraction.X,
            fraction.Y,
            initialText);

        var created = await Annotations.CreateAsync(newAnnotation, CancellationToken.None);
        _annotations = _annotations.Append(created).ToList();

        // Zurück zum Select-Modus — verhindert versehentliche Mehrfach-Erstellung.
        _annotationMode = AnnotationMode.Select;
        await RecomputeSignatureStatusesAsync();
    }

    private void OpenFreeTextEditor(Annotation annotation)
    {
        // Ein bestehender Text wird editiert → evtl. offener Pending-State (neuer,
        // noch nicht gespeicherter Text) ist damit hinfällig.
        _pendingFreeTextPosition = null;
        _editingFreeText = annotation;
        _editingFreeTextContent = FreeTextAnnotation.GetText(annotation);
        // F-11: Pending-Stil aus der Annotation initialisieren.
        _editingFreeTextFontSize = FreeTextAnnotation.GetFontSize(annotation);
        _editingFreeTextColor = FreeTextAnnotation.GetColor(annotation);
    }

    private async Task SaveEditingFreeTextAsync()
    {
        var newText = _editingFreeTextContent;

        // Fall A (F-10): NEUER Freitext, noch nicht persistiert (Pending-State).
        if (_editingFreeText is null)
        {
            var pending = _pendingFreeTextPosition;
            _pendingFreeTextPosition = null;
            _editingFreeTextContent = string.Empty;

            // Nichts getippt (oder kein PDF) → gar nicht erst erzeugen: Platzieren
            // + Abbrechen bzw. leer Speichern = 0 Storage-Writes, kein Badge-Flackern.
            if (pending is null || _currentPdfId is null || string.IsNullOrWhiteSpace(newText))
            {
                return;
            }

            var newAnnotation = FreeTextAnnotation.Create(
                _currentPdfId.Value, pending.Value.Page, pending.Value.X, pending.Value.Y,
                newText, _editingFreeTextFontSize, _editingFreeTextColor);
            var created = await Annotations.CreateAsync(newAnnotation, CancellationToken.None);
            _annotations = _annotations.Append(created).ToList();
            await RecomputeSignatureStatusesAsync();
            return;
        }

        // Fall B: BESTEHENDER Freitext.
        var current = _editingFreeText;

        // Leer editiert → Annotation entfernen (Edit-Pfad behält die Lösch-Logik).
        if (string.IsNullOrWhiteSpace(newText))
        {
            await DeleteEditingFreeTextAsync();
            return;
        }

        // F-11: Text UND Stil zusammen prüfen/persistieren (ein Write, ein Bump).
        var textChanged = FreeTextAnnotation.GetText(current) != newText;
        var styleChanged =
            Math.Abs(FreeTextAnnotation.GetFontSize(current) - _editingFreeTextFontSize) > 0.0005
            || !string.Equals(FreeTextAnnotation.GetColor(current), _editingFreeTextColor, StringComparison.OrdinalIgnoreCase);
        if (textChanged || styleChanged)
        {
            var updated = FreeTextAnnotation.WithTextAndStyle(
                current, newText, _editingFreeTextFontSize, _editingFreeTextColor);
            var saved = await Annotations.UpdateAsync(updated, CancellationToken.None);
            ReplaceAnnotation(saved);
            await RecomputeSignatureStatusesAsync();
        }

        _editingFreeText = null;
        _editingFreeTextContent = string.Empty;
    }

    private async Task DeleteEditingFreeTextAsync()
    {
        // Pending-Text (F-10, noch nicht persistiert) → nur verwerfen, es gibt
        // nichts zu löschen und der Signatur-Hash ändert sich nicht.
        if (_editingFreeText is null)
        {
            _pendingFreeTextPosition = null;
            _editingFreeTextContent = string.Empty;
            return;
        }
        var idToRemove = _editingFreeText.Id;
        await Annotations.DeleteAsync(idToRemove, CancellationToken.None);
        RemoveAnnotation(idToRemove);
        _editingFreeText = null;
        _editingFreeTextContent = string.Empty;
        await RecomputeSignatureStatusesAsync();
    }

    private void CancelFreeTextEditing()
    {
        // F-10: Ein neuer (Pending-)Freitext wurde noch nicht persistiert → einfach
        // verwerfen (kein Storage-Write). Ein bestehender Freitext bleibt
        // unverändert stehen. Kein Löschen-bei-leer mehr nötig, da leere Freitexte
        // gar nicht erst gespeichert werden.
        _pendingFreeTextPosition = null;
        _editingFreeText = null;
        _editingFreeTextContent = string.Empty;
    }

    private void SetFreeTextStyle(double fontSize, string color)
    {
        // F-11: Nur den Pending-Stil im Editor-State ändern (Live-Vorschau über das
        // gerenderte Div des bearbeiteten Freitexts). KEIN Storage-Write und kein
        // Signatur-Recompute pro Swatch-Klick — persistiert wird einmal beim
        // Speichern (SaveEditingFreeTextAsync). Funktioniert für Pending & Bestand.
        _editingFreeTextFontSize = fontSize;
        _editingFreeTextColor = color;
    }

    // Startet den JS-seitigen Drag eines absolut positionierten Overlay-Elements
    // (Freitext/Signatur) und meldet die End-Fraction via callbackName an C#
    // zurück (F-16 — löst die zwei identischen MouseDown-Interop-Blöcke ab).
    private async Task StartElementDragAsync(string selector, string callbackName, string id, MouseEventArgs e)
    {
        if (_dotNetRef is null) return;
        try
        {
            await JS.InvokeVoidAsync(
                "pageboundShortcuts.dragElementToFraction",
                selector,
                PageCanvasSelector,
                e.ClientX,
                e.ClientY,
                _dotNetRef,
                callbackName,
                id);
        }
        catch (JSException)
        {
            // Bridge nicht erreichbar — Drag wird einfach nicht starten.
        }
    }

    private async Task HandleFreeTextMouseDownAsync(MouseEventArgs e, Annotation freeText)
    {
        if (_dotNetRef is null) return;
        if (e.Button != 0) return;
        // Offenen Sticky-Note-Editor zuerst speichern — der Freitext-Div stoppt
        // die Event-Propagation, sonst ginge dessen ungespeicherter Text beim
        // Wechsel auf den Freitext verloren (analog F-04 Freitext↔Freitext).
        if (_editingAnnotation is not null)
        {
            await SaveEditingAnnotationAsync();
        }
        await StartElementDragAsync(
            $"[data-pb-freetext-id=\"{freeText.Id.Value}\"]",
            nameof(HandleFreeTextDragCompleteAsync),
            freeText.Id.Value,
            e);
    }

    [JSInvokable]
    public async Task HandleFreeTextDragCompleteAsync(string freeTextId, double newX, double newY)
    {
        var freeText = _annotations.FirstOrDefault(a =>
            a.Id.Value == freeTextId && a.Type == AnnotationType.FreeText);
        if (freeText is null) return;

        var currentX = FreeTextAnnotation.GetX(freeText);
        var currentY = FreeTextAnnotation.GetY(freeText);
        // Klick ohne Bewegung → Editor öffnen (Position unverändert).
        if (Math.Abs(currentX - newX) < 0.0005 && Math.Abs(currentY - newY) < 0.0005)
        {
            // Editor-Wechsel: ist bereits ein ANDERER Freitext-Editor offen (ein
            // bestehender Text ODER ein neuer Pending-Text, F-10), dessen Inhalt
            // zuerst speichern. Der Freitext-Div stoppt die Event-Propagation
            // (@onmousedown:stopPropagation), daher greift HandlePdfClickAsync hier
            // nicht und der Inhalt ginge sonst verloren.
            if (IsFreeTextEditorOpen && (_editingFreeText is null || _editingFreeText.Id.Value != freeText.Id.Value))
            {
                await SaveEditingFreeTextAsync();
            }
            OpenFreeTextEditor(freeText);
            await InvokeAsync(StateHasChanged);
            return;
        }

        var updated = FreeTextAnnotation.WithPosition(freeText, newX, newY);
        var saved = await Annotations.UpdateAsync(updated, CancellationToken.None);
        ReplaceAnnotation(saved);

        // Freitext-Position ist Teil des Signatur-Integritäts-Hashs → nach dem
        // Verschieben Status neu berechnen (analog SaveEditingFreeTextAsync).
        await RecomputeSignatureStatusesAsync();

        await InvokeAsync(StateHasChanged);
    }

    private sealed record NormalizedPosition(double X, double Y);

    // --- PNG-Signatur + Integrität (FA-015, FA-016, FA-017) -----------------

    private async Task HandleSignatureImageSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _errorMessage = null;
        Console.WriteLine($"[SIG-DIAG] OnChange gefeuert: file={file?.Name} size={file?.Size} type={file?.ContentType}");

        if (file.Size > MaxSignatureBytes)
        {
            _errorMessage = $"Signaturbild ist zu groß (max {MaxSignatureBytes / 1024} KB).";
            return;
        }
        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            _errorMessage = "Bitte eine Bilddatei (PNG / JPG) auswählen.";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(MaxSignatureBytes);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            var base64 = Convert.ToBase64String(bytes);
            var mime = string.IsNullOrEmpty(file.ContentType) ? "image/png" : file.ContentType;
            _activeSignatureImage = $"data:{mime};base64,{base64}";
            _activeSignatureFilename = file.Name;
            // Wie der Zeichnen-Flow (OnSignatureDrawnAsync): über die Methode in
            // den Platzieren-Modus wechseln, nicht das Feld direkt setzen — sonst
            // bleibt beim Wechsel aus einem Zeichenmodus der JS-Pointer-Listener
            // hängen und fängt die Platzieren-Klicks ab.
            await SetAnnotationMode(AnnotationMode.Signature);
            _signatureMenu?.ForceClose(); // Menü zu → Backdrop weg → Platzieren-Klick erreicht die Seite
            Console.WriteLine($"[SIG-DIAG] geladen: activeImg={_activeSignatureImage != null} mode={_annotationMode}, Menue geschlossen");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Signaturbild konnte nicht geladen werden: {ex.Message}";
            _activeSignatureImage = null;
            _activeSignatureFilename = null;
        }
    }

    private void ClearActiveSignature()
    {
        _activeSignatureImage = null;
        _activeSignatureFilename = null;
        if (_annotationMode == AnnotationMode.Signature)
        {
            _annotationMode = AnnotationMode.Select;
        }
    }

    private async Task PlaceSignatureAsync(MouseEventArgs e)
    {
        Console.WriteLine($"[SIG-DIAG] PlaceSignatureAsync erreicht: activeImg={_activeSignatureImage != null} pdfId={_currentPdfId != null}");
        if (_activeSignatureImage is null) return;
        if (_currentPdfId is null) return;

        var fraction = await JS.InvokeAsync<NormalizedPosition?>(
            "pageboundShortcuts.clientPositionToFraction",
            PdfImageSelector,
            e.ClientX,
            e.ClientY);
        Console.WriteLine($"[SIG-DIAG] fraction={(fraction is null ? "null" : $"{fraction.X:F2},{fraction.Y:F2}")}");
        if (fraction is null) return;

        // Default-Größe: 25 % Breite, 8 % Höhe — ausreichend für eine
        // handschriftliche Unterschrift. Klick ist Top-Left der Signatur.
        const double width = 0.25;
        const double height = 0.08;
        var x = Math.Min(fraction.X, 1 - width);
        var y = Math.Min(fraction.Y, 1 - height);
        var signedAt = DateTimeOffset.UtcNow;

        var newAnnotation = SignatureAnnotation.Create(
            _currentPdfId.Value,
            _currentPage,
            _activeSignatureImage,
            x, y, width, height,
            signedAt,
            integrityHash: null,
            signer: _signer);

        // Erst Annotation anlegen — damit wir eine echte ID haben.
        var created = await Annotations.CreateAsync(newAnnotation, CancellationToken.None);

        // Hash berechnen über pdfHash + Bestand vor dieser Signatur + Zeitstempel.
        var hash = await Integrity.ComputeSignatureHashAsync(
            _currentPdfId.Value,
            created,
            _annotations, // _annotations enthält noch nicht 'created'
            signedAt,
            CancellationToken.None);

        // Hash zurück in die Signatur schreiben.
        var withHash = SignatureAnnotation.WithIntegrityHash(created, hash);
        var saved = await Annotations.UpdateAsync(withHash, CancellationToken.None);

        _annotations = _annotations.Append(saved).ToList();
        _signatureStatuses[saved.Id.Value] = SignatureIntegrityStatus.Valid;

        // Nach Platzieren: zurück zum Select-Modus, Signatur bleibt geladen
        // damit weitere Platzierungen mit derselben Unterschrift möglich sind.
        _annotationMode = AnnotationMode.Select;
    }

    private async Task RecomputeSignatureStatusesAsync()
    {
        if (_currentPdfId is null)
        {
            _signatureStatuses.Clear();
            return;
        }

        // F-12: Alle Signaturen in EINEM Durchlauf verifizieren — der kanonische
        // Annotations-Block wird intern nur einmal gebaut (statt pro Signatur).
        var results = await Integrity.VerifyAllAsync(
            _currentPdfId.Value, _annotations, CancellationToken.None);
        _signatureStatuses = results.ToDictionary(kvp => kvp.Key.Value, kvp => kvp.Value);
    }

    private async Task DeleteSignatureAsync(Annotation signature)
    {
        await Annotations.DeleteAsync(signature.Id, CancellationToken.None);
        RemoveAnnotation(signature.Id);
        _signatureStatuses.Remove(signature.Id.Value);
        await RecomputeSignatureStatusesAsync();
    }

    private async Task LoadSignerFromStorageAsync()
    {
        if (_signerLoaded) return;
        _signerLoaded = true;
        try
        {
            var stored = await Storage.GetAsync<SignerInfo>(SignerStorageKey, CancellationToken.None);
            if (stored is not null)
            {
                _signer = stored;
            }
        }
        catch
        {
            // Storage nicht erreichbar — Signer bleibt leer, harmlos.
        }
    }

    private async Task SaveSignerToStorageAsync()
    {
        try
        {
            await Storage.SetAsync(SignerStorageKey, _signer, CancellationToken.None);
        }
        catch
        {
            // Persistenz best-effort; UI bleibt funktional.
        }
    }

    private async Task ExportSignedPdfAsync()
    {
        if (_originalPdfBytes is null || _currentPdfId is null) return;
        var signatureAnnotations = _annotations
            .Where(a => a.Type == AnnotationType.Signature)
            .OrderBy(a => a.PageNumber)
            .ThenBy(a => SignatureAnnotation.GetSignedAt(a))
            .ToList();
        if (signatureAnnotations.Count == 0) return;

        _isSavingSignedPdf = true;
        _errorMessage = null;

        try
        {
            var embedded = signatureAnnotations.Select(a =>
            {
                var dataUrl = SignatureAnnotation.GetImageDataUrl(a);
                var commaIdx = dataUrl.IndexOf(',');
                var base64 = commaIdx >= 0 ? dataUrl[(commaIdx + 1)..] : dataUrl;
                var bytes = Convert.FromBase64String(base64);
                return new EmbeddedSignature(
                    PageNumber: a.PageNumber,
                    ImageBytes: bytes,
                    X: SignatureAnnotation.GetX(a),
                    Y: SignatureAnnotation.GetY(a),
                    Width: SignatureAnnotation.GetWidth(a),
                    Height: SignatureAnnotation.GetHeight(a),
                    SignedAt: SignatureAnnotation.GetSignedAt(a),
                    Signer: SignatureAnnotation.GetSigner(a),
                    IntegrityHash: SignatureAnnotation.GetIntegrityHash(a));
            }).ToList();

            using var ms = new MemoryStream(_originalPdfBytes);
            var signed = await Manipulator.EmbedSignaturesAsync(ms, embedded, CancellationToken.None);

            var baseName = !string.IsNullOrWhiteSpace(_currentFilename)
                ? System.IO.Path.GetFileNameWithoutExtension(_currentFilename)
                : (_handle?.Title ?? "pagebound");
            var safeBase = string.Concat(baseName.Select(c =>
                char.IsLetterOrDigit(c) || c is '_' or '-' or '.' or ' ' ? c : '_'));
            var downloadName = $"{safeBase}_signed.pdf";

            var b64 = Convert.ToBase64String(signed);
            await JS.InvokeVoidAsync(
                "pageboundShortcuts.downloadBytes",
                downloadName,
                b64,
                "application/pdf");
        }
        catch (Exception ex)
        {
            // Volle Diagnose in die UI rendern, weil TargetInvocationException
            // bei JS-Interop-Rückgabewegen die echte Exception oft verschluckt.
            var details = new System.Text.StringBuilder();
            var walker = ex;
            while (walker is not null)
            {
                details.AppendLine($"{walker.GetType().FullName}: {walker.Message}");
                walker = walker.InnerException;
            }
            _errorMessage = $"Signiertes PDF konnte nicht erzeugt werden:\n{details}";
            try
            {
                await JS.InvokeVoidAsync("console.error", "[Pagebound] sign-pdf failed", ex.ToString());
            }
            catch
            {
                // Konsole nicht verfügbar — Fehler steht eh in der UI.
            }
        }
        finally
        {
            _isSavingSignedPdf = false;
        }
    }

    // „Annotationen einbrennen": brennt ALLE Sidecar-Annotationen (Highlights,
    // Notizen, Ink, Formen, Signaturen) fest in die PDF-Bytes und lädt das
    // Ergebnis als <name>.flach.pdf herunter. Die Sidecar/Originaldatei bleibt
    // unangetastet — das Ergebnis ist eine eigenständige, „flache" PDF.
    private async Task FlattenAnnotationsAsync()
    {
        if (_originalPdfBytes is null || _annotations.Count == 0 || _isFlattening) return;

        _isFlattening = true;
        _errorMessage = null;
        try
        {
            using var ms = new MemoryStream(_originalPdfBytes);
            var flattened = await Manipulator.FlattenAnnotationsAsync(ms, _annotations, CancellationToken.None);

            var baseName = !string.IsNullOrWhiteSpace(_currentFilename)
                ? System.IO.Path.GetFileNameWithoutExtension(_currentFilename)
                : (_handle?.Title ?? "pagebound");
            var safeBase = string.Concat(baseName.Select(c =>
                char.IsLetterOrDigit(c) || c is '_' or '-' or '.' or ' ' ? c : '_'));

            await JS.InvokeVoidAsync(
                "pageboundShortcuts.downloadBytes",
                $"{safeBase}.flach.pdf",
                Convert.ToBase64String(flattened),
                "application/pdf");
        }
        catch (Exception ex)
        {
            var details = new System.Text.StringBuilder();
            var walker = ex;
            while (walker is not null)
            {
                details.AppendLine($"{walker.GetType().FullName}: {walker.Message}");
                walker = walker.InnerException;
            }
            _errorMessage = $"Annotationen konnten nicht eingebrannt werden:\n{details}";
        }
        finally
        {
            _isFlattening = false;
        }
    }

    private async Task HandleSignatureMouseDownAsync(MouseEventArgs e, Annotation signature)
    {
        if (_dotNetRef is null) return;
        // Linke Maustaste nur; ohne diese Prüfung würde Rechtsklick auch
        // einen Drag-Listener registrieren.
        if (e.Button != 0) return;
        await StartElementDragAsync(
            $"[data-pb-signature-id=\"{signature.Id.Value}\"]",
            nameof(HandleSignatureDragCompleteAsync),
