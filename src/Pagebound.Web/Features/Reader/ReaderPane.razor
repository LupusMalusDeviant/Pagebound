    private async Task FindPatternMatchesAsync()
    {
        if (_handle is null || _isFindingPattern) return;
        var source = _redactPreset == "custom"
            ? _redactCustomRegex
            : (RedactPresets.TryGetValue(_redactPreset, out var s) ? s : string.Empty);
        if (string.IsNullOrWhiteSpace(source)) return;
        _isFindingPattern = true;
        _patternFindStatus = null;
        try
        {
            var matches = await JS.InvokeAsync<TextMatchDto[]>("pageboundPdf.findTextMatches", _handle.Id, source, "")
                .ConfigureAwait(false);
            var added = 0;
            foreach (var mt in matches ?? Array.Empty<TextMatchDto>())
            {
                // Duplikate (nahezu gleiche Box) überspringen.
                if (_redactions.Any(r => r.Page == mt.Page
                    && Math.Abs(r.X - mt.X) < 0.002 && Math.Abs(r.Y - mt.Y) < 0.002)) continue;
                _redactions.Add(new RedactionBox(mt.Page, mt.X, mt.Y, mt.W, mt.H));
                added++;
            }
            _patternFindStatus = L.T("reader.redact.pattern.found", new Dictionary<string, object> { ["count"] = added });
        }
        catch (Exception ex)
        {
            _patternFindStatus = L.T("reader.redact.pattern.error", new Dictionary<string, object> { ["message"] = ex.Message });
        }
        finally
        {
            _isFindingPattern = false;
        }
    }

