                            else
                            {
                                <div class="text-xs text-pb-fg-muted animate-pulse">@L.T("app.loadingShort")</div>
                            }
                        </div>
                        <div class="mt-1 flex items-center justify-between text-xs">
                            <span class="text-pb-fg-muted">@L.T("tools.page.label", new Dictionary<string, object> { ["index"] = pageRef.OriginalIndex })</span>
                            @if (pageRef.Rotation != 0)
                            {
                                <span class="rounded bg-pb-accent/15 px-1.5 py-0.5 text-pb-accent">@pageRef.Rotation°</span>
                            }
                        </div>

                        @* Split-Toggle-Button — nur sichtbar bei Hover, außer aktiv *@
                        @if (!isFirst)
                        {
                            var splitToggleTitle = splitActive ? L.T("tools.split.removeTitle") : L.T("tools.split.beforeTitle");
                            <button type="button"
                                    class="@($"absolute -top-2 -left-2 w-6 h-6 rounded-full shadow border text-xs flex items-center justify-center transition-opacity {(splitActive ? "bg-pb-accent text-white border-pb-accent opacity-100" : "bg-pb-surface text-pb-fg-muted border-pb-border opacity-0 group-hover:opacity-100 hover:text-pb-fg")}")"
                                    @onclick="@(() => ToggleSplitBefore(pageRef))"
                                    @onclick:stopPropagation
                                    title="@splitToggleTitle"
                                    aria-label="@splitToggleTitle"
                                    aria-pressed="@splitActive.ToString().ToLowerInvariant()">
                                <Icon Name="split" />
                            </button>
                        }
                    </button>
                </div>
            }
        </div>

        @if (_pages.Any(p => p.Deleted))
        {
            var deletedCount = _pages.Count(p => p.Deleted);
            <div class="max-w-4xl mx-auto mt-4 rounded-lg border border-dashed border-pb-border p-3 text-sm text-pb-fg-muted">
                @L.T("tools.deleted.summary", new Dictionary<string, object> { ["count"] = deletedCount })
                — <button type="button" class="text-pb-accent hover:underline" @onclick="UndoDeletes">@L.T("tools.deleted.undo")</button>
            </div>
        }
        }
    }
    else if (_handle is null && !_isLoading)
    {
        <div class="max-w-4xl mx-auto mt-6 rounded-lg border border-dashed border-pb-border p-6 text-center text-sm text-pb-fg-muted">
            @(Embedded ? L.T("reader.tools.empty") : L.T("tools.empty"))
        </div>
    }
</div>

@code {
    private const long MaxFileSize = 200L * 1024 * 1024; // 200 MB für Editor-Modus

    // FA-027: Verschlüsselung läuft über WebCrypto (Bridge encryptPdf) — ~15 ms
    // statt ~30 s Freeze, im Browser gegen PDF.js verifiziert (öffnet mit Passwort).
    private const bool EncryptionUiEnabled = true;

    // UX: Werkzeug-Leisten in Desktop-typische Kategorie-Tabs gruppiert, damit nie
    // mehr als die Leisten einer Kategorie gleichzeitig sichtbar sind (vorher 12
    // gestapelt). Reine Sichtbarkeits-Steuerung — keine Zustands-/Logikänderung.
    private enum ToolCategory { Pages, Export, Stamp, Security, Standards }

    private ToolCategory _activeCategory = ToolCategory.Pages;

    private sealed record ToolCategoryDef(ToolCategory Category, string LabelKey);

    private static readonly ToolCategoryDef[] ToolCategories =
    {
        new(ToolCategory.Pages,     "tools.category.pages"),
        new(ToolCategory.Export,    "tools.category.export"),
        new(ToolCategory.Stamp,     "tools.category.stamp"),
        new(ToolCategory.Security,  "tools.category.security"),
        new(ToolCategory.Standards, "tools.category.standards"),
    };

    /// <summary>Bytes eines bereits geladenen PDFs (z. B. aus dem Reader-Tab) — wird beim ersten Render übernommen.</summary>
    [Parameter] public byte[]? InitialPdfBytes { get; set; }

    /// <summary>Anzeigename zum vorgeladenen PDF (für Datei-Info und Download-Namen).</summary>
    [Parameter] public string? InitialPdfName { get; set; }

    /// <summary>True, wenn das Panel im Reader-Subtab steckt (kompaktere Texte, Vorbefüllungs-Hinweis).</summary>
    [Parameter] public bool Embedded { get; set; }

    private PdfDocumentHandle? _handle;
    private string? _currentFilename;
    private byte[]? _originalPdfBytes;
    private bool _prefilledFromReader;

    // Wasserzeichen + Seitenzahlen (Stempeln)
    private string _watermarkText = string.Empty;
    private bool _stampPageNumbers = true;
    private PageNumberPosition _stampPnPosition = PageNumberPosition.BottomCenter;
    private bool _isStamping;
    private string? _stampStatus;
    private bool _isLoading;
    private bool _isSaving;
    private bool _isCompressing;
    private int _compressQuality = 70;
    private string? _compressionResult;
    private string _encryptPassword = string.Empty;
    private bool _isEncrypting;
    private string? _encryptStatus;
    private readonly List<SelectedImage> _images = new();
    private PdfPageSizeMode _imgPageSize = PdfPageSizeMode.ImageSize;
    private bool _isBuildingImagesPdf;
    private string? _imgStatus;
    private int _dragIndex = -1;
    // FA-030/031/032: Konvertieren des geladenen PDF.
    private bool _isConverting;
    private ConversionFormat _convertFormat = ConversionFormat.Png;
    private string? _convertStatus;

    private static readonly (PdfPageSizeMode Mode, string LabelKey)[] ImagePageSizeModes =
    {
        (PdfPageSizeMode.ImageSize, "tools.img2pdf.size.image"),
        (PdfPageSizeMode.A4, "tools.img2pdf.size.a4"),
        (PdfPageSizeMode.Letter, "tools.img2pdf.size.letter")
    };

    private static readonly (int Quality, string LabelKey)[] CompressionPresets =
    {
        (40, "tools.compress.quality.low"),
        (70, "tools.compress.quality.medium"),
        (90, "tools.compress.quality.high")
    };
    private string? _errorMessage;
    private int _thumbnailProgress;
    private int _appendedPdfsCount;

    private List<PageState> _pages = new();
    private Dictionary<int, string> _thumbnails = new();
    private CancellationTokenSource? _thumbnailCts;

    private int SelectedCount => _pages.Count(p => p.Selected && !p.Deleted);

    private int SplitPointCount => _pages.Count(p => p.SplitBeforeThis && !p.Deleted);

    private bool HasPendingEdits =>
        _pages.Any(p => p.Deleted)
        || _pages.Any(p => p.Rotation != 0)
        || _pages.Any(p => p.SplitBeforeThis);

    private bool HasChanges => _appendedPdfsCount > 0 || HasPendingEdits;

    protected override async Task OnInitializedAsync()
    {
        // Vorbefüllung aus dem Reader (Subtab „Werkzeuge"): die dort bereits
        // geladenen Bytes direkt übernehmen — kein erneuter Datei-Dialog nötig.
        if (InitialPdfBytes is { Length: > 0 })
        {
            _prefilledFromReader = true;
            await LoadPdfBytesAsync(InitialPdfBytes, InitialPdfName);
        }
    }

    private async Task HandleFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        _isLoading = true;
        _prefilledFromReader = false;
        try
        {
            await using var stream = e.File.OpenReadStream(MaxFileSize);
            await using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            await LoadPdfBytesAsync(buffer.ToArray(), e.File.Name);
        }
        catch (Exception ex)
        {
            _errorMessage = $"PDF konnte nicht geöffnet werden: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Gemeinsamer Lade-Pfad für Datei-Dialog UND Vorbefüllung aus dem Reader.
    /// </summary>
    private async Task LoadPdfBytesAsync(byte[] bytes, string? filename)
    {
        _errorMessage = null;
        _isLoading = true;
        await UnloadCurrentAsync();

        try
        {
            _currentFilename = filename;
            _originalPdfBytes = bytes;
            using var buffer = new MemoryStream(bytes, writable: false);

            _handle = await Renderer.LoadAsync(buffer, new LoadOptions(), CancellationToken.None);
            _pages = Enumerable.Range(1, _handle.PageCount)
                .Select(i => new PageState { OriginalIndex = i })
                .ToList();
            _thumbnails = new Dictionary<int, string>(_handle.PageCount);
            _thumbnailProgress = 0;

            // Thumbnails sequenziell rendern, mit StateHasChanged zwischen
            // den Seiten, damit das UI laufend aktualisiert wird.
            _thumbnailCts = new CancellationTokenSource();
            _ = RenderThumbnailsAsync(_handle, _thumbnailCts.Token);
        }
        catch (Exception ex)
        {
            _errorMessage = $"PDF konnte nicht geöffnet werden: {ex.Message}";
            _handle = null;
            _pages.Clear();
            _originalPdfBytes = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RenderThumbnailsAsync(PdfDocumentHandle handle, CancellationToken ct)
    {
        try
        {
            for (var i = 1; i <= handle.PageCount; i++)
            {
                ct.ThrowIfCancellationRequested();
                var rendered = await Renderer.RenderPageAsync(
                    handle,
                    i,
                    new RenderOptions(Scale: 0.35),
                    ct);
                if (rendered.RasterBytes is not null && rendered.RasterFormat is not null)
                {
                    _thumbnails[i] = $"data:{rendered.RasterFormat};base64,{Convert.ToBase64String(rendered.RasterBytes)}";
                }
                _thumbnailProgress = i;
                await InvokeAsync(StateHasChanged);
                // Browser-Frame Zeit zum Atmen geben
                await Task.Yield();
            }
        }
        catch (OperationCanceledException) { /* erwartet bei Datei-Wechsel */ }
        catch (Exception ex)
        {
            _errorMessage = $"Thumbnail-Erzeugung abgebrochen: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleSelection(PageState page) => page.Selected = !page.Selected;

    private void SelectAll()
    {
        foreach (var page in _pages.Where(p => !p.Deleted)) page.Selected = true;
    }

    private void DeselectAll()
    {
        foreach (var page in _pages) page.Selected = false;
    }

    private void RotateSelected(int delta)
    {
        foreach (var page in _pages.Where(p => p.Selected && !p.Deleted))
        {
            page.Rotation = (((page.Rotation + delta) % 360) + 360) % 360;
        }
    }

    private void DeleteSelected()
    {
        foreach (var page in _pages.Where(p => p.Selected && !p.Deleted))
        {
            page.Deleted = true;
            page.Selected = false;
        }
    }

    private void UndoDeletes()
    {
        foreach (var page in _pages.Where(p => p.Deleted))
        {
            page.Deleted = false;
        }
    }

    private void ToggleSplitBefore(PageState page)
    {
        page.SplitBeforeThis = !page.SplitBeforeThis;
    }

    private void ResetSplitPoints()
    {
        foreach (var page in _pages)
        {
            page.SplitBeforeThis = false;
        }
    }

    private async Task HandleAppendFileAsync(InputFileChangeEventArgs e)
    {
        if (_originalPdfBytes is null) return;
        if (HasPendingEdits)
        {
            _errorMessage = "Bitte vorher speichern oder Änderungen verwerfen, bevor du eine weitere PDF anhängst.";
            return;
        }

        _isLoading = true;
        _errorMessage = null;
        try
        {
            var file = e.File;
            await using var stream = file.OpenReadStream(MaxFileSize);
            await using var newBuffer = new MemoryStream();
            await stream.CopyToAsync(newBuffer);
            var newBytes = newBuffer.ToArray();

            using var oldMs = new MemoryStream(_originalPdfBytes);
            using var newMs = new MemoryStream(newBytes);
            var merged = await Manipulator.MergeAsync(
                new Stream[] { oldMs, newMs },
                CancellationToken.None);

            // Aktuelle PDF entladen und mit den merged Bytes neu laden,
            // damit Thumbnails und Seitenzahl konsistent sind.
            _thumbnailCts?.Cancel();
            _thumbnailCts?.Dispose();
            if (_handle is not null)
            {
                try { await Renderer.UnloadAsync(_handle); } catch { /* ignore */ }
                _handle = null;
            }

            _originalPdfBytes = merged;
            using var loadMs = new MemoryStream(merged);
            _handle = await Renderer.LoadAsync(loadMs, new LoadOptions(), CancellationToken.None);

            _pages = Enumerable.Range(1, _handle.PageCount)
                .Select(i => new PageState { OriginalIndex = i })
                .ToList();
            _thumbnails = new Dictionary<int, string>(_handle.PageCount);
            _thumbnailProgress = 0;
            _appendedPdfsCount++;

            // Dateinamen anpassen — beim zweiten Append "_+2.pdf" etc.
            var baseName = System.IO.Path.GetFileNameWithoutExtension(_currentFilename ?? "pagebound");
            if (!baseName.EndsWith("_merged", StringComparison.Ordinal))
            {
                baseName += "_merged";
            }
            _currentFilename = $"{baseName}.pdf";

            _thumbnailCts = new CancellationTokenSource();
            _ = RenderThumbnailsAsync(_handle, _thumbnailCts.Token);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Anhängen fehlgeschlagen: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private List<int> ComputeSplitPointsInResult()
    {
        // Split-Punkte beziehen sich auf die fertige PDF nach Löschungen,
        // also nummerieren wir die nicht-gelöschten Seiten neu durch und
        // erfassen jede Position, vor der ein Split-Marker sitzt.
        var splitPoints = new List<int>();
        var newPos = 0;
        foreach (var page in _pages.Where(p => !p.Deleted))
        {
            if (page.SplitBeforeThis && newPos > 0)
            {
                splitPoints.Add(newPos);
            }
            newPos++;
        }
        return splitPoints;
    }

    private async Task SaveAsync()
    {
        if (_originalPdfBytes is null || !HasChanges) return;
        _isSaving = true;
        _errorMessage = null;
        try
        {
            byte[] working = _originalPdfBytes;

            // 1) Drehungen anwenden (auf dem Original-Seitenindex)
            var rotations = _pages
                .Where(p => !p.Deleted && p.Rotation != 0)
                .ToDictionary(p => p.OriginalIndex, p => p.Rotation);
            if (rotations.Count > 0)
            {
                using var ms = new MemoryStream(working);
                working = await Manipulator.RotateAsync(ms, rotations, CancellationToken.None);
            }

            // 2) Löschungen anwenden — Indizes beziehen sich noch auf das
            //    Original (Rotationen haben Indizes nicht verschoben).
            var deleted = _pages.Where(p => p.Deleted).Select(p => p.OriginalIndex).ToList();
            if (deleted.Count > 0)
            {
                using var ms = new MemoryStream(working);
                working = await Manipulator.DeletePagesAsync(ms, deleted, CancellationToken.None);
            }

            var baseName = !string.IsNullOrWhiteSpace(_currentFilename)
                ? System.IO.Path.GetFileNameWithoutExtension(_currentFilename)
                : "pagebound";

            var splitPoints = ComputeSplitPointsInResult();
            if (splitPoints.Count > 0)
            {
                // Mehrere Teil-PDFs erzeugen und nacheinander herunterladen.
                using var ms = new MemoryStream(working);
                var parts = await Manipulator.SplitAsync(ms, splitPoints, CancellationToken.None);
                for (var i = 0; i < parts.Count; i++)
                {
                    var name = $"{baseName}_part{i + 1}.pdf";
                    var b64 = Convert.ToBase64String(parts[i]);
                    await JS.InvokeVoidAsync(
                        "pageboundShortcuts.downloadBytes",
                        name,
                        b64,
                        "application/pdf");
                }
            }
            else
            {
                var downloadName = $"{baseName}_edited.pdf";
                var base64 = Convert.ToBase64String(working);
                await JS.InvokeVoidAsync(
                    "pageboundShortcuts.downloadBytes",
                    downloadName,
                    base64,
                    "application/pdf");
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Speichern fehlgeschlagen: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task CompressAsync()
    {
        if (_originalPdfBytes is null || _isCompressing) return;
        _isCompressing = true;
        _compressionResult = null;
        _errorMessage = null;
        try
        {
            var options = new CompressionOptions(ImageQuality: _compressQuality);
            await using var stream = new MemoryStream(_originalPdfBytes);
            var compressed = await Manipulator
                .CompressAsync(stream, options, null, CancellationToken.None)
                .ConfigureAwait(false);

            var origSize = _originalPdfBytes.Length;
            var newSize = compressed.Length;
            var ratio = origSize > 0 ? (1.0 - (double)newSize / origSize) * 100.0 : 0.0;
            _compressionResult = L.T("tools.compress.result", new Dictionary<string, object>
            {
                ["orig"] = FormatBytes(origSize),
                ["compressed"] = FormatBytes(newSize),
                ["ratio"] = ratio.ToString("F1", CultureInfo.InvariantCulture)
            });

            var filename = BuildCompressedFilename(_currentFilename);
            var base64 = Convert.ToBase64String(compressed);
            await JS.InvokeVoidAsync("pageboundShortcuts.downloadBytes", filename, base64, "application/pdf")
                .ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isCompressing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024L * 1024) return $"{bytes / 1024.0:F0} KB";
        if (bytes < 1024L * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F2} GB";
    }

    private static string BuildCompressedFilename(string? originalName)
    {
        var baseName = string.IsNullOrWhiteSpace(originalName) ? "document" : originalName;
        if (baseName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            baseName = baseName.Substring(0, baseName.Length - 4);
        }
        var safe = string.Concat(baseName.Select(c =>
            char.IsLetterOrDigit(c) || c is '_' or '-' or '.' or ' ' ? c : '_'));
        return $"{safe}.compressed.pdf";
    }

