@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject IPdfRenderer Renderer
@inject IPdfManipulator Manipulator
@inject IImageToPdfConverter ImageConverter
@inject IPdfConverter Converter
@inject IPdfArchiveService Archive
@inject ILocalizationService L
@inject IJSRuntime JS
@implements IAsyncDisposable

@*
    Wiederverwendbares PDF-Werkzeuge-Panel (extrahiert aus der /tools-Seite):
    - Standalone: <PdfToolsPanel /> auf /tools (PdfToolsPage liefert Masthead drumherum).
    - Embedded:   im Reader-Subtab „Werkzeuge" (ReaderPage) mit Embedded="true" und
                  optional vorbefüllten Bytes des dort geöffneten Dokuments
                  (InitialPdfBytes/InitialPdfName) — kein erneutes Laden nötig.
*@

<div>
    <div class="max-w-4xl mx-auto rounded-lg pb-glass p-4">
        <label class="flex flex-col gap-2 text-sm">
            <span class="font-medium">@L.T("tools.choosePdf")</span>
            <InputFile OnChange="HandleFileSelectedAsync"
                       accept=".pdf"
                       class="block text-sm file:mr-3 file:rounded file:border-0 file:bg-pb-accent file:px-3 file:py-1.5 file:font-semibold file:text-[var(--accent-ink)] file:cursor-pointer cursor-pointer" />
        </label>
        @if (Embedded && _prefilledFromReader)
        {
            <p class="mt-2 text-xs text-pb-fg-muted">@L.T("reader.tools.prefilled")</p>
        }
        @if (_errorMessage is not null)
        {
            <div class="mt-3 rounded border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">
                @_errorMessage
            </div>
        }
        @if (_isLoading)
        {
            <div class="mt-3 text-sm text-pb-fg-muted" aria-live="polite">@L.T("app.loadingShort")</div>
        }
        @if (_handle is not null)
        {
            <div class="mt-3 flex items-center gap-3 text-sm text-pb-fg-muted">
                <span><span class="font-medium text-pb-fg">@(_currentFilename ?? L.T("tools.fallbackFilename"))</span> · @_handle.PageCount @L.T("tools.pages")</span>
                @if (_thumbnailProgress < _handle.PageCount)
                {
                    <span class="text-xs">@L.T("tools.thumbnails.progress", new Dictionary<string, object> { ["current"] = _thumbnailProgress, ["total"] = _handle.PageCount })</span>
                    <div class="flex-1 h-1 bg-pb-bg rounded overflow-hidden max-w-xs">
                        <div class="h-full bg-pb-accent transition-all"
                             style="@($"width:{(_thumbnailProgress * 100.0 / _handle.PageCount).ToString("F1", CultureInfo.InvariantCulture)}%")"></div>
                    </div>
                }
            </div>
        }
    </div>

    @* Bilder → PDF (FA-025) — eigenständige Erstellung, unabhängig von einer geladenen PDF. *@
    <div class="max-w-4xl mx-auto mt-4 rounded-lg pb-glass p-4">
        <div class="flex items-center justify-between gap-3">
            <span class="font-medium text-sm">@L.T("tools.img2pdf.heading")</span>
            <label class="btn primary cursor-pointer">
                @L.T("tools.img2pdf.choose")
                <InputFile OnChange="HandleImagesSelectedAsync"
                           accept="image/png,image/jpeg"
                           multiple
                           class="hidden" />
            </label>
        </div>
        <p class="mt-1 text-xs text-pb-fg-muted">@L.T("tools.img2pdf.hint")</p>

        @if (_images.Count > 0)
        {
            <div class="mt-3 flex items-center gap-2 text-sm flex-wrap">
                <span class="text-pb-fg-muted">@L.T("tools.img2pdf.pageSize")</span>
                @foreach (var mode in ImagePageSizeModes)
                {
                    var m = mode;
                    var active = _imgPageSize == m.Mode;
                    <button type="button"
                            class="@($"rounded border px-2 py-0.5 text-xs {(active ? "pb-toolbtn is-on" : "pb-toolbtn")}")"
                            @onclick="@(() => _imgPageSize = m.Mode)">
                        @L.T(m.LabelKey)
                    </button>
                }
                <button type="button"
                        class="btn primary sm ml-auto disabled:opacity-40"
                        disabled="@_isBuildingImagesPdf"
                        @onclick="BuildImagesPdfAsync">
                    @(_isBuildingImagesPdf
                        ? L.T("tools.img2pdf.building")
                        : L.T("tools.img2pdf.build", new Dictionary<string, object> { ["count"] = _images.Count }))
                </button>
                <button type="button"
                        class="text-xs text-pb-fg-muted hover:text-pb-fg"
                        @onclick="@(() => _images.Clear())">
                    @L.T("tools.img2pdf.clear")
                </button>
            </div>

            <ul class="mt-3 grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-3">
                @for (var i = 0; i < _images.Count; i++)
                {
                    var idx = i;
                    var image = _images[idx];
                    <li draggable="true"
                        class="relative rounded border border-pb-border bg-pb-surface p-1 cursor-move"
                        @ondragstart="@(() => _dragIndex = idx)"
                        @ondragover:preventDefault="true"
                        @ondrop="@(() => OnImageDrop(idx))"
                        title="@image.Name">
                        <div class="aspect-[3/4] flex items-center justify-center bg-pb-bg rounded overflow-hidden">
                            <img src="@image.DataUrl" alt="@image.Name" draggable="false" class="max-w-full max-h-full" />
                        </div>
                        <div class="mt-1 flex items-center justify-between text-xs">
                            <span class="text-pb-fg-muted tabular-nums">@(idx + 1)</span>
                            <button type="button"
                                    class="text-pb-fg-muted hover:text-red-400"
                                    @onclick="@(() => _images.RemoveAt(idx))"
                                    @onclick:stopPropagation
                                    aria-label="@L.T("tools.img2pdf.remove")">✕</button>
                        </div>
                    </li>
                }
            </ul>

            @if (_imgStatus is not null)
            {
                <div class="mt-3 rounded border border-green-300/40 bg-green-50/10 px-3 py-2 text-sm text-pb-fg">
                    @_imgStatus
                    <button type="button" class="float-right text-pb-fg-muted hover:text-pb-fg"
                            @onclick="@(() => _imgStatus = null)" aria-label="@L.T("common.close")">✕</button>
                </div>
            }
        }
    </div>

    @if (_handle is not null && _pages.Count > 0)
    {
        @* Kategorie-Tabs (Desktop-App-Muster) — bündeln die Werkzeug-Leisten, damit
           nie mehr als die Leisten einer Kategorie gleichzeitig sichtbar sind. *@
        <div class="pb-segbar max-w-4xl mx-auto mt-4" role="tablist" aria-label="@L.T("tools.categories.aria")">
            @foreach (var cat in ToolCategories)
            {
                var c = cat;
                <button type="button" role="tab"
                        aria-selected="@((_activeCategory == c.Category).ToString().ToLowerInvariant())"
                        class="@(_activeCategory == c.Category ? "pb-seg is-on" : "pb-seg")"
                        @onclick="@(() => _activeCategory = c.Category)">
                    @L.T(c.LabelKey)
                </button>
            }
        </div>

        @if (_activeCategory == ToolCategory.Pages)
        {
        <div class="max-w-4xl mx-auto mt-4 rounded-lg pb-glass p-3 flex flex-wrap items-center gap-2 text-sm">
            <span class="text-pb-fg-muted">@L.T("tools.selection.label")</span>
            <button type="button"
                    class="rounded border border-pb-border px-2 py-0.5 text-pb-fg-muted hover:text-pb-fg"
                    @onclick="SelectAll">@L.T("tools.selection.all")</button>
            <button type="button"
                    class="rounded border border-pb-border px-2 py-0.5 text-pb-fg-muted hover:text-pb-fg"
                    @onclick="DeselectAll">@L.T("tools.selection.none")</button>
            <span class="text-xs text-pb-fg-muted">@L.T("tools.selection.count", new Dictionary<string, object> { ["selected"] = SelectedCount, ["total"] = _pages.Count(p => !p.Deleted) })</span>

            <span class="ml-3 text-pb-fg-muted">@L.T("tools.action.label")</span>
            <button type="button"
                    class="rounded border border-pb-border bg-pb-bg px-2 py-0.5 hover:bg-pb-surface disabled:opacity-40"
                    disabled="@(SelectedCount == 0)"
                    @onclick="@(() => RotateSelected(-90))"
                    title="@L.T("tools.action.rotateCcwTitle")">
                @L.T("tools.action.rotateCcw")
            </button>
            <button type="button"
                    class="rounded border border-pb-border bg-pb-bg px-2 py-0.5 hover:bg-pb-surface disabled:opacity-40"
                    disabled="@(SelectedCount == 0)"
                    @onclick="@(() => RotateSelected(90))"
                    title="@L.T("tools.action.rotateCwTitle")">
                @L.T("tools.action.rotateCw")
            </button>
            <button type="button"
                    class="rounded border border-red-300/40 px-2 py-0.5 text-red-400 hover:bg-red-50/10 disabled:opacity-40"
                    disabled="@(SelectedCount == 0 || SelectedCount == _pages.Count(p => !p.Deleted))"
                    @onclick="DeleteSelected"
                    title="@L.T("tools.action.deleteTitle")">
                @L.T("tools.action.delete")
            </button>

            <label class="rounded border border-pb-border bg-pb-bg px-2 py-0.5 text-pb-fg-muted hover:text-pb-fg cursor-pointer @(HasPendingEdits ? "opacity-40 cursor-not-allowed" : "")"
                   title="@(HasPendingEdits ? L.T("tools.action.appendBlockedTitle") : L.T("tools.action.appendTitle"))">
                @L.T("tools.action.append")
                <InputFile OnChange="HandleAppendFileAsync"
                           accept=".pdf"
                           disabled="@HasPendingEdits"
                           class="hidden" />
            </label>

            @if (SplitPointCount > 0)
            {
                <span class="text-xs rounded bg-pb-accent/15 px-2 py-0.5 text-pb-accent">
                    @L.T("tools.split.summary", new Dictionary<string, object> { ["count"] = SplitPointCount, ["parts"] = SplitPointCount + 1 })
                </span>
                <button type="button"
                        class="text-xs text-pb-fg-muted hover:text-pb-fg"
                        @onclick="ResetSplitPoints">
                    @L.T("tools.split.reset")
                </button>
            }

            <button type="button"
                    class="btn primary sm ml-auto disabled:opacity-40"
                    disabled="@(_isSaving || !HasChanges)"
                    @onclick="SaveAsync"
                    title="@(HasChanges ? L.T("tools.save.title") : L.T("tools.save.noChangesTitle"))">
                @(_isSaving
                    ? L.T("common.savingProgress")
                    : SplitPointCount > 0
                        ? L.T("tools.save.changesWithParts", new Dictionary<string, object> { ["parts"] = SplitPointCount + 1 })
                        : L.T("tools.save.changes"))
            </button>
        </div>
        }

        @if (_activeCategory == ToolCategory.Export)
        {
        @* Compress-Bar (FA-026) — eigene Reihe weil destruktiv (verliert Vektor-Text)
           und unabhängig von den Pages-Edits oben. *@
        <div class="max-w-4xl mx-auto mt-2 rounded-lg pb-glass p-3 flex flex-wrap items-center gap-2 text-sm">
            <span class="text-pb-fg-muted">@L.T("tools.compress.label")</span>
            @foreach (var preset in CompressionPresets)
            {
                var p = preset;
                var isActive = _compressQuality == p.Quality;
                <button type="button"
                        class="@($"rounded border px-2 py-0.5 text-xs {(isActive ? "pb-toolbtn is-on" : "pb-toolbtn")}")"
                        @onclick="@(() => _compressQuality = p.Quality)">
                    @L.T(p.LabelKey)
                </button>
            }
            <button type="button"
                    class="ml-auto rounded border border-pb-border bg-pb-bg px-3 py-1 text-pb-fg-muted hover:text-pb-fg disabled:opacity-40"
                    disabled="@(_isCompressing || _handle is null)"
                    title="@L.T("tools.compress.title")"
                    @onclick="CompressAsync">
                @(_isCompressing ? L.T("tools.compress.running") : L.T("tools.compress.button"))
            </button>
        </div>

        @if (_compressionResult is not null)
        {
            <div class="max-w-4xl mx-auto mt-2 rounded border border-green-300/40 bg-green-50/10 px-3 py-2 text-sm text-pb-fg">
                @_compressionResult
                <button type="button"
                        class="float-right text-pb-fg-muted hover:text-pb-fg"
                        @onclick="@(() => _compressionResult = null)"
                        aria-label="@L.T("common.close")">✕</button>
            </div>
        }
        }

        @* Encrypt-Bar (FA-027) — bis zum WASM-Perf-Umbau (WebCrypto/qpdf) ausgeblendet. *@
        @if (EncryptionUiEnabled && _activeCategory == ToolCategory.Security)
        {
        <div class="max-w-4xl mx-auto mt-2 rounded-lg pb-glass p-3 flex flex-wrap items-center gap-2 text-sm">
            <span class="text-pb-fg-muted">@L.T("tools.encrypt.label")</span>
            <input type="password"
                   @bind="_encryptPassword"
                   @bind:event="oninput"
                   class="flex-1 min-w-[12rem] rounded border border-pb-border bg-pb-bg px-3 py-1.5 text-sm"
                   placeholder="@L.T("tools.encrypt.placeholder")"
                   autocomplete="new-password"
                   aria-label="@L.T("tools.encrypt.label")" />
            <button type="button"
                    class="ml-auto rounded border border-pb-border bg-pb-bg px-3 py-1 text-pb-fg-muted hover:text-pb-fg disabled:opacity-40"
                    disabled="@(_isEncrypting || _handle is null || string.IsNullOrEmpty(_encryptPassword))"
                    title="@L.T("tools.encrypt.title")"
                    @onclick="EncryptPdfAsync">
                @(_isEncrypting ? L.T("tools.encrypt.running") : L.T("tools.encrypt.button"))
            </button>
        </div>
        @if (_encryptStatus is not null)
        {
            <div class="max-w-4xl mx-auto mt-2 rounded border border-green-300/40 bg-green-50/10 px-3 py-2 text-sm text-pb-fg">
                @_encryptStatus
                <button type="button"
                        class="float-right text-pb-fg-muted hover:text-pb-fg"
                        @onclick="@(() => _encryptStatus = null)"
                        aria-label="@L.T("common.close")">✕</button>
            </div>
        }
        <p class="max-w-4xl mx-auto mt-1 text-xs text-pb-fg-muted">@L.T("tools.encrypt.note")</p>
        }

        @if (_activeCategory == ToolCategory.Export)
        {
        @* Konvertieren (FA-030 PNG/JPG, FA-031 Text, FA-032 HTML) *@
        <div class="max-w-4xl mx-auto mt-2 rounded-lg pb-glass p-3 flex flex-wrap items-center gap-2 text-sm">
            <span class="text-pb-fg-muted">@L.T("tools.convert.label")</span>
            <select @bind="_convertFormat"
                    class="rounded border border-pb-border bg-pb-bg px-2 py-1 text-sm"
                    aria-label="@L.T("tools.convert.label")">
                <option value="@ConversionFormat.Png">@L.T("tools.convert.png")</option>
                <option value="@ConversionFormat.Jpg">@L.T("tools.convert.jpg")</option>
                <option value="@ConversionFormat.Text">@L.T("tools.convert.text")</option>
                <option value="@ConversionFormat.Html">@L.T("tools.convert.html")</option>
                <option value="@ConversionFormat.Csv">@L.T("tools.convert.csv")</option>
                <option value="@ConversionFormat.Docx">@L.T("tools.convert.docx")</option>
            </select>
            <button type="button"
                    class="ml-auto rounded border border-pb-border bg-pb-bg px-3 py-1 text-pb-fg-muted hover:text-pb-fg disabled:opacity-40"
                    disabled="@(_isConverting || _handle is null)"
                    title="@L.T("tools.convert.title")"
                    @onclick="ConvertPdfAsync">
                @(_isConverting ? L.T("tools.convert.running") : L.T("tools.convert.button"))
            </button>
        </div>
        @if (_convertStatus is not null)
        {
            <div class="max-w-4xl mx-auto mt-2 rounded border border-green-300/40 bg-green-50/10 px-3 py-2 text-sm text-pb-fg">
                @_convertStatus
                <button type="button"
                        class="float-right text-pb-fg-muted hover:text-pb-fg"
                        @onclick="@(() => _convertStatus = null)"
                        aria-label="@L.T("common.close")">✕</button>
            </div>
        }
        <p class="max-w-4xl mx-auto mt-1 text-xs text-pb-fg-muted">@L.T("tools.convert.note")</p>
        }

        @if (_activeCategory == ToolCategory.Stamp)
        {
        @* Formularfelder anlegen (Roadmap D1) *@
        <div class="max-w-4xl mx-auto mt-2 rounded-lg pb-glass p-3 space-y-2 text-sm">
            <div class="flex flex-wrap items-center gap-2">
                <span class="text-pb-fg-muted">@L.T("tools.formfields.label")</span>
                <input @bind="_ffName" @bind:event="oninput" placeholder="@L.T("tools.formfields.name")"
                       class="rounded border border-pb-border bg-pb-bg px-2 py-1 text-sm" aria-label="@L.T("tools.formfields.name")" />
                <select @bind="_ffType" class="rounded border border-pb-border bg-pb-bg px-2 py-1 text-sm" aria-label="@L.T("tools.formfields.type")">
                    <option value="text">@L.T("tools.formfields.type.text")</option>
                    <option value="checkbox">@L.T("tools.formfields.type.checkbox")</option>
                </select>
                <input type="number" min="1" @bind="_ffPage" class="w-16 rounded border border-pb-border bg-pb-bg px-2 py-1 text-sm" aria-label="@L.T("tools.formfields.page")" />
                <select @bind="_ffAnchor" class="rounded border border-pb-border bg-pb-bg px-2 py-1 text-sm" aria-label="@L.T("tools.formfields.anchor")">
                    <option value="tl">@L.T("tools.formfields.anchor.tl")</option>
                    <option value="tr">@L.T("tools.formfields.anchor.tr")</option>
                    <option value="mc">@L.T("tools.formfields.anchor.mc")</option>
                    <option value="bl">@L.T("tools.formfields.anchor.bl")</option>
                    <option value="br">@L.T("tools.formfields.anchor.br")</option>
                </select>
                <button type="button" class="rounded border border-pb-border px-2 py-0.5 text-pb-fg-muted hover:text-pb-fg disabled:opacity-40"
                        disabled="@string.IsNullOrWhiteSpace(_ffName)" @onclick="AddFormField">@L.T("tools.formfields.add")</button>
            </div>
            @if (_formFields.Count > 0)
            {
                <ul class="text-xs text-pb-fg-muted rounded border border-pb-border divide-y divide-pb-border max-h-32 overflow-auto">
                    @foreach (var f in _formFields)
                    {
                        <li class="px-2 py-1">@f.Name · @(f.FieldType == "checkbox" ? L.T("tools.formfields.type.checkbox") : L.T("tools.formfields.type.text")) · @L.T("tools.pages") @f.PageNumber</li>
                    }
                </ul>
                <div class="flex items-center gap-2">
                    <button type="button" class="btn primary disabled:opacity-40" disabled="@_isCreatingFields" @onclick="ApplyFormFieldsAsync">
                        @(_isCreatingFields ? L.T("tools.formfields.running") : L.T("tools.formfields.apply"))
                    </button>
                    <button type="button" class="rounded border border-pb-border px-2 py-0.5 text-pb-fg-muted hover:text-pb-fg" @onclick="@(() => _formFields.Clear())">@L.T("tools.formfields.clear")</button>
                </div>
            }
            <p class="text-xs text-pb-fg-muted">@L.T("tools.formfields.note")</p>
        </div>

        @* Metadaten bearbeiten (MCP↔PWA-Parität: pdf_set_metadata) *@
        <div class="max-w-4xl mx-auto mt-2 rounded-lg pb-glass p-3 space-y-2 text-sm">
            <div class="flex flex-wrap items-center gap-2">
                <span class="text-pb-fg-muted">@L.T("tools.metadata.label")</span>
                <button type="button" class="rounded border border-pb-border px-2 py-0.5 text-pb-fg-muted hover:text-pb-fg disabled:opacity-40"
                        disabled="@_isSettingMeta" @onclick="LoadMetadataAsync">@L.T("tools.metadata.load")</button>
            </div>
            <div class="grid gap-2 sm:grid-cols-2">
                <input @bind="_metaTitle" placeholder="@L.T("tools.metadata.title")" class="rounded border border-pb-border bg-pb-bg px-2 py-1 text-sm" aria-label="@L.T("tools.metadata.title")" />
                <input @bind="_metaAuthor" placeholder="@L.T("tools.metadata.author")" class="rounded border border-pb-border bg-pb-bg px-2 py-1 text-sm" aria-label="@L.T("tools.metadata.author")" />
                <input @bind="_metaSubject" placeholder="@L.T("tools.metadata.subject")" class="rounded border border-pb-border bg-pb-bg px-2 py-1 text-sm" aria-label="@L.T("tools.metadata.subject")" />
                <input @bind="_metaKeywords" placeholder="@L.T("tools.metadata.keywords")" class="rounded border border-pb-border bg-pb-bg px-2 py-1 text-sm" aria-label="@L.T("tools.metadata.keywords")" />
            </div>
            <button type="button" class="btn primary disabled:opacity-40" disabled="@_isSettingMeta" @onclick="ApplyMetadataAsync">
                @(_isSettingMeta ? L.T("tools.metadata.running") : L.T("tools.metadata.apply"))
            </button>
            <p class="text-xs text-pb-fg-muted">@L.T("tools.metadata.note")</p>
        </div>
        }

        @if (_activeCategory == ToolCategory.Standards)
        {
        @* PDF/A (Best Effort) — MCP-Parität: pdf_to_pdfa. Keine Konformitätsgarantie. *@
        <div class="max-w-4xl mx-auto mt-2 rounded-lg pb-glass p-3 space-y-2 text-sm">
            <div class="flex flex-wrap items-center gap-2">
                <span class="text-pb-fg-muted">@L.T("tools.pdfa.label")</span>
                <label class="flex items-center gap-1.5 cursor-pointer whitespace-nowrap">
                    <input type="checkbox" @bind="_pdfaFlatten" /> @L.T("tools.pdfa.flatten")
                </label>
                <label class="flex items-center gap-1.5 cursor-pointer whitespace-nowrap" title="@L.T("tools.pdfa.embedFontsTitle")">
                    <input type="checkbox" @bind="_pdfaEmbedFonts" /> @L.T("tools.pdfa.embedFonts")
                </label>
                <button type="button"
                        class="ml-auto rounded border border-pb-border bg-pb-bg px-3 py-1 text-pb-fg-muted hover:text-pb-fg disabled:opacity-40"
                        disabled="@(_isConvertingPdfa || _handle is null)"
                        title="@L.T("tools.pdfa.buttonTitle")"
                        @onclick="ConvertToPdfAAsync">
                    @(_isConvertingPdfa ? L.T("tools.pdfa.running") : L.T("tools.pdfa.button"))
                </button>
            </div>
            @if (_pdfaStatus is not null)
            {
                <div class="rounded border border-green-300/40 bg-green-50/10 px-3 py-2 text-pb-fg">
                    @_pdfaStatus
                    <button type="button" class="float-right text-pb-fg-muted hover:text-pb-fg"
                            @onclick="@(() => _pdfaStatus = null)" aria-label="@L.T("common.close")">✕</button>
                </div>
            }
            @if (_pdfaWarnings.Count > 0)
            {
                <div class="rounded border border-amber-300/40 bg-amber-50/10 px-3 py-2">
                    <p class="font-medium text-pb-fg">@L.T("tools.pdfa.warningsHeading")</p>
                    <ul class="mt-1 list-disc pl-5 text-xs text-pb-fg-muted space-y-0.5">
                        @foreach (var warning in _pdfaWarnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </div>
            }
            <p class="text-xs text-pb-fg-muted">@L.T("tools.pdfa.note")</p>
        </div>
        }

        @if (_activeCategory == ToolCategory.Security)
        {
        @* Signieren (Zertifikat, P12) — MCP-Parität: pdf_sign. Kryptografische
           Signatur (adbe.pkcs7.detached); Abgrenzung zur optischen Bild-Signatur
           mit Hash-Badge im Reader siehe tools.sign.note. *@
        <div class="max-w-4xl mx-auto mt-2 rounded-lg pb-glass p-3 space-y-2 text-sm">
            <div class="flex flex-wrap items-center gap-2">
                <span class="text-pb-fg-muted">@L.T("tools.sign.label")</span>
                <label class="rounded border border-pb-border bg-pb-bg px-2 py-0.5 text-pb-fg-muted hover:text-pb-fg cursor-pointer">
                    @L.T("tools.sign.chooseCert")
                    <InputFile OnChange="HandleSignCertSelectedAsync"
                               accept=".p12,.pfx"
