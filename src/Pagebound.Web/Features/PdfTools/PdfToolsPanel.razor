    // --- Signieren (Zertifikat, P12) — MCP-Parität: pdf_sign -------------------
    // Property-Injection statt @inject, damit alle Sign-Änderungen in diesem
    // Block gebündelt bleiben (Header wird parallel anderweitig bearbeitet).
    [Inject] private IPdfSignService SignService { get; set; } = default!;

    private const long MaxCertFileSize = 1L * 1024 * 1024; // 1 MB reicht für P12/PFX-Dateien
    private byte[]? _signCertBytes;
    private string? _signCertName;
    private string _signPassword = string.Empty;
    private string _signReason = string.Empty;
    private string _signLocation = string.Empty;
    private bool _isSigning;
    private string? _signStatus;
    private string? _signSubject;
    private readonly List<string> _signWarnings = new();

    private async Task HandleSignCertSelectedAsync(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        _signStatus = null;
        _signSubject = null;
        _signWarnings.Clear();
        try
        {
            await using var stream = e.File.OpenReadStream(MaxCertFileSize);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _signCertBytes = ms.ToArray();
            _signCertName = e.File.Name;
        }
        catch (Exception ex)
        {
            _signCertBytes = null;
            _signCertName = null;
            _errorMessage = $"Zertifikat konnte nicht geladen werden: {ex.Message}";
        }
    }

    private async Task SignPdfAsync()
    {
        if (_originalPdfBytes is null || _signCertBytes is null || _isSigning || string.IsNullOrEmpty(_signPassword)) return;
        _isSigning = true;
        _signStatus = null;
        _signSubject = null;
        _signWarnings.Clear();
        _errorMessage = null;
        try
        {
            var options = new PdfSignOptions(
                Reason: string.IsNullOrWhiteSpace(_signReason) ? null : _signReason.Trim(),
                Location: string.IsNullOrWhiteSpace(_signLocation) ? null : _signLocation.Trim(),
                ContactInfo: null);
            await using var stream = new MemoryStream(_originalPdfBytes);
            var result = await SignService.SignAsync(stream, _signCertBytes, _signPassword, options, CancellationToken.None)
                .ConfigureAwait(false);

            var filename = BuildSignedFilename(_currentFilename);
            await JS.InvokeVoidAsync(
                "pageboundShortcuts.downloadBytes",
                filename,
                Convert.ToBase64String(result.Bytes),
                "application/pdf").ConfigureAwait(false);

            _signWarnings.AddRange(result.Warnings);
            _signSubject = result.SignerSubject;
            _signStatus = L.T("tools.sign.done", new Dictionary<string, object> { ["name"] = filename });
            _signPassword = string.Empty; // Passwort nicht im UI-State behalten
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSigning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string BuildSignedFilename(string? originalName)
    {
        var baseName = string.IsNullOrWhiteSpace(originalName) ? "dokument" : originalName;
        if (baseName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            baseName = baseName[..^4];
        var safe = string.Concat(baseName.Select(c =>
            char.IsLetterOrDigit(c) || c is '_' or '-' or '.' or ' ' ? c : '_'));
        return $"{safe}-signiert.pdf";
    }
