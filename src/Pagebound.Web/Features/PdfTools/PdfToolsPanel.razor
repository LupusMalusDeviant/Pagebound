    // --- Bilder → PDF (FA-025) -----------------------------------------------

    private async Task HandleImagesSelectedAsync(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        _imgStatus = null;
        const long maxPerImage = 50L * 1024 * 1024;
        try
        {
            foreach (var file in e.GetMultipleFiles(maximumFileCount: 200))
            {
                await using var stream = file.OpenReadStream(maxPerImage);
                await using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var bytes = ms.ToArray();
                var mime = string.IsNullOrWhiteSpace(file.ContentType)
                    ? (file.Name.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ? "image/png" : "image/jpeg")
                    : file.ContentType;
                _images.Add(new SelectedImage
                {
                    Name = file.Name,
                    Mime = mime,
                    Bytes = bytes,
                    DataUrl = $"data:{mime};base64,{Convert.ToBase64String(bytes)}"
                });
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Bild konnte nicht geladen werden: {ex.Message}";
        }
    }

    private void OnImageDrop(int targetIndex)
    {
        if (_dragIndex < 0 || _dragIndex >= _images.Count || _dragIndex == targetIndex)
        {
            _dragIndex = -1;
            return;
        }
        var item = _images[_dragIndex];
        _images.RemoveAt(_dragIndex);
        _images.Insert(targetIndex, item);
        _dragIndex = -1;
    }

    private async Task BuildImagesPdfAsync()
    {
        if (_images.Count == 0 || _isBuildingImagesPdf) return;
        _isBuildingImagesPdf = true;
        _errorMessage = null;
        _imgStatus = null;
        try
        {
            var inputs = _images.Select(i => new PdfImageInput(i.Bytes, i.Mime)).ToList();
            var options = new ImageToPdfOptions(_imgPageSize);
            var pdf = await ImageConverter.ConvertAsync(inputs, options, CancellationToken.None).ConfigureAwait(false);

            const string name = "bilder.pdf";
            await JS.InvokeVoidAsync("pageboundShortcuts.downloadBytes", name, Convert.ToBase64String(pdf), "application/pdf")
                .ConfigureAwait(false);
            _imgStatus = L.T("tools.img2pdf.result", new Dictionary<string, object> { ["count"] = _images.Count, ["name"] = name });
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBuildingImagesPdf = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task UnloadCurrentAsync()
    {
        _thumbnailCts?.Cancel();
