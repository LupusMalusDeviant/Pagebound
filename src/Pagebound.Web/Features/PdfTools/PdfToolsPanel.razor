    // --- Formularfelder anlegen (Roadmap D1) ---------------------------------
    private string _ffName = string.Empty;
    private string _ffType = "text";
    private int _ffPage = 1;
    private string _ffAnchor = "tl";
    private bool _isCreatingFields;
    private readonly List<FormFieldRegion> _formFields = new();

    private void AddFormField()
    {
        if (_handle is null || string.IsNullOrWhiteSpace(_ffName)) return;
        var page = Math.Clamp(_ffPage, 1, _handle.PageCount);
        var isCheck = _ffType == "checkbox";
        double w = isCheck ? 0.03 : 0.28;
        double h = isCheck ? 0.03 : 0.035;
        var a = (string.IsNullOrEmpty(_ffAnchor) ? "tl" : _ffAnchor).PadRight(2, 'l');
        double x = a[1] switch { 'c' => 0.5 - w / 2, 'r' => 0.92 - w, _ => 0.08 };
        double y = a[0] switch { 'm' => 0.5 - h / 2, 'b' => 0.90 - h, _ => 0.08 };
        _formFields.Add(new FormFieldRegion(page, x, y, w, h, _ffName.Trim(), isCheck ? "checkbox" : "text"));
        _ffName = string.Empty;
    }

    private async Task ApplyFormFieldsAsync()
    {
        if (_originalPdfBytes is null || _formFields.Count == 0 || _isCreatingFields) return;
        _isCreatingFields = true;
        _convertStatus = null;
        try
        {
            await using var stream = new MemoryStream(_originalPdfBytes);
            var result = await Manipulator.CreateFormFieldsAsync(stream, _formFields, CancellationToken.None).ConfigureAwait(false);
            var filename = BuildConvertedFilename(_currentFilename, "formfields.pdf");
            await JS.InvokeVoidAsync(
                "pageboundShortcuts.downloadBytes",
                filename,
                Convert.ToBase64String(result),
                "application/pdf").ConfigureAwait(false);
            _convertStatus = L.T("tools.formfields.done", new Dictionary<string, object> { ["count"] = _formFields.Count });
            _formFields.Clear();
        }
        catch (Exception ex)
        {
            _convertStatus = L.T("tools.convert.error", new Dictionary<string, object> { ["message"] = ex.Message });
        }
        finally
        {
            _isCreatingFields = false;
            await InvokeAsync(StateHasChanged);
        }
    }

