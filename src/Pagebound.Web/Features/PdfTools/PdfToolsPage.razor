@page "/tools"
@inject ILocalizationService L

@*
    Standalone-Seite für die PDF-Werkzeuge. Die eigentliche Funktionalität
    steckt in <PdfToolsPanel /> — dieselbe Komponente läuft auch als Subtab
    „Werkzeuge" im Reader (dort mit vorbefülltem Dokument).
*@

<PageTitle>@L.T("tools.pageTitle")</PageTitle>

<section class="mx-auto max-w-[1800px] px-4 sm:px-6 lg:px-8 py-8">
    <header class="max-w-4xl mx-auto masthead-pg">
        <div class="folio-line">
            <span>@L.T("home.ed.local")</span><span class="sep">·</span>
            <span>@L.T("tools.folio.noUpload")</span>
        </div>
        <h1 class="page-title">@L.T("tools.heading")</h1>
        <p class="standfirst">@L.T("tools.subheading")</p>
    </header>

    <PdfToolsPanel />
</section>
