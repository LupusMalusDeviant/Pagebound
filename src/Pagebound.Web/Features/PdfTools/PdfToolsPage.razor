@page "/tools"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject IPdfRenderer Renderer
@inject IPdfManipulator Manipulator
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>PDF-Werkzeuge — Pagebound</PageTitle>

<section class="mx-auto max-w-[1800px] px-4 sm:px-6 lg:px-8 py-8">
    <header class="max-w-4xl mx-auto mb-6">
        <h1 class="text-2xl font-bold">PDF-Werkzeuge</h1>
        <p class="mt-1 text-sm text-pb-fg-muted">
            Seiten drehen, löschen, zusammenfügen — Acrobat-Pro-Funktionen,
            kostenfrei und lokal im Browser. (Erste Iteration: Drehen / Löschen / Save.)
        </p>
    </header>

    <div class="max-w-4xl mx-auto rounded-lg border border-pb-border bg-pb-surface p-4">
        <label class="flex flex-col gap-2 text-sm">
            <span class="font-medium">PDF auswählen</span>
            <InputFile OnChange="HandleFileSelectedAsync"
                       accept=".pdf"
                       class="block text-sm file:mr-3 file:rounded file:border-0 file:bg-pb-accent file:px-3 file:py-1.5 file:text-white file:cursor-pointer cursor-pointer" />
        </label>
        @if (_errorMessage is not null)
        {
            <div class="mt-3 rounded border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">
                @_errorMessage
            </div>
        }
        @if (_isLoading)
        {
            <div class="mt-3 text-sm text-pb-fg-muted" aria-live="polite">Lade …</div>
        }
        @if (_handle is not null)
        {
            <div class="mt-3 flex items-center gap-3 text-sm text-pb-fg-muted">
                <span><span class="font-medium text-pb-fg">@(_currentFilename ?? "PDF")</span> · @_handle.PageCount Seiten</span>
                @if (_thumbnailProgress < _handle.PageCount)
                {
                    <span class="text-xs">Thumbnails: @_thumbnailProgress / @_handle.PageCount</span>
                    <div class="flex-1 h-1 bg-pb-bg rounded overflow-hidden max-w-xs">
                        <div class="h-full bg-pb-accent transition-all"
                             style="@($"width:{(_thumbnailProgress * 100.0 / _handle.PageCount).ToString("F1", CultureInfo.InvariantCulture)}%")"></div>
                    </div>
                }
            </div>
        }
    </div>

    @if (_handle is not null && _pages.Count > 0)
    {
        <div class="max-w-4xl mx-auto mt-4 rounded-lg border border-pb-border bg-pb-surface p-3 flex flex-wrap items-center gap-2 text-sm">
            <span class="text-pb-fg-muted">Auswahl:</span>
            <button type="button"
                    class="rounded border border-pb-border px-2 py-0.5 text-pb-fg-muted hover:text-pb-fg"
                    @onclick="SelectAll">Alle</button>
            <button type="button"
                    class="rounded border border-pb-border px-2 py-0.5 text-pb-fg-muted hover:text-pb-fg"
                    @onclick="DeselectAll">Keine</button>
            <span class="text-xs text-pb-fg-muted">@SelectedCount von @_pages.Count(p => !p.Deleted)</span>

            <span class="ml-3 text-pb-fg-muted">Aktion:</span>
            <button type="button"
                    class="rounded border border-pb-border bg-pb-bg px-2 py-0.5 hover:bg-pb-surface disabled:opacity-40"
                    disabled="@(SelectedCount == 0)"
                    @onclick="@(() => RotateSelected(-90))"
                    title="Markierte Seiten 90° gegen den Uhrzeigersinn drehen">
                ↺ −90°
            </button>
            <button type="button"
                    class="rounded border border-pb-border bg-pb-bg px-2 py-0.5 hover:bg-pb-surface disabled:opacity-40"
                    disabled="@(SelectedCount == 0)"
                    @onclick="@(() => RotateSelected(90))"
                    title="Markierte Seiten 90° im Uhrzeigersinn drehen">
                ↻ +90°
            </button>
            <button type="button"
                    class="rounded border border-red-300/40 px-2 py-0.5 text-red-400 hover:bg-red-50/10 disabled:opacity-40"
                    disabled="@(SelectedCount == 0 || SelectedCount == _pages.Count(p => !p.Deleted))"
                    @onclick="DeleteSelected"
                    title="Markierte Seiten aus der PDF entfernen (mindestens eine Seite muss übrig bleiben)">
                🗑 Löschen
            </button>

            <button type="button"
                    class="ml-auto rounded bg-pb-accent px-3 py-1 text-white hover:opacity-90 disabled:opacity-40"
                    disabled="@(_isSaving || !HasChanges)"
                    @onclick="SaveAsync"
                    title="@(HasChanges ? "Modifizierte PDF herunterladen" : "Keine Änderungen vorhanden")">
                @(_isSaving ? "Speichere …" : "💾 Speichern (PDF)")
            </button>
        </div>

        <div class="mt-6 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
            @foreach (var page in _pages.Where(p => !p.Deleted))
            {
                var pageRef = page;
                var thumbnail = _thumbnails.GetValueOrDefault(pageRef.OriginalIndex);
                <button type="button"
                        class="@($"group relative rounded-lg border bg-pb-surface p-2 text-left transition-colors {(pageRef.Selected ? "border-pb-accent ring-2 ring-pb-accent/40" : "border-pb-border hover:border-pb-fg-muted")}")"
                        @onclick="@(() => ToggleSelection(pageRef))"
                        aria-pressed="@pageRef.Selected.ToString().ToLowerInvariant()">
                    <div class="aspect-[3/4] flex items-center justify-center bg-pb-bg rounded overflow-hidden">
                        @if (thumbnail is not null)
                        {
                            <img src="@thumbnail"
                                 alt="@($"Seite {pageRef.OriginalIndex}")"
                                 draggable="false"
                                 style="@($"transform:rotate({pageRef.Rotation}deg)")"
                                 class="max-w-full max-h-full transition-transform" />
                        }
                        else
                        {
                            <div class="text-xs text-pb-fg-muted animate-pulse">Lade …</div>
                        }
                    </div>
                    <div class="mt-1 flex items-center justify-between text-xs">
                        <span class="text-pb-fg-muted">Seite @pageRef.OriginalIndex</span>
                        @if (pageRef.Rotation != 0)
                        {
                            <span class="rounded bg-pb-accent/15 px-1.5 py-0.5 text-pb-accent">@pageRef.Rotation°</span>
                        }
                    </div>
                </button>
            }
        </div>

        @if (_pages.Any(p => p.Deleted))
        {
            var deletedCount = _pages.Count(p => p.Deleted);
            <div class="max-w-4xl mx-auto mt-4 rounded-lg border border-dashed border-pb-border p-3 text-sm text-pb-fg-muted">
                @deletedCount Seite(n) zum Löschen markiert
                — <button type="button" class="text-pb-accent hover:underline" @onclick="UndoDeletes">rückgängig machen</button>
            </div>
        }
    }
    else if (_handle is null && !_isLoading)
    {
        <div class="max-w-4xl mx-auto mt-6 rounded-lg border border-dashed border-pb-border p-6 text-center text-sm text-pb-fg-muted">
            Wähle eine PDF-Datei aus, um Seiten zu drehen, zu löschen oder zu sortieren.
        </div>
    }
</section>

@code {
    private const long MaxFileSize = 200L * 1024 * 1024; // 200 MB für Editor-Modus

    private PdfDocumentHandle? _handle;
    private string? _currentFilename;
    private byte[]? _originalPdfBytes;
    private bool _isLoading;
    private bool _isSaving;
    private string? _errorMessage;
    private int _thumbnailProgress;

    private List<PageState> _pages = new();
    private Dictionary<int, string> _thumbnails = new();
    private CancellationTokenSource? _thumbnailCts;

    private int SelectedCount => _pages.Count(p => p.Selected && !p.Deleted);

    private bool HasChanges =>
        _pages.Any(p => p.Deleted)
        || _pages.Any(p => p.Rotation != 0);

    private async Task HandleFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        _isLoading = true;
        await UnloadCurrentAsync();

        try
        {
            _currentFilename = e.File.Name;
            await using var stream = e.File.OpenReadStream(MaxFileSize);
            await using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            _originalPdfBytes = buffer.ToArray();
            buffer.Position = 0;

            _handle = await Renderer.LoadAsync(buffer, new LoadOptions(), CancellationToken.None);
            _pages = Enumerable.Range(1, _handle.PageCount)
                .Select(i => new PageState { OriginalIndex = i })
                .ToList();
            _thumbnails = new Dictionary<int, string>(_handle.PageCount);
            _thumbnailProgress = 0;

            // Thumbnails sequenziell rendern, mit StateHasChanged zwischen
            // den Seiten, damit das UI laufend aktualisiert wird.
            _thumbnailCts = new CancellationTokenSource();
            _ = RenderThumbnailsAsync(_handle, _thumbnailCts.Token);
        }
        catch (Exception ex)
        {
            _errorMessage = $"PDF konnte nicht geöffnet werden: {ex.Message}";
            _handle = null;
            _pages.Clear();
            _originalPdfBytes = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RenderThumbnailsAsync(PdfDocumentHandle handle, CancellationToken ct)
    {
        try
        {
            for (var i = 1; i <= handle.PageCount; i++)
            {
                ct.ThrowIfCancellationRequested();
                var rendered = await Renderer.RenderPageAsync(
                    handle,
                    i,
                    new RenderOptions(Scale: 0.35),
                    ct);
                if (rendered.RasterBytes is not null && rendered.RasterFormat is not null)
                {
                    _thumbnails[i] = $"data:{rendered.RasterFormat};base64,{Convert.ToBase64String(rendered.RasterBytes)}";
                }
                _thumbnailProgress = i;
                await InvokeAsync(StateHasChanged);
                // Browser-Frame Zeit zum Atmen geben
                await Task.Yield();
            }
        }
        catch (OperationCanceledException) { /* erwartet bei Datei-Wechsel */ }
        catch (Exception ex)
        {
            _errorMessage = $"Thumbnail-Erzeugung abgebrochen: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleSelection(PageState page) => page.Selected = !page.Selected;

    private void SelectAll()
    {
        foreach (var page in _pages.Where(p => !p.Deleted)) page.Selected = true;
    }

    private void DeselectAll()
    {
        foreach (var page in _pages) page.Selected = false;
    }

    private void RotateSelected(int delta)
    {
        foreach (var page in _pages.Where(p => p.Selected && !p.Deleted))
        {
            page.Rotation = (((page.Rotation + delta) % 360) + 360) % 360;
        }
    }

    private void DeleteSelected()
    {
        foreach (var page in _pages.Where(p => p.Selected && !p.Deleted))
        {
            page.Deleted = true;
            page.Selected = false;
        }
    }

    private void UndoDeletes()
    {
        foreach (var page in _pages.Where(p => p.Deleted))
        {
            page.Deleted = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_originalPdfBytes is null || !HasChanges) return;
        _isSaving = true;
        _errorMessage = null;
        try
        {
            byte[] working = _originalPdfBytes;

            // 1) Drehungen anwenden (auf dem Original-Seitenindex)
            var rotations = _pages
                .Where(p => !p.Deleted && p.Rotation != 0)
                .ToDictionary(p => p.OriginalIndex, p => p.Rotation);
            if (rotations.Count > 0)
            {
                using var ms = new MemoryStream(working);
                working = await Manipulator.RotateAsync(ms, rotations, CancellationToken.None);
            }

            // 2) Löschungen anwenden — Indizes beziehen sich noch auf das
            //    Original (Rotationen haben Indizes nicht verschoben).
            var deleted = _pages.Where(p => p.Deleted).Select(p => p.OriginalIndex).ToList();
            if (deleted.Count > 0)
            {
                using var ms = new MemoryStream(working);
                working = await Manipulator.DeletePagesAsync(ms, deleted, CancellationToken.None);
            }

            var baseName = !string.IsNullOrWhiteSpace(_currentFilename)
                ? System.IO.Path.GetFileNameWithoutExtension(_currentFilename)
                : "pagebound";
            var downloadName = $"{baseName}_edited.pdf";

            // PDF-Daten binär downloaden (eigener JS-Helper mit base64 → Uint8Array → Blob).
            var base64 = Convert.ToBase64String(working);
            await JS.InvokeVoidAsync(
                "pageboundShortcuts.downloadBytes",
                downloadName,
                base64,
                "application/pdf");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Speichern fehlgeschlagen: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task UnloadCurrentAsync()
    {
        _thumbnailCts?.Cancel();
        _thumbnailCts?.Dispose();
        _thumbnailCts = null;
        if (_handle is not null)
        {
            try { await Renderer.UnloadAsync(_handle); } catch { /* ignore */ }
            _handle = null;
        }
        _pages.Clear();
        _thumbnails.Clear();
        _thumbnailProgress = 0;
        _originalPdfBytes = null;
    }

    public async ValueTask DisposeAsync()
    {
        await UnloadCurrentAsync();
    }

    private sealed class PageState
    {
        public int OriginalIndex { get; init; }
        public bool Selected { get; set; }
        public bool Deleted { get; set; }
        public int Rotation { get; set; } // 0, 90, 180, 270
    }
}
