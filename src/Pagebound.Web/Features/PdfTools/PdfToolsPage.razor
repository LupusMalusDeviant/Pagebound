@page "/tools"
@inject NavigationManager Nav

@*
    Die PDF-Werkzeuge sind im Reader aufgegangen (Subtab „Werkzeuge").
    /tools bleibt als Lesezeichen bestehen und leitet dorthin um, damit die
    Werkzeuge nur noch EINEN Ort haben (Reader + Werkzeuge zusammengelegt).
*@

@code {
    protected override void OnInitialized()
        => Nav.NavigateTo("/reader?tab=tools", replace: true);
}
