@page "/editor"
@page "/editor/{Id}"
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using Pagebound.Core.Abstractions
@using Pagebound.Core.Domain
@implements IDisposable
@inject IEditorDraftService Drafts
@inject IDesignFolderService Designs
@inject ILocalizationService L
@inject IJSRuntime JS

<PageTitle>@L.T("editor.pageTitle")</PageTitle>

<div class="flex h-full min-h-0">
    @* Backdrop hinter der mobilen Sidebar (Drawer) *@
    @if (_sidebarOpen)
    {
        <div class="no-print fixed inset-0 z-30 bg-black/50 lg:hidden" @onclick="@(() => _sidebarOpen = false)"></div>
    }

    @* ---- Seitenleiste (Werkzeuge); auf Mobile als einblendbarer Drawer ---- *@
    <aside class="pb-editor-sidebar no-print w-72 shrink-0 overflow-y-auto border-r border-pb-border bg-pb-bg p-3 text-sm text-pb-fg
                  max-lg:fixed max-lg:inset-y-0 max-lg:left-0 max-lg:z-40 max-lg:w-80 max-lg:max-w-[85vw] max-lg:shadow-2xl
                  max-lg:transition-transform max-lg:duration-200 @(_sidebarOpen ? "max-lg:translate-x-0" : "max-lg:-translate-x-full")">
        <div class="mb-1 flex items-start justify-between gap-2">
            <h1 class="text-base font-semibold">@L.T("editor.heading")</h1>
            <button class="btn-fmt pb-mobile-only" title="@L.T("editor.sidebar.close")" @onclick="@(() => _sidebarOpen = false)">@Ic("x")</button>
        </div>
        <p class="mb-3 text-xs text-pb-fg-muted">@L.T("editor.subtitle")</p>

        <label class="mb-1 block text-xs font-medium text-pb-fg-muted">@L.T("editor.doc.title")</label>
        <input class="mb-3 w-full rounded border border-pb-border bg-pb-bg px-2 py-1"
               placeholder="@L.T("editor.doc.titlePlaceholder")" @bind="_doc.Title" @bind:event="oninput" />

        <label class="mb-1 block text-xs font-medium text-pb-fg-muted">@L.T("editor.layout.label")</label>
        <select class="mb-3 w-full rounded border border-pb-border bg-pb-bg px-2 py-1"
                @bind="LayoutBinding">
            <option value="@PageLayout.A4Portrait">@L.T("editor.layout.a4p")</option>
            <option value="@PageLayout.A4Landscape">@L.T("editor.layout.a4l")</option>
            <option value="@PageLayout.A5Portrait">@L.T("editor.layout.a5")</option>
            <option value="@PageLayout.Letter">@L.T("editor.layout.letter")</option>
            <option value="@PageLayout.Slide16x9">@L.T("editor.layout.slide")</option>
            <option value="@PageLayout.DinLong">@L.T("editor.layout.dinlong")</option>
            <option value="@PageLayout.A6Landscape">@L.T("editor.layout.a6l")</option>
        </select>

        <label class="mb-3 flex items-center gap-2 text-xs">
            <input type="checkbox" @bind="_showCrops" /> @L.T("editor.crops")
        </label>

        @* ---- Design (Theme): Schriften + Farben dokumentweit ---- *@
        <label class="mb-1 block text-xs font-medium text-pb-fg-muted">@L.T("editor.theme.label")</label>
        <select class="mb-2 w-full rounded border border-pb-border bg-pb-bg px-2 py-1" value="@(_doc.Theme?.Name ?? "")" @onchange="OnThemePresetChange">
            <option value="">@L.T("editor.theme.none")</option>
            @if (_doc.Theme is not null && EditorThemes.Presets.All(p => p.Name != _doc.Theme.Name))
            {
                <option value="@_doc.Theme.Name">@_doc.Theme.Name</option>
            }
            @foreach (var preset in EditorThemes.Presets)
            {
                <option value="@preset.Name">@preset.Name</option>
            }
        </select>
        @if (_doc.Theme is not null)
        {
            <div class="mb-2 rounded border border-pb-border p-2">
                <label class="mb-1 block text-xs">@L.T("editor.theme.headingFont")</label>
                <select class="mb-2 w-full rounded border border-pb-border bg-pb-bg px-2 py-1 text-xs" @bind="_doc.Theme.HeadingFont">
                    @foreach (var key in EditorThemes.FontStacks.Keys)
                    {
                        <option value="@key">@L.T($"editor.font.{key}")</option>
                    }
                </select>
                <label class="mb-1 block text-xs">@L.T("editor.theme.bodyFont")</label>
                <select class="mb-2 w-full rounded border border-pb-border bg-pb-bg px-2 py-1 text-xs" @bind="_doc.Theme.BodyFont">
                    @foreach (var key in EditorThemes.FontStacks.Keys)
                    {
                        <option value="@key">@L.T($"editor.font.{key}")</option>
                    }
                </select>
                <div class="mb-2 grid grid-cols-2 gap-1 text-xs">
                    <label class="flex items-center gap-1"><input type="color" @bind="_doc.Theme.HeadingColor" /> @L.T("editor.theme.headingColor")</label>
                    <label class="flex items-center gap-1"><input type="color" @bind="_doc.Theme.BodyColor" /> @L.T("editor.theme.textColor")</label>
                    <label class="flex items-center gap-1"><input type="color" @bind="_doc.Theme.AccentColor" /> @L.T("editor.theme.accentColor")</label>
                    <label class="flex items-center gap-1">
                        <input type="color" value="@(_doc.Theme.PageBackground ?? "#ffffff")"
                               @onchange="@(e => { if (_doc.Theme is not null) _doc.Theme.PageBackground = EditorThemes.SanitizeColorOrNull(e.Value?.ToString()); })" />
                        @L.T("editor.theme.pageColor")
                    </label>
                </div>
                <button class="btn-side w-full" @onclick="ExportTheme">@L.T("editor.theme.export")</button>
            </div>
        }
        <label class="mb-1 block text-xs text-pb-fg-muted">@L.T("editor.theme.import")</label>
        <InputFile class="mb-3 w-full text-xs" OnChange="OnImportTheme" accept="application/json,.json" />

        @* ---- Seiten (Multi-Page) ---- *@
        <div class="mb-1 text-xs font-medium text-pb-fg-muted">@L.T("editor.page.label")</div>
        <ul class="mb-2 space-y-1">
            @for (int pi = 0; pi < _doc.Pages.Count; pi++)
            {
                var page = _doc.Pages[pi];
                var idx = pi;
                <li class="flex cursor-move items-center gap-0.5 @(_dropPageIdx == idx && _dragPageIdx >= 0 && _dragPageIdx != idx ? "border-t-2 border-pb-accent" : "")"
                    draggable="true"
                    @ondragstart="@(() => _dragPageIdx = idx)"
                    @ondragend="@(() => { _dragPageIdx = -1; _dropPageIdx = -1; })"
                    @ondragenter="@(() => { if (_dragPageIdx >= 0) _dropPageIdx = idx; })"
                    @ondragover:preventDefault="true"
                    @ondrop:preventDefault="true"
                    @ondrop="@(() => OnPageListDrop(idx))">
                    <button class="flex-1 truncate rounded px-1 py-0.5 text-left hover:bg-pb-surface @(_selectedPage == page ? "text-pb-accent" : "")"
                            @onclick="@(() => SelectPage(page))">@PageLabel(idx)</button>
                    <button class="btn-side px-1" title="@L.T("editor.page.up")" @onclick="@(() => MovePage(page, -1))">@Ic("up")</button>
                    <button class="btn-side px-1" title="@L.T("editor.page.down")" @onclick="@(() => MovePage(page, 1))">@Ic("down")</button>
                    <button class="btn-side px-1" title="@L.T("editor.page.duplicate")" @onclick="@(() => DuplicatePage(page))">@Ic("copy")</button>
                    <button class="btn-side px-1 text-[#dc2626]" title="@L.T("editor.page.delete")"
                            disabled="@(_doc.Pages.Count <= 1)" @onclick="@(() => DeletePage(page))">@Ic("x")</button>
                </li>
            }
        </ul>
        <button class="btn-side mb-3 w-full is-primary" @onclick="AddPage">@AddPageLabel()</button>

        @* ---- Hintergrund der gewählten Seite (Farbe + Bild) ---- *@
        @if (_selectedPage is not null)
        {
            <div class="mb-3 rounded border border-pb-border p-2">
                <div class="mb-2 text-xs font-semibold text-pb-fg-muted">@L.T("editor.doc.background")</div>
                <div class="mb-2 flex items-center gap-2">
                    <input type="color" value="@(_selectedPage.Background ?? "#ffffff")"
                           @onchange="@(e => { if (_selectedPage is not null) _selectedPage.Background = e.Value?.ToString(); })" />
                    <button class="btn-side" @onclick="@(() => { if (_selectedPage is not null) _selectedPage.Background = null; })">@L.T("editor.doc.backgroundNone")</button>
                </div>

                <label class="mb-1 block text-xs">@L.T("editor.doc.bgImage")</label>
                <InputFile class="mb-2 w-full text-xs" OnChange="OnPageBgSelected" accept="image/png,image/jpeg,image/webp" />
                @if (!string.IsNullOrEmpty(_selectedPage.BackgroundImage))
                {
                    <div class="mb-2 flex items-center gap-2">
                        <select class="flex-1 rounded border border-pb-border bg-pb-bg px-2 py-1 text-xs" disabled="@_selectedPage.BackgroundRepeat"
                                @onchange="@(e => { if (_selectedPage is not null) _selectedPage.BackgroundSize = e.Value?.ToString() ?? "cover"; })">
                            <option value="cover" selected="@(_selectedPage.BackgroundSize == "cover")">@L.T("editor.doc.bgCover")</option>
                            <option value="contain" selected="@(_selectedPage.BackgroundSize == "contain")">@L.T("editor.doc.bgContain")</option>
                        </select>
                        <button class="btn-side text-[#dc2626]" @onclick="@(() => { if (_selectedPage is not null) _selectedPage.BackgroundImage = null; })">@L.T("editor.doc.bgImageNone")</button>
                    </div>
                    <label class="mb-1 block text-xs">@L.T("editor.doc.bgPosition")</label>
                    <select class="mb-2 w-full rounded border border-pb-border bg-pb-bg px-2 py-1 text-xs" disabled="@_selectedPage.BackgroundRepeat"
                            @onchange="@(e => { if (_selectedPage is not null) _selectedPage.BackgroundPosition = e.Value?.ToString() ?? "center"; })">
                        <option value="top" selected="@(_selectedPage.BackgroundPosition == "top")">@L.T("editor.doc.bgPos.top")</option>
                        <option value="center" selected="@(_selectedPage.BackgroundPosition == "center")">@L.T("editor.doc.bgPos.center")</option>
                        <option value="bottom" selected="@(_selectedPage.BackgroundPosition == "bottom")">@L.T("editor.doc.bgPos.bottom")</option>
                    </select>
                    <label class="mb-1 block text-xs">@L.T("editor.doc.bgOpacity"): @_selectedPage.BackgroundOpacityPercent%</label>
                    <input type="range" min="10" max="100" step="5" class="mb-2 w-full"
                           value="@_selectedPage.BackgroundOpacityPercent"
                           @oninput="@(e => { if (_selectedPage is not null && int.TryParse(e.Value?.ToString(), out var v)) _selectedPage.BackgroundOpacityPercent = Math.Clamp(v, 10, 100); })" />
                    <label class="mb-2 flex items-center gap-2 text-xs">
                        <input type="checkbox" checked="@_selectedPage.BackgroundRepeat"
                               @onchange="@(e => { if (_selectedPage is not null) _selectedPage.BackgroundRepeat = e.Value is true; })" />
                        @L.T("editor.doc.bgRepeat")
                    </label>
                }
                @if (_doc.Pages.Count > 1 && (!string.IsNullOrEmpty(_selectedPage.BackgroundImage) || !string.IsNullOrEmpty(_selectedPage.Background)))
                {
                    <button class="btn-side w-full" @onclick="ApplyBackgroundToAllPages">@L.T("editor.doc.bgAllPages")</button>
                }
            </div>
        }

        <div class="mb-1 text-xs font-medium text-pb-fg-muted">@L.T("editor.add.label")</div>
        <div class="mb-3 grid grid-cols-2 gap-1">
            <button class="btn-side" @onclick="@(() => AddBlock(EditorBlockType.Heading))">@L.T("editor.add.heading")</button>
            <button class="btn-side" @onclick="@(() => AddBlock(EditorBlockType.Paragraph))">@L.T("editor.add.paragraph")</button>
            <button class="btn-side" @onclick="@(() => AddBlock(EditorBlockType.Image))">@L.T("editor.add.image")</button>
            <button class="btn-side" @onclick="@(() => AddBlock(EditorBlockType.Shape))">@L.T("editor.add.shape")</button>
            <button class="btn-side" @onclick="@(() => AddBlock(EditorBlockType.Spacer))">@L.T("editor.add.spacer")</button>
            <button class="btn-side" @onclick="@(() => AddBlock(EditorBlockType.Table))">@L.T("editor.add.table")</button>
        </div>

        <label class="mb-1 block text-xs font-medium text-pb-fg-muted">@L.T("editor.template.label")</label>
        <select class="mb-3 w-full rounded border border-pb-border bg-pb-bg px-2 py-1" @onchange="ApplyTemplate">
            <option value="">@L.T("editor.template.choose")</option>
            <option value="@EditorTemplates.TemplateKind.Invoice">@L.T("editor.template.invoice")</option>
            <option value="@EditorTemplates.TemplateKind.Letter">@L.T("editor.template.letter")</option>
            <option value="@EditorTemplates.TemplateKind.Flyer">@L.T("editor.template.flyer")</option>
            <option value="@EditorTemplates.TemplateKind.Slide">@L.T("editor.template.slide")</option>
        </select>

        @* ---- Eigenschaften des gewählten Blocks ---- *@
        @if (_selected is not null)
        {
            <div class="mb-3 rounded border border-pb-border p-2">
                <div class="mb-2 text-xs font-semibold text-pb-fg-muted">@L.T("editor.props.label") · @BlockTypeName(_selected.Type)</div>

                @if (_selected.Type is EditorBlockType.Heading)
                {
                    <label class="mb-1 block text-xs">@L.T("editor.props.level")</label>
                    <select class="mb-2 w-full rounded border border-pb-border bg-pb-bg px-2 py-1" @bind="_selected.Level">
                        <option value="1">H1</option><option value="2">H2</option><option value="3">H3</option>
                    </select>
                }

                @if (_selected.Type is EditorBlockType.Heading or EditorBlockType.Paragraph or EditorBlockType.Image)
                {
                    <div class="mb-2 flex gap-1">
                        <button class="btn-side flex-1 @(_selected.Align=="left"?"is-on":"")" title="@L.T("editor.fmt.alignLeft")" @onclick="@(() => SetAlign("left"))">@Ic("align-left")</button>
                        <button class="btn-side flex-1 @(_selected.Align=="center"?"is-on":"")" title="@L.T("editor.fmt.alignCenter")" @onclick="@(() => SetAlign("center"))">@Ic("align-center")</button>
                        <button class="btn-side flex-1 @(_selected.Align=="right"?"is-on":"")" title="@L.T("editor.fmt.alignRight")" @onclick="@(() => SetAlign("right"))">@Ic("align-right")</button>
                    </div>
                }

                @if (_selected.Type is EditorBlockType.Heading or EditorBlockType.Paragraph or EditorBlockType.Table)
                {
                    <label class="mb-1 block text-xs">@L.T("editor.props.fontSize")</label>
                    <input type="number" min="6" max="120" placeholder="@L.T("editor.props.fontSizeAuto")"
                           class="mb-2 w-full rounded border border-pb-border bg-pb-bg px-2 py-1" @bind="_selected.FontSizePt" />
                }

                @if (_selected.Type is EditorBlockType.Image)
                {
                    <label class="mb-1 block text-xs">@L.T("editor.props.chooseImage")</label>
                    <InputFile class="mb-2 w-full text-xs" OnChange="OnImageSelected" accept="image/png,image/jpeg,image/webp" />
                    <label class="mb-1 block text-xs">@L.T("editor.props.imageWidth"): @_selected.WidthPercent%</label>
                    <input type="range" min="10" max="100" step="5" class="mb-1 w-full" @bind="_selected.WidthPercent" @bind:event="oninput" />
                }

                @if (_selected.Type is EditorBlockType.Shape)
                {
                    <label class="mb-1 block text-xs">@L.T("editor.props.shape")</label>
                    <select class="mb-2 w-full rounded border border-pb-border bg-pb-bg px-2 py-1" @bind="_selected.Shape">
                        <option value="rectangle">@L.T("editor.props.shape.rectangle")</option>
                        <option value="line">@L.T("editor.props.shape.line")</option>
                        <option value="divider">@L.T("editor.props.shape.divider")</option>
                    </select>
                    <div class="mb-2 flex items-center gap-2">
                        <input type="color" @bind="_selected.Color" />
                        <input type="number" min="1" max="400" class="w-20 rounded border border-pb-border bg-pb-bg px-1 py-0.5" @bind="_selected.HeightPx" />
                        <span class="text-xs text-pb-fg-muted">px</span>
                    </div>
                    @if (_selected.Shape == "rectangle")
                    {
                        <label class="mb-2 flex items-center gap-2 text-xs"><input type="checkbox" @bind="_selected.Fill" /> @L.T("editor.props.fill")</label>
                    }
                }

                @if (_selected.Type is EditorBlockType.Spacer)
                {
                    <label class="mb-1 block text-xs">@L.T("editor.props.spacerHeight"): @_selected.HeightPx px</label>
                    <input type="range" min="4" max="400" step="4" class="mb-2 w-full" @bind="_selected.HeightPx" @bind:event="oninput" />
                }

                @if (_selected.Type is EditorBlockType.Table)
                {
                    <label class="mb-2 flex items-center gap-2 text-xs"><input type="checkbox" @bind="_selected.HeaderRow" /> @L.T("editor.props.table.header")</label>
                    <div class="grid grid-cols-2 gap-1">
                        <button class="btn-side" @onclick="@(() => TableAddRow(_selected))">+ @L.T("editor.props.table.row")</button>
                        <button class="btn-side" @onclick="@(() => TableRemoveRow(_selected))">− @L.T("editor.props.table.row")</button>
                        <button class="btn-side" @onclick="@(() => TableAddCol(_selected))">+ @L.T("editor.props.table.col")</button>
                        <button class="btn-side" @onclick="@(() => TableRemoveCol(_selected))">− @L.T("editor.props.table.col")</button>
                    </div>
                }

                @if (_selected.Type is not EditorBlockType.Spacer)
                {
                    <label class="mb-1 mt-2 block text-xs">@L.T("editor.props.bg")</label>
                    <div class="mb-2 flex items-center gap-2">
                        <input type="color" value="@(_selected.Background ?? "#ffffff")" @onchange="@(e => { if (_selected is not null) _selected.Background = e.Value?.ToString(); })" />
                        <button class="btn-side" @onclick="@(() => { if (_selected is not null) _selected.Background = null; })">@L.T("editor.props.bgNone")</button>
                    </div>
                }

                <div class="mt-2 flex gap-1">
                    <button class="btn-side flex-1" title="@L.T("editor.block.up")" @onclick="@(() => MoveBlock(_selected, -1))">@Ic("up")</button>
                    <button class="btn-side flex-1" title="@L.T("editor.block.down")" @onclick="@(() => MoveBlock(_selected, 1))">@Ic("down")</button>
                    <button class="btn-side flex-1" title="@L.T("editor.block.duplicate")" @onclick="@(() => DuplicateBlock(_selected))">@Ic("copy")</button>
                    <button class="btn-side flex-1 text-[#dc2626]" title="@L.T("editor.block.delete")" @onclick="@(() => DeleteBlock(_selected))">@Ic("trash")</button>
                </div>
            </div>
        }

        @* ---- Entwürfe ---- *@
        <div class="mb-1 text-xs font-medium text-pb-fg-muted">@L.T("editor.draft.label")</div>
        <div class="mb-2 flex gap-1">
            <button class="btn-side flex-1" @onclick="NewDocument">@L.T("editor.draft.new")</button>
            <button class="btn-side flex-1 is-primary" @onclick="Save" disabled="@_busy">@(_busy ? L.T("editor.draft.saving") : L.T("editor.draft.save"))</button>
        </div>
        @if (!string.IsNullOrEmpty(_status)) { <div class="mb-2 text-xs text-pb-accent">@_status</div> }
        @if (_drafts.Count == 0)
        {
            <div class="mb-3 text-xs text-pb-fg-muted">@L.T("editor.draft.none")</div>
        }
        else
        {
            <ul class="mb-3 space-y-1">
                @foreach (var d in _drafts)
                {
                    <li class="flex items-center gap-1">
                        <button class="flex-1 truncate rounded px-1 py-0.5 text-left hover:bg-pb-surface @(_doc.Id==d.Id?"text-pb-accent":"")"
                                title="@L.T("editor.draft.load")" @onclick="@(() => LoadDraft(d.Id))">
                            @(string.IsNullOrWhiteSpace(d.Title) ? L.T("common.untitled") : d.Title)
                        </button>
                        <button class="rounded px-1 text-pb-fg-muted hover:text-[#dc2626]" title="@L.T("editor.draft.delete")"
                                @onclick="@(() => DeleteDraft(d.Id))">@Ic("x")</button>
                    </li>
                }
            </ul>
        }

        @* ---- Design-Ordner (Dateisystem): Designs als Schablonen ---- *@
        <div class="mb-1 text-xs font-medium text-pb-fg-muted">@L.T("editor.designs.label")</div>
        @if (!_designsSupported)
        {
            <p class="mb-3 text-xs text-pb-fg-muted">@L.T("editor.designs.unsupported")</p>
        }
        else if (_designFolder is null)
        {
            <button class="btn-side mb-1 w-full" @onclick="PickDesignFolder">@L.T("editor.designs.pick")</button>
            <p class="mb-3 text-xs text-pb-fg-muted">@L.T("editor.designs.hint")</p>
        }
        else
        {
            <div class="mb-2 flex items-center gap-1 text-xs">
                <span class="flex min-w-0 flex-1 items-center gap-1.5" title="@_designFolder">@Ic("folder") <span class="truncate">@_designFolder</span></span>
                <button class="btn-side px-1" title="@L.T("editor.designs.refresh")" @onclick="RefreshDesignsAsync">@Ic("refresh")</button>
                <button class="btn-side px-1" title="@L.T("editor.designs.change")" @onclick="PickDesignFolder">@Ic("swap")</button>
                <button class="btn-side px-1" title="@L.T("editor.designs.disconnect")" @onclick="DisconnectDesignFolder">@Ic("x")</button>
            </div>
            <div class="mb-2 grid grid-cols-1 gap-1">
                <button class="btn-side" @onclick="SaveAsDesign">@L.T("editor.designs.saveCurrent")</button>
                <button class="btn-side" @onclick="SeedDefaultDesigns">@L.T("editor.designs.seed")</button>
            </div>
            @if (_templateFile is not null)
            {
                <div class="mb-2 rounded border border-pb-border p-2 text-xs">
                    <div class="mb-1 flex items-center gap-1.5 truncate text-pb-accent">@Ic("pen") @L.T("editor.designs.editing"): <strong class="truncate">@_templateFile</strong></div>
                    <div class="flex gap-1">
                        <button class="btn-side flex-1 is-primary" @onclick="SaveTemplate">@L.T("editor.designs.saveTemplate")</button>
                        <button class="btn-side" @onclick="@(() => _templateFile = null)">@L.T("editor.designs.endEditing")</button>
                    </div>
                </div>
            }
            @if (!string.IsNullOrEmpty(_designStatus))
            {
                <div class="mb-2 text-xs text-pb-accent">@_designStatus</div>
            }
            @if (_designs.Count == 0)
            {
                <div class="mb-3 text-xs text-pb-fg-muted">@L.T("editor.designs.none")</div>
            }
            else
            {
                <ul class="mb-3 space-y-1">
                    @foreach (var d in _designs)
                    {
                        var design = d;
                        <li class="flex items-center gap-0.5 text-xs">
                            <button class="flex-1 truncate rounded px-1 py-0.5 text-left hover:bg-pb-surface @(_templateFile == design.FileName ? "text-pb-accent" : "")"
                                    title="@L.T("editor.designs.use")" @onclick="@(() => UseDesignAsync(design.FileName))">@design.Title</button>
                            <button class="btn-side px-1" title="@L.T("editor.designs.edit")" @onclick="@(() => EditTemplateAsync(design.FileName))">@Ic("pen")</button>
                            <button class="btn-side px-1 text-[#dc2626]" title="@L.T("editor.designs.delete")" @onclick="@(() => DeleteDesignAsync(design.FileName))">@Ic("x")</button>
                        </li>
                    }
                </ul>
            }
        }

        <div class="mb-1 text-xs font-medium text-pb-fg-muted">@L.T("editor.export.label")</div>
        <div class="mb-3 grid grid-cols-3 gap-1">
            <button class="btn-side is-primary" @onclick="ExportPdf">@L.T("editor.export.pdf")</button>
            <button class="btn-side" @onclick="ExportHtml">@L.T("editor.export.html")</button>
            <button class="btn-side" @onclick="ExportJson">@L.T("editor.export.json")</button>
        </div>

        <label class="mb-1 block text-xs font-medium text-pb-fg-muted">@L.T("editor.import.label")</label>
        <InputFile class="mb-3 w-full text-xs" OnChange="OnImportDocument" accept="application/json,.json" />
    </aside>

    @* ---- Hauptbereich: Rich-Text-Leiste + Seiten-Leinwand ------------- *@
    <div class="flex min-w-0 flex-1 flex-col">
        <div class="pb-editor-toolbar no-print flex flex-wrap items-center gap-1 border-b border-pb-border bg-pb-bg p-2 text-sm">
            <button class="btn-fmt pb-mobile-only" @onclick="@(() => _sidebarOpen = !_sidebarOpen)" title="@L.T("editor.heading")">@Ic("menu")</button>
            <button class="btn-fmt" disabled="@(_undoList.Count == 0)" @onclick="UndoAsync" title="@L.T("editor.undo")">@Ic("undo")</button>
            <button class="btn-fmt" disabled="@(_redoList.Count == 0)" @onclick="RedoAsync" title="@L.T("editor.redo")">@Ic("redo")</button>
            <span class="mx-1 h-4 w-px bg-pb-border"></span>
            <button class="btn-fmt font-bold" @onmousedown:preventDefault="true" @onclick="@(() => Format("bold"))" title="@L.T("editor.fmt.bold")">B</button>
            <button class="btn-fmt italic" @onmousedown:preventDefault="true" @onclick="@(() => Format("italic"))" title="@L.T("editor.fmt.italic")">I</button>
            <button class="btn-fmt underline" @onmousedown:preventDefault="true" @onclick="@(() => Format("underline"))" title="@L.T("editor.fmt.underline")">U</button>
            <span class="mx-1 h-4 w-px bg-pb-border"></span>
            <button class="btn-fmt" @onmousedown:preventDefault="true" @onclick="@(() => Format("insertUnorderedList"))" title="@L.T("editor.fmt.ul")">@Ic("list-ul")</button>
            <button class="btn-fmt" @onmousedown:preventDefault="true" @onclick="@(() => Format("insertOrderedList"))" title="@L.T("editor.fmt.ol")">@Ic("list-ol")</button>
            <span class="mx-1 h-4 w-px bg-pb-border"></span>
            <button class="btn-fmt" @onmousedown:preventDefault="true" @onclick="@(() => Format("justifyLeft"))" title="@L.T("editor.fmt.alignLeft")">@Ic("align-left")</button>
            <button class="btn-fmt" @onmousedown:preventDefault="true" @onclick="@(() => Format("justifyCenter"))" title="@L.T("editor.fmt.alignCenter")">@Ic("align-center")</button>
            <button class="btn-fmt" @onmousedown:preventDefault="true" @onclick="@(() => Format("justifyRight"))" title="@L.T("editor.fmt.alignRight")">@Ic("align-right")</button>
            <button class="btn-fmt" @onmousedown:preventDefault="true" @onclick="@(() => Format("removeFormat"))" title="@L.T("editor.fmt.clear")">@Ic("eraser")</button>
            <span class="mx-1 h-4 w-px bg-pb-border"></span>
            <span class="text-xs text-pb-fg-muted" title="@L.T("editor.fmt.textColor")">A</span>
            @foreach (var col in TextColors)
            {
                var c = col;
                <button class="h-5 w-5 rounded-full border border-pb-border" style="background:@c" title="@L.T("editor.fmt.textColor")"
                        @onmousedown:preventDefault="true" @onclick="@(() => Format("foreColor", c))"></button>
            }
            <input type="color" class="h-5 w-5 cursor-pointer rounded-full border border-pb-border bg-transparent p-0" title="@L.T("editor.fmt.textColorPick")"
                   @onchange="@(e => ApplyColor("foreColor", e.Value?.ToString() ?? "#000000"))" />
            <span class="ml-1 inline-flex text-pb-fg-muted" title="@L.T("editor.fmt.highlight")">@Ic("highlight")</span>
            @foreach (var col in HiliteColors)
            {
                var c = col;
                <button class="h-5 w-5 rounded border border-pb-border" style="background:@c" title="@L.T("editor.fmt.highlight")"
                        @onmousedown:preventDefault="true" @onclick="@(() => Format("hiliteColor", c))"></button>
            }
            <input type="color" class="h-5 w-5 cursor-pointer rounded border border-pb-border bg-transparent p-0" title="@L.T("editor.fmt.highlightPick")"
                   @onchange="@(e => ApplyColor("hiliteColor", e.Value?.ToString() ?? "#ffff00"))" />
            <button class="btn-fmt" title="@L.T("editor.fmt.highlightNone")" @onmousedown:preventDefault="true" @onclick="@(() => Format("hiliteColor", "transparent"))">@Ic("highlight-off")</button>
            <span class="mx-1 h-4 w-px bg-pb-border"></span>
            <label class="flex items-center gap-1 text-xs text-pb-fg-muted">
                @L.T("editor.zoom.label")
                <select class="rounded border border-pb-border bg-pb-bg px-1 py-0.5 text-xs" @bind="ZoomBinding">
                    <option value="auto">@L.T("editor.zoom.auto")</option>
                    <option value="50">50 %</option>
                    <option value="75">75 %</option>
                    <option value="100">100 %</option>
                    <option value="125">125 %</option>
                    <option value="150">150 %</option>
                </select>
            </label>
            <span class="ml-auto hidden text-xs text-pb-fg-muted xl:inline">@L.T("editor.fmt.hint")</span>
        </div>

        <div class="pb-doc-stage flex-1" @onclick="DeselectIfBackground">
            <div class="pb-zoom">
            @{ var dim = EditorLayouts.For(_doc.Layout); }
            @for (int pi = 0; pi < _doc.Pages.Count; pi++)
            {
                var page = _doc.Pages[pi];
                var pageIndex = pi;
                <div class="pb-page @(_selectedPage == page ? "pb-page-selected" : "")" id="pb-page-@pageIndex"
                     style="@PageStyle(page, dim)"
                     @onclick:stopPropagation="true" @onclick="@(() => SelectPage(page))"
                     @ondragover:preventDefault="true"
                     @ondrop:preventDefault="true" @ondrop="@(() => OnPageAreaDrop(page))">

                    @* Hintergrundbild als eigene Ebene (Deckkraft/Position/Kacheln) — liegt unter den Blöcken. *@
                    @if (!string.IsNullOrEmpty(page.BackgroundImage))
                    {
                        <div class="pb-page-bg" style="@PageBgLayerCss(page)"></div>
                    }

                    @* Seiten-Kopf (nur Bildschirm): Bezeichnung + Seiten-Aktionen *@
                    <div class="no-print absolute -top-6 left-0 right-0 flex items-center justify-between text-xs text-white/90" contenteditable="false">
                        <span class="flex items-center gap-1">
                            <span class="rounded bg-black/40 px-1.5 py-0.5">@PageLabel(pageIndex)</span>
                            @if (_overflow.Contains(pageIndex))
                            {
                                <span class="inline-flex items-center gap-1 rounded bg-[#dc2626] px-1.5 py-0.5 font-medium text-white" title="@L.T("editor.page.overflow")">@Ic("warn") @L.T("editor.page.overflowShort")</span>
                            }
                        </span>
                        <span class="flex gap-0.5">
                            <button class="btn-fmt" title="@L.T("editor.page.up")" @onclick:stopPropagation="true" @onclick="@(() => MovePage(page, -1))">@Ic("up")</button>
                            <button class="btn-fmt" title="@L.T("editor.page.down")" @onclick:stopPropagation="true" @onclick="@(() => MovePage(page, 1))">@Ic("down")</button>
                            <button class="btn-fmt" title="@L.T("editor.page.duplicate")" @onclick:stopPropagation="true" @onclick="@(() => DuplicatePage(page))">@Ic("copy")</button>
                            <button class="btn-fmt text-[#fca5a5]" title="@L.T("editor.page.delete")" disabled="@(_doc.Pages.Count <= 1)" @onclick:stopPropagation="true" @onclick="@(() => DeletePage(page))">@Ic("trash")</button>
                        </span>
                    </div>

                    @if (_showCrops)
                    {
                        <span class="pb-crop pb-crop-tl"></span><span class="pb-crop pb-crop-tr"></span>
                        <span class="pb-crop pb-crop-bl"></span><span class="pb-crop pb-crop-br"></span>
                    }
                    @if (page.Blocks.Count == 0)
                    {
                        <p class="text-pb-fg-muted" style="position:relative;color:#9ca3af">@L.T("editor.emptyDoc")</p>
                    }
                    @foreach (var b in page.Blocks)
                    {
                        var blk = b;
                        <div class="pb-block @(_selected==blk ? "pb-selected" : "") @(_dropBlock == blk && _dragBlock is not null && _dragBlock != blk ? "pb-drop-target" : "")" @key="blk.Id"
                             style="@(string.IsNullOrEmpty(blk.Background) ? null : $"background:{blk.Background}")"
                             @onclick:stopPropagation="true" @onclick="@(() => SelectBlock(page, blk))"
                             @ondragenter="@(() => { if (_dragBlock is not null) _dropBlock = blk; })"
                             @ondragover:preventDefault="true"
                             @ondrop:preventDefault="true" @ondrop:stopPropagation="true" @ondrop="@(() => OnBlockDrop(page, blk))">
                            <span class="pb-drag-handle no-print" contenteditable="false" draggable="true" title="@L.T("editor.block.dragHandle")"
                                  @ondragstart="@(() => { _dragBlock = blk; _dropBlock = null; })"
                                  @ondragend="@(() => { _dragBlock = null; _dropBlock = null; })">@Ic("grip")</span>
                            @if (_selected == blk)
                            {
                                <div class="no-print absolute -top-3 right-1 z-30 flex gap-0.5 rounded border border-pb-border bg-pb-bg px-1 py-0.5 shadow-sm" contenteditable="false">
                                    <button class="btn-fmt" title="@L.T("editor.block.up")" @onmousedown:preventDefault="true" @onclick:stopPropagation="true" @onclick="@(() => MoveBlock(blk, -1))">@Ic("up")</button>
                                    <button class="btn-fmt" title="@L.T("editor.block.down")" @onmousedown:preventDefault="true" @onclick:stopPropagation="true" @onclick="@(() => MoveBlock(blk, 1))">@Ic("down")</button>
                                    <button class="btn-fmt" title="@L.T("editor.block.duplicate")" @onmousedown:preventDefault="true" @onclick:stopPropagation="true" @onclick="@(() => DuplicateBlock(blk))">@Ic("copy")</button>
                                    <button class="btn-fmt text-[#dc2626]" title="@L.T("editor.block.delete")" @onmousedown:preventDefault="true" @onclick:stopPropagation="true" @onclick="@(() => DeleteBlock(blk))">@Ic("trash")</button>
                                </div>
                            }
                            @switch (blk.Type)
                            {
                                case EditorBlockType.Heading:
                                    <div id="blk-@blk.Id" class="pb-edit pb-h@(blk.Level) align-@blk.Align" contenteditable="true" style="@FontSizeCss(blk)"
                                         data-placeholder="@L.T("editor.ph.heading")" @onfocusin="@(() => SelectBlock(page, blk))" @onblur="OnEditableBlur">@((MarkupString)(blk.Text ?? ""))</div>
                                    break;
                                case EditorBlockType.Paragraph:
                                    <div id="blk-@blk.Id" class="pb-edit pb-para align-@blk.Align" contenteditable="true" style="@FontSizeCss(blk)"
                                         data-placeholder="@L.T("editor.ph.paragraph")" @onfocusin="@(() => SelectBlock(page, blk))" @onblur="OnEditableBlur">@((MarkupString)(blk.Text ?? ""))</div>
                                    break;
                                case EditorBlockType.Image:
                                    <div class="pb-img-wrap align-@blk.Align">
                                        @if (!string.IsNullOrEmpty(blk.Src))
                                        {
                                            <img class="pb-img" src="@blk.Src" alt="@blk.Alt" style="width:@(blk.WidthPercent)%" />
                                        }
                                        else
                                        {
                                            <div style="border:1px dashed #9ca3af;color:#9ca3af;padding:24px;text-align:center">@L.T("editor.image.empty")</div>
                                        }
                                    </div>
                                    break;
                                case EditorBlockType.Spacer:
                                    <div class="pb-spacer" style="height:@(blk.HeightPx)px"></div>
                                    break;
                                case EditorBlockType.Shape:
                                    @if (blk.Shape == "line")
                                    {
                                        <div class="pb-shape-line" style="color:@blk.Color"></div>
                                    }
                                    else if (blk.Shape == "divider")
                                    {
                                        <div class="pb-shape-divider"></div>
                                    }
                                    else
                                    {
                                        <div class="pb-shape-rect @(blk.Fill ? "is-filled" : null)" style="height:@(blk.HeightPx)px;color:@blk.Color"></div>
                                    }
                                    break;
                                case EditorBlockType.Table:
                                    <table class="pb-table" style="@FontSizeCss(blk)">
                                        @if (blk.Rows is not null)
                                        {
                                            @for (int r = 0; r < blk.Rows.Count; r++)
                                            {
                                                var rr = r;
                                                <tr>
                                                    @for (int c = 0; c < blk.Rows[rr].Count; c++)
                                                    {
                                                        var cc = c;
                                                        @if (blk.HeaderRow && rr == 0)
                                                        {
                                                            <th id="cell-@blk.Id-@rr-@cc" class="pb-edit" contenteditable="true" @onblur="OnEditableBlur">@((MarkupString)blk.Rows[rr][cc])</th>
                                                        }
                                                        else
                                                        {
                                                            <td id="cell-@blk.Id-@rr-@cc" class="pb-edit" contenteditable="true" @onblur="OnEditableBlur">@((MarkupString)blk.Rows[rr][cc])</td>
                                                        }
                                                    }
                                                </tr>
                                            }
                                        }
                                    </table>
                                    break;
                            }
                        </div>
                    }
                </div>
            }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Id { get; set; }

    private EditorDocument _doc = EditorDocument.NewEmpty(string.Empty);
    private EditorBlock? _selected;
    private EditorPage? _selectedPage;
    private IReadOnlyList<EditorDraftInfo> _drafts = Array.Empty<EditorDraftInfo>();
    private bool _showCrops;
    private bool _busy;
    private string? _status;
    private string? _focusBlockId;
    private bool _pageSizeDirty = true;

    // Undo/Redo: Schnappschüsse des gesamten Dokuments vor jeder Struktur-Änderung.
    // Günstig trotz eingebetteter Bilder (Data-URL-Strings werden referenzgeteilt).
    private const int MaxUndo = 50;
    private readonly List<EditorDocument> _undoList = new();
    private readonly List<EditorDocument> _redoList = new();

    // Seiten-Indizes, deren Inhalt das Papierformat sprengt (Überlauf-Warnung).
    private HashSet<int> _overflow = new();

    // Design-Ordner (Dateisystem): Designs sind Schablonen (*.pbdesign.json).
    // _templateFile != null = expliziter „Template bearbeiten“-Modus — nur dann
    // schreibt „Template speichern“ in die Datei zurück.
    // Drag & Drop: Block-Umsortierung (auch seitenübergreifend), Seitenliste,
    // Datei-Drop auf die Leinwand (Bilder/JSON via JS-Bridge + DotNetObjectReference).
    private EditorBlock? _dragBlock;
    private EditorBlock? _dropBlock;
    private int _dragPageIdx = -1;
    private int _dropPageIdx = -1;
    private DotNetObjectReference<DesignerPage>? _selfRef;

    // Mobile: Sidebar als Drawer + Zoom der Seiten-Leinwand ("auto" = an Breite anpassen).
    private bool _sidebarOpen;
    private string _zoomMode = "auto";
    private string ZoomBinding
    {
        get => _zoomMode;
        set => _zoomMode = value;
    }

    private const string DesignSuffix = ".pbdesign.json";
    private bool _designsSupported;
    private string? _designFolder;
    private IReadOnlyList<DesignFileInfo> _designs = Array.Empty<DesignFileInfo>();
    private string? _templateFile;
    private string? _designStatus;

    private static readonly JsonSerializerOptions ExportJsonOptions = new()
    {
        WriteIndented = true,
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        // Lesbarer Export-Sidecar (LF-05): <,>,& nicht zu \u00XX escapen. Sicher,
        // weil die Datei heruntergeladen und nicht in HTML eingebettet wird.
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
        Converters = { new JsonStringEnumConverter() }
    };

    private static readonly JsonSerializerOptions ImportJsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        Converters = { new JsonStringEnumConverter() }
    };

    private PageLayout LayoutBinding
    {
        get => _doc.Layout;
        set { if (value == _doc.Layout) return; PushUndo(); _doc.Layout = value; _pageSizeDirty = true; }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Id))
        {
            var loaded = await Drafts.LoadAsync(Id, CancellationToken.None);
            if (loaded is not null) _doc = loaded.Migrate();
        }
        _doc.Migrate();
        _selectedPage = _doc.Pages.FirstOrDefault();
        await RefreshDraftsAsync();

        _designsSupported = await Designs.IsSupportedAsync(CancellationToken.None);
        if (_designsSupported)
        {
            _designFolder = await Designs.GetFolderNameAsync(CancellationToken.None);
            // Best-Effort: ohne bereits erteilte Berechtigung bleibt die Liste leer,
            // bis der Nutzer per Klick (= Nutzergeste für den Permission-Prompt)
            // aktualisiert oder eine Aktion ausführt.
            if (_designFolder is not null) await RefreshDesignsAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("pageboundWysiwyg.initializeEditor");
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("pageboundWysiwyg.registerFileDrop", _selfRef);
        }
        if (_pageSizeDirty)
        {
            _pageSizeDirty = false;
            await JS.InvokeVoidAsync("pageboundWysiwyg.setPageSize", EditorLayouts.For(_doc.Layout).CssPageSize);
        }
        if (_focusBlockId is not null)
        {
            var id = _focusBlockId;
            _focusBlockId = null;
            await JS.InvokeVoidAsync("pageboundWysiwyg.focusBlockEnd", $"blk-{id}");
        }
        // Zoom nach jedem Render anwenden (Layout/Modus können sich geändert haben;
        // die Bridge schreibt nur einen Style-Wert — vernachlässigbar günstig).
        await JS.InvokeVoidAsync("pageboundWysiwyg.setZoom", _zoomMode, EditorLayouts.For(_doc.Layout).WidthMm);
        await MeasureOverflowAsync();
    }

    /// <summary>Misst nach jedem Render, ob Seiteninhalt das Papierformat sprengt (würde im Druck abgeschnitten).</summary>
    private async Task MeasureOverflowAsync()
    {
        var ids = Enumerable.Range(0, _doc.Pages.Count).Select(i => $"pb-page-{i}").ToList();
        var result = await JS.InvokeAsync<Dictionary<string, bool>>("pageboundWysiwyg.measureOverflow", ids);
        var overflow = new HashSet<int>();
        for (var i = 0; i < _doc.Pages.Count; i++)
            if (result.TryGetValue($"pb-page-{i}", out var over) && over) overflow.Add(i);
        if (!overflow.SetEquals(_overflow))
        {
            _overflow = overflow;
            StateHasChanged();
        }
    }

    private async Task RefreshDraftsAsync()
        => _drafts = await Drafts.ListAsync(CancellationToken.None);

    private string BlockTypeName(EditorBlockType t) => L.T($"editor.type.{t.ToString().ToLowerInvariant()}");

    // --- Inline-SVG-Icons (statt Emojis): stroke-basiert, folgen currentColor ----
    private const string IcOpen = "<svg class=\"pb-ic\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">";

    private static readonly Dictionary<string, string> IconPaths = new()
    {
        ["up"] = "<path d='M8 13V3M3.5 7.5 8 3l4.5 4.5'/>",
