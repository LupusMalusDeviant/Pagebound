    // --- Vorlagen / Entwürfe --------------------------------------------------
    private void NewDocument()
    {
        PushUndo();
        _doc = EditorDocument.NewEmpty(string.Empty, _doc.Layout);
        _selected = null;
        _selectedPage = _doc.Pages.FirstOrDefault();
        _status = null;
        _pageSizeDirty = true;
        _templateFile = null;
    }

    // An das Vorlagen-<select> gebunden. Wird nach dem Anwenden auf "" zurückgesetzt,
    // damit sich dieselbe Vorlage erneut auswählen lässt (sonst feuert @onchange nicht).
    private string _templateSelect = "";

    private void ApplyTemplate(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        if (string.IsNullOrEmpty(raw) || !Enum.TryParse<EditorTemplates.TemplateKind>(raw, out var kind))
        {
            _templateSelect = "";
            return;
        }
        PushUndo();
        _doc = EditorTemplates.Create(kind).Migrate();
        _selected = null;
        _selectedOverlay = null;
        _selectedPage = _doc.Pages.FirstOrDefault();
        _status = null;
        _pageSizeDirty = true;
        _templateFile = null;
        _templateSelect = ""; // Auswahl zurücksetzen → erneutes Anwenden möglich
    }

    private async Task Save()
    {
        if (_busy) return;
        _busy = true;
        _status = null;
        try
        {
            await SyncAllAsync();
            if (string.IsNullOrWhiteSpace(_doc.Title)) _doc.Title = L.T("common.untitled");
            await Drafts.SaveAsync(_doc, CancellationToken.None);
            await RefreshDraftsAsync();
            _status = L.T("editor.draft.saved");
        }
        finally { _busy = false; }
    }

    private async Task LoadDraft(string id)
    {
        var loaded = await Drafts.LoadAsync(id, CancellationToken.None);
        if (loaded is null) return;
        PushUndo();
        _doc = loaded.Migrate();
        _selected = null;
        _selectedPage = _doc.Pages.FirstOrDefault();
        _status = null;
        _pageSizeDirty = true;
        _templateFile = null;
    }

    private async Task DeleteDraft(string id)
    {
        await Drafts.DeleteAsync(id, CancellationToken.None);
        if (_doc.Id == id) NewDocument();
        await RefreshDraftsAsync();
    }

