    private async Task ExportPdf()
    {
        // Klarer Hinweis: PDF ist statisch — interaktive Elemente (Mindmaps, Folien-
        // Navigation) erscheinen als Standbild. Nur bei vorhandenen Mindmaps warnen.
        if (DocumentHasInteractive() &&
            !await JS.InvokeAsync<bool>("confirm", L.T("editor.export.pdfWarn")))
            return;
        await JS.InvokeVoidAsync("pageboundWysiwyg.blurActive");
        await SyncAllAsync();
        _selected = null;
        var wasSingle = _singleSlide;
        _singleSlide = false; // alle Seiten in den Druck aufnehmen
        StateHasChanged();
        await JS.InvokeVoidAsync("pageboundWysiwyg.setPageSize", EditorLayouts.For(_doc.Layout).CssPageSize);
        await JS.InvokeVoidAsync("pageboundWysiwyg.triggerPrint");
        _singleSlide = wasSingle;
        StateHasChanged(); // Einzelfolien-Ansicht nach dem Druck wieder anzeigen
    }

    private bool DocumentHasInteractive()
        => _doc.Pages.Any(p => p.Blocks.Any(b => b.Type == EditorBlockType.Mindmap));

    private async Task ExportHtml()
    {
        await JS.InvokeVoidAsync("pageboundWysiwyg.blurActive");
        await SyncAllAsync();
        _selected = null;
        StateHasChanged();
        await Task.Yield();

        var dim = EditorLayouts.For(_doc.Layout);
        var pages = new List<(string Style, string Inner)>();
        for (var i = 0; i < _doc.Pages.Count; i++)
        {
            // Inner enthält bereits die .pb-page-bg-Ebene (Inline-Styles); Theme-
            // Variablen + Seitenfarbe kommen als Style des Seiten-Containers mit.
            var inner = await JS.InvokeAsync<string>("pageboundWysiwyg.getCleanHtml", $"pb-page-{i}");
            pages.Add((PageThemeAndColorCss(_doc.Pages[i]), inner));
        }
        var html = BuildStandaloneHtml(_doc.Title, dim, pages);
        await DownloadTextAsync(SafeName(_doc.Title) + ".html", html, "text/html");
    }

    /// <summary>Interaktiver HTML-Export: Folien-Layouts werden ein Deck mit
    /// Navigation (Pfeiltasten/Buttons), Mindmaps bleiben als Live-D3-Widget
    /// bedienbar (Zoom/Auf-/Zuklappen). Kein PDF — vollständig dynamisch.</summary>
    private async Task ExportInteractiveHtml()
    {
        await JS.InvokeVoidAsync("pageboundWysiwyg.blurActive");
        await SyncAllAsync();
        _selected = null;
        var wasSingle = _singleSlide;
        _singleSlide = false; // alle Seiten rendern (DOM-Quelle des Exports)
        StateHasChanged();
        await Task.Yield();

        var dim = EditorLayouts.For(_doc.Layout);
        var allBlocks = _doc.Pages.SelectMany(p => p.Blocks).ToList();
        var anyMind = allBlocks.Any(b => b.Type == EditorBlockType.Mindmap && b.Mind is not null);

        var pages = new List<(string Style, string Inner)>();
        for (var i = 0; i < _doc.Pages.Count; i++)
        {
            var inner = await JS.InvokeAsync<string>("pageboundWysiwyg.getCleanHtml", $"pb-page-{i}");
            inner = ReplaceMindImages(inner, allBlocks);
            pages.Add((PageThemeAndColorCss(_doc.Pages[i]), inner));
        }

        // D3-Bundle nur einbetten, wenn Mindmaps vorhanden sind (sonst kein Ballast).
        var mindJs = anyMind ? await JS.InvokeAsync<string>("pageboundWysiwyg.fetchText", "js/mind-bridge.js") : "";
        var isDeck = _doc.Layout == PageLayout.Slide16x9 && _doc.Pages.Count > 1;
        var html = BuildInteractiveHtml(_doc.Title, dim, pages, isDeck, mindJs);
        await DownloadTextAsync(SafeName(_doc.Title) + "-interaktiv.html", html, "text/html");

        _singleSlide = wasSingle;
        StateHasChanged(); // Einzelfolien-Ansicht nach dem Export wiederherstellen
    }

    /// <summary>Ersetzt statische Mindmap-Bilder (&lt;img data-mind="…"&gt;) im
    /// Export-HTML durch Live-Container mit base64-kodierten Baumdaten.</summary>
    private string ReplaceMindImages(string html, List<EditorBlock> allBlocks)
        => System.Text.RegularExpressions.Regex.Replace(html,
            "<img\\b[^>]*\\bdata-mind=\"([^\"]+)\"[^>]*>",
            m =>
            {
                var blk = allBlocks.FirstOrDefault(b => b.Id == m.Groups[1].Value);
                if (blk?.Mind is null) return m.Value; // Bild als Fallback behalten
                var json = JsonSerializer.Serialize(blk.Mind, ImportJsonOptions);
                var b64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(json));
                return $"<div class=\"pb-mind-host\" data-mind-tree=\"{b64}\"></div>";
            });

    private async Task ExportJson()
    {
        await JS.InvokeVoidAsync("pageboundWysiwyg.blurActive");
        await SyncAllAsync();
        var json = JsonSerializer.Serialize(_doc, ExportJsonOptions);
        await DownloadTextAsync(SafeName(_doc.Title) + ".json", json, "application/json");
    }

    private Task DownloadTextAsync(string filename, string text, string mime)
    {
        var b64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(text));
        return JS.InvokeVoidAsync("pageboundShortcuts.downloadBytes", filename, b64, mime).AsTask();
    }

    private static string SafeName(string? title)
    {
        var baseName = string.IsNullOrWhiteSpace(title) ? "dokument" : title;
        return string.Concat(baseName.Select(c => char.IsLetterOrDigit(c) || c is '_' or '-' or ' ' ? c : '_')).Trim();
    }

    private static string BuildStandaloneHtml(string title, PageDimensions dim, List<(string Style, string Inner)> pages)
    {
        var safeTitle = System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(title) ? "Dokument" : title);
        var sb = new StringBuilder();
        sb.Append("<!doctype html><html lang=\"de\"><head><meta charset=\"utf-8\">");
        sb.Append("<title>").Append(safeTitle).Append("</title><style>");
        sb.Append("@page{size:").Append(dim.CssPageSize).Append(";margin:0}");
        sb.Append("body{margin:0;background:#e5e7eb;color:#111827;font-family:Georgia,'Times New Roman',serif}");
        sb.Append(".pb-page{box-sizing:border-box;position:relative;background:#fff;width:").Append(dim.CssWidth)
          .Append(";min-height:").Append(dim.CssHeight).Append(";padding:").Append(dim.CssMargin).Append(";margin:0 auto 12px;page-break-after:always;")
          .Append("color:var(--doc-color-body,#111827);font-family:var(--doc-font-body,Georgia,'Times New Roman',serif)}");
        sb.Append(".pb-page:last-child{page-break-after:auto;margin-bottom:0}");
        sb.Append(".pb-page-bg{position:absolute;inset:0;pointer-events:none}");
        sb.Append(".pb-block{position:relative;margin:0 0 8px}.pb-block:last-child{margin-bottom:0}");
        sb.Append(".pb-h1,.pb-h2,.pb-h3{font-family:var(--doc-font-heading,inherit);color:var(--doc-color-heading,inherit)}");
        sb.Append(".pb-h1{font-size:22pt;font-weight:700}.pb-h2{font-size:16pt;font-weight:700}.pb-h3{font-size:13pt;font-weight:700}");
        sb.Append(".pb-para{font-size:11pt;line-height:1.5}");
        sb.Append(".pb-spacer{width:100%}");
        sb.Append(".pb-img{display:inline-block;max-width:100%;height:auto}.pb-img-wrap.align-center{text-align:center}.pb-img-wrap.align-right{text-align:right}");
        sb.Append(".pb-cols{display:flex;align-items:flex-start}.pb-col{flex:1 1 0;min-width:0;font-size:11pt}");
        sb.Append(".pb-overlay{position:absolute;box-sizing:border-box}.pb-ov-text{word-wrap:break-word}");
        sb.Append(".pb-ov-img{display:block;width:100%;height:auto}.pb-ov-shape{width:100%;height:100%}.pb-ov-shape.is-ellipse{border-radius:50%}");
        sb.Append(".pb-shape-rect{width:100%;border:1.5px solid currentColor}.pb-shape-rect.is-filled{background:currentColor;border:none}");
        sb.Append(".pb-shape-line{border-top:1.5px solid currentColor}.pb-shape-divider{border-top:1px solid var(--doc-color-accent,#d1d5db);margin:6px 0}");
        sb.Append(".pb-table{width:100%;border-collapse:collapse;font-size:10.5pt}.pb-table td,.pb-table th{border:1px solid #9ca3af;padding:4px 8px;text-align:left}.pb-table th{background:var(--doc-color-accent-soft,#f3f4f6);color:#111827}");
        sb.Append(".align-center{text-align:center}.align-right{text-align:right}.align-justify{text-align:justify}");
        sb.Append("*{-webkit-print-color-adjust:exact;print-color-adjust:exact}");
        sb.Append("</style></head><body>");
        foreach (var (style, inner) in pages)
        {
            sb.Append("<div class=\"pb-page\" style=\"").Append(style).Append("\">").Append(inner).Append("</div>");
        }
        sb.Append("</body></html>");
        return sb.ToString();
    }

    /// <summary>Standalone-HTML mit Interaktivität: Folien-Deck (Navigation) und
    /// Live-D3-Mindmaps. Druck/PDF aus dieser Datei zeigt weiterhin Standbilder.</summary>
    private static string BuildInteractiveHtml(string title, PageDimensions dim, List<(string Style, string Inner)> pages, bool isDeck, string mindBundleJs)
    {
        var safeTitle = System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(title) ? "Dokument" : title);
        var sb = new StringBuilder();
        sb.Append("<!doctype html><html lang=\"de\"><head><meta charset=\"utf-8\">");
        sb.Append("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">");
        sb.Append("<title>").Append(safeTitle).Append("</title><style>");
        sb.Append("@page{size:").Append(dim.CssPageSize).Append(";margin:0}");
        sb.Append("body{margin:0;background:#e5e7eb;color:#111827;font-family:Georgia,'Times New Roman',serif}");
        sb.Append(".pb-page{box-sizing:border-box;position:relative;background:#fff;width:").Append(dim.CssWidth)
          .Append(";min-height:").Append(dim.CssHeight).Append(";padding:").Append(dim.CssMargin).Append(";margin:0 auto 12px;")
          .Append("color:var(--doc-color-body,#111827);font-family:var(--doc-font-body,Georgia,'Times New Roman',serif)}");
        sb.Append(".pb-page-bg{position:absolute;inset:0;pointer-events:none}");
        sb.Append(".pb-block{position:relative;margin:0 0 8px}.pb-block:last-child{margin-bottom:0}");
        sb.Append(".pb-h1,.pb-h2,.pb-h3{font-family:var(--doc-font-heading,inherit);color:var(--doc-color-heading,inherit)}");
        sb.Append(".pb-h1{font-size:22pt;font-weight:700}.pb-h2{font-size:16pt;font-weight:700}.pb-h3{font-size:13pt;font-weight:700}");
        sb.Append(".pb-para{font-size:11pt;line-height:1.5}.pb-spacer{width:100%}");
        sb.Append(".pb-img{display:inline-block;max-width:100%;height:auto}.pb-img-wrap.align-center{text-align:center}.pb-img-wrap.align-right{text-align:right}");
        sb.Append(".pb-cols{display:flex;align-items:flex-start}.pb-col{flex:1 1 0;min-width:0;font-size:11pt}");
        sb.Append(".pb-overlay{position:absolute;box-sizing:border-box}.pb-ov-text{word-wrap:break-word}");
        sb.Append(".pb-ov-img{display:block;width:100%;height:auto}.pb-ov-shape{width:100%;height:100%}.pb-ov-shape.is-ellipse{border-radius:50%}");
        sb.Append(".pb-shape-rect{width:100%;border:1.5px solid currentColor}.pb-shape-rect.is-filled{background:currentColor;border:none}");
        sb.Append(".pb-shape-line{border-top:1.5px solid currentColor}.pb-shape-divider{border-top:1px solid var(--doc-color-accent,#d1d5db);margin:6px 0}");
        sb.Append(".pb-table{width:100%;border-collapse:collapse;font-size:10.5pt}.pb-table td,.pb-table th{border:1px solid #9ca3af;padding:4px 8px;text-align:left}.pb-table th{background:var(--doc-color-accent-soft,#f3f4f6);color:#111827}");
        sb.Append(".align-center{text-align:center}.align-right{text-align:right}.align-justify{text-align:justify}");
        // Live-Mindmap-Container
        sb.Append(".pb-mind-host{display:inline-block;width:100%;height:").Append(isDeck ? "66vh" : "480px")
          .Append(";min-height:320px;border:1px solid #d6d3cb;border-radius:10px;background:#F9F8F6;overflow:hidden;vertical-align:top}");
        if (isDeck)
        {
            sb.Append("body{background:#1f2937}");
            sb.Append(".pb-page{display:none;box-shadow:0 12px 48px rgba(0,0,0,.45)}");
            sb.Append(".pb-page.active{display:block}");
            sb.Append(".deck-nav{position:fixed;left:0;right:0;bottom:0;display:flex;justify-content:center;align-items:center;gap:18px;padding:10px;background:rgba(17,24,39,.9);color:#fff;font-family:system-ui,sans-serif;z-index:50}");
            sb.Append(".deck-nav button{font:inherit;cursor:pointer;border:1px solid #6b7280;background:#374151;color:#fff;border-radius:8px;padding:6px 18px;font-size:18px;line-height:1}");
            sb.Append(".deck-nav button:disabled{opacity:.4;cursor:default}");
            sb.Append("@media print{.deck-nav{display:none}.pb-page{display:block !important}}");
        }
        sb.Append("*{-webkit-print-color-adjust:exact;print-color-adjust:exact}");
        sb.Append("</style></head><body").Append(isDeck ? " class=\"pb-deck\"" : "").Append(">");
        foreach (var (style, inner) in pages)
            sb.Append("<div class=\"pb-page\" style=\"").Append(style).Append("\">").Append(inner).Append("</div>");
        if (isDeck)
        {
            sb.Append("<div class=\"deck-nav\"><button id=\"deck-prev\" aria-label=\"prev\">‹</button>")
              .Append("<span id=\"deck-counter\"></span><button id=\"deck-next\" aria-label=\"next\">›</button></div>");
            sb.Append("<script>(function(){var s=[].slice.call(document.querySelectorAll('.pb-page'));if(!s.length)return;var i=0;var c=document.getElementById('deck-counter');var p=document.getElementById('deck-prev'),n=document.getElementById('deck-next');function show(x){i=Math.max(0,Math.min(s.length-1,x));s.forEach(function(e,k){e.classList.toggle('active',k===i);});c.textContent=(i+1)+' / '+s.length;p.disabled=i===0;n.disabled=i===s.length-1;}p.onclick=function(){show(i-1);};n.onclick=function(){show(i+1);};document.addEventListener('keydown',function(e){if(e.key==='ArrowRight'||e.key===' '){e.preventDefault();show(i+1);}if(e.key==='ArrowLeft')show(i-1);});show(0);})();</script>");
        }
        if (!string.IsNullOrEmpty(mindBundleJs))
        {
            sb.Append("<script>").Append(mindBundleJs).Append("</script>");
            sb.Append("<script>try{pageboundMind.mountAllViewers();}catch(e){}</script>");
        }
        sb.Append("</body></html>");
        return sb.ToString();
    }
