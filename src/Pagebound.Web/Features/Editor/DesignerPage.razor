    private static MarkupString Ic(string name) => (MarkupString)(IcOpen + IconPaths[name] + "</svg>");

    private bool IsSlide => _doc.Layout == PageLayout.Slide16x9;
    private string PageLabel(int idx) => L.T(IsSlide ? "editor.page.nthSlide" : "editor.page.nthPage", new Dictionary<string, object> { ["n"] = idx + 1 });
    private string AddPageLabel() => L.T(IsSlide ? "editor.page.addSlide" : "editor.page.add");

    private string PageStyle(EditorPage page, PageDimensions dim)
    {
        var sb = new StringBuilder();
        sb.Append("width:").Append(dim.CssWidth).Append(";height:").Append(dim.CssHeight).Append(";padding:").Append(dim.CssMargin).Append(';');
        sb.Append(PageThemeAndColorCss(page));
        return sb.ToString();
    }

    /// <summary>Theme-Variablen (--doc-*) + Seiten-Hintergrundfarbe als Inline-Style.
    /// Das Hintergrund-BILD liegt als eigene Ebene (.pb-page-bg) unter den Blöcken.</summary>
    private string PageThemeAndColorCss(EditorPage page)
    {
        var sb = new StringBuilder();
        var theme = _doc.Theme;
        if (theme is not null)
        {
            sb.Append("--doc-font-heading:").Append(EditorThemes.FontStack(theme.HeadingFont)).Append(';');
            sb.Append("--doc-font-body:").Append(EditorThemes.FontStack(theme.BodyFont)).Append(';');
            sb.Append("--doc-color-heading:").Append(theme.HeadingColor).Append(';');
            sb.Append("--doc-color-body:").Append(theme.BodyColor).Append(';');
            sb.Append("--doc-color-accent:").Append(theme.AccentColor).Append(';');
            sb.Append("--doc-color-accent-soft:").Append(EditorThemes.MixWithWhite(theme.AccentColor, 12)).Append(';');
        }
        var bg = page.Background ?? theme?.PageBackground;
        if (!string.IsNullOrEmpty(bg)) sb.Append("background-color:").Append(bg).Append(';');
        return sb.ToString();
    }

    private static string PageBgLayerCss(EditorPage page)
    {
        var sb = new StringBuilder();
        sb.Append("background-image:url('").Append(page.BackgroundImage).Append("');");
        if (page.BackgroundRepeat)
        {
            sb.Append("background-repeat:repeat;background-size:auto;background-position:left top;");
        }
        else
        {
            sb.Append("background-repeat:no-repeat;");
            sb.Append("background-size:").Append(page.BackgroundSize == "contain" ? "contain" : "cover").Append(';');
            var pos = page.BackgroundPosition is "top" or "bottom" ? page.BackgroundPosition : "center";
            sb.Append("background-position:center ").Append(pos).Append(';');
        }
        if (page.BackgroundOpacityPercent < 100)
            sb.Append("opacity:").Append((page.BackgroundOpacityPercent / 100.0).ToString("0.##", CultureInfo.InvariantCulture)).Append(';');
        return sb.ToString();
    }

    private static string? FontSizeCss(EditorBlock b)
        => b.FontSizePt is int pt ? $"font-size:{Math.Clamp(pt, 6, 120)}pt" : null;

    private static string ImageStyle(EditorBlock b)
    {
        var sb = new StringBuilder();
        sb.Append("width:").Append(b.WidthPercent).Append("%;");
        if (b.CornerRadiusPx > 0) sb.Append("border-radius:").Append(b.CornerRadiusPx).Append("px;");
        if (b.BorderWidthPx > 0 && !string.IsNullOrEmpty(b.BorderColor))
            sb.Append("border:").Append(b.BorderWidthPx).Append("px solid ").Append(b.BorderColor).Append(';');
        if (b.ShadowEnabled) sb.Append("box-shadow:0 6px 18px rgba(0,0,0,.25);");
        return sb.ToString();
    }

    private static string OverlayStyle(EditorOverlay ov)
    {
        var inv = CultureInfo.InvariantCulture;
        var sb = new StringBuilder();
        sb.Append("left:").Append(ov.XPercent.ToString("0.##", inv)).Append("%;");
        sb.Append("top:").Append(ov.YPercent.ToString("0.##", inv)).Append("%;");
        sb.Append("width:").Append(ov.WidthPercent.ToString("0.##", inv)).Append("%;");
        if (ov.Type == EditorOverlayType.Shape)
            sb.Append("height:").Append(ov.HeightPercent.ToString("0.##", inv)).Append("%;");
        if (ov.RotationDeg != 0) sb.Append("transform:rotate(").Append(ov.RotationDeg).Append("deg);");
        if (ov.OpacityPercent < 100) sb.Append("opacity:").Append((ov.OpacityPercent / 100.0).ToString("0.##", inv)).Append(';');
        return sb.ToString();
    }

    private static string OverlayTextCss(EditorOverlay ov)
    {
        var sb = new StringBuilder();
        sb.Append("color:").Append(ov.Color).Append(';');
        if (ov.FontSizePt is int pt) sb.Append("font-size:").Append(Math.Clamp(pt, 6, 120)).Append("pt;");
        if (!string.IsNullOrEmpty(ov.Background)) sb.Append("background:").Append(ov.Background).Append(";padding:2px 6px;");
        return sb.ToString();
    }

    // --- Sync DOM (contentEditable) → Modell ---------------------------------
    private async Task SyncAllAsync()
    {
        var ids = new List<string>();
        foreach (var page in _doc.Pages)
        {
            foreach (var b in page.Blocks)
            {
                if (b.Type is EditorBlockType.Heading or EditorBlockType.Paragraph)
                {
                    ids.Add($"blk-{b.Id}");
                }
                else if (b.Type == EditorBlockType.Table && b.Rows is not null)
                {
                    for (var r = 0; r < b.Rows.Count; r++)
                        for (var c = 0; c < b.Rows[r].Count; c++)
                            ids.Add($"cell-{b.Id}-{r}-{c}");
                }
                else if (b.Type == EditorBlockType.Columns && b.ColumnsHtml is not null)
                {
                    for (var c = 0; c < b.ColumnsHtml.Count; c++)
                        ids.Add($"col-{b.Id}-{c}");
                }
            }
            foreach (var ov in page.Overlays)
                if (ov.Type == EditorOverlayType.Text) ids.Add($"ovedit-{ov.Id}");
        }
        if (ids.Count == 0) return;
        var values = await JS.InvokeAsync<Dictionary<string, string>>("pageboundWysiwyg.readValues", ids);
        foreach (var page in _doc.Pages)
        {
            foreach (var b in page.Blocks)
            {
                if (b.Type is EditorBlockType.Heading or EditorBlockType.Paragraph)
                {
                    if (values.TryGetValue($"blk-{b.Id}", out var v)) b.Text = v;
                }
                else if (b.Type == EditorBlockType.Table && b.Rows is not null)
                {
                    for (var r = 0; r < b.Rows.Count; r++)
                        for (var c = 0; c < b.Rows[r].Count; c++)
                            if (values.TryGetValue($"cell-{b.Id}-{r}-{c}", out var cv)) b.Rows[r][c] = cv;
                }
                else if (b.Type == EditorBlockType.Columns && b.ColumnsHtml is not null)
                {
                    for (var c = 0; c < b.ColumnsHtml.Count; c++)
                        if (values.TryGetValue($"col-{b.Id}-{c}", out var colv)) b.ColumnsHtml[c] = colv;
                }
            }
            foreach (var ov in page.Overlays)
                if (ov.Type == EditorOverlayType.Text && values.TryGetValue($"ovedit-{ov.Id}", out var ovv)) ov.Text = ovv;
        }
    }

    private Task OnEditableBlur() => SyncAllAsync();

    // --- Undo/Redo --------------------------------------------------------------
    private void PushUndo()
    {
        _undoList.Add(_doc.Snapshot());
        if (_undoList.Count > MaxUndo) _undoList.RemoveAt(0);
        _redoList.Clear();
    }

    private async Task UndoAsync()
    {
        if (_undoList.Count == 0) return;
        await SyncAllAsync();
        _redoList.Add(_doc.Snapshot());
        _doc = _undoList[^1];
        _undoList.RemoveAt(_undoList.Count - 1);
        AfterDocReplaced();
    }

    private async Task RedoAsync()
    {
        if (_redoList.Count == 0) return;
        await SyncAllAsync();
        _undoList.Add(_doc.Snapshot());
        _doc = _redoList[^1];
        _redoList.RemoveAt(_redoList.Count - 1);
        AfterDocReplaced();
    }

    private void AfterDocReplaced()
    {
        _selected = null;
        _selectedOverlay = null;
        _selectedPage = _doc.Pages.FirstOrDefault();
        _pageSizeDirty = true;
        // Sicherheit: Dokumentwechsel (auch Undo/Redo) beendet die Template-
        // Bearbeitung — sonst könnte fremder Inhalt ins Template geschrieben werden.
        _templateFile = null;
    }

    // --- Theme ------------------------------------------------------------------
    private void OnThemePresetChange(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        PushUndo();
        if (string.IsNullOrEmpty(name))
        {
            _doc.Theme = null;
            return;
        }
        var preset = EditorThemes.Presets.FirstOrDefault(p => p.Name == name);
        if (preset is not null) _doc.Theme = preset.Clone();
    }

    private async Task ExportTheme()
    {
        if (_doc.Theme is null) return;
        var json = JsonSerializer.Serialize(_doc.Theme, ExportJsonOptions);
        var name = string.IsNullOrWhiteSpace(_doc.Theme.Name) ? "theme" : SafeName(_doc.Theme.Name);
        await DownloadTextAsync(name + ".pbtheme.json", json, "application/json");
    }

    private async Task OnImportTheme(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(256 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var theme = JsonSerializer.Deserialize<EditorTheme>(Encoding.UTF8.GetString(ms.ToArray()), ImportJsonOptions);
            if (theme is null) throw new JsonException();
            PushUndo();
            _doc.Theme = EditorThemes.Sanitize(theme);
            _status = L.T("editor.import.done");
        }
        catch
        {
            _status = L.T("editor.import.error");
        }
    }

    // --- Dokument-Import (JSON-Roundtrip zu „Export → JSON") ---------------------
    private async Task OnImportDocument(InputFileChangeEventArgs e)
    {
        try
        {
            const long max = 64 * 1024 * 1024;
            await using var stream = e.File.OpenReadStream(max);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var doc = await ParseDesignJsonAsync(Encoding.UTF8.GetString(ms.ToArray()));
            if (doc is null) throw new JsonException();
            doc.Id = Guid.NewGuid().ToString("N"); // keine Kollision mit vorhandenen Entwürfen
            PushUndo();
            _doc = doc;
            AfterDocReplaced();
            _status = L.T("editor.import.done");
        }
        catch
        {
            _status = L.T("editor.import.error");
        }
    }

    // --- HTML-Import (Texte aus einer hochgeladenen HTML-Datei übernehmen) -------
    private async Task OnImportHtml(InputFileChangeEventArgs e)
    {
        try
        {
            const long max = 32 * 1024 * 1024;
            await using var stream = e.File.OpenReadStream(max);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var html = Encoding.UTF8.GetString(ms.ToArray());
            // Strukturextraktion (Überschriften/Absätze/Listen/Tabellen/Bilder) im
            // Browser-DOM; das Ergebnis ist EditorDocument-förmig und durchläuft
            // dieselbe Säuberung wie der JSON-Import (Skripte/Styles fliegen raus).
            var json = await JS.InvokeAsync<string>("pageboundWysiwyg.importHtmlToDocument", html);
            var doc = await ParseDesignJsonAsync(json);
            if (doc is null || doc.Pages.Count == 0) throw new JsonException();
            doc.Id = Guid.NewGuid().ToString("N");
            doc.Title = string.IsNullOrWhiteSpace(doc.Title) ? StripExtension(e.File.Name) : doc.Title;
            PushUndo();
            _doc = doc;
            AfterDocReplaced();
            _status = L.T("editor.import.done");
        }
        catch
        {
            _status = L.T("editor.import.error");
        }
    }

    private static string StripExtension(string name)
    {
        var dot = name.LastIndexOf('.');
        return dot > 0 ? name[..dot] : name;
    }

    /// <summary>Parst + säubert eine Dokument-JSON aus Fremdquellen (Datei-Import,
    /// Design-Ordner). Liefert <c>null</c>, wenn die Datei kein gültiges Dokument ist.</summary>
    private async Task<EditorDocument?> ParseDesignJsonAsync(string json)
    {
        EditorDocument? doc;
        try
        {
            doc = JsonSerializer.Deserialize<EditorDocument>(json, ImportJsonOptions);
        }
        catch
        {
            return null;
        }
        if (doc is null) return null;
        doc.Migrate();
        SanitizeImportedDocument(doc);
        await SanitizeImportedHtmlAsync(doc);
        return doc;
    }

    /// <summary>Begrenzt alle Werte einer importierten Datei auf sichere Bereiche
    /// (nur Hex-Farben, nur data:image-URLs, Wertebereiche) — schützt vor
    /// CSS-Injection über manipulierte JSON-Dateien.</summary>
    private static void SanitizeImportedDocument(EditorDocument doc)
    {
        if (doc.Theme is not null) EditorThemes.Sanitize(doc.Theme);
        foreach (var page in doc.Pages)
        {
            page.Background = EditorThemes.SanitizeColorOrNull(page.Background);
            if (page.BackgroundImage is not null && !page.BackgroundImage.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase))
                page.BackgroundImage = null;
            page.BackgroundSize = page.BackgroundSize == "contain" ? "contain" : "cover";
            page.BackgroundPosition = page.BackgroundPosition is "top" or "bottom" ? page.BackgroundPosition : "center";
            page.BackgroundOpacityPercent = Math.Clamp(page.BackgroundOpacityPercent, 10, 100);
            foreach (var b in page.Blocks)
            {
                b.Align = b.Align is "center" or "right" or "justify" ? b.Align : "left";
                b.Level = Math.Clamp(b.Level, 1, 3);
                b.Color = EditorThemes.SanitizeColor(b.Color, "#1f2937");
                b.Background = EditorThemes.SanitizeColorOrNull(b.Background);
                b.WidthPercent = Math.Clamp(b.WidthPercent, 10, 100);
                b.HeightPx = Math.Clamp(b.HeightPx, 1, 400);
                b.CornerRadiusPx = Math.Clamp(b.CornerRadiusPx, 0, 48);
                b.BorderWidthPx = Math.Clamp(b.BorderWidthPx, 0, 12);
                b.BorderColor = EditorThemes.SanitizeColorOrNull(b.BorderColor);
                b.ColumnGapPx = Math.Clamp(b.ColumnGapPx, 0, 64);
                if (b.ColumnsHtml is { Count: > 4 }) b.ColumnsHtml = b.ColumnsHtml.Take(4).ToList();
                if (b.FontSizePt is int pt) b.FontSizePt = Math.Clamp(pt, 6, 120);
                if (b.Src is not null && !b.Src.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase))
                    b.Src = null;
                if (b.Mind is not null) SanitizeMindNode(b.Mind, 0);
            }
            foreach (var ov in page.Overlays)
            {
                ov.XPercent = Math.Clamp(ov.XPercent, -20, 98);
                ov.YPercent = Math.Clamp(ov.YPercent, -10, 98);
                ov.WidthPercent = Math.Clamp(ov.WidthPercent, 4, 100);
                ov.HeightPercent = Math.Clamp(ov.HeightPercent, 2, 100);
                ov.RotationDeg = Math.Clamp(ov.RotationDeg, -180, 180);
                ov.OpacityPercent = Math.Clamp(ov.OpacityPercent, 10, 100);
                ov.Align = ov.Align is "center" or "right" or "justify" ? ov.Align : "left";
                ov.Color = EditorThemes.SanitizeColor(ov.Color, "#111827");
                ov.Background = EditorThemes.SanitizeColorOrNull(ov.Background);
                ov.Shape = ov.Shape == "ellipse" ? "ellipse" : "rectangle";
                if (ov.FontSizePt is int opt) ov.FontSizePt = Math.Clamp(opt, 6, 120);
                if (ov.Src is not null && !ov.Src.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase))
                    ov.Src = null;
            }
        }
    }

    /// <summary>Begrenzt einen importierten Mindmap-Baum: Labels als Klartext (kein
    /// HTML), Tiefe ≤ 8, ≤ 100 Kinder je Knoten, gültige Ids. Schützt vor
    /// manipulierten/übergroßen Bäumen aus Fremddateien.</summary>
    private static void SanitizeMindNode(MindmapNode n, int depth)
    {
        n.Label = (n.Label ?? string.Empty).Replace('<', ' ').Replace('>', ' ').Trim();
        if (n.Label.Length > 200) n.Label = n.Label[..200];
        if (string.IsNullOrWhiteSpace(n.Id)) n.Id = Guid.NewGuid().ToString("N");
        if (depth >= 8) { n.Children.Clear(); return; }
        if (n.Children.Count > 100) n.Children = n.Children.Take(100).ToList();
        foreach (var c in n.Children) SanitizeMindNode(c, depth + 1);
    }

    /// <summary>Säubert alle Rich-Text-Felder eines importierten Dokuments über den
    /// DOM-basierten Sanitizer der JS-Brücke (entfernt Skripte/Event-Handler).</summary>
    private async Task SanitizeImportedHtmlAsync(EditorDocument doc)
    {
        var fragments = new List<string>();
        foreach (var page in doc.Pages)
        {
            foreach (var b in page.Blocks)
            {
                if (b.Text is not null) fragments.Add(b.Text);
                if (b.Rows is not null) foreach (var row in b.Rows) fragments.AddRange(row);
                if (b.ColumnsHtml is not null) fragments.AddRange(b.ColumnsHtml);
            }
            foreach (var ov in page.Overlays)
                if (ov.Text is not null) fragments.Add(ov.Text);
        }
        if (fragments.Count == 0) return;
        var clean = await JS.InvokeAsync<string[]>("pageboundWysiwyg.sanitizeHtmlBatch", (object)fragments.ToArray());
        var i = 0;
        foreach (var page in doc.Pages)
        {
            foreach (var b in page.Blocks)
            {
                if (b.Text is not null) b.Text = clean[i++];
                if (b.Rows is not null)
                    foreach (var row in b.Rows)
                        for (var c = 0; c < row.Count; c++) row[c] = clean[i++];
                if (b.ColumnsHtml is not null)
                    for (var c = 0; c < b.ColumnsHtml.Count; c++) b.ColumnsHtml[c] = clean[i++];
            }
            foreach (var ov in page.Overlays)
                if (ov.Text is not null) ov.Text = clean[i++];
        }
    }

    // --- Design-Ordner (Dateisystem) ---------------------------------------------
    private async Task PickDesignFolder()
    {
        var name = await Designs.PickFolderAsync(CancellationToken.None);
        if (name is null) return; // Abbruch
        _designFolder = name;
        _templateFile = null;
        _designStatus = null;
        await RefreshDesignsAsync();
    }

    private async Task DisconnectDesignFolder()
    {
        await Designs.ClearFolderAsync(CancellationToken.None);
        _designFolder = null;
        _designs = Array.Empty<DesignFileInfo>();
        _templateFile = null;
        _designStatus = null;
    }

    private async Task RefreshDesignsAsync()
        => _designs = await Designs.ListAsync(CancellationToken.None);

    /// <summary>Legt die mitgelieferten Standard-Designs in den Ordner — vorhandene
    /// Dateien werden nie überschrieben (Designs des Nutzers bleiben unangetastet).</summary>
    private async Task SeedDefaultDesigns()
    {
        var written = 0;
        foreach (var def in EditorDesignDefaults.All)
        {
            var file = def.FileBaseName + DesignSuffix;
            if (await Designs.ExistsAsync(file, CancellationToken.None)) continue;
            var json = JsonSerializer.Serialize(def.Create(), ExportJsonOptions);
            if (await Designs.WriteAsync(file, json, CancellationToken.None)) written++;
        }
        _designStatus = L.T("editor.designs.seeded", new Dictionary<string, object> { ["n"] = written });
        await RefreshDesignsAsync();
    }

    /// <summary>Speichert das aktuelle Dokument als neue Design-Datei im Ordner.
    /// Vorhandene fremde Dateien werden nicht überschrieben (Name wird hochgezählt);
    /// nur im „Template bearbeiten“-Modus schreibt <see cref="SaveTemplate"/> zurück.</summary>
    private async Task SaveAsDesign()
    {
        await JS.InvokeVoidAsync("pageboundWysiwyg.blurActive");
        await SyncAllAsync();
        var baseName = SafeName(string.IsNullOrWhiteSpace(_doc.Title) ? "design" : _doc.Title);
        var file = baseName + DesignSuffix;
        var n = 2;
        while (await Designs.ExistsAsync(file, CancellationToken.None))
        {
            file = $"{baseName}-{n++}{DesignSuffix}";
            if (n > 50) { _designStatus = L.T("editor.designs.error"); return; }
        }
        var json = JsonSerializer.Serialize(_doc, ExportJsonOptions);
        _designStatus = await Designs.WriteAsync(file, json, CancellationToken.None)
            ? L.T("editor.designs.saved", new Dictionary<string, object> { ["file"] = file })
            : L.T("editor.designs.error");
        await RefreshDesignsAsync();
    }

    /// <summary>„Verwenden“: lädt das Design als Schablone — Kopie mit neuer Id,
    /// die Datei im Ordner bleibt unverändert.</summary>
    private async Task UseDesignAsync(string fileName)
    {
        var json = await Designs.ReadAsync(fileName, CancellationToken.None);
        var doc = json is null ? null : await ParseDesignJsonAsync(json);
        if (doc is null) { _designStatus = L.T("editor.designs.error"); return; }
        doc.Id = Guid.NewGuid().ToString("N");
        PushUndo();
        _doc = doc;
        AfterDocReplaced();
        _designStatus = L.T("editor.designs.useLoaded");
        _status = null;
    }

    /// <summary>„Template bearbeiten“: lädt das Design und verknüpft es mit der
    /// Datei — <see cref="SaveTemplate"/> schreibt dann dorthin zurück.</summary>
    private async Task EditTemplateAsync(string fileName)
    {
        var json = await Designs.ReadAsync(fileName, CancellationToken.None);
        var doc = json is null ? null : await ParseDesignJsonAsync(json);
        if (doc is null) { _designStatus = L.T("editor.designs.error"); return; }
        PushUndo();
        _doc = doc;
        AfterDocReplaced();
        _templateFile = fileName;
        _designStatus = null;
        _status = null;
    }

    private async Task SaveTemplate()
    {
        if (_templateFile is null) return;
        await JS.InvokeVoidAsync("pageboundWysiwyg.blurActive");
        await SyncAllAsync();
        var json = JsonSerializer.Serialize(_doc, ExportJsonOptions);
        _designStatus = await Designs.WriteAsync(_templateFile, json, CancellationToken.None)
            ? L.T("editor.designs.templateSaved")
            : L.T("editor.designs.error");
        await RefreshDesignsAsync();
    }

    private async Task DeleteDesignAsync(string fileName)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            L.T("editor.designs.deleteConfirm", new Dictionary<string, object> { ["file"] = fileName }));
        if (!confirmed) return;
        if (!await Designs.DeleteAsync(fileName, CancellationToken.None))
        {
            _designStatus = L.T("editor.designs.error");
            return;
        }
        if (_templateFile == fileName) _templateFile = null;
        _designStatus = null;
        await RefreshDesignsAsync();
    }

    // --- Drag & Drop --------------------------------------------------------------
    /// <summary>Block-Drop auf einen Ziel-Block: fügt den gezogenen Block davor ein
    /// (auch seitenübergreifend). Die Pfeil-Buttons bleiben als Tastatur-/Touch-Weg.</summary>
    private async Task OnBlockDrop(EditorPage targetPage, EditorBlock target)
    {
        var dragged = _dragBlock;
        _dragBlock = null;
        _dropBlock = null;
        if (dragged is null || dragged == target) return;
        var sourcePage = PageOf(dragged);
        if (sourcePage is null) return;
        await SyncAllAsync();
        PushUndo();
        sourcePage.Blocks.Remove(dragged);
        var at = targetPage.Blocks.IndexOf(target);
        if (at < 0) at = targetPage.Blocks.Count;
        targetPage.Blocks.Insert(at, dragged);
        _selected = dragged;
        _selectedPage = targetPage;
    }

    /// <summary>Block-Drop auf freie Seitenfläche: hängt den Block ans Seitenende.</summary>
    private async Task OnPageAreaDrop(EditorPage targetPage)
    {
        var dragged = _dragBlock;
        _dragBlock = null;
        _dropBlock = null;
        if (dragged is null) return;
        var sourcePage = PageOf(dragged);
        if (sourcePage is null) return;
        if (sourcePage == targetPage && targetPage.Blocks.LastOrDefault() == dragged) return;
        await SyncAllAsync();
        PushUndo();
        sourcePage.Blocks.Remove(dragged);
        targetPage.Blocks.Add(dragged);
        _selected = dragged;
        _selectedPage = targetPage;
    }

    /// <summary>Seitenliste: gezogene Seite vor die Zielposition verschieben.</summary>
    private async Task OnPageListDrop(int targetIdx)
    {
        var from = _dragPageIdx;
        _dragPageIdx = -1;
        _dropPageIdx = -1;
        if (from < 0 || from >= _doc.Pages.Count || from == targetIdx) return;
        await SyncAllAsync();
        PushUndo();
        var page = _doc.Pages[from];
        _doc.Pages.RemoveAt(from);
        var at = Math.Clamp(targetIdx > from ? targetIdx - 1 : targetIdx, 0, _doc.Pages.Count);
        _doc.Pages.Insert(at, page);
        _selectedPage = page;
    }

    /// <summary>Vom JS-Datei-Drop gemeldete Dateien (Leinwand): Bilder werden als
    /// Bild-Blöcke auf der Zielseite eingefügt; eine JSON-Datei importiert das
    /// Dokument (wie „Import (JSON-Dokument)").</summary>
    public sealed record DroppedFile(string Name, string Kind, string? DataUrl, string? Text);

    [JSInvokable]
    public async Task OnFilesDropped(int pageIndex, DroppedFile[] files)
    {
        var json = files.FirstOrDefault(f => f.Kind == "json" && !string.IsNullOrEmpty(f.Text));
        if (json is not null)
        {
            var doc = await ParseDesignJsonAsync(json.Text!);
            if (doc is null)
            {
                _status = L.T("editor.import.error");
            }
            else
            {
                doc.Id = Guid.NewGuid().ToString("N");
                PushUndo();
                _doc = doc;
                AfterDocReplaced();
                _status = L.T("editor.import.done");
            }
            StateHasChanged();
            return;
        }

        var images = files.Where(f => f.Kind == "image"
            && f.DataUrl is not null
            && f.DataUrl.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase)).ToList();
        if (images.Count == 0) return;

        await SyncAllAsync();
        PushUndo();
        var page = pageIndex >= 0 && pageIndex < _doc.Pages.Count ? _doc.Pages[pageIndex] : CurrentPage();
        foreach (var img in images)
        {
            var compressed = await JS.InvokeAsync<string>("pageboundWysiwyg.compressDataUrl", img.DataUrl, 2000, 0.85);
            var block = new EditorBlock { Type = EditorBlockType.Image, Src = compressed, Alt = img.Name, WidthPercent = 60, Align = "center" };
            page.Blocks.Add(block);
            _selected = block;
        }
        _selectedPage = page;
        _status = L.T("editor.dnd.imagesAdded", new Dictionary<string, object> { ["n"] = images.Count });
        StateHasChanged();
    }

    public void Dispose() => _selfRef?.Dispose();

    private void ApplyBackgroundToAllPages()
    {
        if (_selectedPage is null) return;
        PushUndo();
        foreach (var page in _doc.Pages)
        {
            if (page == _selectedPage) continue;
            page.Background = _selectedPage.Background;
            page.BackgroundImage = _selectedPage.BackgroundImage;
            page.BackgroundSize = _selectedPage.BackgroundSize;
            page.BackgroundOpacityPercent = _selectedPage.BackgroundOpacityPercent;
            page.BackgroundPosition = _selectedPage.BackgroundPosition;
            page.BackgroundRepeat = _selectedPage.BackgroundRepeat;
        }
    }

    // --- Auswahl --------------------------------------------------------------
    private void SelectBlock(EditorPage page, EditorBlock b)
    {
        if (_selected != b) _cropL = _cropT = _cropR = _cropB = 0;
        if (_selected != b && b.Type is EditorBlockType.Mindmap) _mindNodeId = b.Mind?.Id;
        _selected = b;
        _selectedPage = page;
        _selectedOverlay = null;
    }
    private void SelectPage(EditorPage page)
    {
        _selectedPage = page; _selected = null; _selectedOverlay = null;
        if (_singleSlide) { var i = _doc.Pages.IndexOf(page); if (i >= 0) _slideIndex = i; }
    }

    // --- Einzelfolien-Ansicht ----------------------------------------------------
    private void ToggleSingleSlide()
    {
        _singleSlide = !_singleSlide;
        if (_singleSlide)
        {
            var i = _selectedPage is null ? 0 : _doc.Pages.IndexOf(_selectedPage);
            _slideIndex = Math.Clamp(i < 0 ? 0 : i, 0, Math.Max(0, _doc.Pages.Count - 1));
            _selectedPage = _doc.Pages[_slideIndex];
        }
    }

    private void GoSlide(int dir)
    {
        _slideIndex = Math.Clamp(_slideIndex + dir, 0, _doc.Pages.Count - 1);
        _selectedPage = _doc.Pages[_slideIndex];
        _selected = null;
        _selectedOverlay = null;
    }
    private void SelectOverlay(EditorPage page, EditorOverlay ov) { _selectedOverlay = ov; _selectedPage = page; _selected = null; }
    private void DeselectIfBackground() { _selected = null; _selectedOverlay = null; }

    private void SetAlign(string align)
    {
        if (_selected is null) return;
        _selected.Align = align;
    }

    // --- Seiten ---------------------------------------------------------------
    private EditorPage CurrentPage()
    {
        if (_selectedPage is null || !_doc.Pages.Contains(_selectedPage))
        {
            _selectedPage = _doc.Pages.FirstOrDefault();
            if (_selectedPage is null)
            {
                _selectedPage = new EditorPage();
                _doc.Pages.Add(_selectedPage);
            }
        }
        return _selectedPage;
    }

    private async Task AddPage()
    {
        await SyncAllAsync();
        PushUndo();
        var page = new EditorPage();
        var at = _selectedPage is not null ? _doc.Pages.IndexOf(_selectedPage) + 1 : _doc.Pages.Count;
        if (at < 0 || at > _doc.Pages.Count) at = _doc.Pages.Count;
        _doc.Pages.Insert(at, page);
        _selectedPage = page;
        _selected = null;
        _selectedOverlay = null;
    }

    private async Task DuplicatePage(EditorPage page)
    {
        await SyncAllAsync();
        PushUndo();
        var copy = page.Clone();
        _doc.Pages.Insert(_doc.Pages.IndexOf(page) + 1, copy);
        _selectedPage = copy;
        _selected = null;
        _selectedOverlay = null;
    }

    private async Task DeletePage(EditorPage page)
    {
        if (_doc.Pages.Count <= 1) return;
        await SyncAllAsync();
        PushUndo();
        var i = _doc.Pages.IndexOf(page);
        _doc.Pages.Remove(page);
        // Selektion aufräumen, falls sie auf der gelöschten Seite lag (sonst editiert
        // das Eigenschaften-Panel einen Block/ein Overlay, das nicht mehr sichtbar ist).
        if (_selected is not null && page.Blocks.Contains(_selected)) _selected = null;
        if (_selectedOverlay is not null && page.Overlays.Contains(_selectedOverlay)) _selectedOverlay = null;
        _selectedPage = _doc.Pages[Math.Clamp(i, 0, _doc.Pages.Count - 1)];
    }

    private async Task MovePage(EditorPage page, int dir)
    {
        await SyncAllAsync();
        var i = _doc.Pages.IndexOf(page);
        var j = i + dir;
        if (i < 0 || j < 0 || j >= _doc.Pages.Count) return;
        PushUndo();
        (_doc.Pages[i], _doc.Pages[j]) = (_doc.Pages[j], _doc.Pages[i]);
    }

    // --- Blöcke hinzufügen/bewegen/löschen -----------------------------------
    private async Task AddBlock(EditorBlockType type)
    {
        await SyncAllAsync();
        PushUndo();
        var page = CurrentPage();
        var b = new EditorBlock { Type = type };
        if (type is EditorBlockType.Shape && _doc.Theme is not null) b.Color = _doc.Theme.AccentColor;
        switch (type)
        {
            case EditorBlockType.Heading: b.Level = 2; b.Text = ""; break;
            case EditorBlockType.Paragraph: b.Text = ""; break;
            case EditorBlockType.Image: b.WidthPercent = 60; b.Align = "center"; b.Alt = L.T("editor.image.empty"); break;
            case EditorBlockType.Shape: b.Shape = "rectangle"; b.Color = "#1f2937"; b.HeightPx = 48; break;
            case EditorBlockType.Spacer: b.HeightPx = 24; break;
            case EditorBlockType.Table:
                b.HeaderRow = true;
                b.Rows = new List<List<string>>
                {
                    new() { "Spalte 1", "Spalte 2", "Spalte 3" },
                    new() { "", "", "" },
                    new() { "", "", "" }
                };
                break;
            case EditorBlockType.Columns:
                b.ColumnsHtml = new List<string> { "", "" };
                break;
            case EditorBlockType.QrCode:
                b.Text = "https://";
                b.WidthPercent = 30;
                b.Align = "center";
                b.Src = await JS.InvokeAsync<string>("pageboundWysiwyg.makeQr", b.Text, 512);
                break;
            case EditorBlockType.Mindmap:
                b.WidthPercent = 80;
                b.Align = "center";
                b.Mind = new MindmapNode
                {
                    Label = L.T("editor.mind.rootDefault"),
                    Children =
                    {
                        new MindmapNode { Label = L.T("editor.mind.branchDefault") + " 1" },
                        new MindmapNode { Label = L.T("editor.mind.branchDefault") + " 2" }
                    }
                };
                b.Src = await JS.InvokeAsync<string>("pageboundMind.renderMindmapDataUrl", JsonSerializer.Serialize(b.Mind, ImportJsonOptions));
                break;
        }
        page.Blocks.Add(b);
        _selected = b;
        if (b.Mind is not null) _mindNodeId = b.Mind.Id;
        _selectedOverlay = null;
        if (type is EditorBlockType.Heading or EditorBlockType.Paragraph) _focusBlockId = b.Id;
    }

    private async Task OnQrTextChanged(string text)
    {
        if (_selected is null || _selected.Type != EditorBlockType.QrCode) return;
        _selected.Text = text;
        _selected.Src = await JS.InvokeAsync<string>("pageboundWysiwyg.makeQr", text, 512);
    }

    // --- Mindmap-Block: bearbeitbarer Knoten-Baum -------------------------------
    private string? _mindNodeId;

    /// <summary>Knoten in Vorlauf-Reihenfolge mit Tiefe (für Dropdown + Operationen).</summary>
    private static IEnumerable<(MindmapNode node, int depth)> FlattenMind(MindmapNode root)
    {
        IEnumerable<(MindmapNode, int)> Rec(MindmapNode n, int d)
        {
            yield return (n, d);
            foreach (var c in n.Children)
                foreach (var x in Rec(c, d + 1))
                    yield return x;
        }
        return Rec(root, 0);
    }

    private static MindmapNode? FindMindNode(MindmapNode root, string? id)
        => id is null ? null : FlattenMind(root).Select(t => t.node).FirstOrDefault(n => n.Id == id);

    private static MindmapNode? FindMindParent(MindmapNode root, string id)
        => FlattenMind(root).Select(t => t.node).FirstOrDefault(n => n.Children.Any(c => c.Id == id));

    private static string MindIndent(int depth) => depth == 0 ? "" : new string(' ', depth * 3) + "└ ";
    private static string MindShort(string label)
        => string.IsNullOrEmpty(label) ? "—" : (label.Length > 42 ? label[..42] + "…" : label);

    private bool CanMindIndent(MindmapNode node)
    {
        if (_selected?.Mind is null || node == _selected.Mind) return false;
        var parent = FindMindParent(_selected.Mind, node.Id);
        return parent is not null && parent.Children.IndexOf(node) > 0; // braucht einen Vorgänger-Geschwisterknoten
    }

    private bool CanMindOutdent(MindmapNode node)
    {
        if (_selected?.Mind is null || node == _selected.Mind) return false;
        var parent = FindMindParent(_selected.Mind, node.Id);
        return parent is not null && parent != _selected.Mind; // Eltern dürfen nicht die Wurzel sein
    }

    private MindmapNode? CurrentMindNode()
        => _selected?.Mind is null ? null : FindMindNode(_selected.Mind, _mindNodeId) ?? _selected.Mind;

    private void OnMindNodeSelect(ChangeEventArgs e) => _mindNodeId = e.Value?.ToString();

    private Task OnMindLabelChange(ChangeEventArgs e) => MindRename(e.Value?.ToString() ?? string.Empty);

    private async Task RerenderMindAsync()
    {
        if (_selected?.Mind is null) return;
        var json = JsonSerializer.Serialize(_selected.Mind, ImportJsonOptions);
        _selected.Src = await JS.InvokeAsync<string>("pageboundMind.renderMindmapDataUrl", json);
    }

    private async Task MindRename(string label)
    {
        var node = CurrentMindNode();
        if (node is null) return;
        PushUndo();
        node.Label = label;
        await RerenderMindAsync();
    }

    private async Task MindAddChild()
    {
        var node = CurrentMindNode();
        if (node is null) return;
        PushUndo();
        var child = new MindmapNode { Label = L.T("editor.mind.branchDefault") };
        node.Children.Add(child);
        _mindNodeId = child.Id;
        await RerenderMindAsync();
    }

    private async Task MindAddSibling()
    {
        if (_selected?.Mind is null) return;
        var node = CurrentMindNode();
        if (node is null || node == _selected.Mind) return;
        var parent = FindMindParent(_selected.Mind, node.Id);
        if (parent is null) return;
        PushUndo();
        var sibling = new MindmapNode { Label = L.T("editor.mind.branchDefault") };
        parent.Children.Insert(parent.Children.IndexOf(node) + 1, sibling);
        _mindNodeId = sibling.Id;
        await RerenderMindAsync();
    }

    private async Task MindDelete()
    {
        if (_selected?.Mind is null) return;
        var node = CurrentMindNode();
        if (node is null || node == _selected.Mind) return;
        var parent = FindMindParent(_selected.Mind, node.Id);
        if (parent is null) return;
        PushUndo();
        parent.Children.Remove(node);
        _mindNodeId = parent.Id;
        await RerenderMindAsync();
    }

    private async Task MindMove(int dir)
    {
        if (_selected?.Mind is null) return;
        var node = CurrentMindNode();
        if (node is null || node == _selected.Mind) return;
        var parent = FindMindParent(_selected.Mind, node.Id);
        if (parent is null) return;
        var i = parent.Children.IndexOf(node);
        var j = i + dir;
        if (j < 0 || j >= parent.Children.Count) return;
        PushUndo();
        (parent.Children[i], parent.Children[j]) = (parent.Children[j], parent.Children[i]);
        await RerenderMindAsync();
    }

    /// <summary>Einrücken: Knoten wird Kind seines vorherigen Geschwisterknotens.</summary>
    private async Task MindIndentNode()
    {
        if (_selected?.Mind is null) return;
        var node = CurrentMindNode();
        if (node is null || !CanMindIndent(node)) return;
        var parent = FindMindParent(_selected.Mind, node.Id)!;
        var i = parent.Children.IndexOf(node);
        var prev = parent.Children[i - 1];
        PushUndo();
        parent.Children.RemoveAt(i);
        prev.Children.Add(node);
        await RerenderMindAsync();
    }

    /// <summary>Ausrücken: Knoten wird Geschwister seines Elternknotens (eine Ebene höher).</summary>
    private async Task MindOutdent()
    {
        if (_selected?.Mind is null) return;
        var node = CurrentMindNode();
        if (node is null || !CanMindOutdent(node)) return;
        var parent = FindMindParent(_selected.Mind, node.Id)!;
        var grand = FindMindParent(_selected.Mind, parent.Id)!;
        PushUndo();
        parent.Children.Remove(node);
        grand.Children.Insert(grand.Children.IndexOf(parent) + 1, node);
        await RerenderMindAsync();
    }

    private async Task ColumnAdd(EditorBlock b)
    {
        await SyncAllAsync();
        b.ColumnsHtml ??= new List<string>();
        if (b.ColumnsHtml.Count >= 4) return;
        PushUndo();
        b.ColumnsHtml.Add("");
    }

    private async Task ColumnRemove(EditorBlock b)
    {
        await SyncAllAsync();
        if (b.ColumnsHtml is not { Count: > 2 }) return;
        PushUndo();
        b.ColumnsHtml.RemoveAt(b.ColumnsHtml.Count - 1);
    }

    // --- Overlays (frei platzierte Elemente) -----------------------------------
    private async Task AddOverlay(EditorOverlayType type)
    {
        await SyncAllAsync();
        PushUndo();
        var page = CurrentPage();
        var ov = new EditorOverlay { Type = type };
        switch (type)
        {
            case EditorOverlayType.Text:
                ov.Text = L.T("editor.overlay.textDefault");
                ov.WidthPercent = 40;
                break;
            case EditorOverlayType.Image:
                ov.WidthPercent = 30;
                ov.Alt = L.T("editor.image.empty");
                break;
            case EditorOverlayType.Shape:
                ov.WidthPercent = 30;
                ov.HeightPercent = 10;
                ov.Color = _doc.Theme?.AccentColor ?? "#2563eb";
                ov.OpacityPercent = 80;
                break;
        }
        // Leicht versetzt einfügen, damit mehrere neue Overlays nicht exakt stapeln.
        var offset = (page.Overlays.Count % 5) * 4;
        ov.XPercent = 10 + offset;
        ov.YPercent = 10 + offset;
        page.Overlays.Add(ov);
        _selectedOverlay = ov;
        _selectedPage = page;
        _selected = null;
    }

    private EditorPage? PageOfOverlay(EditorOverlay ov) => _doc.Pages.FirstOrDefault(p => p.Overlays.Contains(ov));

    private async Task DeleteOverlay(EditorOverlay ov)
    {
        await SyncAllAsync();
        var page = PageOfOverlay(ov);
        if (page is null) return;
        PushUndo();
        page.Overlays.Remove(ov);
        if (_selectedOverlay == ov) _selectedOverlay = null;
    }

    private async Task DuplicateOverlay(EditorOverlay ov)
    {
        await SyncAllAsync();
        var page = PageOfOverlay(ov);
        if (page is null) return;
        PushUndo();
        var copy = ov.Clone();
        copy.XPercent = Math.Min(95, copy.XPercent + 3);
        copy.YPercent = Math.Min(95, copy.YPercent + 3);
        page.Overlays.Add(copy);
        _selectedOverlay = copy;
    }

    /// <summary>Stapel-Reihenfolge ändern (Listenposition = Z-Ordnung).</summary>
    private async Task MoveOverlayZ(EditorOverlay ov, int dir)
    {
        await SyncAllAsync();
        var page = PageOfOverlay(ov);
        if (page is null) return;
        var i = page.Overlays.IndexOf(ov);
        var j = i + dir;
        if (i < 0 || j < 0 || j >= page.Overlays.Count) return;
        PushUndo();
        (page.Overlays[i], page.Overlays[j]) = (page.Overlays[j], page.Overlays[i]);
    }

    private async Task OnOverlayImageSelected(InputFileChangeEventArgs e)
    {
        if (_selectedOverlay is null || _selectedOverlay.Type != EditorOverlayType.Image) return;
        var dataUrl = await ReadCompressedImageAsync(e.File);
        if (dataUrl is null) return;
        PushUndo();
        _selectedOverlay.Src = dataUrl;
        _selectedOverlay.Alt = e.File.Name;
    }

    /// <summary>Vom Pointer-Drag/-Resize (JS) gemeldete End-Geometrie eines Overlays.</summary>
    [JSInvokable]
    public Task OnOverlayGeometry(string id, double xPercent, double yPercent, double widthPercent)
    {
        foreach (var page in _doc.Pages)
        {
            var ov = page.Overlays.FirstOrDefault(o => o.Id == id);
            if (ov is null) continue;
            PushUndo();
            ov.XPercent = Math.Clamp(xPercent, -20, 98);
            ov.YPercent = Math.Clamp(yPercent, -10, 98);
            ov.WidthPercent = Math.Clamp(widthPercent, 4, 100);
            StateHasChanged();
            break;
        }
        return Task.CompletedTask;
    }

    /// <summary>Globale Tastatur-Shortcuts (JS-Bridge): Strg+S, Strg+Z/Y, Entf.</summary>
    [JSInvokable]
    public async Task OnShortcut(string name)
    {
        switch (name)
        {
            case "save": await Save(); break;
            case "undo": await UndoAsync(); break;
            case "redo": await RedoAsync(); break;
            case "delete":
                if (_selectedOverlay is not null) await DeleteOverlay(_selectedOverlay);
                else if (_selected is not null) await DeleteBlock(_selected);
                break;
        }
        StateHasChanged();
    }

    // --- Serie aus CSV ({{platzhalter}}) ----------------------------------------
    private async Task OnSeriesCsvSelected(InputFileChangeEventArgs e)
    {
        try
        {
            await JS.InvokeVoidAsync("pageboundWysiwyg.blurActive");
            await SyncAllAsync();
            await using var stream = e.File.OpenReadStream(16 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var rows = EditorSeries.ParseCsv(Encoding.UTF8.GetString(ms.ToArray()));
            if (rows.Count == 0)
            {
                _status = L.T("editor.series.empty");
                return;
            }
            PushUndo();
            _doc = EditorSeries.Expand(_doc, rows);
            AfterDocReplaced();
            _status = L.T("editor.series.done", new Dictionary<string, object> { ["n"] = rows.Count, ["pages"] = _doc.Pages.Count });
        }
        catch
        {
            _status = L.T("editor.series.error");
        }
    }

    // --- Bild zuschneiden (Crop wird fest eingebacken, Undo via PushUndo) -------
    private int _cropL, _cropT, _cropR, _cropB;

    /// <summary>Live-Vorschau des Zuschnitts am selektierten Bild (clip-path; erst „Anwenden" backt ihn ein).</summary>
    private string? CropPreviewCss(EditorBlock b)
        => _selected == b && (_cropL + _cropT + _cropR + _cropB) > 0
            ? $";clip-path:inset({_cropT}% {_cropR}% {_cropB}% {_cropL}%)"
            : null;

    private async Task ApplyCrop()
    {
        if (_selected?.Src is null || _cropL + _cropT + _cropR + _cropB == 0) return;
        var cropped = await JS.InvokeAsync<string>("pageboundWysiwyg.cropDataUrl",
            _selected.Src, _cropL / 100.0, _cropT / 100.0, _cropR / 100.0, _cropB / 100.0);
        PushUndo();
        _selected.Src = cropped;
        _cropL = _cropT = _cropR = _cropB = 0;
    }

    /// <summary>Touch-Fallback des Block-Umsortierens (JS-Bridge): Quelle auf Ziel-Block
    /// oder ans Ende der Zielseite verschieben.</summary>
    [JSInvokable]
    public async Task OnBlockTouchDrop(string blockId, string? targetBlockId, int pageIndex)
    {
        EditorBlock? dragged = null;
        foreach (var p in _doc.Pages)
            dragged ??= p.Blocks.FirstOrDefault(x => x.Id == blockId);
        if (dragged is null) return;
        _dragBlock = dragged;
        if (targetBlockId is not null)
        {
            foreach (var p in _doc.Pages)
            {
                var target = p.Blocks.FirstOrDefault(x => x.Id == targetBlockId);
                if (target is not null) { await OnBlockDrop(p, target); break; }
            }
        }
        else if (pageIndex >= 0 && pageIndex < _doc.Pages.Count)
        {
            await OnPageAreaDrop(_doc.Pages[pageIndex]);
        }
        _dragBlock = null;
        StateHasChanged();
    }

    /// <summary>Liest eine Bilddatei und re-encodiert sie platzsparend (JS-Canvas).</summary>
    private async Task<string?> ReadCompressedImageAsync(IBrowserFile? file)
    {
        if (file is null) return null;
        const long max = 12 * 1024 * 1024;
        await using var stream = file.OpenReadStream(max);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var mime = string.IsNullOrEmpty(file.ContentType) ? "image/png" : file.ContentType;
        var dataUrl = $"data:{mime};base64,{Convert.ToBase64String(ms.ToArray())}";
        return await JS.InvokeAsync<string>("pageboundWysiwyg.compressDataUrl", dataUrl, 2000, 0.85);
    }

    private EditorPage? PageOf(EditorBlock b) => _doc.Pages.FirstOrDefault(p => p.Blocks.Contains(b));

    private async Task MoveBlock(EditorBlock b, int dir)
    {
