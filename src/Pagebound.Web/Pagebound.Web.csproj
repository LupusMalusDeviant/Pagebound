<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!--
      Trimming AN, Modus "partial" (Bean PDF-Tool-asm1): gekürzt werden nur
      Framework-Assemblies, die sich dafür markieren. Unsere eigenen Assemblies
      (Core/Infrastructure/Web) bleiben vollständig — dort liegen alle Typen, die
      per reflexionsbasiertem System.Text.Json serialisiert werden (IndexedDB,
      Sidecar, Designer-JSON, Integritäts-Hash). Ohne Trimming wurden 205 statt 49
      Framework-Assemblies ausgeliefert und beim Start geladen (u. a.
      System.Private.Xml, System.Data.Common — von nichts hier benutzt).
      Gemessen (docs/findings/MESSUNG-2026-11-05-kaltstart.md): Kaltstart
      9,45 → 4,19 MB, 4G 10,2 → 5,0 s.
      NICHT "full": das kürzt auch unsere Assemblies und bricht Router und JSON
      (ausprobiert: CtorNotLocated beim ersten Render).
      Abgesichert durch E2E JsonRoundTripTests (laufen gegen den Publish).
    -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!--
      Ohne ICU (Bean PDF-Tool-icu1): spart die icudt-Datei beim Start (144 KB br
      bei DE/EN, bis 249 KB bei anderen Browsersprachen). Kulturabhängig war nur:
      Library-Sortierung → Core/Text/TitleComparer (DIN 5007, Umlaute wie
      Grundbuchstaben) und Dateigrößen → Core/Text/ByteSizeFormatter (nach
      App-Sprache). Nebenwirkung erwünscht: Zahlen landen nie mehr mit Dezimal-
      komma in CSS/SVG (so geschehen in ReaderPane, Highlight-Toolbar).
      HybridGlobalization ist in .NET 10 wirkungslos (geprüft: ICU bleibt).
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pagebound.Core\Pagebound.Core.csproj" />
    <ProjectReference Include="..\Pagebound.Infrastructure\Pagebound.Infrastructure.csproj" />
  </ItemGroup>

</Project>
