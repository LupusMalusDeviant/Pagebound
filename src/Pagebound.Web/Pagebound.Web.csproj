<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!--
      Trimming aus: PdfSharpCore nutzt intern Reflection (Type.GetType auf
      Dictionary-Subtypes im Save-Pfad, Font-/Image-Resolver-Lookups), die
      beim Publish ohne Roots wegoptimiert werden. Solange wir keine
      gezielten TrimmerRoots-Descriptors pflegen, ist die Bundle-Differenz
      akzeptabel.
    -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pagebound.Core\Pagebound.Core.csproj" />
    <ProjectReference Include="..\Pagebound.Infrastructure\Pagebound.Infrastructure.csproj" />
  </ItemGroup>

</Project>
