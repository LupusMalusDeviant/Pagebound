{
  "name": "Pagebound – PDF ohne Upload",
  "short_name": "Pagebound",
  "description": "PDFs lesen, annotieren, unterschreiben, schwärzen und bearbeiten – komplett im Browser, ohne Upload, ohne Konto, ohne Tracking.",
  "lang": "de",
  "categories": ["productivity", "utilities", "business"],
  "id": "./",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#03173d",
  "prefer_related_applications": false,
  "file_handlers": [
    {
      "action": "/editor",
      "accept": {
        "application/json": [".pbdesign.json"]
      }
    }
  ],
  "icons": [
    {
      "src": "icon-512.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "icon-192.png",
      "type": "image/png",
      "sizes": "192x192"
    }
  ]
}
