@page "/"
@inject ILocalizationService L

<PageTitle>@L.T("app.title")</PageTitle>

<article class="ed">
    <header class="masthead-pg">
        <div class="folio-line">
            <span>@L.T("home.ed.folio")</span><span class="sep">·</span>
            <span>@L.T("app.version")</span><span class="sep">·</span>
            <span>@L.T("home.ed.local")</span>
        </div>
        <h1 class="wordmark-xl">Page<em>bound</em></h1>
        <p class="standfirst">@L.T("home.hero.lead")</p>
        <div class="actions">
            <a href="/reader" class="btn primary"><Icon Name="reader" /> @L.T("home.hero.ctaReader")</a>
            <a href="/library" class="link-cta">@L.T("home.hero.ctaLibrary") <Icon Name="arrowR" /></a>
            <a href="/tools" class="link-cta">@L.T("home.hero.ctaTools") <Icon Name="arrowR" /></a>
        </div>
    </header>

    <div class="ed-grid">
        <div class="ed-main">
            <section class="ed-sec" aria-labelledby="home-usp-h">
                <h2 class="ed-h" id="home-usp-h">@L.T("home.ed.uspHeading")</h2>
                <ol class="toc">
                    <li class="toc-item">
                        <span class="toc-num" aria-hidden="true">01</span>
                        <div class="toc-body"><h3>@L.T("home.usp.signature.title")</h3><p>@L.T("home.usp.signature.body")</p></div>
                    </li>
                    <li class="toc-item">
                        <span class="toc-num" aria-hidden="true">02</span>
                        <div class="toc-body"><h3>@L.T("home.usp.library.title")</h3><p>@L.T("home.usp.library.body")</p></div>
                    </li>
                    <li class="toc-item">
                        <span class="toc-num" aria-hidden="true">03</span>
                        <div class="toc-body"><h3>@L.T("home.usp.markdown.title")</h3><p>@L.T("home.usp.markdown.body")</p></div>
                    </li>
                </ol>
            </section>

            <section class="ed-sec" aria-labelledby="home-have-h">
                <h2 class="ed-h" id="home-have-h">@L.T("home.builtin.heading")</h2>
                <ul class="feat-list">
                    @foreach (var (kKey, dKey) in Haves)
                    {
                        <li><span class="k">@L.T(kKey)</span><p>@L.T(dKey)</p></li>
                    }
                </ul>
            </section>

            <section class="ed-sec" aria-labelledby="home-road-h">
                <h2 class="ed-h" id="home-road-h">@L.T("home.status.heading") <span class="ed-h-meta">@L.T("app.version") → v1.0</span></h2>
                <ol class="ledger">
                    @foreach (var r in RoadmapRows())
                    {
                        <li class="ledger-row">
                            <span class="ver">@r.Release</span>
                            <span class="ttl">@r.Label</span>
                            <span class="dots" aria-hidden="true"></span>
                            <span class="@($"status {r.Kind}")">@r.StatusText</span>
                        </li>
                    }
                </ol>
                <p class="spec-note">@L.T("home.ed.specPrefix") <code>docs/03-pflichtenheft.md</code></p>
            </section>
        </div>

        <aside class="ed-margin" aria-label="@L.T("home.margin.heading")">
            <div>
                <h2 class="m-h">@L.T("home.margin.heading")</h2>
                <dl class="m-facts">
                    <div class="m-fact"><dt>@L.T("home.margin.version")</dt><dd class="mono">@L.T("app.version")</dd></div>
                    <div class="m-fact"><dt>@L.T("home.margin.backend")</dt><dd>@L.T("home.margin.backendVal")</dd></div>
                    <div class="m-fact"><dt>@L.T("home.margin.integrity")</dt><dd class="mono">SHA-256</dd></div>
                    <div class="m-fact"><dt>@L.T("home.margin.export")</dt><dd>JSON-Sidecar · Markdown</dd></div>
                    <div class="m-fact"><dt>@L.T("home.margin.language")</dt><dd>DE / EN</dd></div>
                </dl>
            </div>
            <div class="colophon">
                <div class="c-h">
<Icon Name="shield" />
                    @L.T("home.colophon.heading")
                </div>
                <strong>@L.T("home.privacy.title").</strong> @L.T("home.privacy.body")
            </div>
        </aside>
    </div>
</article>

@code {
    // Linke "Register"-Spalte: Kategorie-Label (k) + bestehende Beschreibung (d).
    private static readonly (string K, string D)[] Haves =
    {
        ("home.have.read", "home.builtin.viewer"),
        ("home.have.annotate", "home.builtin.annotations"),
        ("home.have.sign", "home.builtin.signature"),
        ("home.have.tools", "home.builtin.tools"),
        ("home.have.ocr", "home.builtin.ocr"),
        ("home.have.view", "home.builtin.viewerExtras"),
    };

    // Roadmap als Ledger — Status semantisch (ok/warn/muted). Aktueller Stand:
    // 0.1–1.0 inhaltlich erledigt; danach Beta-Erweiterungen (Designer/MCP/Deploy),
    // offen nur noch die Release-Mechanik (öffentlicher Tag) + gespeicherte Batch-Regeln.
    private IEnumerable<(string Release, string Label, string Kind, string StatusText)> RoadmapRows()
    {
        var done = L.T("home.status.done");
        var pending = L.T("home.status.pending");

        yield return ("0.1", L.T("home.builtin.viewer"), "ok", done);
        yield return ("0.2", L.T("home.builtin.annotations"), "ok", done);
        yield return ("0.3", L.T("home.builtin.tools"), "ok", done);
        yield return ("0.4", L.T("home.usp.signature.title"), "ok", done);
        yield return ("0.5", L.T("home.usp.library.title"), "ok", done);
        yield return ("0.6", "Multi-PDF Split-View", "ok", done);
        yield return ("0.7", L.T("home.usp.markdown.title"), "ok", done);
        yield return ("0.8", "AcroForms / Encrypt / Bild→PDF / Compress", "ok", done);
        yield return ("0.9", $"{L.T("home.builtin.ocr")} + Batch", "ok", done);
        yield return ("1.0", L.T("home.road.v1"), "ok", done);
        yield return ("1.0+", L.T("home.road.beta.suite"), "ok", done);
        yield return ("1.0+", L.T("home.road.beta.mcp"), "ok", done);
        yield return ("next", L.T("home.road.next"), "warn", pending);
    }
}
