@page "/"
@inject ILocalizationService L

<PageTitle>@L.T("app.title")</PageTitle>

<section class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="text-3xl font-bold tracking-tight">@L.T("app.title")</h1>
    <p class="mt-2 text-pb-fg-muted">
        @L.T("app.tagline")
        <span class="inline-block rounded bg-pb-accent/10 px-2 py-0.5 text-xs font-medium text-pb-accent">
            @L.T("app.preAlpha")
        </span>
    </p>

    <div class="mt-8 rounded-lg border border-pb-border bg-pb-surface p-6">
        <h2 class="text-lg font-semibold">@L.T("home.nextUp")</h2>
        <ul class="mt-3 space-y-2 text-sm">
            <li>📄 @L.T("home.feature.pdfOpen") <span class="text-pb-fg-muted">(Release 0.1)</span></li>
            <li>🖊️ @L.T("home.feature.highlight") <span class="text-pb-fg-muted">(Release 0.1 – 0.2)</span></li>
            <li>📚 @L.T("home.feature.library") <span class="text-pb-fg-muted">(Release 0.5)</span></li>
            <li>🔒 @L.T("home.feature.signature") <span class="text-pb-fg-muted">(Release 0.4)</span></li>
            <li>🔗 @L.T("home.feature.markdown") <span class="text-pb-fg-muted">(Release 0.7)</span></li>
        </ul>
        <p class="mt-4 text-sm text-pb-fg-muted">
            @((MarkupString)L.T("home.releaseHint", new Dictionary<string, object>
            {
                ["0"] = "<code class=\"rounded bg-pb-bg px-1 py-0.5 text-xs\">docs/02-lastenheft.md</code>"
            }))
        </p>
    </div>
</section>
