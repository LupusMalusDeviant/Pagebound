@page "/not-found"
@layout MainLayout
@inject ILocalizationService L

<PageTitle>@L.T("notFound.title") — @L.T("app.title")</PageTitle>

<section class="mx-auto max-w-2xl px-6 py-12">
    <h1 class="text-2xl font-bold">@L.T("notFound.title")</h1>
    <p class="mt-2 text-pb-fg-muted">
        @L.T("notFound.text")
        <a href="/" class="text-pb-accent hover:underline">@L.T("notFound.toHome")</a>
    </p>
</section>
