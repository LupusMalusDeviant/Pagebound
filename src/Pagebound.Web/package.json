{
  "name": "pagebound-web",
  "version": "0.0.0-pre",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "Tailwind/CSS + JavaScript-Interop build pipeline für Pagebound.Web (Blazor WASM frontend liegt im .NET-Projekt).",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./wwwroot/css/app.src.css -o ./wwwroot/css/app.css --minify",
    "build:js": "node esbuild.mjs",
    "watch:css": "tailwindcss -i ./wwwroot/css/app.src.css -o ./wwwroot/css/app.css --watch",
    "watch:js": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "esbuild": "^0.28.0",
    "pdfjs-dist": "^6.0.227",
    "typescript": "^6.0.3"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.10",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0"
  }
}
